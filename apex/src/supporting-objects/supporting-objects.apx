supportingObject (
    prerequisites {
        systemPrivileges: [
            createTable
            createView
            createProcedure
            createTrigger
            createSequence
        ]
    }
    installationMessages {
        welcome:
            ```
            Installs the KYC Compliance Platform database objects: XXFND_ shared components and XXCMP_ KYC objects, seed data, scheduler jobs and the first administrator.
            ```
        confirmation:
            ```
            Install the database objects now? Existing XXFND_/XXCMP_ tables are upgraded instead of recreated.
            ```
        installSuccess:
            ```
            Installed. You are the first System Administrator. Sign in and open Administration: set the application settings (sender email, Fusion URL and credential), the web credentials and the document storage endpoint.
            ```
        installFailure:
            ```
            Installation failed. Check the script results, fix the cause and reinstall Supporting Objects; every script can be re-run.
            ```
    }
    upgrade {
        upgradeWhenSqlQuery:
            ```sql
            select null from user_tables where table_name = 'XXFND_LOOKUP_TYPES'
            ```
    }
    upgradeMessages {
        welcome:
            ```
            Upgrades the KYC Compliance Platform packages, views, seed data and jobs. Tables and data are kept.
            ```
        success:
            ```
            Upgrade complete.
            ```
    }
    deinstall {
        script:
            ```
            begin
                for j in (select job_name from user_scheduler_jobs where job_name like 'XXFND\_%' escape '\') loop
                    dbms_scheduler.drop_job(j.job_name, force => true);
                end loop;
                for o in (select object_type, object_name from user_objects
                           where (object_name like 'XXFND\_%' escape '\' or object_name like 'XXCMP\_%' escape '\')
                             and object_type in ('VIEW','PACKAGE','SEQUENCE','TABLE')
                           order by decode(object_type, 'VIEW', 1, 'PACKAGE', 2, 'SEQUENCE', 3, 'TABLE', 4)) loop
                    execute immediate 'drop ' || o.object_type || ' ' || o.object_name
                        || case when o.object_type = 'TABLE' then ' cascade constraints purge' end;
                end loop;
            end;
            /
            ```
    }
    deinstallationMessages {
        confirmation:
            ```
            This drops every XXFND_ and XXCMP_ table, package and job, with all data.
            ```
    }
    advanced {
        includeInAppExport: true
    }

    validation (
        name: DBMS_CRYPTO granted
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- Runs the check as the parsing schema itself, the way the packages will use it.
                declare
                    l_type pls_integer;
                begin
                    execute immediate 'begin :t := dbms_crypto.hash_sh256; end;' using out l_type;
                    return true;
                exception
                    when others then
                        return false;
                end;
                ```
        }
        error {
            errorMessage:
                ```
                Ask the database administrator to run: grant execute on dbms_crypto to <parsing schema>
                ```
        }
    )

    validation (
        name: DBMS_RLS granted
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- Row-level data security (XXFND_VPD_PKG) attaches its policies with DBMS_RLS.
                declare
                    l_type pls_integer;
                begin
                    execute immediate 'begin :t := dbms_rls.dynamic; end;' using out l_type;
                    return true;
                exception
                    when others then
                        return false;
                end;
                ```
        }
        error {
            errorMessage:
                ```
                Ask the database administrator to run: grant execute on dbms_rls to <parsing schema>
                ```
        }
    )

    installScript (
        name: 00 Deployment framework
        execution {
            sequence: 5
        }
        script {
            content:
                ```
                --------------------------------------------------------------------------------
                -- 00_deployment_framework.sql
                -- Release tracking for chunk deployments. Every chunk ships one idempotent
                -- upgrade script that (1) checks XXFND_DDL_PKG.RELEASE_APPLIED, (2) applies its
                -- DDL with IF [NOT] EXISTS / ADD_COLUMN, and (3) records itself with MARK_RELEASE.
                -- Re-importing the same release therefore changes nothing.
                --------------------------------------------------------------------------------
                create table if not exists xxfnd_schema_releases (
                    release_code           varchar2(30)   not null,
                    description            varchar2(400)  not null,
                    applied_date           timestamp      default systimestamp not null,
                    applied_by             varchar2(255)  not null,
                    constraint xxfnd_schema_releases_pk primary key (release_code)
                );

                create or replace package xxfnd_ddl_pkg authid current_user as
                    -- True once MARK_RELEASE has recorded this release in this schema.
                    function release_applied(p_release_code in varchar2) return boolean;
                    procedure mark_release(p_release_code in varchar2, p_description in varchar2);
                    -- ALTER TABLE ... ADD (<column> <definition>) only when the column is missing.
                    procedure add_column(p_table_name in varchar2, p_column_name in varchar2, p_definition in varchar2);
                end xxfnd_ddl_pkg;
                /

                create or replace package body xxfnd_ddl_pkg as

                    function release_applied(p_release_code in varchar2) return boolean is
                        l_count pls_integer;
                    begin
                        select count(*) into l_count from xxfnd_schema_releases where release_code = upper(p_release_code);
                        return l_count > 0;
                    end release_applied;

                    procedure mark_release(p_release_code in varchar2, p_description in varchar2) is
                    begin
                        merge into xxfnd_schema_releases t
                        using (select upper(p_release_code) release_code from dual) s
                           on (t.release_code = s.release_code)
                         when not matched then
                            insert (release_code, description, applied_by)
                            values (s.release_code, p_description,
                                    coalesce(sys_context('APEX$SESSION', 'APP_USER'), sys_context('USERENV', 'SESSION_USER')));
                    end mark_release;

                    procedure add_column(p_table_name in varchar2, p_column_name in varchar2, p_definition in varchar2) is
                        l_table  varchar2(128) := upper(dbms_assert.simple_sql_name(p_table_name));
                        l_column varchar2(128) := upper(dbms_assert.simple_sql_name(p_column_name));
                        l_count  pls_integer;
                    begin
                        select count(*) into l_count from user_tab_columns where table_name = l_table and column_name = l_column;
                        if l_count = 0 then
                            execute immediate 'alter table ' || l_table || ' add (' || l_column || ' ' || p_definition || ')';
                        end if;
                    end add_column;

                end xxfnd_ddl_pkg;
                /

                begin
                    xxfnd_ddl_pkg.mark_release('R09', 'Release 9: deployment framework (baseline incl. install fixes and Chunk 0)');
                    commit;
                end;
                /
                ```
        }
    )

    installScript (
        name: 01 Common tables - XXFND - part 1 of 3
        execution {
            sequence: 10
        }
        script {
            content:
                ```
                --------------------------------------------------------------------------------
                -- 01_xxfnd_tables.sql
                -- Common, reusable components (XXFND_). Any application in workspace XXCUS
                -- may use these objects. KYC-specific objects live in 02_xxcmp_tables.sql.
                --
                --   0.0  Lookups, identity and access, notification templates, audit, retention
                --   0.1  Attachments (EBS FND attachments model; UCM or SharePoint storage)
                --   0.2  Workflow engine
                --   0.4  Integration hub
                --   0.5  Descriptive flexfields (EBS structure, Fusion typed segments)
                --
                -- Conventions
                --   * Surrogate keys are identity columns; stable setup data uses natural keys.
                --   * Every table carries the standard WHO columns; XXFND_UTIL_PKG creates the
                --     trigger that fills them and increments OBJECT_VERSION_NUMBER.
                --   * ENABLED_FLAG plus START/END_DATE_ACTIVE where effective dating applies.
                --   * Single-column lookup codes are validated by LOVs and packages, not by a
                --     foreign key, because XXFND_LOOKUP_VALUES has a two-column key (the same
                --     approach as FND_LOOKUP_VALUES).
                --   * _TL tables hold translated text; LANGUAGE_CODE uses APEX language codes
                --     ('en', 'ar'). A missing translation falls back to the base row.
                --------------------------------------------------------------------------------

                --==============================================================================
                -- 0.0  LOOKUPS
                --==============================================================================
                create table xxfnd_lookup_types (
                    lookup_type            varchar2(30)   not null,
                    meaning                varchar2(200)  not null,
                    description            varchar2(500),
                    application_code       varchar2(30),
                    customization_level    varchar2(1)    default 'U' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_lookup_types_pk primary key (lookup_type),
                    constraint xxfnd_lookup_types_ck1 check (customization_level in ('S','E','U'))
                );
                comment on table  xxfnd_lookup_types is 'Lookup type header (FND_LOOKUP_TYPES). APPLICATION_CODE null = shared by every application.';
                comment on column xxfnd_lookup_types.customization_level is 'S = system (values locked), E = extensible (values may be added), U = user (fully editable).';

                create table xxfnd_lookup_values (
                    lookup_type            varchar2(30)   not null,
                    lookup_code            varchar2(30)   not null,
                    meaning                varchar2(200)  not null,
                    description            varchar2(500),
                    tag                    varchar2(150),
                    parent_lookup_type     varchar2(30),
                    parent_lookup_code     varchar2(30),
                    display_sequence       number,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    start_date_active      date           default trunc(sysdate) not null,
                    end_date_active        date,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_lookup_values_pk primary key (lookup_type, lookup_code),
                    constraint xxfnd_lookup_values_fk1 foreign key (lookup_type) references xxfnd_lookup_types (lookup_type),
                    constraint xxfnd_lookup_values_fk2 foreign key (parent_lookup_type, parent_lookup_code)
                        references xxfnd_lookup_values (lookup_type, lookup_code),
                    constraint xxfnd_lookup_values_ck1 check (enabled_flag in ('Y','N')),
                    constraint xxfnd_lookup_values_ck2 check (end_date_active is null or end_date_active >= start_date_active)
                );
                create index xxfnd_lookup_values_n1 on xxfnd_lookup_values (parent_lookup_type, parent_lookup_code);
                comment on table  xxfnd_lookup_values is 'Lookup values (FND_LOOKUP_VALUES). Parent columns support dependent (cascading) values.';
                comment on column xxfnd_lookup_values.tag is 'One extra attribute for a value, e.g. a jurisdiction''s UBO threshold. Needs more than one? Use a dedicated table.';

                create table xxfnd_lookup_values_tl (
                    lookup_type            varchar2(30)   not null,
                    lookup_code            varchar2(30)   not null,
                    language_code          varchar2(10)   not null,
                    meaning                varchar2(200)  not null,
                    description            varchar2(500),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_lookup_values_tl_pk primary key (lookup_type, lookup_code, language_code),
                    constraint xxfnd_lookup_values_tl_fk1 foreign key (lookup_type, lookup_code)
                        references xxfnd_lookup_values (lookup_type, lookup_code) on delete cascade
                );

                --==============================================================================
                -- 0.0  IDENTITY AND ACCESS
                --==============================================================================
                create table xxfnd_employees (
                    employee_id            number generated by default on null as identity,
                    source_type            varchar2(20)   default 'LOCAL' not null,
                    fusion_person_id       number,
                    fusion_person_number   varchar2(30),
                    user_name              varchar2(255)  not null,
                    full_name              varchar2(240)  not null,
                    email_address          varchar2(320)  not null,
                    department_name        varchar2(240),
                    job_title              varchar2(240),
                    last_sync_date         timestamp,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    start_date_active      date           default trunc(sysdate) not null,
                    end_date_active        date,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_employees_pk primary key (employee_id),
                    constraint xxfnd_employees_uk1 unique (user_name),
                    constraint xxfnd_employees_uk2 unique (email_address),
                    constraint xxfnd_employees_ck1 check (source_type in ('FUSION','LOCAL')),
                    constraint xxfnd_employees_ck2 check (
                        (source_type = 'FUSION' and fusion_person_id is not null) or
                        (source_type = 'LOCAL'  and fusion_person_id is null)),
                    constraint xxfnd_employees_ck3 check (enabled_flag in ('Y','N')),
                    constraint xxfnd_employees_ck4 check (user_name = upper(user_name))
                );
                create unique index xxfnd_employees_u3 on xxfnd_employees (fusion_person_id);
                comment on table  xxfnd_employees is 'One row per person. FUSION rows are maintained by the Fusion HCM sync and are read-only in the application; LOCAL rows are maintained by an administrator.';
                comment on column xxfnd_employees.user_name is 'Matches APP_USER after sign-in (upper case). This is how a session resolves to a person.';

                create table xxfnd_roles (
                    role_code              varchar2(30)   not null,
                    application_code       varchar2(30)   not null,
                    role_name              varchar2(200)  not null,
                    description            varchar2(500),
                    view_sensitive_flag    varchar2(1)    default 'N' not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_roles_pk primary key (role_code),
                    constraint xxfnd_roles_ck1 check (view_sensitive_flag in ('Y','N')),
                    constraint xxfnd_roles_ck2 check (enabled_flag in ('Y','N'))
                );
                create index xxfnd_roles_n1 on xxfnd_roles (application_code);
                comment on table xxfnd_roles is 'Application roles. Enforced by APEX authorization schemes that call XXFND_SECURITY_PKG.';

                create table xxfnd_user_roles (
                    user_role_id           number generated by default on null as identity,
                    employee_id            number         not null,
                    role_code              varchar2(30)   not null,
                    start_date_active      date           default trunc(sysdate) not null,
                    end_date_active        date,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_user_roles_pk primary key (user_role_id),
                    constraint xxfnd_user_roles_fk1 foreign key (employee_id) references xxfnd_employees (employee_id),
                    constraint xxfnd_user_roles_fk2 foreign key (role_code) references xxfnd_roles (role_code),
                    constraint xxfnd_user_roles_ck1 check (enabled_flag in ('Y','N')),
                    constraint xxfnd_user_roles_ck2 check (end_date_active is null or end_date_active >= start_date_active)
                );
                create index xxfnd_user_roles_n1 on xxfnd_user_roles (employee_id);
                create index xxfnd_user_roles_n2 on xxfnd_user_roles (role_code);
                -- One open-ended grant per person and role; closed history rows may repeat.
                -- Every key column is wrapped in the CASE: rows outside the condition have an all-NULL key and are not indexed.
                create unique index xxfnd_user_roles_u1 on xxfnd_user_roles (
                    case when end_date_active is null then employee_id end,
                    case when end_date_active is null then role_code end);

                create table xxfnd_sod_rules (
                    sod_rule_id            number generated by default on null as identity,
                    role_code_1            varchar2(30)   not null,
                    role_code_2            varchar2(30)   not null,
                    conflict_scope         varchar2(30)   not null,
                    description            varchar2(500),
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_sod_rules_pk primary key (sod_rule_id),
                    constraint xxfnd_sod_rules_fk1 foreign key (role_code_1) references xxfnd_roles (role_code),
                    constraint xxfnd_sod_rules_fk2 foreign key (role_code_2) references xxfnd_roles (role_code),
                    constraint xxfnd_sod_rules_uk1 unique (role_code_1, role_code_2, conflict_scope),
                    constraint xxfnd_sod_rules_ck1 check (role_code_1 < role_code_2),
                    constraint xxfnd_sod_rules_ck2 check (enabled_flag in ('Y','N'))
                );
                comment on table  xxfnd_sod_rules is 'Role pairs that one person may not both exercise within CONFLICT_SCOPE. Stored in canonical order so a pair cannot be entered twice.';
                comment on column xxfnd_sod_rules.conflict_scope is 'Lookup SOD_SCOPE, e.g. SAME_RECORD (same case) or GLOBAL (never both roles).';

                --==============================================================================
                -- 0.0  NOTIFICATION TEMPLATES, AUDIT, RETENTION
                --==============================================================================
                create table xxfnd_notification_templates (
                    template_code          varchar2(50)   not null,
                    application_code       varchar2(30),
                    subject                varchar2(500)  not null,
                    body_html              clob           not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_notif_templates_pk primary key (template_code),
                    constraint xxfnd_notif_templates_ck1 check (enabled_flag in ('Y','N'))
                );
                comment on table xxfnd_notification_templates is 'Wording of every system email and alert. Placeholders use #TOKEN# syntax and are replaced at send time.';

                create table xxfnd_notification_templates_tl (
                    template_code          varchar2(50)   not null,
                    language_code          varchar2(10)   not null,
                    subject                varchar2(500)  not null,
                    body_html              clob           not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_notif_templates_tl_pk primary key (template_code, language_code),
                    constraint xxfnd_notif_templates_tl_fk1 foreign key (template_code)
                        references xxfnd_notification_templates (template_code) on delete cascade
                );

                create table xxfnd_audit_log (
                    audit_log_id           number generated by default on null as identity,
                    table_name             varchar2(128)  not null,
                    pk_value               varchar2(400)  not null,
                    action_code            varchar2(1)    not null,
                    column_name            varchar2(128),
                    old_value              varchar2(4000),
                    new_value              varchar2(4000),
                    change_reason          varchar2(1000),
                    changed_by             varchar2(255)  not null,
                    changed_date           timestamp      default systimestamp not null,
                    constraint xxfnd_audit_log_pk primary key (audit_log_id),
                    constraint xxfnd_audit_log_ck1 check (action_code in ('I','U','D'))
                );
                create index xxfnd_audit_log_n1 on xxfnd_audit_log (table_name, pk_value);
                create index xxfnd_audit_log_n2 on xxfnd_audit_log (changed_date);
                comment on table xxfnd_audit_log is 'Append-only change log for configuration tables, written by triggers that XXFND_AUDIT_PKG generates. Rows are never updated, so there are no WHO columns.';

                create table xxfnd_retention_policies (
                    retention_policy_id    number generated by default on null as identity,
                    table_name             varchar2(128)  not null,
                    jurisdiction           varchar2(30),
                    retention_years        number(3)      not null,
                    action_at_expiry       varchar2(30)   not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_retention_policies_pk primary key (retention_policy_id),
                    constraint xxfnd_retention_policies_ck1 check (action_at_expiry in ('ARCHIVE','PURGE','FLAG_FOR_REVIEW')),
                    constraint xxfnd_retention_policies_ck2 check (retention_years > 0),
                    constraint xxfnd_retention_policies_ck3 check (enabled_flag in ('Y','N'))
                );
                create unique index xxfnd_retention_policies_u1 on xxfnd_retention_policies (table_name, nvl(jurisdiction, '#'));

                --==============================================================================
                -- 0.4  INTEGRATION HUB  (created before attachments, which reference endpoints)
                --==============================================================================
                create table xxfnd_integration_endpoints (
                    endpoint_code          varchar2(30)   not null,
                    endpoint_name          varchar2(200)  not null,
                    endpoint_type          varchar2(30)   not null,
                    base_url               varchar2(1000) not null,
                    web_credential_static_id varchar2(255),
                    oauth_token_url        varchar2(1000),
                    oauth_scope            varchar2(1000),
                    status_code            varchar2(20)   default 'REGISTERED' not null,
                    description            varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_int_endpoints_pk primary key (endpoint_code),
                    constraint xxfnd_int_endpoints_ck1 check (status_code in ('REGISTERED','ACTIVE','INACTIVE'))
                );
                comment on column xxfnd_integration_endpoints.oauth_token_url is 'OAuth2 client-credentials token URL (not a secret), e.g. https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token for SharePoint via Microsoft Graph.';
                comment on table  xxfnd_integration_endpoints is 'Non-Oracle external systems. Secrets live only in APEX Web Credentials (Shared Components); this table stores the credential static ID. Oracle Fusion uses APEX''s native Fusion integration instead.';
                comment on column xxfnd_integration_endpoints.endpoint_type is 'Lookup ENDPOINT_TYPE: UCM, SHAREPOINT, SCREENING_PROVIDER, REGISTRY_PROVIDER, DOC_AUTH_PROVIDER, OTHER.';

                create table xxfnd_integration_purposes (
                    purpose_code           varchar2(30)   not null,
                    application_code       varchar2(30),
                    purpose_name           varchar2(200)  not null,
                    endpoint_code          varchar2(30),
                    capture_method         varchar2(20)   default 'MANUAL' not null,
                    approval_status        varchar2(20)   default 'DRAFT' not null,
                    approved_by            varchar2(255),
                    approved_date          timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_int_purposes_pk primary key (purpose_code),
                    constraint xxfnd_int_purposes_fk1 foreign key (endpoint_code) references xxfnd_integration_endpoints (endpoint_code),
                    constraint xxfnd_int_purposes_ck1 check (capture_method in ('MANUAL','API')),
                    constraint xxfnd_int_purposes_ck2 check (approval_status in ('DRAFT','PENDING_APPROVAL','APPROVED','REJECTED')),
                    constraint xxfnd_int_purposes_ck3 check (capture_method = 'MANUAL' or endpoint_code is not null)
                );
                comment on table xxfnd_integration_purposes is 'Which endpoint serves each business purpose, and whether it runs manually or by API. Changes take effect only after a second person approves them.';

                create table xxfnd_transmissions (
                    transmission_id        number generated by default on null as identity,
                    endpoint_code          varchar2(30)   not null,
                    purpose_code           varchar2(30)   not null,
                    entity_name            varchar2(60),
                    pk1_value              varchar2(150),
                    http_method            varchar2(10)   not null,
                    request_url            varchar2(4000) not null,
                    request_payload        clob,
                    response_status_code   number(3),
                    response_payload       clob,
                    status_code            varchar2(20)   default 'PENDING' not null,
                    retry_count            number(3)      default 0 not null,
                    error_message          varchar2(4000),
                    sent_date              timestamp      default systimestamp not null,
                    responded_date         timestamp,
                    created_by             varchar2(255)  not null,
                    constraint xxfnd_transmissions_pk primary key (transmission_id),
                    constraint xxfnd_transmissions_fk1 foreign key (endpoint_code) references xxfnd_integration_endpoints (endpoint_code),
                    constraint xxfnd_transmissions_fk2 foreign key (purpose_code) references xxfnd_integration_purposes (purpose_code),
                    constraint xxfnd_transmissions_ck1 check (status_code in ('PENDING','SUCCESS','FAILED','RETRYING'))
                );
                create index xxfnd_transmissions_n1 on xxfnd_transmissions (entity_name, pk1_value);
                create index xxfnd_transmissions_n2 on xxfnd_transmissions (status_code, sent_date);
                comment on table xxfnd_transmissions is 'Business-level log of every outbound call, tied to the record it served. Binary payloads are not stored; REQUEST_PAYLOAD holds metadata only for file uploads.';

                --==============================================================================
                -- 0.1  ATTACHMENTS  (EBS: FND_DOCUMENT_ENTITIES, FND_ATTACHMENT_FUNCTIONS,
                --      FND_ATTACHMENT_BLOCKS, FND_ATTACHMENT_BLK_ENTITIES, FND_DOC_CATEGORY_USAGES,
                --      FND_DOCUMENT_CATEGORIES, FND_DOCUMENTS, FND_ATTACHED_DOCUMENTS)
                --==============================================================================
                create table xxfnd_document_entities (
                    entity_name            varchar2(60)   not null,
                    application_code       varchar2(30),
                    table_name             varchar2(128)  not null,
                    pk1_column             varchar2(128)  not null,
                    pk2_column             varchar2(128),
                    pk3_column             varchar2(128),
                    pk4_column             varchar2(128),
                    pk5_column             varchar2(128),
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_doc_entities_pk primary key (entity_name),
                    constraint xxfnd_doc_entities_ck1 check (enabled_flag in ('Y','N'))
                );
                comment on table xxfnd_document_entities is 'Registered attachable entities (FND_DOCUMENT_ENTITIES). Gives ATTACHED_DOCUMENTS.ENTITY_NAME a real foreign key.';

                create table xxfnd_document_entities_tl (
                    entity_name            varchar2(60)   not null,
                    language_code          varchar2(10)   not null,
                    user_entity_name       varchar2(240)  not null,
                    description            varchar2(500),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_doc_entities_tl_pk primary key (entity_name, language_code),
                    constraint xxfnd_doc_entities_tl_fk1 foreign key (entity_name)
                        references xxfnd_document_entities (entity_name) on delete cascade
                );

                create table xxfnd_document_categories (
                    category_code          varchar2(30)   not null,
                    application_code       varchar2(30),
                    category_name          varchar2(240)  not null,
                    description            varchar2(500),
                    default_datatype_code  varchar2(30)   default 'FILE' not null,
                    has_expiry_flag        varchar2(1)    default 'N' not null,
                    max_age_days           number(5),
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    start_date_active      date           default trunc(sysdate) not null,
                    end_date_active        date,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_doc_categories_pk primary key (category_code),
                    constraint xxfnd_doc_categories_ck1 check (default_datatype_code in ('FILE','SHORT_TEXT','LONG_TEXT','WEB_PAGE')),
                    constraint xxfnd_doc_categories_ck2 check (has_expiry_flag in ('Y','N')),
                    constraint xxfnd_doc_categories_ck3 check (enabled_flag in ('Y','N')),
                    constraint xxfnd_doc_categories_ck4 check (max_age_days is null or max_age_days > 0)
                );
                comment on column xxfnd_document_categories.has_expiry_flag is 'Y = the document itself expires (passport, licence); an expiry date is required on upload.';
                comment on column xxfnd_document_categories.max_age_days is 'How recent the document must be when submitted (e.g. utility bill within 90 days). Separate from expiry.';

                create table xxfnd_document_categories_tl (
                    category_code          varchar2(30)   not null,
                    language_code          varchar2(10)   not null,
                    category_name          varchar2(240)  not null,
                    description            varchar2(500),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_doc_categories_tl_pk primary key (category_code, language_code),
                    constraint xxfnd_doc_categories_tl_fk1 foreign key (category_code)
                        references xxfnd_document_categories (category_code) on delete cascade
                );

                create table xxfnd_attachment_functions (
                    function_code          varchar2(60)   not null,
                    application_code       varchar2(30),
                    function_name          varchar2(240)  not null,
                    apex_app_alias         varchar2(255)  not null,
                    apex_page_id           number         not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_att_functions_pk primary key (function_code),
                    constraint xxfnd_att_functions_uk1 unique (apex_app_alias, apex_page_id),
                    constraint xxfnd_att_functions_ck1 check (enabled_flag in ('Y','N'))
                );
                comment on table  xxfnd_attachment_functions is 'An APEX page that shows attachments (FND_ATTACHMENT_FUNCTIONS). Keyed by application alias, which stays stable across imports; the numeric application ID does not.';

                create table xxfnd_attachment_blocks (
                    function_code          varchar2(60)   not null,
                    block_code             varchar2(60)   not null,
                    region_static_id       varchar2(255)  not null,
                    block_name             varchar2(240),
                    display_sequence       number,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_att_blocks_pk primary key (function_code, block_code),
                    constraint xxfnd_att_blocks_fk1 foreign key (function_code)
                        references xxfnd_attachment_functions (function_code) on delete cascade,
                    constraint xxfnd_att_blocks_uk1 unique (function_code, region_static_id)
                );
                comment on table xxfnd_attachment_blocks is 'A region on the page (FND_ATTACHMENT_BLOCKS), identified by its static ID.';

                create table xxfnd_attachment_blk_entities (
                    function_code          varchar2(60)   not null,
                    block_code             varchar2(60)   not null,
                    entity_name            varchar2(60)   not null,
                    pk1_page_item          varchar2(255)  not null,
                    pk2_page_item          varchar2(255),
                    pk3_page_item          varchar2(255),
                    pk4_page_item          varchar2(255),
                    pk5_page_item          varchar2(255),
                    insert_allowed_flag    varchar2(1)    default 'Y' not null,
                    update_allowed_flag    varchar2(1)    default 'Y' not null,
                    delete_allowed_flag    varchar2(1)    default 'N' not null,
                    display_sequence       number,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_att_blk_entities_pk primary key (function_code, block_code, entity_name),
                    constraint xxfnd_att_blk_entities_fk1 foreign key (function_code, block_code)
                        references xxfnd_attachment_blocks (function_code, block_code) on delete cascade,
                    constraint xxfnd_att_blk_entities_fk2 foreign key (entity_name) references xxfnd_document_entities (entity_name),
                    constraint xxfnd_att_blk_entities_ck1 check (insert_allowed_flag in ('Y','N')),
                    constraint xxfnd_att_blk_entities_ck2 check (update_allowed_flag in ('Y','N')),
                    constraint xxfnd_att_blk_entities_ck3 check (delete_allowed_flag in ('Y','N'))
                );
                comment on table xxfnd_attachment_blk_entities is 'Which entity a region attaches to, which page items supply PK1-PK5, and what the user may do (FND_ATTACHMENT_BLK_ENTITIES).';

                create table xxfnd_doc_category_usages (
                    function_code          varchar2(60)   not null,
                    category_code          varchar2(30)   not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_doc_category_usages_pk primary key (function_code, category_code),
                    constraint xxfnd_doc_category_usages_fk1 foreign key (function_code)
                        references xxfnd_attachment_functions (function_code) on delete cascade,
                    constraint xxfnd_doc_category_usages_fk2 foreign key (category_code) references xxfnd_document_categories (category_code),
                    constraint xxfnd_doc_category_usages_ck1 check (enabled_flag in ('Y','N'))
                );
                comment on table xxfnd_doc_category_usages is 'Categories a page may offer (FND_DOC_CATEGORY_USAGES). A page with no rows here offers every enabled category.';
                ```
        }
    )

    installScript (
        name: 02 Common tables - XXFND - part 2 of 3
        execution {
            sequence: 20
        }
        script {
            content:
                ```
                create table xxfnd_storage_config (
                    storage_config_id      number generated by default on null as identity,
                    entity_name            varchar2(60),
                    category_code          varchar2(30),
                    storage_type           varchar2(30)   not null,
                    endpoint_code          varchar2(30)   not null,
                    folder_path_template   varchar2(1000) default '/#ENTITY_NAME#/#PK1_VALUE#' not null,
                    ucm_security_group     varchar2(100),
                    ucm_doc_type           varchar2(100),
                    ucm_doc_account        varchar2(100),
                    sharepoint_site_id     varchar2(500),
                    sharepoint_drive_id    varchar2(500),
                    priority               number         default 100 not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_storage_config_pk primary key (storage_config_id),
                    constraint xxfnd_storage_config_fk1 foreign key (entity_name) references xxfnd_document_entities (entity_name),
                    constraint xxfnd_storage_config_fk2 foreign key (category_code) references xxfnd_document_categories (category_code),
                    constraint xxfnd_storage_config_fk3 foreign key (endpoint_code) references xxfnd_integration_endpoints (endpoint_code),
                    constraint xxfnd_storage_config_ck1 check (storage_type in ('UCM','SHAREPOINT')),
                    constraint xxfnd_storage_config_ck2 check (
                        (storage_type = 'UCM'        and ucm_security_group is not null) or
                        (storage_type = 'SHAREPOINT' and sharepoint_site_id is not null and sharepoint_drive_id is not null)),
                    constraint xxfnd_storage_config_ck3 check (enabled_flag in ('Y','N'))
                );
                create unique index xxfnd_storage_config_u1 on xxfnd_storage_config (nvl(entity_name,'#'), nvl(category_code,'#'));
                comment on table  xxfnd_storage_config is 'Where files are stored: Oracle UCM (WebCenter Content) or SharePoint. The most specific row wins (entity + category, then entity, then category, then the default row with both null); PRIORITY breaks ties.';
                comment on column xxfnd_storage_config.folder_path_template is 'Folder for new files. Tokens: #ENTITY_NAME#, #PK1_VALUE#..#PK5_VALUE#, #CATEGORY_CODE#, #YYYY#.';

                create table xxfnd_documents (
                    document_id            number generated by default on null as identity,
                    category_code          varchar2(30)   not null,
                    datatype_code          varchar2(30)   not null,
                    base_document_id       number,
                    version_number         number         default 1 not null,
                    storage_config_id      number,
                    storage_type           varchar2(30),
                    external_document_id   varchar2(500),
                    external_version_id    varchar2(500),
                    external_url           varchar2(2000),
                    file_name              varchar2(400),
                    mime_type              varchar2(255),
                    file_size_bytes        number,
                    text_content           clob,
                    url                    varchar2(2000),
                    document_date          date,
                    expiry_date            date,
                    upload_status          varchar2(20)   default 'PENDING' not null,
                    upload_error           varchar2(4000),
                    automated_check_status varchar2(30)   default 'NOT_CHECKED' not null,
                    start_date_active      date           default trunc(sysdate) not null,
                    end_date_active        date,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_documents_pk primary key (document_id),
                    constraint xxfnd_documents_fk1 foreign key (category_code) references xxfnd_document_categories (category_code),
                    constraint xxfnd_documents_fk2 foreign key (base_document_id) references xxfnd_documents (document_id),
                    constraint xxfnd_documents_fk3 foreign key (storage_config_id) references xxfnd_storage_config (storage_config_id),
                    constraint xxfnd_documents_ck1 check (datatype_code in ('FILE','SHORT_TEXT','LONG_TEXT','WEB_PAGE')),
                    constraint xxfnd_documents_ck2 check (upload_status in ('PENDING','STORED','FAILED','NOT_APPLICABLE')),
                    constraint xxfnd_documents_ck3 check (automated_check_status in ('NOT_CHECKED','PASSED','FLAGGED')),
                    constraint xxfnd_documents_ck4 check (
                        (datatype_code = 'FILE'     and storage_type in ('UCM','SHAREPOINT') and file_name is not null) or
                        (datatype_code = 'WEB_PAGE' and url is not null and storage_type is null) or
                        (datatype_code in ('SHORT_TEXT','LONG_TEXT') and storage_type is null))
                );
                create index xxfnd_documents_n1 on xxfnd_documents (category_code);
                create index xxfnd_documents_n2 on xxfnd_documents (base_document_id);
                comment on table  xxfnd_documents is 'Document header (FND_DOCUMENTS). Files are held in UCM or SharePoint; the database keeps only the reference. Text and web-page documents need no external store.';
                comment on column xxfnd_documents.base_document_id is 'First version of this document. Null on the first version; later versions point back to it.';
                comment on column xxfnd_documents.document_date is 'Issue date printed on the document. Checked against the category''s MAX_AGE_DAYS.';
                comment on column xxfnd_documents.external_document_id is 'UCM dDocName, or SharePoint drive item ID.';
                comment on column xxfnd_documents.external_version_id is 'UCM dID, or SharePoint version label.';
                comment on column xxfnd_documents.upload_status is 'PENDING until the external store confirms the file; FAILED keeps the error in UPLOAD_ERROR so nothing is silently lost.';
                comment on column xxfnd_documents.automated_check_status is 'Reserved for an automated authenticity check (integration purpose DOC_AUTHENTICITY).';

                create table xxfnd_documents_tl (
                    document_id            number         not null,
                    language_code          varchar2(10)   not null,
                    title                  varchar2(400),
                    description            varchar2(2000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_documents_tl_pk primary key (document_id, language_code),
                    constraint xxfnd_documents_tl_fk1 foreign key (document_id) references xxfnd_documents (document_id) on delete cascade
                );

                create table xxfnd_attached_documents (
                    attached_document_id   number generated by default on null as identity,
                    document_id            number         not null,
                    entity_name            varchar2(60)   not null,
                    pk1_value              varchar2(150)  not null,
                    pk2_value              varchar2(150),
                    pk3_value              varchar2(150),
                    pk4_value              varchar2(150),
                    pk5_value              varchar2(150),
                    category_code          varchar2(30)   not null,
                    seq_num                number         default 10 not null,
                    primary_category_flag  varchar2(1)    default 'N' not null,
                    expiration_date        timestamp,
                    -- descriptive flexfield (XXFND_DF_*): context + typed reserved segments
                    attribute_category       varchar2(150),
                    attribute1               varchar2(150),
                    attribute2               varchar2(150),
                    attribute3               varchar2(150),
                    attribute4               varchar2(150),
                    attribute5               varchar2(150),
                    attribute6               varchar2(150),
                    attribute7               varchar2(150),
                    attribute8               varchar2(150),
                    attribute9               varchar2(150),
                    attribute10              varchar2(150),
                    attribute11              varchar2(150),
                    attribute12              varchar2(150),
                    attribute13              varchar2(150),
                    attribute14              varchar2(150),
                    attribute15              varchar2(150),
                    attribute16              varchar2(150),
                    attribute17              varchar2(150),
                    attribute18              varchar2(150),
                    attribute19              varchar2(150),
                    attribute20              varchar2(150),
                    attribute21              varchar2(150),
                    attribute22              varchar2(150),
                    attribute23              varchar2(150),
                    attribute24              varchar2(150),
                    attribute25              varchar2(150),
                    attribute26              varchar2(150),
                    attribute27              varchar2(150),
                    attribute28              varchar2(150),
                    attribute29              varchar2(150),
                    attribute30              varchar2(150),
                    attribute_number1        number,
                    attribute_number2        number,
                    attribute_number3        number,
                    attribute_number4        number,
                    attribute_number5        number,
                    attribute_number6        number,
                    attribute_number7        number,
                    attribute_number8        number,
                    attribute_number9        number,
                    attribute_number10       number,
                    attribute_date1          date,
                    attribute_date2          date,
                    attribute_date3          date,
                    attribute_date4          date,
                    attribute_date5          date,
                    attribute_date6          date,
                    attribute_date7          date,
                    attribute_date8          date,
                    attribute_date9          date,
                    attribute_date10         date,
                    attribute_timestamp1     timestamp,
                    attribute_timestamp2     timestamp,
                    attribute_timestamp3     timestamp,
                    attribute_timestamp4     timestamp,
                    attribute_timestamp5     timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_attached_documents_pk primary key (attached_document_id),
                    constraint xxfnd_attached_documents_fk1 foreign key (document_id) references xxfnd_documents (document_id),
                    constraint xxfnd_attached_documents_fk2 foreign key (entity_name) references xxfnd_document_entities (entity_name),
                    constraint xxfnd_attached_documents_fk3 foreign key (category_code) references xxfnd_document_categories (category_code),
                    constraint xxfnd_attached_documents_ck1 check (primary_category_flag in ('Y','N'))
                );
                create index xxfnd_attached_documents_n1 on xxfnd_attached_documents (entity_name, pk1_value, pk2_value, pk3_value);
                create index xxfnd_attached_documents_n2 on xxfnd_attached_documents (document_id);
                comment on table  xxfnd_attached_documents is 'Links a document to any record of a registered entity (FND_ATTACHED_DOCUMENTS). Carries its own descriptive flexfield.';
                comment on column xxfnd_attached_documents.expiration_date is 'Soft delete. A removed attachment keeps its row and audit history.';

                create table xxfnd_entity_containers (
                    entity_container_id    number generated by default on null as identity,
                    entity_name            varchar2(60)   not null,
                    pk1_value              varchar2(150)  not null,
                    storage_config_id      number         not null,
                    external_folder_id     varchar2(500),
                    external_folder_path   varchar2(2000) not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_entity_containers_pk primary key (entity_container_id),
                    constraint xxfnd_entity_containers_fk1 foreign key (entity_name) references xxfnd_document_entities (entity_name),
                    constraint xxfnd_entity_containers_fk2 foreign key (storage_config_id) references xxfnd_storage_config (storage_config_id),
                    constraint xxfnd_entity_containers_uk1 unique (entity_name, pk1_value, storage_config_id)
                );
                comment on table xxfnd_entity_containers is 'The external folder created for one record, so later files land in the same place.';

                --==============================================================================
                -- 0.2  WORKFLOW ENGINE  (EBS WF vocabulary: item type, process, activity,
                --      transition, item, notification)
                --==============================================================================
                create table xxfnd_wf_item_types (
                    item_type              varchar2(30)   not null,
                    application_code       varchar2(30),
                    item_type_name         varchar2(240)  not null,
                    entity_name            varchar2(60)   not null,
                    description            varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_wf_item_types_pk primary key (item_type),
                    constraint xxfnd_wf_item_types_fk1 foreign key (entity_name) references xxfnd_document_entities (entity_name)
                );
                comment on table xxfnd_wf_item_types is 'What a workflow runs against, e.g. KYC_CASE on entity XXCMP_REQUESTS. Reuses the attachment entity registry as the one list of business entities.';

                create table xxfnd_wf_processes (
                    item_type              varchar2(30)   not null,
                    process_code           varchar2(30)   not null,
                    version_number         number         not null,
                    process_name           varchar2(240)  not null,
                    active_flag            varchar2(1)    default 'N' not null,
                    description            varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_wf_processes_pk primary key (item_type, process_code, version_number),
                    constraint xxfnd_wf_processes_fk1 foreign key (item_type) references xxfnd_wf_item_types (item_type),
                    constraint xxfnd_wf_processes_ck1 check (active_flag in ('Y','N'))
                );
                -- Every key column is wrapped in the CASE: rows outside the condition have an all-NULL key and are not indexed.
                create unique index xxfnd_wf_processes_u1 on xxfnd_wf_processes (
                    case when active_flag = 'Y' then item_type end,
                    case when active_flag = 'Y' then process_code end);
                comment on table xxfnd_wf_processes is 'Versioned process definitions. One active version per process; running items stay on the version they started on.';

                create table xxfnd_wf_activities (
                    activity_id            number generated by default on null as identity,
                    item_type              varchar2(30)   not null,
                    process_code           varchar2(30)   not null,
                    version_number         number         not null,
                    activity_code          varchar2(30)   not null,
                    activity_name          varchar2(240)  not null,
                    activity_type          varchar2(20)   not null,
                    performer_role_code    varchar2(30),
                    notification_template_code varchar2(50),
                    timeout_hours          number,
                    start_flag             varchar2(1)    default 'N' not null,
                    end_flag               varchar2(1)    default 'N' not null,
                    display_sequence       number,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_wf_activities_pk primary key (activity_id),
                    constraint xxfnd_wf_activities_uk1 unique (item_type, process_code, version_number, activity_code),
                    constraint xxfnd_wf_activities_fk1 foreign key (item_type, process_code, version_number)
                        references xxfnd_wf_processes (item_type, process_code, version_number),
                    constraint xxfnd_wf_activities_fk2 foreign key (performer_role_code) references xxfnd_roles (role_code),
                    constraint xxfnd_wf_activities_fk3 foreign key (notification_template_code)
                        references xxfnd_notification_templates (template_code),
                    constraint xxfnd_wf_activities_ck1 check (activity_type in ('START','TASK','APPROVAL','NOTIFICATION','WAIT','END')),
                    constraint xxfnd_wf_activities_ck2 check (start_flag in ('Y','N')),
                    constraint xxfnd_wf_activities_ck3 check (end_flag in ('Y','N'))
                );
                -- Every key column is wrapped in the CASE: rows outside the condition have an all-NULL key and are not indexed.
                create unique index xxfnd_wf_activities_u2 on xxfnd_wf_activities (
                    case when start_flag = 'Y' then item_type end,
                    case when start_flag = 'Y' then process_code end,
                    case when start_flag = 'Y' then version_number end);

                create table xxfnd_wf_transitions (
                    transition_id          number generated by default on null as identity,
                    from_activity_id       number         not null,
                    result_code            varchar2(30)   not null,
                    to_activity_id         number         not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_wf_transitions_pk primary key (transition_id),
                    constraint xxfnd_wf_transitions_fk1 foreign key (from_activity_id) references xxfnd_wf_activities (activity_id) on delete cascade,
                    constraint xxfnd_wf_transitions_fk2 foreign key (to_activity_id) references xxfnd_wf_activities (activity_id),
                    constraint xxfnd_wf_transitions_uk1 unique (from_activity_id, result_code)
                );
                comment on table xxfnd_wf_transitions is 'From an activity, a result code leads to exactly one next activity. The caller decides which result to submit (e.g. APPROVED_NEEDS_L2 vs APPROVED_FINAL).';

                create table xxfnd_wf_items (
                    wf_item_id             number generated by default on null as identity,
                    item_type              varchar2(30)   not null,
                    process_code           varchar2(30)   not null,
                    version_number         number         not null,
                    entity_name            varchar2(60)   not null,
                    pk1_value              varchar2(150)  not null,
                    current_activity_id    number         not null,
                    item_status            varchar2(20)   default 'ACTIVE' not null,
                    started_date           timestamp      default systimestamp not null,
                    completed_date         timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_wf_items_pk primary key (wf_item_id),
                    constraint xxfnd_wf_items_fk1 foreign key (item_type, process_code, version_number)
                        references xxfnd_wf_processes (item_type, process_code, version_number),
                    constraint xxfnd_wf_items_fk2 foreign key (current_activity_id) references xxfnd_wf_activities (activity_id),
                    constraint xxfnd_wf_items_ck1 check (item_status in ('ACTIVE','SUSPENDED','COMPLETE','CANCELLED'))
                );
                -- Every key column is wrapped in the CASE: rows outside the condition have an all-NULL key and are not indexed.
                create unique index xxfnd_wf_items_u1 on xxfnd_wf_items (
                    case when item_status in ('ACTIVE','SUSPENDED') then entity_name end,
                    case when item_status in ('ACTIVE','SUSPENDED') then pk1_value end,
                    case when item_status in ('ACTIVE','SUSPENDED') then item_type end);
                create index xxfnd_wf_items_n1 on xxfnd_wf_items (current_activity_id, item_status);
                comment on table xxfnd_wf_items is 'A running process instance. Business tables keep no STATUS column; status is read from here.';

                create table xxfnd_wf_activity_history (
                    activity_history_id    number generated by default on null as identity,
                    wf_item_id             number         not null,
                    activity_id            number         not null,
                    actioned_by            varchar2(255),
                    on_behalf_of           varchar2(255),
                    result_code            varchar2(30),
                    notes                  varchar2(4000),
                    entered_date           timestamp      default systimestamp not null,
                    exited_date            timestamp,
                    constraint xxfnd_wf_act_history_pk primary key (activity_history_id),
                    constraint xxfnd_wf_act_history_fk1 foreign key (wf_item_id) references xxfnd_wf_items (wf_item_id),
                    constraint xxfnd_wf_act_history_fk2 foreign key (activity_id) references xxfnd_wf_activities (activity_id)
                );
                create index xxfnd_wf_act_history_n1 on xxfnd_wf_activity_history (wf_item_id);
                comment on table xxfnd_wf_activity_history is 'Every activity an item passed through. Append-only; ENTERED_DATE and ACTIONED_BY are the audit trail.';
                comment on column xxfnd_wf_activity_history.on_behalf_of is 'Set when a delegate acted for the original performer.';

                create table xxfnd_wf_notifications (
                    notification_id        number generated by default on null as identity,
                    wf_item_id             number         not null,
                    activity_id            number         not null,
                    recipient_user_name    varchar2(255)  not null,
                    original_recipient     varchar2(255),
                    template_code          varchar2(50),
                    status_code            varchar2(20)   default 'QUEUED' not null,
                    subject                varchar2(500),
                    body_html              clob,
                    queued_date            timestamp      default systimestamp not null,
                    sent_date              timestamp,
                    due_date               timestamp,
                    responded_date         timestamp,
                    error_message          varchar2(4000),
                    constraint xxfnd_wf_notifications_pk primary key (notification_id),
                    constraint xxfnd_wf_notifications_fk1 foreign key (wf_item_id) references xxfnd_wf_items (wf_item_id),
                    constraint xxfnd_wf_notifications_ck1 check (status_code in ('QUEUED','SENT','FAILED','RESPONDED','EXPIRED','CANCELLED'))
                );
                create index xxfnd_wf_notifications_n1 on xxfnd_wf_notifications (status_code, queued_date);
                create index xxfnd_wf_notifications_n2 on xxfnd_wf_notifications (recipient_user_name, status_code);
                comment on table xxfnd_wf_notifications is 'Deferred notification queue. A case transition only inserts QUEUED rows; the scheduler job XXFND_WF_MAILER sends them, so a mail outage never blocks a save.';

                create table xxfnd_wf_delegations (
                    delegation_id          number generated by default on null as identity,
                    delegator_user_name    varchar2(255)  not null,
                    delegate_user_name     varchar2(255)  not null,
                    item_type              varchar2(30),
                    start_date             date           not null,
                    end_date               date           not null,
                    reason                 varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_wf_delegations_pk primary key (delegation_id),
                    constraint xxfnd_wf_delegations_fk1 foreign key (item_type) references xxfnd_wf_item_types (item_type),
                    constraint xxfnd_wf_delegations_ck1 check (end_date >= start_date),
                    constraint xxfnd_wf_delegations_ck2 check (delegator_user_name <> delegate_user_name)
                );
                create index xxfnd_wf_delegations_n1 on xxfnd_wf_delegations (delegator_user_name, start_date, end_date);
                comment on table xxfnd_wf_delegations is 'Vacation rules. ITEM_TYPE null = delegate everything.';

                --==============================================================================
                -- 0.5  DESCRIPTIVE FLEXFIELDS  (EBS: FND_FLEX_VALUE_SETS, FND_DESCRIPTIVE_FLEXS,
                --      FND_DESCR_FLEX_CONTEXTS, FND_DESCR_FLEX_COLUMN_USAGES; Fusion typed segments)
                --==============================================================================
                create table xxfnd_value_sets (
                    value_set_code         varchar2(60)   not null,
                    value_set_name         varchar2(240)  not null,
                    description            varchar2(1000),
                    validation_type        varchar2(20)   not null,
                    format_type            varchar2(20)   not null,
                    maximum_size           number(4),
                    number_precision       number(2),
                    minimum_value          varchar2(150),
                    maximum_value          varchar2(150),
                    uppercase_only_flag    varchar2(1)    default 'N' not null,
                    lookup_type            varchar2(30),
                    parent_value_set_code  varchar2(60),
                    table_query            clob,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_value_sets_pk primary key (value_set_code),
                    constraint xxfnd_value_sets_fk1 foreign key (lookup_type) references xxfnd_lookup_types (lookup_type),
                    constraint xxfnd_value_sets_fk2 foreign key (parent_value_set_code) references xxfnd_value_sets (value_set_code),
                    constraint xxfnd_value_sets_ck1 check (validation_type in ('NONE','INDEPENDENT','DEPENDENT','TABLE')),
                    constraint xxfnd_value_sets_ck2 check (format_type in ('CHAR','NUMBER','DATE','TIMESTAMP')),
                    constraint xxfnd_value_sets_ck3 check (uppercase_only_flag in ('Y','N')),
                    constraint xxfnd_value_sets_ck4 check (
                        (validation_type = 'NONE'        and lookup_type is null and table_query is null) or
                        (validation_type = 'INDEPENDENT' and lookup_type is not null and format_type = 'CHAR') or
                        (validation_type = 'DEPENDENT'   and lookup_type is not null and parent_value_set_code is not null and format_type = 'CHAR') or
                        (validation_type = 'TABLE'       and table_query is not null))
                );
                comment on table  xxfnd_value_sets is 'Segment validation (FND_FLEX_VALUE_SETS). INDEPENDENT/DEPENDENT sets draw values from the Lookup engine; DEPENDENT uses the parent columns on XXFND_LOOKUP_VALUES.';
                comment on column xxfnd_value_sets.table_query is 'TABLE validation only. Must return RETURN_VALUE and DISPLAY_VALUE; may reference :CONTEXT_CODE.';

                create table xxfnd_df_flexfields (
                    descriptive_flexfield_code varchar2(60) not null,
                    application_code       varchar2(30),
                    table_name             varchar2(128)  not null,
                    pk_column_name         varchar2(128)  not null,
                    context_column_name    varchar2(128)  default 'ATTRIBUTE_CATEGORY' not null,
                    context_reference_column varchar2(128),
                    default_context_code   varchar2(80),
                    context_required_flag  varchar2(1)    default 'N' not null,
                    context_user_selectable_flag varchar2(1) default 'N' not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_df_flexfields_pk primary key (descriptive_flexfield_code),
                    constraint xxfnd_df_flexfields_uk1 unique (table_name),
                    constraint xxfnd_df_flexfields_ck1 check (context_required_flag in ('Y','N')),
                    constraint xxfnd_df_flexfields_ck2 check (context_user_selectable_flag in ('Y','N')),
                    constraint xxfnd_df_flexfields_ck3 check (enabled_flag in ('Y','N'))
                );
                comment on table  xxfnd_df_flexfields is 'One DFF per table (FND_DESCRIPTIVE_FLEXS). Registering a table here plus enabling contexts and segments is all it takes for every screen carrying the DFF region to render the fields.';
                comment on column xxfnd_df_flexfields.context_reference_column is 'Derive the context from this column on the same row, e.g. JURISDICTION (FND_DEFAULT_CONTEXT_FIELDS).';
                comment on column xxfnd_df_flexfields.context_user_selectable_flag is 'Y = when no reference column, the user picks the context from a list.';

                create table xxfnd_df_flexfields_tl (
                    descriptive_flexfield_code varchar2(60) not null,
                    language_code          varchar2(10)   not null,
                    flexfield_name         varchar2(240)  not null,
                    description            varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_df_flexfields_tl_pk primary key (descriptive_flexfield_code, language_code),
                    constraint xxfnd_df_flexfields_tl_fk1 foreign key (descriptive_flexfield_code)
                        references xxfnd_df_flexfields (descriptive_flexfield_code) on delete cascade
                );

                create table xxfnd_df_contexts (
                    descriptive_flexfield_code varchar2(60) not null,
                    context_code           varchar2(80)   not null,
                    context_name           varchar2(240)  not null,
                    description            varchar2(1000),
                    global_flag            varchar2(1)    default 'N' not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    protected_flag         varchar2(1)    default 'N' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_df_contexts_pk primary key (descriptive_flexfield_code, context_code),
                    constraint xxfnd_df_contexts_fk1 foreign key (descriptive_flexfield_code)
                        references xxfnd_df_flexfields (descriptive_flexfield_code),
                    constraint xxfnd_df_contexts_ck1 check (global_flag in ('Y','N')),
                    constraint xxfnd_df_contexts_ck2 check (enabled_flag in ('Y','N')),
                    constraint xxfnd_df_contexts_ck3 check (protected_flag in ('Y','N')),
                    constraint xxfnd_df_contexts_ck4 check (global_flag = 'N' or context_code = 'GLOBAL')
                );
                -- One GLOBAL context per flexfield. Single-expression key: non-global rows are NULL and not indexed.
                create unique index xxfnd_df_contexts_u1 on xxfnd_df_contexts (
                    case when global_flag = 'Y' then descriptive_flexfield_code end);
                comment on table  xxfnd_df_contexts is 'Contexts (FND_DESCR_FLEX_CONTEXTS). GLOBAL segments show on every row; other contexts show when ATTRIBUTE_CATEGORY matches.';
                comment on column xxfnd_df_contexts.protected_flag is 'Y = seeded by the system; administrators cannot disable or delete it.';
                ```
        }
    )

    installScript (
        name: 03 Common tables - XXFND - part 3 of 3
        execution {
            sequence: 30
        }
        script {
            content:
                ```
                create table xxfnd_df_contexts_tl (
                    descriptive_flexfield_code varchar2(60) not null,
                    context_code           varchar2(80)   not null,
                    language_code          varchar2(10)   not null,
                    context_name           varchar2(240)  not null,
                    description            varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_df_contexts_tl_pk primary key (descriptive_flexfield_code, context_code, language_code),
                    constraint xxfnd_df_contexts_tl_fk1 foreign key (descriptive_flexfield_code, context_code)
                        references xxfnd_df_contexts (descriptive_flexfield_code, context_code) on delete cascade
                );

                create table xxfnd_df_segments (
                    descriptive_flexfield_code varchar2(60) not null,
                    context_code           varchar2(80)   not null,
                    segment_code           varchar2(30)   not null,
                    column_name            varchar2(128)  not null,
                    sequence_number        number(3)      not null,
                    prompt                 varchar2(240)  not null,
                    help_text              varchar2(1000),
                    value_set_code         varchar2(60)   not null,
                    required_flag          varchar2(1)    default 'N' not null,
                    default_type           varchar2(20)   default 'NONE' not null,
                    default_value          varchar2(4000),
                    read_only_flag         varchar2(1)    default 'N' not null,
                    display_flag           varchar2(1)    default 'Y' not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_df_segments_pk primary key (descriptive_flexfield_code, context_code, segment_code),
                    constraint xxfnd_df_segments_uk1 unique (descriptive_flexfield_code, context_code, column_name),
                    constraint xxfnd_df_segments_uk2 unique (descriptive_flexfield_code, context_code, sequence_number),
                    constraint xxfnd_df_segments_fk1 foreign key (descriptive_flexfield_code, context_code)
                        references xxfnd_df_contexts (descriptive_flexfield_code, context_code),
                    constraint xxfnd_df_segments_fk2 foreign key (value_set_code) references xxfnd_value_sets (value_set_code),
                    constraint xxfnd_df_segments_ck1 check (required_flag in ('Y','N')),
                    constraint xxfnd_df_segments_ck2 check (default_type in ('NONE','CONSTANT','SQL')),
                    constraint xxfnd_df_segments_ck3 check (read_only_flag in ('Y','N')),
                    constraint xxfnd_df_segments_ck4 check (display_flag in ('Y','N')),
                    constraint xxfnd_df_segments_ck5 check (enabled_flag in ('Y','N')),
                    constraint xxfnd_df_segments_ck6 check (default_type = 'NONE' or default_value is not null),
                    constraint xxfnd_df_segments_ck7 check (regexp_like(column_name,
                        '^ATTRIBUTE([1-9]|[12][0-9]|30)$|^ATTRIBUTE_NUMBER([1-9]|10)$|^ATTRIBUTE_DATE([1-9]|10)$|^ATTRIBUTE_TIMESTAMP[1-5]$'))
                );
                create index xxfnd_df_segments_n1 on xxfnd_df_segments (value_set_code);
                comment on table  xxfnd_df_segments is 'Segments (FND_DESCR_FLEX_COLUMN_USAGES): maps a field to one reserved column. XXFND_DFF_PKG also checks that the column family matches the value set format and that GLOBAL columns are not reused by other contexts.';
                comment on column xxfnd_df_segments.default_value is 'CONSTANT: the literal. SQL: a query returning one value; may reference :CONTEXT_CODE.';

                create table xxfnd_df_segments_tl (
                    descriptive_flexfield_code varchar2(60) not null,
                    context_code           varchar2(80)   not null,
                    segment_code           varchar2(30)   not null,
                    language_code          varchar2(10)   not null,
                    prompt                 varchar2(240)  not null,
                    help_text              varchar2(1000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxfnd_df_segments_tl_pk primary key (descriptive_flexfield_code, context_code, segment_code, language_code),
                    constraint xxfnd_df_segments_tl_fk1 foreign key (descriptive_flexfield_code, context_code, segment_code)
                        references xxfnd_df_segments (descriptive_flexfield_code, context_code, segment_code) on delete cascade
                );
                ```
        }
    )

    installScript (
        name: 04 KYC tables - XXCMP
        execution {
            sequence: 40
        }
        script {
            content:
                ```
                --------------------------------------------------------------------------------
                -- 02_xxcmp_tables.sql
                -- KYC/KYB-specific objects (XXCMP_), Module 0 scope:
                --   0.0  KYC rules engine (questionnaires), conclusion templates, approval matrix
                --   0.1  Mandatory-document rules
                --   0.2  Request for Information; workflow activity controls
                --   0.3  Party / entity master (carries the DFF column block)
                -- Depends on 01_xxfnd_tables.sql.
                --------------------------------------------------------------------------------

                --==============================================================================
                -- 0.3  PARTY / ENTITY MASTER
                --==============================================================================
                create sequence xxcmp_party_number_s start with 1 nocache;

                create table xxcmp_parties (
                    party_id               number generated by default on null as identity,
                    party_number           varchar2(30)   not null,
                    party_type             varchar2(30)   not null,
                    party_name             varchar2(360)  not null,
                    registration_number    varchar2(60),
                    jurisdiction           varchar2(30),
                    entity_type            varchar2(30),
                    incorporation_date     date,
                    date_of_birth          date,
                    nationality            varchar2(30),
                    data_provenance        varchar2(30)   default 'SELF_DECLARED' not null,
                    last_verified_date     timestamp,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- descriptive flexfield (XXFND_DF_*): context + typed reserved segments
                    attribute_category       varchar2(150),
                    attribute1               varchar2(150),
                    attribute2               varchar2(150),
                    attribute3               varchar2(150),
                    attribute4               varchar2(150),
                    attribute5               varchar2(150),
                    attribute6               varchar2(150),
                    attribute7               varchar2(150),
                    attribute8               varchar2(150),
                    attribute9               varchar2(150),
                    attribute10              varchar2(150),
                    attribute11              varchar2(150),
                    attribute12              varchar2(150),
                    attribute13              varchar2(150),
                    attribute14              varchar2(150),
                    attribute15              varchar2(150),
                    attribute16              varchar2(150),
                    attribute17              varchar2(150),
                    attribute18              varchar2(150),
                    attribute19              varchar2(150),
                    attribute20              varchar2(150),
                    attribute21              varchar2(150),
                    attribute22              varchar2(150),
                    attribute23              varchar2(150),
                    attribute24              varchar2(150),
                    attribute25              varchar2(150),
                    attribute26              varchar2(150),
                    attribute27              varchar2(150),
                    attribute28              varchar2(150),
                    attribute29              varchar2(150),
                    attribute30              varchar2(150),
                    attribute_number1        number,
                    attribute_number2        number,
                    attribute_number3        number,
                    attribute_number4        number,
                    attribute_number5        number,
                    attribute_number6        number,
                    attribute_number7        number,
                    attribute_number8        number,
                    attribute_number9        number,
                    attribute_number10       number,
                    attribute_date1          date,
                    attribute_date2          date,
                    attribute_date3          date,
                    attribute_date4          date,
                    attribute_date5          date,
                    attribute_date6          date,
                    attribute_date7          date,
                    attribute_date8          date,
                    attribute_date9          date,
                    attribute_date10         date,
                    attribute_timestamp1     timestamp,
                    attribute_timestamp2     timestamp,
                    attribute_timestamp3     timestamp,
                    attribute_timestamp4     timestamp,
                    attribute_timestamp5     timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_parties_pk primary key (party_id),
                    constraint xxcmp_parties_uk1 unique (party_number),
                    constraint xxcmp_parties_ck1 check (party_type in ('ORGANIZATION','PERSON')),
                    constraint xxcmp_parties_ck2 check (data_provenance in ('SELF_DECLARED','REGISTRY_VERIFIED')),
                    constraint xxcmp_parties_ck3 check (enabled_flag in ('Y','N')),
                    constraint xxcmp_parties_ck4 check (
                        (party_type = 'PERSON'       and registration_number is null and entity_type is null and incorporation_date is null) or
                        (party_type = 'ORGANIZATION' and date_of_birth is null and nationality is null))
                );
                create index xxcmp_parties_n1 on xxcmp_parties (upper(party_name));
                create index xxcmp_parties_n2 on xxcmp_parties (registration_number, jurisdiction);
                comment on table  xxcmp_parties is 'Every company or individual the organization deals with. Shared master data: Intake links to it, Investigation enriches it.';
                comment on column xxcmp_parties.party_number is 'Human-readable number, e.g. P-000123, assigned by trigger.';
                comment on column xxcmp_parties.data_provenance is 'REGISTRY_VERIFIED once confirmed against an official registry (integration purpose REGISTRY_LOOKUP).';

                create table xxcmp_party_contacts (
                    party_contact_id       number generated by default on null as identity,
                    party_id               number         not null,
                    contact_type           varchar2(30)   not null,
                    contact_value          varchar2(500)  not null,
                    contact_name           varchar2(240),
                    primary_flag           varchar2(1)    default 'N' not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- descriptive flexfield (XXFND_DF_*): context + typed reserved segments
                    attribute_category       varchar2(150),
                    attribute1               varchar2(150),
                    attribute2               varchar2(150),
                    attribute3               varchar2(150),
                    attribute4               varchar2(150),
                    attribute5               varchar2(150),
                    attribute6               varchar2(150),
                    attribute7               varchar2(150),
                    attribute8               varchar2(150),
                    attribute9               varchar2(150),
                    attribute10              varchar2(150),
                    attribute11              varchar2(150),
                    attribute12              varchar2(150),
                    attribute13              varchar2(150),
                    attribute14              varchar2(150),
                    attribute15              varchar2(150),
                    attribute16              varchar2(150),
                    attribute17              varchar2(150),
                    attribute18              varchar2(150),
                    attribute19              varchar2(150),
                    attribute20              varchar2(150),
                    attribute21              varchar2(150),
                    attribute22              varchar2(150),
                    attribute23              varchar2(150),
                    attribute24              varchar2(150),
                    attribute25              varchar2(150),
                    attribute26              varchar2(150),
                    attribute27              varchar2(150),
                    attribute28              varchar2(150),
                    attribute29              varchar2(150),
                    attribute30              varchar2(150),
                    attribute_number1        number,
                    attribute_number2        number,
                    attribute_number3        number,
                    attribute_number4        number,
                    attribute_number5        number,
                    attribute_number6        number,
                    attribute_number7        number,
                    attribute_number8        number,
                    attribute_number9        number,
                    attribute_number10       number,
                    attribute_date1          date,
                    attribute_date2          date,
                    attribute_date3          date,
                    attribute_date4          date,
                    attribute_date5          date,
                    attribute_date6          date,
                    attribute_date7          date,
                    attribute_date8          date,
                    attribute_date9          date,
                    attribute_date10         date,
                    attribute_timestamp1     timestamp,
                    attribute_timestamp2     timestamp,
                    attribute_timestamp3     timestamp,
                    attribute_timestamp4     timestamp,
                    attribute_timestamp5     timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_party_contacts_pk primary key (party_contact_id),
                    constraint xxcmp_party_contacts_fk1 foreign key (party_id) references xxcmp_parties (party_id),
                    constraint xxcmp_party_contacts_ck1 check (primary_flag in ('Y','N')),
                    constraint xxcmp_party_contacts_ck2 check (enabled_flag in ('Y','N'))
                );
                create index xxcmp_party_contacts_n1 on xxcmp_party_contacts (party_id);
                -- Every key column is wrapped in the CASE: rows outside the condition have an all-NULL key and are not indexed.
                create unique index xxcmp_party_contacts_u1 on xxcmp_party_contacts (
                    case when primary_flag = 'Y' then party_id end,
                    case when primary_flag = 'Y' then contact_type end);
                comment on table xxcmp_party_contacts is 'Ways to reach a party. One primary per contact type; the RFI process emails the primary EMAIL contact.';

                create table xxcmp_party_relationships (
                    party_relationship_id  number generated by default on null as identity,
                    subject_party_id       number         not null,
                    object_party_id        number         not null,
                    relationship_type      varchar2(30)   not null,
                    ownership_percentage   number(5,2),
                    start_date             date           default trunc(sysdate) not null,
                    end_date               date,
                    officer_corrected_flag varchar2(1)    default 'N' not null,
                    latest_ubo_status      varchar2(30),
                    -- descriptive flexfield (XXFND_DF_*): context + typed reserved segments
                    attribute_category       varchar2(150),
                    attribute1               varchar2(150),
                    attribute2               varchar2(150),
                    attribute3               varchar2(150),
                    attribute4               varchar2(150),
                    attribute5               varchar2(150),
                    attribute6               varchar2(150),
                    attribute7               varchar2(150),
                    attribute8               varchar2(150),
                    attribute9               varchar2(150),
                    attribute10              varchar2(150),
                    attribute11              varchar2(150),
                    attribute12              varchar2(150),
                    attribute13              varchar2(150),
                    attribute14              varchar2(150),
                    attribute15              varchar2(150),
                    attribute16              varchar2(150),
                    attribute17              varchar2(150),
                    attribute18              varchar2(150),
                    attribute19              varchar2(150),
                    attribute20              varchar2(150),
                    attribute21              varchar2(150),
                    attribute22              varchar2(150),
                    attribute23              varchar2(150),
                    attribute24              varchar2(150),
                    attribute25              varchar2(150),
                    attribute26              varchar2(150),
                    attribute27              varchar2(150),
                    attribute28              varchar2(150),
                    attribute29              varchar2(150),
                    attribute30              varchar2(150),
                    attribute_number1        number,
                    attribute_number2        number,
                    attribute_number3        number,
                    attribute_number4        number,
                    attribute_number5        number,
                    attribute_number6        number,
                    attribute_number7        number,
                    attribute_number8        number,
                    attribute_number9        number,
                    attribute_number10       number,
                    attribute_date1          date,
                    attribute_date2          date,
                    attribute_date3          date,
                    attribute_date4          date,
                    attribute_date5          date,
                    attribute_date6          date,
                    attribute_date7          date,
                    attribute_date8          date,
                    attribute_date9          date,
                    attribute_date10         date,
                    attribute_timestamp1     timestamp,
                    attribute_timestamp2     timestamp,
                    attribute_timestamp3     timestamp,
                    attribute_timestamp4     timestamp,
                    attribute_timestamp5     timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_party_rel_pk primary key (party_relationship_id),
                    constraint xxcmp_party_rel_fk1 foreign key (subject_party_id) references xxcmp_parties (party_id),
                    constraint xxcmp_party_rel_fk2 foreign key (object_party_id) references xxcmp_parties (party_id),
                    constraint xxcmp_party_rel_ck1 check (subject_party_id <> object_party_id),
                    constraint xxcmp_party_rel_ck2 check (ownership_percentage is null or ownership_percentage between 0 and 100),
                    constraint xxcmp_party_rel_ck3 check (end_date is null or end_date >= start_date),
                    constraint xxcmp_party_rel_ck4 check (officer_corrected_flag in ('Y','N')),
                    constraint xxcmp_party_rel_ck5 check (latest_ubo_status is null or latest_ubo_status in ('UBO','NOT_UBO','NOT_YET_ASSESSED'))
                );
                create index xxcmp_party_rel_n1 on xxcmp_party_relationships (subject_party_id);
                create index xxcmp_party_rel_n2 on xxcmp_party_relationships (object_party_id);
                comment on table  xxcmp_party_relationships is 'Ownership and control stack. SUBJECT holds the relationship over OBJECT (subject is shareholder of object). Multi-level cycles are rejected by trigger.';
                comment on column xxcmp_party_relationships.latest_ubo_status is 'Display copy of the latest UBO determination. The authoritative record is the UBO register (Module 2).';

                --==============================================================================
                -- 0.0  KYC RULES ENGINE
                --==============================================================================
                create table xxcmp_questionnaires (
                    questionnaire_code     varchar2(30)   not null,
                    questionnaire_name     varchar2(240)  not null,
                    audience               varchar2(20)   not null,
                    low_risk_max_score     number,
                    medium_risk_max_score  number,
                    current_version_number number         default 1 not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_questionnaires_pk primary key (questionnaire_code),
                    constraint xxcmp_questionnaires_ck1 check (audience in ('REQUESTER','OFFICER')),
                    constraint xxcmp_questionnaires_ck2 check (enabled_flag in ('Y','N')),
                    constraint xxcmp_questionnaires_ck3 check (
                        low_risk_max_score is null or medium_risk_max_score is null or medium_risk_max_score >= low_risk_max_score),
                    constraint xxcmp_questionnaires_ck4 check (
                        audience = 'REQUESTER' or (low_risk_max_score is null and medium_risk_max_score is null))
                );
                comment on table  xxcmp_questionnaires is 'Requester intake questionnaires (scored, drive routing) and the Officer investigation questionnaire (unscored, informs a manual classification).';
                comment on column xxcmp_questionnaires.current_version_number is 'Raised when an approved scoring change goes live. Responses snapshot the version they were scored against.';

                create table xxcmp_questions (
                    question_id            number generated by default on null as identity,
                    questionnaire_code     varchar2(30)   not null,
                    section_name           varchar2(240),
                    question_text          varchar2(2000) not null,
                    answer_type            varchar2(30)   not null,
                    lookup_type            varchar2(30),
                    gate_question_flag     varchar2(1)    default 'N' not null,
                    required_flag          varchar2(1)    default 'Y' not null,
                    display_sequence       number,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_questions_pk primary key (question_id),
                    constraint xxcmp_questions_fk1 foreign key (questionnaire_code) references xxcmp_questionnaires (questionnaire_code),
                    constraint xxcmp_questions_fk2 foreign key (lookup_type) references xxfnd_lookup_types (lookup_type),
                    constraint xxcmp_questions_ck1 check (answer_type in ('SINGLE_SELECT','MULTI_SELECT','YES_NO','TEXT','NUMBER','DATE')),
                    constraint xxcmp_questions_ck2 check (gate_question_flag in ('Y','N')),
                    constraint xxcmp_questions_ck3 check (required_flag in ('Y','N')),
                    constraint xxcmp_questions_ck4 check (enabled_flag in ('Y','N'))
                );
                create index xxcmp_questions_n1 on xxcmp_questions (questionnaire_code, display_sequence);
                comment on column xxcmp_questions.gate_question_flag is 'Applicability gate, evaluated before scoring. All gates answered their waiver-qualifying way = KYC not required.';

                create table xxcmp_questions_tl (
                    question_id            number         not null,
                    language_code          varchar2(10)   not null,
                    question_text          varchar2(2000) not null,
                    section_name           varchar2(240),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_questions_tl_pk primary key (question_id, language_code),
                    constraint xxcmp_questions_tl_fk1 foreign key (question_id) references xxcmp_questions (question_id) on delete cascade
                );

                create table xxcmp_answer_options (
                    answer_option_id       number generated by default on null as identity,
                    question_id            number         not null,
                    lookup_type            varchar2(30),
                    lookup_code            varchar2(30),
                    answer_label           varchar2(240),
                    risk_points            number         default 0 not null,
                    critical_flag          varchar2(1)    default 'N' not null,
                    waiver_qualifying_flag varchar2(1)    default 'N' not null,
                    display_sequence       number,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    approval_status        varchar2(20)   default 'DRAFT' not null,
                    approved_by            varchar2(255),
                    approved_date          timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_answer_options_pk primary key (answer_option_id),
                    constraint xxcmp_answer_options_fk1 foreign key (question_id) references xxcmp_questions (question_id) on delete cascade,
                    constraint xxcmp_answer_options_fk2 foreign key (lookup_type, lookup_code)
                        references xxfnd_lookup_values (lookup_type, lookup_code),
                    constraint xxcmp_answer_options_ck1 check (critical_flag in ('Y','N')),
                    constraint xxcmp_answer_options_ck2 check (waiver_qualifying_flag in ('Y','N')),
                    constraint xxcmp_answer_options_ck3 check (enabled_flag in ('Y','N')),
                    constraint xxcmp_answer_options_ck4 check (approval_status in ('DRAFT','PENDING_APPROVAL','APPROVED','REJECTED')),
                    constraint xxcmp_answer_options_ck5 check (
                        (lookup_type is not null and lookup_code is not null and answer_label is null) or
                        (lookup_type is null and lookup_code is null and answer_label is not null))
                );
                create index xxcmp_answer_options_n1 on xxcmp_answer_options (question_id);
                comment on table  xxcmp_answer_options is 'Answers with risk weight, critical-escalation and waiver flags. Only APPROVED rows are used for scoring; a scoring change needs a second person''s approval.';
                comment on column xxcmp_answer_options.risk_points is 'Copied onto each response answer at submission, so later changes never rewrite a past case''s score.';

                create table xxcmp_conclusion_templates (
                    risk_tier              varchar2(30)   not null,
                    template_name          varchar2(240)  not null,
                    template_text          clob           not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_conclusion_templates_pk primary key (risk_tier),
                    constraint xxcmp_conclusion_templates_ck1 check (enabled_flag in ('Y','N'))
                );
                comment on table xxcmp_conclusion_templates is 'Pre-filled Compliance Report conclusion by risk tier. Tokens: #PARTY_NAME#, #REQUEST_NUMBER#, #RISK_TIER#, #RISK_FACTORS#.';

                create table xxcmp_approval_matrix (
                    risk_tier              varchar2(30)   not null,
                    required_levels        number(1)      not null,
                    level1_role_code       varchar2(30)   not null,
                    level2_role_code       varchar2(30),
                    sar_gate_flag          varchar2(1)    default 'N' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_approval_matrix_pk primary key (risk_tier),
                    constraint xxcmp_approval_matrix_fk1 foreign key (level1_role_code) references xxfnd_roles (role_code),
                    constraint xxcmp_approval_matrix_fk2 foreign key (level2_role_code) references xxfnd_roles (role_code),
                    constraint xxcmp_approval_matrix_ck1 check (required_levels in (1,2)),
                    constraint xxcmp_approval_matrix_ck2 check (
                        (required_levels = 1 and level2_role_code is null) or
                        (required_levels = 2 and level2_role_code is not null and level2_role_code <> level1_role_code)),
                    constraint xxcmp_approval_matrix_ck3 check (sar_gate_flag in ('Y','N'))
                );
                comment on table xxcmp_approval_matrix is 'Approval levels and roles by risk tier. Enhanced KYC always takes the HIGH row regardless of tier (applied in XXCMP_APPROVAL logic, Module 2).';

                --==============================================================================
                -- 0.1  MANDATORY-DOCUMENT RULES
                --==============================================================================
                create table xxcmp_attachment_rules (
                    attachment_rule_id     number generated by default on null as identity,
                    entity_name            varchar2(60)   not null,
                    category_code          varchar2(30)   not null,
                    jurisdiction           varchar2(30),
                    entity_type            varchar2(30),
                    mandatory_flag         varchar2(1)    default 'Y' not null,
                    priority               number         default 100 not null,
                    enabled_flag           varchar2(1)    default 'Y' not null,
                    approval_status        varchar2(20)   default 'DRAFT' not null,
                    approved_by            varchar2(255),
                    approved_date          timestamp,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_attachment_rules_pk primary key (attachment_rule_id),
                    constraint xxcmp_attachment_rules_fk1 foreign key (entity_name) references xxfnd_document_entities (entity_name),
                    constraint xxcmp_attachment_rules_fk2 foreign key (category_code) references xxfnd_document_categories (category_code),
                    constraint xxcmp_attachment_rules_ck1 check (mandatory_flag in ('Y','N')),
                    constraint xxcmp_attachment_rules_ck2 check (enabled_flag in ('Y','N')),
                    constraint xxcmp_attachment_rules_ck3 check (approval_status in ('DRAFT','PENDING_APPROVAL','APPROVED','REJECTED'))
                );
                create unique index xxcmp_attachment_rules_u1 on xxcmp_attachment_rules (
                    entity_name, category_code, nvl(jurisdiction,'#'), nvl(entity_type,'#'));
                comment on table xxcmp_attachment_rules is 'Which document categories are mandatory by entity, jurisdiction and entity type. Most specific rule wins; PRIORITY breaks ties. Changes need a second person''s approval.';

                --==============================================================================
                -- 0.2  REQUEST FOR INFORMATION; WORKFLOW ACTIVITY CONTROLS
                --==============================================================================
                create table xxcmp_rfis (
                    rfi_id                 number generated by default on null as identity,
                    rfi_number             varchar2(30)   not null,
                    entity_name            varchar2(60)   not null,
                    pk1_value              varchar2(150)  not null,
                    wf_item_id             number,
                    recipient_type         varchar2(30)   not null,
                    recipient_user_name    varchar2(255),
                    recipient_party_contact_id number,
                    rfi_category           varchar2(30)   not null,
                    description            varchar2(4000) not null,
                    continue_other_work_flag varchar2(1)  not null,
                    rfi_status             varchar2(30)   default 'WAITING_FOR_INFORMATION' not null,
                    due_date               date,
                    response_token_hash    varchar2(128),
                    token_expiry_date      timestamp,
                    response_text          clob,
                    responded_date         timestamp,
                    resolved_date          timestamp,
                    resolution_notes       varchar2(4000),
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_rfis_pk primary key (rfi_id),
                    constraint xxcmp_rfis_uk1 unique (rfi_number),
                    constraint xxcmp_rfis_fk1 foreign key (entity_name) references xxfnd_document_entities (entity_name),
                    constraint xxcmp_rfis_fk2 foreign key (wf_item_id) references xxfnd_wf_items (wf_item_id),
                    constraint xxcmp_rfis_fk3 foreign key (recipient_party_contact_id) references xxcmp_party_contacts (party_contact_id),
                    constraint xxcmp_rfis_ck1 check (recipient_type in ('REQUESTING_DEPARTMENT','EXTERNAL_PARTY')),
                    constraint xxcmp_rfis_ck2 check (continue_other_work_flag in ('Y','N')),
                    constraint xxcmp_rfis_ck3 check (rfi_status in
                        ('WAITING_FOR_INFORMATION','ON_HOLD_PENDING','ON_HOLD_INVESTIGATION','RESOLVED','REJECTED_RETURNED','CANCELLED')),
                    constraint xxcmp_rfis_ck4 check (
                        (recipient_type = 'REQUESTING_DEPARTMENT' and recipient_user_name is not null) or
                        (recipient_type = 'EXTERNAL_PARTY'        and recipient_party_contact_id is not null))
                );
                create index xxcmp_rfis_n1 on xxcmp_rfis (entity_name, pk1_value);
                create unique index xxcmp_rfis_u2 on xxcmp_rfis (response_token_hash);
                comment on table  xxcmp_rfis is 'Requests for Information raised at document checklist review, investigation or approval return. Attaches generically so it does not depend on Module 1 or 2 tables.';
                comment on column xxcmp_rfis.response_token_hash is 'SHA-256 hash of the one-time token emailed to an external party. The token itself is never stored.';

                create table xxcmp_wf_activity_controls (
                    activity_id            number         not null,
                    requires_sar_assessment_flag varchar2(1) default 'N' not null,
                    -- standard WHO columns
                    created_by               varchar2(255)  not null,
                    creation_date            timestamp      not null,
                    last_updated_by          varchar2(255)  not null,
                    last_update_date         timestamp      not null,
                    last_update_login        varchar2(255),
                    object_version_number    number         default 1 not null,
                    constraint xxcmp_wf_activity_controls_pk primary key (activity_id),
                    constraint xxcmp_wf_activity_controls_fk1 foreign key (activity_id)
                        references xxfnd_wf_activities (activity_id) on delete cascade,
                    constraint xxcmp_wf_activity_controls_ck1 check (requires_sar_assessment_flag in ('Y','N'))
                );
                comment on table xxcmp_wf_activity_controls is 'KYC-specific switches on a generic workflow activity, kept here so the XXFND engine stays application-neutral. REQUIRES_SAR_ASSESSMENT adds the SAR question to the Decision Action screen.';

                create sequence xxcmp_rfi_number_s start with 1 nocache;
                ```
        }
    )

    installScript (
        name: 05 Core packages - part 1 of 2
        execution {
            sequence: 50
        }
        script {
            content:
                ```
                --------------------------------------------------------------------------------
                -- 03_xxfnd_core_pkgs.sql
                --   XXFND_UTIL_PKG      session user/language, lookups, WHO-trigger generator
                --   XXFND_AUDIT_PKG     change reason + audit-trigger generator
                --   XXFND_SECURITY_PKG  role checks, segregation of duties, Fusion HCM sync
                --   XXFND_APPROVAL_PKG  maker-checker for configuration changes
                --------------------------------------------------------------------------------

                create or replace package xxfnd_util_pkg authid definer as
                    -- Signed-in APEX user, or the database user outside APEX (install, jobs).
                    function current_user return varchar2;
                    -- Session language as an APEX language code ('en', 'ar'); defaults to 'en'.
                    function current_lang return varchar2;
                    function in_apex_session return boolean;
                    -- Install mode: seed scripts run inside an APEX session when installed as
                    -- Supporting Objects; this makes the session count as "not APEX" so seeded
                    -- rows are not treated as user edits (maker-checker, lookup locks).
                    procedure set_install_mode(p_on in boolean);

                    function lookup_meaning(p_lookup_type in varchar2, p_lookup_code in varchar2) return varchar2;
                    function is_valid_lookup(p_lookup_type in varchar2, p_lookup_code in varchar2) return boolean;
                    procedure assert_lookup(p_lookup_type in varchar2, p_lookup_code in varchar2, p_label in varchar2);

                    -- Replace #TOKEN# placeholders from a JSON object {"TOKEN":"value",...}.
                    function replace_tokens(p_text in clob, p_tokens_json in clob) return clob;

                    -- WHO-column trigger: fills CREATED_BY/CREATION_DATE/LAST_UPDATED_BY/
                    -- LAST_UPDATE_DATE/LAST_UPDATE_LOGIN and increments OBJECT_VERSION_NUMBER.
                    procedure create_who_trigger(p_table_name in varchar2);
                    -- Creates WHO triggers on every XXFND_/XXCMP_ table that has the WHO columns.
                    procedure create_all_who_triggers;
                end xxfnd_util_pkg;
                /

                create or replace package body xxfnd_util_pkg as

                    g_install_mode boolean := false;

                    procedure set_install_mode(p_on in boolean) is
                    begin
                        g_install_mode := nvl(p_on, false);
                    end set_install_mode;

                    function in_apex_session return boolean is
                    begin
                        return not g_install_mode and sys_context('APEX$SESSION', 'APP_USER') is not null;
                    end in_apex_session;

                    function current_user return varchar2 is
                    begin
                        return coalesce(sys_context('APEX$SESSION', 'APP_USER'),
                                        sys_context('USERENV', 'SESSION_USER'));
                    end current_user;

                    function current_lang return varchar2 is
                        l_lang varchar2(30);
                    begin
                        if in_apex_session then
                            begin
                                l_lang := lower(apex_util.get_session_lang);
                            exception
                                when others then l_lang := null;
                            end;
                        end if;
                        -- Normalise regional variants ('en-us' -> 'en') to match seeded rows.
                        return nvl(regexp_substr(l_lang, '^[a-z]+'), 'en');
                    end current_lang;

                    function lookup_meaning(p_lookup_type in varchar2, p_lookup_code in varchar2) return varchar2 is
                        l_meaning xxfnd_lookup_values.meaning%type;
                    begin
                        if p_lookup_code is null then
                            return null;
                        end if;
                        select nvl(t.meaning, v.meaning)
                          into l_meaning
                          from xxfnd_lookup_values v
                          left join xxfnd_lookup_values_tl t
                            on t.lookup_type = v.lookup_type
                           and t.lookup_code = v.lookup_code
                           and t.language_code = current_lang
                         where v.lookup_type = p_lookup_type
                           and v.lookup_code = p_lookup_code;
                        return l_meaning;
                    exception
                        when no_data_found then
                            return p_lookup_code;
                    end lookup_meaning;

                    function is_valid_lookup(p_lookup_type in varchar2, p_lookup_code in varchar2) return boolean is
                        l_count pls_integer;
                    begin
                        select count(*)
                          into l_count
                          from xxfnd_lookup_values v
                         where v.lookup_type = p_lookup_type
                           and v.lookup_code = p_lookup_code
                           and v.enabled_flag = 'Y'
                           and trunc(sysdate) between v.start_date_active and nvl(v.end_date_active, trunc(sysdate));
                        return l_count > 0;
                    end is_valid_lookup;

                    procedure assert_lookup(p_lookup_type in varchar2, p_lookup_code in varchar2, p_label in varchar2) is
                    begin
                        if p_lookup_code is not null and not is_valid_lookup(p_lookup_type, p_lookup_code) then
                            raise_application_error(-20100,
                                p_label || ': "' || p_lookup_code || '" is not an active value of ' || p_lookup_type || '.');
                        end if;
                    end assert_lookup;

                    function replace_tokens(p_text in clob, p_tokens_json in clob) return clob is
                        l_result clob := p_text;
                        l_obj    json_object_t;
                        l_keys   json_key_list;
                    begin
                        if p_text is null or p_tokens_json is null then
                            return p_text;
                        end if;
                        l_obj  := json_object_t.parse(p_tokens_json);
                        l_keys := l_obj.get_keys;
                        for i in 1 .. l_keys.count loop
                            l_result := replace(l_result, '#' || upper(l_keys(i)) || '#', l_obj.get_string(l_keys(i)));
                        end loop;
                        return l_result;
                    end replace_tokens;

                    procedure create_who_trigger(p_table_name in varchar2) is
                        l_table varchar2(128) := upper(dbms_assert.simple_sql_name(p_table_name));
                        l_trg   varchar2(128) := substr(l_table, 1, 124) || '_WHO';
                    begin
                        execute immediate
                            'create or replace trigger ' || l_trg || '
                                before insert or update on ' || l_table || '
                                for each row
                             begin
                                 if inserting then
                                     :new.created_by    := nvl(:new.created_by, xxfnd_util_pkg.current_user);
                                     :new.creation_date := nvl(:new.creation_date, systimestamp);
                                     :new.object_version_number := 1;
                                 else
                                     :new.created_by    := :old.created_by;
                                     :new.creation_date := :old.creation_date;
                                     :new.object_version_number := nvl(:old.object_version_number, 0) + 1;
                                 end if;
                                 :new.last_updated_by   := xxfnd_util_pkg.current_user;
                                 :new.last_update_date  := systimestamp;
                                 :new.last_update_login := sys_context(''APEX$SESSION'', ''APP_SESSION'');
                             end;';
                    end create_who_trigger;

                    procedure create_all_who_triggers is
                    begin
                        for t in (select c.table_name
                                    from user_tab_columns c
                                    join user_tables tb on tb.table_name = c.table_name
                                   where (c.table_name like 'XXFND\_%' escape '\' or c.table_name like 'XXCMP\_%' escape '\')
                                     and c.column_name = 'OBJECT_VERSION_NUMBER'
                                   order by c.table_name)
                        loop
                            create_who_trigger(t.table_name);
                        end loop;
                    end create_all_who_triggers;

                end xxfnd_util_pkg;
                /

                --------------------------------------------------------------------------------
                create or replace package xxfnd_audit_pkg authid definer as
                    -- Set before a save to record why a configuration value changed (FR-36).
                    procedure set_change_reason(p_reason in varchar2);
                    function  get_change_reason return varchar2;
                    procedure clear_change_reason;

                    procedure log_change(p_table_name in varchar2,
                                         p_pk_value   in varchar2,
                                         p_action     in varchar2,
                                         p_column     in varchar2 default null,
                                         p_old_value  in varchar2 default null,
                                         p_new_value  in varchar2 default null);

                    -- Generates an AFTER INSERT/UPDATE/DELETE row trigger that writes one row
                    -- per changed column (updates) or one row per record (inserts, deletes).
                    -- WHO columns and LOB columns are skipped.
                    procedure create_audit_trigger(p_table_name in varchar2);
                    procedure create_config_audit_triggers;
                end xxfnd_audit_pkg;
                /

                create or replace package body xxfnd_audit_pkg as
                    g_reason varchar2(1000);

                    procedure set_change_reason(p_reason in varchar2) is
                    begin
                        g_reason := substr(p_reason, 1, 1000);
                    end set_change_reason;

                    function get_change_reason return varchar2 is
                    begin
                        return g_reason;
                    end get_change_reason;

                    procedure clear_change_reason is
                    begin
                        g_reason := null;
                    end clear_change_reason;

                    procedure log_change(p_table_name in varchar2,
                                         p_pk_value   in varchar2,
                                         p_action     in varchar2,
                                         p_column     in varchar2 default null,
                                         p_old_value  in varchar2 default null,
                                         p_new_value  in varchar2 default null) is
                    begin
                        insert into xxfnd_audit_log
                            (table_name, pk_value, action_code, column_name, old_value, new_value, change_reason, changed_by)
                        values
                            (p_table_name, p_pk_value, p_action, p_column,
                             substr(p_old_value, 1, 4000), substr(p_new_value, 1, 4000),
                             g_reason, xxfnd_util_pkg.current_user);
                    end log_change;

                    function col_to_char(p_ref in varchar2, p_data_type in varchar2) return varchar2 is
                    begin
                        return case
                                 when p_data_type like 'TIMESTAMP%' then 'to_char(' || p_ref || ', ''YYYY-MM-DD HH24:MI:SS.FF'')'
                                 when p_data_type = 'DATE'          then 'to_char(' || p_ref || ', ''YYYY-MM-DD HH24:MI:SS'')'
                                 when p_data_type = 'NUMBER'        then 'to_char(' || p_ref || ', ''TM9'')'
                                 else p_ref
                               end;
                    end col_to_char;

                    procedure create_audit_trigger(p_table_name in varchar2) is
                        l_table varchar2(128) := upper(dbms_assert.simple_sql_name(p_table_name));
                        l_trg   varchar2(128) := substr(l_table, 1, 124) || '_AUD';
                        l_pk_new varchar2(4000);
                        l_pk_old varchar2(4000);
                        l_body  clob;
                    begin
                        for c in (select cc.column_name
                                    from user_constraints uc
                                    join user_cons_columns cc on cc.constraint_name = uc.constraint_name
                                   where uc.table_name = l_table
                                     and uc.constraint_type = 'P'
                                   order by cc.position)
                        loop
                            l_pk_new := l_pk_new || case when l_pk_new is not null then ' || ''|'' || ' end || 'to_char(:new.' || c.column_name || ')';
                            l_pk_old := l_pk_old || case when l_pk_old is not null then ' || ''|'' || ' end || 'to_char(:old.' || c.column_name || ')';
                        end loop;
                        if l_pk_new is null then
                            raise_application_error(-20101, l_table || ' has no primary key; cannot generate audit trigger.');
                        end if;

                        l_body := 'create or replace trigger ' || l_trg || '
                            after insert or update or delete on ' || l_table || '
                            for each row
                            declare
                                l_pk varchar2(400);
                            begin
                                if inserting then
                                    xxfnd_audit_pkg.log_change(''' || l_table || ''', ' || l_pk_new || ', ''I'');
                                    return;
                                elsif deleting then
                                    xxfnd_audit_pkg.log_change(''' || l_table || ''', ' || l_pk_old || ', ''D'');
                                    return;
                                end if;
                                l_pk := ' || l_pk_new || ';
                ';
                        for c in (select column_name, data_type
                                    from user_tab_columns
                                   where table_name = l_table
                                     and data_type not in ('CLOB','BLOB','NCLOB','LONG','LONG RAW','RAW','JSON')
                                     and column_name not in ('CREATED_BY','CREATION_DATE','LAST_UPDATED_BY',
                                                             'LAST_UPDATE_DATE','LAST_UPDATE_LOGIN','OBJECT_VERSION_NUMBER')
                                   order by column_id)
                        loop
                            l_body := l_body || '
                                if (:old.' || c.column_name || ' <> :new.' || c.column_name || ')
                                   or (:old.' || c.column_name || ' is null and :new.' || c.column_name || ' is not null)
                                   or (:old.' || c.column_name || ' is not null and :new.' || c.column_name || ' is null) then
                                    xxfnd_audit_pkg.log_change(''' || l_table || ''', l_pk, ''U'', ''' || c.column_name || ''',
                                        ' || col_to_char(':old.' || c.column_name, c.data_type) || ',
                                        ' || col_to_char(':new.' || c.column_name, c.data_type) || ');
                                end if;';
                        end loop;
                        l_body := l_body || '
                            end;';
                        execute immediate l_body;
                    end create_audit_trigger;

                    procedure create_config_audit_triggers is
                        type t_names is table of varchar2(128);
                        l_tables t_names := t_names(
                            'XXFND_LOOKUP_TYPES','XXFND_LOOKUP_VALUES','XXFND_EMPLOYEES','XXFND_ROLES','XXFND_USER_ROLES',
                            'XXFND_SOD_RULES','XXFND_NOTIFICATION_TEMPLATES','XXFND_RETENTION_POLICIES',
                            'XXFND_INTEGRATION_ENDPOINTS','XXFND_INTEGRATION_PURPOSES',
                            'XXFND_DOCUMENT_ENTITIES','XXFND_DOCUMENT_CATEGORIES','XXFND_ATTACHMENT_FUNCTIONS',
                            'XXFND_ATTACHMENT_BLOCKS','XXFND_ATTACHMENT_BLK_ENTITIES','XXFND_DOC_CATEGORY_USAGES',
                            'XXFND_STORAGE_CONFIG','XXFND_WF_ITEM_TYPES','XXFND_WF_PROCESSES','XXFND_WF_ACTIVITIES',
                            'XXFND_WF_TRANSITIONS','XXFND_WF_DELEGATIONS',
                            'XXFND_VALUE_SETS','XXFND_DF_FLEXFIELDS','XXFND_DF_CONTEXTS','XXFND_DF_SEGMENTS',
                            'XXCMP_QUESTIONNAIRES','XXCMP_QUESTIONS','XXCMP_ANSWER_OPTIONS','XXCMP_CONCLUSION_TEMPLATES',
                            'XXCMP_APPROVAL_MATRIX','XXCMP_ATTACHMENT_RULES','XXCMP_WF_ACTIVITY_CONTROLS');
                    begin
                        for i in 1 .. l_tables.count loop
                            create_audit_trigger(l_tables(i));
                        end loop;
                    end create_config_audit_triggers;

                end xxfnd_audit_pkg;
                /

                --------------------------------------------------------------------------------
                create or replace package xxfnd_security_pkg authid definer as
                    -- Resolve the signed-in person. Null when the user has no active record.
                    function current_employee_id return number;

                    function has_role(p_role_code in varchar2,
                                      p_user_name in varchar2 default null) return boolean;
                    function has_role_yn(p_role_code in varchar2,
                                         p_user_name in varchar2 default null) return varchar2;
                    -- Comma-separated role codes; true when the user holds any of them.
                    function has_any_role(p_role_codes in varchar2,
                                          p_user_name  in varchar2 default null) return boolean;
                    -- Y/N form of HAS_ANY_ROLE for use in SQL (report where clauses, LOVs).
                    function has_any_role_yn(p_role_codes in varchar2,
                                             p_user_name  in varchar2 default null) return varchar2;
                    function can_view_sensitive(p_user_name in varchar2 default null) return boolean;

                    -- Four-eyes: true when the user already acted on this workflow item under a
                    -- role that the SOD rules forbid combining with p_role_code (SAME_RECORD),
                    -- or permanently holds a GLOBAL-conflicting role.
                    function sod_conflict(p_wf_item_id in number,
                                          p_role_code  in varchar2,
                                          p_user_name  in varchar2 default null) return boolean;

                    -- Upserts one Fusion worker (JSON object from the HCM publicWorkers resource).
                    procedure upsert_fusion_worker(p_worker in json_object_t);
                    -- Pages through Fusion HCM publicWorkers using APEX's native Fusion
                    -- integration web credential and refreshes FUSION rows. Run by job XXFND_HCM_SYNC.
                    procedure sync_from_fusion(p_base_url              in varchar2,
                                               p_credential_static_id  in varchar2,
                                               p_page_size             in pls_integer default 200);
                    -- True while SYNC_FROM_FUSION runs; lets the Fusion-owned-row trigger
                    -- (XXFND_EMPLOYEES_SRC) tell the sync apart from a user edit.
                    function sync_running return boolean;

                    -- Creates (or re-enables) a LOCAL employee and grants SYSTEM_ADMIN.
                    -- Used by the installer so someone can sign in and grant further access.
                    procedure bootstrap_admin(p_user_name in varchar2,
                                              p_full_name in varchar2 default null,
                                              p_email     in varchar2 default null);
                end xxfnd_security_pkg;
                /

                create or replace view xxfnd_user_roles_v as
                select ur.user_role_id,
                       ur.employee_id,
                       e.user_name,
                       e.full_name,
                       e.source_type,
                       ur.role_code,
                       r.role_name,
                       r.application_code,
                       ur.start_date_active,
                       ur.end_date_active,
                       ur.enabled_flag,
                       case when ur.enabled_flag = 'Y' and r.enabled_flag = 'Y' and e.enabled_flag = 'Y'
                             and trunc(sysdate) between ur.start_date_active and nvl(ur.end_date_active, trunc(sysdate))
                             and trunc(sysdate) between e.start_date_active  and nvl(e.end_date_active,  trunc(sysdate))
                            then 'Y' else 'N' end active_flag
                  from xxfnd_user_roles ur
                  join xxfnd_employees e on e.employee_id = ur.employee_id
                  join xxfnd_roles r     on r.role_code   = ur.role_code;

                create or replace package body xxfnd_security_pkg as

                    g_sync_running boolean := false;

                    function norm_user(p_user_name in varchar2) return varchar2 is
                    begin
                        return upper(nvl(p_user_name, xxfnd_util_pkg.current_user));
                    end norm_user;

                    function current_employee_id return number is
                        l_id   xxfnd_employees.employee_id%type;
                        l_user varchar2(255) := norm_user(null);   -- private functions cannot be called from SQL
                    begin
                        select e.employee_id
                          into l_id
                          from xxfnd_employees e
                         where e.user_name = l_user
                           and e.enabled_flag = 'Y'
                           and trunc(sysdate) between e.start_date_active and nvl(e.end_date_active, trunc(sysdate));
                        return l_id;
                    exception
                        when no_data_found then
                            return null;
                    end current_employee_id;

                    function has_role(p_role_code in varchar2, p_user_name in varchar2 default null) return boolean is
                        l_count pls_integer;
                        l_user  varchar2(255) := norm_user(p_user_name);
                    begin
                        select count(*)
                          into l_count
                          from xxfnd_user_roles_v v
                         where v.user_name = l_user
                           and v.role_code = p_role_code
                           and v.active_flag = 'Y';
                        return l_count > 0;
                    end has_role;

                    function has_role_yn(p_role_code in varchar2, p_user_name in varchar2 default null) return varchar2 is
                    begin
                        return case when has_role(p_role_code, p_user_name) then 'Y' else 'N' end;
                    end has_role_yn;

                    function has_any_role(p_role_codes in varchar2, p_user_name in varchar2 default null) return boolean is
                        l_count pls_integer;
                        l_user  varchar2(255) := norm_user(p_user_name);
                    begin
                        select count(*)
                          into l_count
                          from xxfnd_user_roles_v v
                         where v.user_name = l_user
                           and v.active_flag = 'Y'
                           and v.role_code in (select trim(column_value)
                                                 from table(apex_string.split(p_role_codes, ',')));
                        return l_count > 0;
                    end has_any_role;

                    function has_any_role_yn(p_role_codes in varchar2, p_user_name in varchar2 default null) return varchar2 is
                    begin
                        return case when has_any_role(p_role_codes, p_user_name) then 'Y' else 'N' end;
                    end has_any_role_yn;

                    function can_view_sensitive(p_user_name in varchar2 default null) return boolean is
                        l_count pls_integer;
                        l_user  varchar2(255) := norm_user(p_user_name);
                    begin
                        select count(*)
                          into l_count
                          from xxfnd_user_roles_v v
                          join xxfnd_roles r on r.role_code = v.role_code
                         where v.user_name = l_user
                           and v.active_flag = 'Y'
                           and r.view_sensitive_flag = 'Y';
                        return l_count > 0;
                    end can_view_sensitive;

                    function sod_conflict(p_wf_item_id in number,
                                          p_role_code  in varchar2,
                                          p_user_name  in varchar2 default null) return boolean is
                        l_count pls_integer;
                        l_user  varchar2(255) := norm_user(p_user_name);
                    begin
                        -- Same record: the user already acted on this item under a conflicting role.
                        select count(*)
                          into l_count
                          from xxfnd_wf_activity_history h
                          join xxfnd_wf_activities a on a.activity_id = h.activity_id
                          join xxfnd_sod_rules s
                            on s.enabled_flag = 'Y'
                           and s.conflict_scope = 'SAME_RECORD'
                           and ((s.role_code_1 = p_role_code and s.role_code_2 = a.performer_role_code) or
                                (s.role_code_2 = p_role_code and s.role_code_1 = a.performer_role_code))
                         where h.wf_item_id = p_wf_item_id
                           and l_user in (upper(h.actioned_by), upper(h.on_behalf_of))
                           and h.result_code is not null;
                        if l_count > 0 then
                            return true;
                        end if;

                        -- Global: the user holds a role that may never be combined with p_role_code.
                        select count(*)
                          into l_count
                          from xxfnd_sod_rules s
                          join xxfnd_user_roles_v v
                            on v.user_name = l_user
                           and v.active_flag = 'Y'
                           and v.role_code = case when s.role_code_1 = p_role_code then s.role_code_2 else s.role_code_1 end
                         where s.enabled_flag = 'Y'
                           and s.conflict_scope = 'GLOBAL'
                           and p_role_code in (s.role_code_1, s.role_code_2);
                        return l_count > 0;
                    end sod_conflict;

                    procedure upsert_fusion_worker(p_worker in json_object_t) is
                        l_person_id   number        := p_worker.get_number('PersonId');
                        l_number      varchar2(30)  := p_worker.get_string('PersonNumber');
                        l_name        varchar2(240) := p_worker.get_string('DisplayName');
                        l_email       varchar2(320) := lower(p_worker.get_string('WorkEmail'));
                        l_dept        varchar2(240);
                        l_job         varchar2(240);
                        l_assignments json_array_t;
                        l_asg         json_object_t;
                    begin
                        if l_person_id is null or l_email is null then
                            return; -- a worker without a work email cannot sign in; skip
                        end if;
                        if p_worker.has('assignments') then
                            l_assignments := p_worker.get_array('assignments');
                            if l_assignments.get_size > 0 then
                                l_asg  := treat(l_assignments.get(0) as json_object_t);
                                l_dept := l_asg.get_string('DepartmentName');
                                l_job  := l_asg.get_string('JobName');
                            end if;
                        end if;

                        -- A LOCAL record created before the person existed in Fusion is adopted,
                        -- not duplicated (the email and user name are unique).
                        update xxfnd_employees
                           set source_type = 'FUSION', fusion_person_id = l_person_id
                         where source_type = 'LOCAL'
                           and fusion_person_id is null
                           and (email_address = l_email or user_name = upper(l_email));

                        merge into xxfnd_employees e
                        using (select l_person_id person_id from dual) s
                           on (e.fusion_person_id = s.person_id)
                         when matched then update set
                              e.fusion_person_number = l_number,
                              e.full_name            = nvl(l_name, e.full_name),
                              e.email_address        = l_email,
                              e.user_name            = upper(l_email),
                              e.department_name      = l_dept,
                              e.job_title            = l_job,
                              e.enabled_flag         = 'Y',
                              e.last_sync_date       = systimestamp
                         when not matched then insert
                              (source_type, fusion_person_id, fusion_person_number, user_name, full_name,
                               email_address, department_name, job_title, last_sync_date)
                              values
                              ('FUSION', l_person_id, l_number, upper(l_email), nvl(l_name, l_email),
                               l_email, l_dept, l_job, systimestamp);
                    end upsert_fusion_worker;

                    procedure sync_from_fusion(p_base_url              in varchar2,
                                               p_credential_static_id  in varchar2,
                                               p_page_size             in pls_integer default 200) is
                        l_offset   pls_integer := 0;
                        l_response clob;
                        l_doc      json_object_t;
                        l_items    json_array_t;
                        l_has_more boolean := true;
                        l_url      varchar2(4000);
                        l_run_ts   timestamp := systimestamp;
                    begin
                        g_sync_running := true;
                        while l_has_more loop
                            l_url := rtrim(p_base_url, '/')
                                  || '/hcmRestApi/resources/11.13.18.05/publicWorkers'
                                  || '?onlyData=true&limit=' || p_page_size || '&offset=' || l_offset
                                  || '&fields=PersonId,PersonNumber,DisplayName,WorkEmail;assignments:DepartmentName,JobName';
                            l_response := apex_web_service.make_rest_request(
                                              p_url                  => l_url,
                                              p_http_method          => 'GET',
                                              p_credential_static_id => p_credential_static_id);
                            if apex_web_service.g_status_code <> 200 then
                                raise_application_error(-20110, 'Fusion HCM sync failed with HTTP '
                                    || apex_web_service.g_status_code || ': ' || dbms_lob.substr(l_response, 500, 1));
                            end if;
                            l_doc   := json_object_t.parse(l_response);
                            l_items := l_doc.get_array('items');
                            for i in 0 .. l_items.get_size - 1 loop
                                upsert_fusion_worker(treat(l_items.get(i) as json_object_t));
                            end loop;
                            l_has_more := nvl(l_doc.get_boolean('hasMore'), false);
                            l_offset   := l_offset + p_page_size;
                            commit;
                        end loop;

                        -- Workers no longer returned by Fusion (terminated) are disabled, not deleted.
                        update xxfnd_employees e
                           set e.enabled_flag = 'N'
                         where e.source_type = 'FUSION'
                           and e.enabled_flag = 'Y'
                           and (e.last_sync_date is null or e.last_sync_date < l_run_ts);
                        commit;
                        g_sync_running := false;
                    exception
                        when others then
                            g_sync_running := false;
                            raise;
                    end sync_from_fusion;

                    function sync_running return boolean is
                    begin
                        return g_sync_running;
                    end sync_running;

                    procedure bootstrap_admin(p_user_name in varchar2,
                                              p_full_name in varchar2 default null,
                                              p_email     in varchar2 default null) is
                        l_user  varchar2(255) := upper(trim(p_user_name));
                        l_email varchar2(320) := lower(trim(coalesce(p_email,
                                                     case when instr(p_user_name, '@') > 0 then p_user_name end,
                                                     p_user_name || '@unknown.invalid')));
                        l_id    number;
                    begin
                        if l_user is null then
                            return;
                        end if;
                        begin
                            select employee_id into l_id from xxfnd_employees where user_name = l_user;
                            update xxfnd_employees set enabled_flag = 'Y', end_date_active = null where employee_id = l_id;
                        exception
                            when no_data_found then
                                insert into xxfnd_employees (source_type, user_name, full_name, email_address)
                                values ('LOCAL', l_user, coalesce(trim(p_full_name), l_user), l_email)
                                returning employee_id into l_id;
                        end;
                        merge into xxfnd_user_roles t
                        using (select l_id employee_id, 'SYSTEM_ADMIN' role_code from dual) s
                           on (t.employee_id = s.employee_id and t.role_code = s.role_code and t.end_date_active is null)
                         when matched then update set t.enabled_flag = 'Y'
                         when not matched then insert (employee_id, role_code) values (s.employee_id, s.role_code);
                    end bootstrap_admin;

                end xxfnd_security_pkg;
                /

                --------------------------------------------------------------------------------
                create or replace package xxfnd_approval_pkg authid definer as
                    -- Tables under maker-checker control.
                    function is_controlled(p_table_name in varchar2) return boolean;

                    procedure submit(p_table_name in varchar2, p_pk_value in varchar2);
                    procedure approve(p_table_name in varchar2, p_pk_value in varchar2);
                    procedure reject(p_table_name in varchar2, p_pk_value in varchar2, p_reason in varchar2);

                    -- Called from the BEFORE UPDATE/INSERT trigger on each controlled table.
                    -- Editing an approved row sends it back for approval; approving your own
                    -- change is refused.
                    procedure apply_rules(p_inserting        in boolean,
                                          p_old_status       in varchar2,
                                          p_new_status       in out varchar2,
                                          p_old_last_updated in varchar2,
                                          p_approved_by      in out varchar2,
                                          p_approved_date    in out timestamp);
                end xxfnd_approval_pkg;
                /
                ```
        }
    )

    installScript (
        name: 06 Core packages - part 2 of 2
        execution {
            sequence: 60
        }
        script {
            content:
                ```
                create or replace package body xxfnd_approval_pkg as

                    function pk_column(p_table_name in varchar2) return varchar2 is
                    begin
                        return case upper(p_table_name)
                                 when 'XXCMP_ANSWER_OPTIONS'       then 'ANSWER_OPTION_ID'
                                 when 'XXCMP_ATTACHMENT_RULES'     then 'ATTACHMENT_RULE_ID'
                                 when 'XXFND_INTEGRATION_PURPOSES' then 'PURPOSE_CODE'
                               end;
                    end pk_column;

                    function is_controlled(p_table_name in varchar2) return boolean is
                    begin
                        return pk_column(p_table_name) is not null;
                    end is_controlled;

                    procedure set_status(p_table_name in varchar2, p_pk_value in varchar2, p_status in varchar2) is
                        l_rows pls_integer;
                    begin
                        if not is_controlled(p_table_name) then
                            raise_application_error(-20120, p_table_name || ' is not under maker-checker control.');
                        end if;
                        -- Table and column names come from the whitelist in PK_COLUMN only.
                        execute immediate 'update ' || upper(p_table_name)
                                       || ' set approval_status = :s where ' || pk_column(p_table_name) || ' = :k'
                            using p_status, p_pk_value;
                        l_rows := sql%rowcount;
                        if l_rows = 0 then
                            raise_application_error(-20121, 'No ' || p_table_name || ' row with key ' || p_pk_value || '.');
                        end if;
                    end set_status;

                    procedure submit(p_table_name in varchar2, p_pk_value in varchar2) is
                    begin
                        set_status(p_table_name, p_pk_value, 'PENDING_APPROVAL');
                    end submit;

                    procedure approve(p_table_name in varchar2, p_pk_value in varchar2) is
                    begin
                        set_status(p_table_name, p_pk_value, 'APPROVED');
                    end approve;

                    procedure reject(p_table_name in varchar2, p_pk_value in varchar2, p_reason in varchar2) is
                    begin
                        if p_reason is null then
                            raise_application_error(-20122, 'Enter a reason for rejecting this change.');
                        end if;
                        xxfnd_audit_pkg.set_change_reason('Rejected: ' || p_reason);
                        set_status(p_table_name, p_pk_value, 'REJECTED');
                        xxfnd_audit_pkg.clear_change_reason;
                    end reject;

                    procedure apply_rules(p_inserting        in boolean,
                                          p_old_status       in varchar2,
                                          p_new_status       in out varchar2,
                                          p_old_last_updated in varchar2,
                                          p_approved_by      in out varchar2,
                                          p_approved_date    in out timestamp) is
                        l_user varchar2(255) := xxfnd_util_pkg.current_user;
                    begin
                        if p_inserting then
                            -- Install scripts (no APEX session) may seed rows as APPROVED.
                            if p_new_status = 'APPROVED' and xxfnd_util_pkg.in_apex_session then
                                p_new_status := 'PENDING_APPROVAL';
                            end if;
                            if p_new_status = 'APPROVED' then
                                p_approved_by   := l_user;
                                p_approved_date := systimestamp;
                            else
                                p_approved_by   := null;
                                p_approved_date := null;
                            end if;
                            return;
                        end if;

                        if p_new_status = 'APPROVED' and nvl(p_old_status, '#') <> 'APPROVED' then
                            if p_old_status <> 'PENDING_APPROVAL' then
                                raise_application_error(-20123, 'Only a change that is pending approval can be approved.');
                            end if;
                            if upper(l_user) = upper(p_old_last_updated) then
                                raise_application_error(-20124, 'You made this change, so someone else must approve it.');
                            end if;
                            p_approved_by   := l_user;
                            p_approved_date := systimestamp;
                        elsif p_new_status = nvl(p_old_status, '#') then
                            -- A content edit (status untouched): approved rows go back for approval.
                            if p_old_status in ('APPROVED','REJECTED') then
                                p_new_status := 'PENDING_APPROVAL';
                            end if;
                            p_approved_by   := null;
                            p_approved_date := null;
                        elsif p_new_status in ('PENDING_APPROVAL','REJECTED','DRAFT') then
                            p_approved_by   := null;
                            p_approved_date := null;
                        end if;
                    end apply_rules;

                end xxfnd_approval_pkg;
                /
                ```
        }
    )

