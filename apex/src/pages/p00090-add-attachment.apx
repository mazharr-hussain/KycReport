page 90 (
    name: Add Attachment
    alias: ADD-ATTACHMENT
    title: Add Attachment
    pageGroup: @attachments
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @kyc-user
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Attach a file, a note or a web link. Files are stored in the configured document store (UCM or SharePoint); only the reference is kept here.
            ```
    }

    region attach (
        name: Attachment
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: attach
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P90_ENTITY_NAME (
        type: hidden
        layout {
            sequence: 1
            region: @attach
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P90_PK1_VALUE (
        type: hidden
        layout {
            sequence: 2
            region: @attach
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P90_SOURCE_PAGE (
        type: hidden
        layout {
            sequence: 3
            region: @attach
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P90_SOURCE_REGION (
        type: hidden
        layout {
            sequence: 4
            region: @attach
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P90_ATTACHED_DOCUMENT_ID (
        type: hidden
        layout {
            sequence: 5
            region: @attach
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P90_CATEGORY_CODE (
        type: selectList
        label {
            label: Category
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.category_name as display_value, c.category_code as return_value
                  from xxfnd_document_categories_vl c
                 where c.enabled_flag = 'Y'
                   and trunc(sysdate) between c.start_date_active and nvl(c.end_date_active, trunc(sysdate))
                   and xxfnd_attach_pkg.category_allowed(:APP_ALIAS, to_number(:P90_SOURCE_PAGE), c.category_code) = 'Y'
                 order by c.category_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Choose the category.
        }
    )

    pageItem P90_DATATYPE_CODE (
        type: selectList
        label {
            label: Attachment Type
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-doc-datatype
        }
        layout {
            sequence: 20
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: FILE
        }
        help {
            helpText: Choose the attachment Type.
        }
    )

    pageItem P90_FILE (
        type: fileUpload
        label {
            label: File
            alignment: left
        }
        layout {
            sequence: 30
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: Drop the file here
            dropzoneDesc: or click to browse
        }
        storage {
            type: appTempFiles
        }
        help {
            helpText: Upload the file.
        }
    )

    pageItem P90_URL (
        type: textField
        label {
            label: Web Address
            alignment: left
        }
        layout {
            sequence: 40
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: Web address
        }
        validation {
            maxLength: 2000
        }
        help {
            helpText: Enter the web Address.
        }
    )

    pageItem P90_TEXT (
        type: textarea
        label {
            label: Text
            alignment: left
        }
        layout {
            sequence: 50
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 6
        }
        help {
            helpText: Enter the text.
        }
    )

    pageItem P90_TITLE (
        type: textField
        label {
            label: Title
            alignment: left
        }
        layout {
            sequence: 60
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 400
        }
        help {
            inlineHelpText: Defaults to the file name.
        }
    )

    pageItem P90_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 70
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 2000
        }
        help {
            helpText: Enter the description.
        }
    )

    pageItem P90_DOCUMENT_DATE (
        type: datePicker
        label {
            label: Issue Date
            alignment: left
        }
        layout {
            sequence: 80
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText:
                ```
                Date printed on the document. Required for categories that must be recent (e.g. proof of address).
                ```
        }
    )

    pageItem P90_EXPIRY_DATE (
        type: datePicker
        label {
            label: Expiry Date
            alignment: left
        }
        layout {
            sequence: 90
            region: @attach
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Required for documents that expire, such as passports and licences.
        }
    )

    region attach_dff (
        name: Additional Information
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.render(
                           p_table_name   => 'XXFND_ATTACHED_DOCUMENTS',
                           p_pk_value     => :P90_ATTACHED_DOCUMENT_ID,
                           p_reference_value => :P90_CATEGORY_CODE,
                           p_context_code => :P90_DFF_CONTEXT);
                ```
            pageItemsToSubmit: [
                P90_ATTACHED_DOCUMENT_ID
                P90_DFF_CONTEXT
                P90_CATEGORY_CODE
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: attach_dff
        }
    )

    pageItem P90_DFF_JSON (
        type: hidden
        layout {
            sequence: 900
            region: @attach
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    pageItem P90_DFF_CONTEXT (
        type: hidden
        layout {
            sequence: 901
            region: @attach
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    dynamicAction bind-attach_dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        comments {
            comments: P90_DFF_JSON and P90_DFF_CONTEXT are unrestricted because this script fills them in the browser before submit; XXFND_DFF_PKG re-validates every value on the server.
        }

        action bind-attach_dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    xxfndDff.bind('attach_dff', 'P90_DFF_JSON', 'P90_DFF_CONTEXT');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-attach-dff (
        name: Refresh attach_dff on change
        execution {
            sequence: 30
        }
        when {
            event: change
            selectionType: items
            items: P90_CATEGORY_CODE
        }

        action refresh-attach-dff-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attach_dff
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction default-datatype (
        name: Default attachment type from category
        execution {
            sequence: 20
        }
        when {
            event: change
            selectionType: items
            items: P90_CATEGORY_CODE
        }

        action default-datatype-set (
            action: setValue
            settings {
                type: sqlQuery
                itemsToSubmit: P90_CATEGORY_CODE
                sqlQuery:
                    ```sql
                    select default_datatype_code from xxfnd_document_categories where category_code = :P90_CATEGORY_CODE
                    ```
            }
            affectedElements {
                selectionType: items
                items: P90_DATATYPE_CODE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction show-file (
        name: Show fields for P90_DATATYPE_CODE
        execution {
            sequence: 40
        }
        when {
            event: change
            selectionType: items
            items: P90_DATATYPE_CODE
        }
        clientSideCondition {
            type: item=value
            item: P90_DATATYPE_CODE
            value: FILE
        }

        action show-file-show-t (
            action: show
            affectedElements {
                selectionType: items
                items: P90_FILE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-file-hide-f (
            action: hide
            affectedElements {
                selectionType: items
                items: P90_FILE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction show-url (
        name: Show fields for P90_DATATYPE_CODE
        execution {
            sequence: 41
        }
        when {
            event: change
            selectionType: items
            items: P90_DATATYPE_CODE
        }
        clientSideCondition {
            type: item=value
            item: P90_DATATYPE_CODE
            value: WEB_PAGE
        }

        action show-url-show-t (
            action: show
            affectedElements {
                selectionType: items
                items: P90_URL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-url-hide-f (
            action: hide
            affectedElements {
                selectionType: items
                items: P90_URL
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction show-text (
        name: Show text for text attachments
        execution {
            sequence: 42
        }
        when {
            event: change
            selectionType: items
            items: P90_DATATYPE_CODE
        }
        clientSideCondition {
            type: itemIsInList
            item: P90_DATATYPE_CODE
            list: SHORT_TEXT,LONG_TEXT
        }

        action show-text-show (
            action: show
            affectedElements {
                selectionType: items
                items: P90_TEXT
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-text-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P90_TEXT
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button add (
        buttonName: ADD
        label: Add Attachment
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation VAL_CAN_INSERT (
        name: Allowed to add
        execution {
            sequence: 5
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when xxfnd_attach_pkg.block_permission(:APP_ALIAS, to_number(:P90_SOURCE_PAGE),
                                      :P90_SOURCE_REGION, :P90_ENTITY_NAME, 'INSERT') = 'Y'
                            then null
                            else 'You are not allowed to add attachments here.' end;
                ```
        }
        error {
            associatedItem: @P90_CATEGORY_CODE
        }
        serverSideCondition {
            whenButtonPressed: @add
        }
    )

    validation VAL_CONTENT_GIVEN (
        name: Content provided
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case
                         when :P90_DATATYPE_CODE = 'FILE' and :P90_FILE is null then 'Choose a file to upload.'
                         when :P90_DATATYPE_CODE = 'WEB_PAGE' and :P90_URL is null then 'Enter the web address.'
                         when :P90_DATATYPE_CODE in ('SHORT_TEXT','LONG_TEXT') and :P90_TEXT is null then 'Enter the text.'
                       end;
                ```
        }
        error {
            associatedItem: @P90_DATATYPE_CODE
        }
        serverSideCondition {
            whenButtonPressed: @add
        }
    )

    process add-attachment (
        name: Add attachment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                if :P90_DATATYPE_CODE = 'FILE' then
                    :P90_ATTACHED_DOCUMENT_ID := xxfnd_attach_pkg.add_file(
                        p_entity_name    => :P90_ENTITY_NAME,
                        p_pk1_value      => :P90_PK1_VALUE,
                        p_category_code  => :P90_CATEGORY_CODE,
                        p_temp_file_name => :P90_FILE,
                        p_title          => :P90_TITLE,
                        p_description    => :P90_DESCRIPTION,
                        p_document_date  => to_date(:P90_DOCUMENT_DATE),
                        p_expiry_date    => to_date(:P90_EXPIRY_DATE));
                else
                    :P90_ATTACHED_DOCUMENT_ID := xxfnd_attach_pkg.add_text(
                        p_entity_name   => :P90_ENTITY_NAME,
                        p_pk1_value     => :P90_PK1_VALUE,
                        p_category_code => :P90_CATEGORY_CODE,
                        p_datatype_code => :P90_DATATYPE_CODE,
                        p_title         => nvl(:P90_TITLE, :P90_URL),
                        p_text          => :P90_TEXT,
                        p_url           => :P90_URL,
                        p_description   => :P90_DESCRIPTION);
                end if;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Attachment added.
        }
        serverSideCondition {
            whenButtonPressed: @add
        }
    )

    validation VAL_P90_DFF (
        name: Validate additional information
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.validate('XXFND_ATTACHED_DOCUMENTS', :P90_DFF_JSON, :P90_DFF_CONTEXT, :P90_ATTACHED_DOCUMENT_ID, p_reference_value => :P90_CATEGORY_CODE);
                ```
        }
        error {
            associatedItem: @P90_DFF_CONTEXT
        }
    )

    process p90-dff-save (
        name: Save Additional Information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_dff_pkg.save('XXFND_ATTACHED_DOCUMENTS', :P90_ATTACHED_DOCUMENT_ID, :P90_DFF_JSON, :P90_DFF_CONTEXT, p_reference_value => :P90_CATEGORY_CODE);
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ADD
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ADD
        }
    )

)
