page 23 (
    name: Party Relationship
    alias: PARTY-RELATIONSHIP
    title: Party Relationship
    pageGroup: @parties
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @compliance-staff
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Who owns or controls the party. Ownership loops are rejected.
    }

    region form (
        name: Party Relationship
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_PARTY_RELATIONSHIPS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P23_PARTY_RELATIONSHIP_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: PARTY_RELATIONSHIP_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P23_OBJECT_PARTY_ID (
        type: hidden
        layout {
            sequence: 5
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: OBJECT_PARTY_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P23_SUBJECT_PARTY_ID (
        type: popupLov
        label {
            label: Owner / Officer
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-parties
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: SUBJECT_PARTY_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        help {
            helpText:
                ```
                The party that holds the interest or role (for example the shareholder or director).
                ```
        }
    )

    pageItem P23_RELATIONSHIP_TYPE (
        type: selectList
        label {
            label: Relationship
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-relationship-type
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: RELATIONSHIP_TYPE
            dataType: varchar2
        }
        help {
            helpText: Choose the relationship.
        }
    )

    pageItem P23_OWNERSHIP_PERCENTAGE (
        type: numberField
        label {
            label: Ownership %
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: OWNERSHIP_PERCENTAGE
            dataType: number
        }
        help {
            helpText: Enter the ownership %.
        }
    )

    pageItem P23_START_DATE (
        type: datePicker
        label {
            label: Start Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: START_DATE
            dataType: date
        }
        help {
            helpText: Choose the start Date.
        }
    )

    pageItem P23_END_DATE (
        type: datePicker
        label {
            label: End Date
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: END_DATE
            dataType: date
        }
        help {
            helpText: Choose the end Date.
        }
    )

    pageItem P23_OFFICER_CORRECTED_FLAG (
        type: switch
        label {
            label: Corrected by Officer
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: OFFICER_CORRECTED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        help {
            helpText: Choose the corrected by Officer.
        }
    )

    pageItem P23_LATEST_UBO_STATUS (
        type: selectList
        label {
            label: UBO Determination
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-ubo-status
            displayNullValue: true
            nullDisplayValue: - Not set -
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: LATEST_UBO_STATUS
            dataType: varchar2
        }
        readOnly {
            type: always
        }
        help {
            helpText: Display copy of the latest UBO determination, maintained by the investigation process.
        }
    )

    region dff (
        name: Additional Information
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.render(
                           p_table_name   => 'XXCMP_PARTY_RELATIONSHIPS',
                           p_pk_value     => :P23_PARTY_RELATIONSHIP_ID,
                           p_context_code => :P23_DFF_CONTEXT);
                ```
            pageItemsToSubmit: [
                P23_PARTY_RELATIONSHIP_ID
                P23_DFF_CONTEXT
            ]
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: dff
        }
    )

    dynamicAction bind-dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        comments {
            comments: P23_DFF_JSON and P23_DFF_CONTEXT are unrestricted because this script fills them in the browser before submit; XXFND_DFF_PKG re-validates every value on the server.
        }

        action bind-dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    xxfndDff.bind('dff', 'P23_DFF_JSON', 'P23_DFF_CONTEXT');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    pageItem P23_DFF_JSON (
        type: hidden
        layout {
            sequence: 900
            region: @form
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    pageItem P23_DFF_CONTEXT (
        type: hidden
        layout {
            sequence: 901
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    validation VAL_P23_DFF (
        name: Validate additional information
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.validate('XXCMP_PARTY_RELATIONSHIPS', :P23_DFF_JSON, :P23_DFF_CONTEXT, :P23_PARTY_RELATIONSHIP_ID);
                ```
        }
        error {
            associatedItem: @P23_DFF_CONTEXT
        }
    )

    process p23-dff-save (
        name: Save Additional Information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_dff_pkg.save('XXCMP_PARTY_RELATIONSHIPS', :P23_PARTY_RELATIONSHIP_ID, :P23_DFF_JSON, :P23_DFF_CONTEXT);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P23_PARTY_RELATIONSHIP_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P23_PARTY_RELATIONSHIP_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P23_PARTY_RELATIONSHIP_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
