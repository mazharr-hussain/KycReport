page 134 (
    name: Attachment Pages
    alias: ATTACHMENT-PAGES
    title: Attachment Pages
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            EBS attachment functions: which page regions show attachments, for which entity, and what users may do.
            ```
    }

    region breadcrumb (
        name: Attachment Pages
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Attachment Pages
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 135, p_items => 'P135_FUNCTION_CODE', p_values => to_char(q.function_code), p_clear_cache => '135') as open_url
                  from (

                            select f.function_code, f.function_name, f.apex_app_alias, f.apex_page_id, f.enabled_flag,
                                   (select count(*) from xxfnd_attachment_blocks b where b.function_code = f.function_code) as regions
                              from xxfnd_attachment_functions f
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column FUNCTION_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#FUNCTION_CODE#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column FUNCTION_NAME (
            type: plainText
            heading {
                heading: Page
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column APEX_APP_ALIAS (
            type: plainText
            heading {
                heading: Application Alias
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column APEX_PAGE_ID (
            type: plainText
            heading {
                heading: Page Number
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column REGIONS (
            type: plainText
            heading {
                heading: Regions
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Register Page
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 135
                clearCache: 135
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

)
