    dynamicAction refresh-screenings (
        name: Refresh screenings
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @screenings
        }

        action refresh-screenings-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @screenings
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )
    dynamicAction refresh-ubos (
        name: Refresh ubos
        execution {
            sequence: 50
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ubos
        }

        action refresh-ubos-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ubos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )
    dynamicAction refresh-party_documents (
        name: Refresh party_documents
        execution {
            sequence: 60
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @party_documents
        }

        action refresh-party_documents-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party_documents
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )
    validation submit-check (
        name: Case complete
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_case_pkg.submit_error(:P211_CASE_ID);
                ```
        }
        error {
            associatedItem: @P211_RISK_TIER
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SUBMIT_APPROVAL
        }
    )

    validation note-text (
        name: Note entered
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_NEW_NOTE is null then 'Enter the note.' end;
                ```
        }
        error {
            associatedItem: @P211_NEW_NOTE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ADD_NOTE
        }
    )

    process open-from-task (
        name: Open from task
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select to_number(detail_pk) into :P211_CASE_ID
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'SINGLE_TASK',
                                   p_task_id        => :P211_TASK_ID,
                                   p_application_id => :APP_ID ) )
                 where task_def_static_id = 'CASE_INVESTIGATION';
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P211_TASK_ID
        }
    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @case
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Save case
        type: formAutoRowProcessing
        formRegion: @case
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Case saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SUBMIT_APPROVAL
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-findings (
        name: Save questionnaire
        type: interactiveGridAutoRowProcessing
        editableRegion: @findings
        execution {
            sequence: 15
            point: processing
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process apply-screening (
        name: Enhanced KYC from screening
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.apply_screening(:P211_CASE_ID);
                ```
        }
        execution {
            sequence: 18
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SUBMIT_APPROVAL
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process submit-for-approval (
        name: Submit for approval
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.submit_for_approval(:P211_CASE_ID);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Case submitted for approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit-approval
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process add-note (
        name: Add note
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                insert into xxcmp_case_notes (case_id, note_text) values (:P211_CASE_ID, :P211_NEW_NOTE);
                :P211_NEW_NOTE := null;
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Note added.
        }
        serverSideCondition {
            whenButtonPressed: @add-note
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
