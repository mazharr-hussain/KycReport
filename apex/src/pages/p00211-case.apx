    button party_documents-add (
        buttonName: PARTY_DOCUMENTS_ADD
        label: Add Document
        layout {
            sequence: 5
            region: @party_documents
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_ENTITY_NAME: XXCMP_PARTIES
                    P90_PK1_VALUE: &P211_PARTY_ID.
                    P90_SOURCE_PAGE: 211
                    P90_SOURCE_REGION: party_documents
                }
                clearCache: 90
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxfnd_attach_pkg.block_permission(:APP_ALIAS, 211, 'party_documents', 'XXCMP_PARTIES', 'INSERT') = 'Y'
                ```
        }
    )

