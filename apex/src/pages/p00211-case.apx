            region: @rfis
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 32
                items: {
                    P32_ENTITY_NAME: XXCMP_CASES
                    P32_PK1_VALUE: &P211_CASE_ID.
                }
                clearCache: 32
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from xxcmp_cases where case_id = :P211_CASE_ID and case_status = 'INVESTIGATION'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

