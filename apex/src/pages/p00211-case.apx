        buttonName: REPORT
        label: Compliance Report
        layout {
            sequence: 30
            region: @buttons
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 217
                items: {
                    P217_CASE_ID: &P211_CASE_ID.
                }
                clearCache: 217
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from xxcmp_cases where case_id = :P211_CASE_ID and closed_date is not null
                ```
        }
