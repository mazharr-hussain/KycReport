page 211 (
    name: Case
    alias: CASE
    title: Case
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    readOnly {
        type: expression
        language: plsql
        plsqlExpression:
            ```plsql
            xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N'
            ```
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Case 360: everything about one case. The officer records screenings, verifies documents, determines the beneficial owners, answers the investigation questionnaire, sets the risk and submits the case for approval.
            ```
    }

    region breadcrumb (
        name: Case
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    region case (
        name: Case
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_CASES
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        advanced {
            htmlDomId: case
        }
    )

    pageItem P211_CASE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: CASE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P211_TASK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @case
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P211_PARTY_ID (
        type: hidden
        layout {
            sequence: 3
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: PARTY_ID
            dataType: number
        }
    )

    pageItem P211_WORKFLOW_ID (
        type: hidden
        layout {
            sequence: 4
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: WORKFLOW_ID
            dataType: number
        }
    )

    pageItem P211_CASE_NUMBER (
        type: displayOnly
        label {
            label: Case
            alignment: left
        }
        layout {
            sequence: 10
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: CASE_NUMBER
            dataType: varchar2
        }
    )
    pageItem P211_PARTY (
        type: displayOnly
        label {
            label: Party
            alignment: left
        }
        layout {
            sequence: 20
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.party_number || ' - ' || p.party_name
                       || nvl2(p.jurisdiction, ' (' || xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction) || ')', null)
                  from xxcmp_cases c join xxcmp_parties p on p.party_id = c.party_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
    )

    pageItem P211_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 30
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('CASE_STATUS', case_status)
                       || case when case_status = 'PENDING_APPROVAL' then ' (level ' || current_level || ')' end
                       || nvl2(closed_date, ' - closed ' || to_char(closed_date, 'DD-Mon-YYYY'), null)
                  from xxcmp_cases where case_id = :P211_CASE_ID
                ```
            used: always
        }
    )

    pageItem P211_SLA (
        type: displayOnly
        label {
            label: SLA Due
            alignment: left
        }
        layout {
            sequence: 40
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(sla_due_date, 'DD-Mon-YYYY')
                       || case when closed_date is null and sla_due_date < trunc(sysdate) then ' - OVERDUE' end
                  from xxcmp_cases where case_id = :P211_CASE_ID
                ```
            used: always
        }
    )

    pageItem P211_REQUEST (
        type: displayOnly
        label {
            label: Request
            alignment: left
        }
        layout {
            sequence: 50
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select r.request_number || ' - '
                       || xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type)
                       || ' - intake score ' || nvl(to_char(r.intake_score), '-') || ' (reference only)'
                  from xxcmp_cases c join xxcmp_requests r on r.request_id = c.request_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
    )

    pageItem P211_ASSIGNED_TO (
        type: selectList
        label {
            label: Assigned To
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct e.full_name || ' (' || ur.user_name || ')' as display_value, ur.user_name as return_value
                  from xxfnd_user_roles_v ur
                  join xxfnd_employees e on e.user_name = ur.user_name
                 where ur.role_code in ('COMPLIANCE_OFFICER','COMPLIANCE_MANAGER','HEAD_OF_COMPLIANCE') and ur.active_flag = 'Y'
                 order by 1
                ```
            displayNullValue: true
            nullDisplayValue: - Unassigned -
        }
        layout {
            sequence: 60
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @case
            column: ASSIGNED_TO
            dataType: varchar2
        }
        help {
            helpText: The investigating officer. A manager can reassign the case.
        }
    )
    pageItem P211_RISK_TIER (
        type: selectList
        label {
            label: Risk Classification
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value from xxfnd_lookup_values
                 where lookup_type = 'RISK_TIER' and enabled_flag = 'Y' order by display_sequence
                ```
            displayNullValue: true
            nullDisplayValue: - Not classified -
        }
        layout {
            sequence: 70
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @case
            column: RISK_TIER
            dataType: varchar2
        }
        help {
            helpText: Your own judgement from everything found in the investigation. The intake score is reference only.
        }
    )
    pageItem P211_ENHANCED_KYC_FLAG (
        type: switch
        label {
            label: Enhanced KYC
            alignment: left
        }
        layout {
            sequence: 80
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @case
            column: ENHANCED_KYC_FLAG
            dataType: varchar2
        }
        help {
            helpText: Set automatically by a confirmed match or a PEP flag; can also be set by the officer.
        }
    )
    pageItem P211_PEP_FLAG (
        type: displayOnly
        label {
            label: PEP
            alignment: left
        }
        layout {
            sequence: 90
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: PEP_FLAG
            dataType: varchar2
        }
    )
    pageItem P211_NEXT_REVIEW_DATE (
        type: displayOnly
        label {
            label: Next Review
            alignment: left
        }
        layout {
            sequence: 100
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: NEXT_REVIEW_DATE
            dataType: date
        }
    )
    pageItem P211_CONDITIONS (
        type: displayOnly
        label {
            label: Conditions
            alignment: left
        }
        layout {
            sequence: 110
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: CONDITIONS
            dataType: varchar2
        }
    )
    region findings (
        name: Investigation Questionnaire
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.answer_id,
                       a.question_id,
                       (select q.section_name from xxcmp_questions q where q.question_id = a.question_id) as section_name,
                       (select q.question_text from xxcmp_questions q where q.question_id = a.question_id) as question_text,
                       a.answer_option_id,
                       a.answer_text
                  from xxcmp_request_answers a
                 where a.case_id = :P211_CASE_ID
                   and a.respondent_type = 'OFFICER'
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: findings
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: No investigation questions are configured.
        }
        toolbar {
            controls: [
                saveButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @SECTION_NAME
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @QUESTION_TEXT
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ANSWER_OPTION_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ANSWER_TEXT
                layout {
                    sequence: 4
                }
            )
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column ANSWER_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_ID
                dataType: number
                primaryKey: true
            }
        )

        column QUESTION_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_ID
                dataType: number
            }
        )

        column SECTION_NAME (
            type: displayOnly
            heading {
                heading: Section
            }
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: SECTION_NAME
                dataType: varchar2
                queryOnly: true
            }
        )

        column QUESTION_TEXT (
            type: displayOnly
            heading {
                heading: Question
            }
            layout {
                sequence: 40
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_TEXT
                dataType: varchar2
                queryOnly: true
            }
        )

        column ANSWER_OPTION_ID (
            type: selectList
            heading {
                heading: Answer
            }
            layout {
                sequence: 50
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select answer_label as display_value, answer_option_id as return_value
                      from xxcmp_answer_options
                     where question_id = :QUESTION_ID and approval_status = 'APPROVED' and enabled_flag = 'Y'
                     order by display_sequence
                    ```
                displayNullValue: true
                nullDisplayValue: -
            }
            cascadingLov {
                parentColumns: QUESTION_ID
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_OPTION_ID
                dataType: number
            }
        )

        column ANSWER_TEXT (
            type: textarea
            heading {
                heading: Findings
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_TEXT
                dataType: varchar2
            }
        )

    )

    region screenings (
        name: Screenings
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.screening_id,
                       xxfnd_util_pkg.lookup_meaning('SCREENING_TYPE', s.screening_type) as screening_type,
                       p.party_name,
                       xxfnd_util_pkg.lookup_meaning('SCREENING_MATCH_STATUS', s.match_status) as match_status,
                       rtrim(case when s.pep_flag = 'Y' then 'PEP, ' end || case when s.sanctions_flag = 'Y' then 'Sanctions, ' end
                             || case when s.adverse_media_flag = 'Y' then 'Adverse media, ' end, ', ') as flags,
                       s.capture_method, s.screened_date, s.result_notes,
                       apex_page.get_url(p_page => 213, p_items => 'P213_SCREENING_ID,P213_CASE_ID', p_values => to_char(s.screening_id) || ',' || :P211_CASE_ID, p_clear_cache => '213') as open_url
                  from xxcmp_screenings s
                  join xxcmp_parties p on p.party_id = s.party_id
                 where s.case_id = :P211_CASE_ID
                 order by s.screened_date desc, s.screening_id desc
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: screenings
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No screening recorded yet.
        }

        column SCREENING_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column SCREENING_TYPE (
            type: plainText
            heading {
                heading: Check
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#SCREENING_TYPE#</a>
                    ```
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 30
            }
        )

        column MATCH_STATUS (
            type: plainText
            heading {
                heading: Result
            }
            layout {
                sequence: 40
            }
        )

        column FLAGS (
            type: plainText
            heading {
                heading: Flags
            }
            layout {
                sequence: 50
            }
        )

        column CAPTURE_METHOD (
            type: plainText
            heading {
                heading: Captured
            }
            layout {
                sequence: 60
            }
        )

        column SCREENED_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 70
            }
        )

        column RESULT_NOTES (
            type: plainText
            heading {
                heading: Notes
            }
            layout {
                sequence: 80
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 90
            }
        )

    )

    region party_documents (
        name: Documents and Verification
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.attached_document_id,
                       a.title, a.category_name, a.document_date, a.expiry_date,
                       case when a.expired_flag = 'Y' then 'Expired' end as expired,
                       case a.entity_name when 'XXCMP_REQUESTS' then 'Request' when 'XXCMP_CASES' then 'Case' else 'Party' end as attached_to,
                       nvl(xxfnd_util_pkg.lookup_meaning('DOC_VERIFICATION_STATUS', v.verification_status), 'Not verified') as verification,
                       v.notes,
                       case when a.datatype_code = 'FILE' then
                           apex_page.get_url(p_page => 1, p_request => 'APPLICATION_PROCESS=DOWNLOAD_DOCUMENT',
                                             p_items => 'G_DOCUMENT_ID', p_values => to_char(a.document_id)) end as download_url,
                       apex_page.get_url(p_page => 215, p_items => 'P215_VERIFICATION_ID,P215_CASE_ID,P215_ATTACHED_DOCUMENT_ID', p_values => to_char(v.verification_id) || ',' || :P211_CASE_ID || ',' || to_char(a.attached_document_id), p_clear_cache => '215') as verify_url
                  from xxfnd_attached_documents_v a
                  left join xxcmp_doc_verifications v on v.attached_document_id = a.attached_document_id and v.case_id = :P211_CASE_ID
                 where (a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = :P211_PARTY_ID)
                    or (a.entity_name = 'XXCMP_CASES' and a.pk1_value = :P211_CASE_ID)
                    or (a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = (select to_char(request_id) from xxcmp_cases where case_id = :P211_CASE_ID))
                 order by a.category_name, a.creation_date
                ```
            pageItemsToSubmit: P211_CASE_ID,P211_PARTY_ID
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_documents
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No documents on the party, the request or the case.
        }

        column ATTACHED_DOCUMENT_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#DOWNLOAD_URL#">#TITLE#</a>
                    ```
            }
        )

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
        )

        column ATTACHED_TO (
            type: plainText
            heading {
                heading: On
            }
            layout {
                sequence: 40
            }
        )

        column DOCUMENT_DATE (
            type: plainText
            heading {
                heading: Dated
            }
            layout {
                sequence: 50
            }
        )

        column EXPIRY_DATE (
            type: plainText
            heading {
                heading: Expires
            }
            layout {
                sequence: 60
            }
        )

        column EXPIRED (
            type: plainText
            heading {
                heading: Expired
            }
            layout {
                sequence: 70
            }
        )

        column VERIFICATION (
            type: plainText
            heading {
                heading: Verification
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#VERIFY_URL#">#VERIFICATION#</a>
                    ```
            }
        )

        column NOTES (
            type: plainText
            heading {
                heading: Notes
            }
            layout {
                sequence: 90
            }
        )

        column DOWNLOAD_URL (
            type: hidden
            layout {
                sequence: 100
            }
        )

        column VERIFY_URL (
            type: hidden
            layout {
                sequence: 110
            }
        )

    )

    region ubos (
        name: Beneficial Owners
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.ubo_id, p.party_name,
                       xxfnd_util_pkg.lookup_meaning('UBO_BASIS', u.basis) as basis,
                       u.ownership_percentage, u.notes, u.created_by,
                       apex_page.get_url(p_page => 214, p_items => 'P214_UBO_ID,P214_CASE_ID', p_values => to_char(u.ubo_id) || ',' || :P211_CASE_ID, p_clear_cache => '214') as open_url
                  from xxcmp_ubo_determinations u
                  join xxcmp_parties p on p.party_id = u.owner_party_id
                 where u.case_id = :P211_CASE_ID
                 order by u.ownership_percentage desc nulls last
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 60
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ubos
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No beneficial owner determined yet.
        }

        column UBO_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Beneficial Owner
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#PARTY_NAME#</a>
                    ```
            }
        )

        column BASIS (
            type: plainText
            heading {
                heading: Basis
            }
            layout {
                sequence: 30
            }
        )

        column OWNERSHIP_PERCENTAGE (
            type: plainText
            heading {
                heading: Ownership %
            }
            layout {
                sequence: 40
            }
        )

        column NOTES (
            type: plainText
            heading {
                heading: Notes
            }
            layout {
                sequence: 50
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Determined By
            }
            layout {
                sequence: 60
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 70
            }
        )

    )

    region notes (
        name: Investigation Notes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.note_text, p.party_name as about, n.created_by, n.creation_date
                  from xxcmp_case_notes n
                  left join xxcmp_parties p on p.party_id = n.related_party_id
                 where n.case_id = :P211_CASE_ID
                 order by n.creation_date desc
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 70
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: notes
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No notes yet.
        }

        column NOTE_TEXT (
            type: plainText
            heading {
                heading: Note
            }
            layout {
                sequence: 10
            }
        )

        column ABOUT (
            type: plainText
            heading {
                heading: About
            }
            layout {
                sequence: 20
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: By
            }
            layout {
                sequence: 30
            }
        )

        column CREATION_DATE (
            type: plainText
            heading {
                heading: When
            }
            layout {
                sequence: 40
            }
        )

    )

    pageItem P211_NEW_NOTE (
        type: textarea
        label {
            label: New Note
            alignment: left
        }
        layout {
            sequence: 10
            region: @notes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 4000
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from xxcmp_cases where case_id = :P211_CASE_ID and case_status = 'INVESTIGATION'
                ```
        }
    )

    region rfis (
        name: Requests for Information
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.rfi_id, r.rfi_number,
                       xxfnd_util_pkg.lookup_meaning('RFI_CATEGORY', r.rfi_category) as category,
                       xxfnd_util_pkg.lookup_meaning('RFI_STATUS', r.rfi_status) as status,
                       case r.continue_other_work_flag when 'N' then 'Pauses the case' end as blocking,
                       r.due_date, r.responded_date,
                       apex_page.get_url(p_page => 31, p_items => 'P31_RFI_ID', p_values => to_char(r.rfi_id), p_clear_cache => '31') as open_url
                  from xxcmp_rfis r
                 where (r.entity_name = 'XXCMP_CASES' and r.pk1_value = :P211_CASE_ID)
                    or (r.entity_name = 'XXCMP_REQUESTS' and r.pk1_value = (select to_char(request_id) from xxcmp_cases where case_id = :P211_CASE_ID))
                 order by r.rfi_id desc
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 80
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: rfis
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No requests for information.
        }

        column RFI_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column RFI_NUMBER (
            type: plainText
            heading {
                heading: RFI
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#RFI_NUMBER#</a>
                    ```
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
        )

        column BLOCKING (
            type: plainText
            heading {
                heading: Effect
            }
            layout {
                sequence: 50
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due
            }
            layout {
                sequence: 60
            }
        )

        column RESPONDED_DATE (
            type: plainText
            heading {
                heading: Answered
            }
            layout {
                sequence: 70
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 80
            }
        )

    )

    region decisions (
        name: Decisions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.level_no, initcap(d.outcome) as outcome,
                       r.role_name, d.decided_by, to_char(d.decision_date, 'DD-Mon-YYYY HH24:MI') as decision_date, d.comments
                  from xxcmp_case_decisions d
                  left join xxfnd_roles r on r.role_code = d.role_code
                 where d.case_id = :P211_CASE_ID
                 order by d.decision_date
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: decisions
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No decision yet.
        }

        column LEVEL_NO (
            type: plainText
            heading {
                heading: Level
            }
            layout {
                sequence: 10
            }
        )

        column OUTCOME (
            type: plainText
            heading {
                heading: Outcome
            }
            layout {
                sequence: 20
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: As
            }
            layout {
                sequence: 30
            }
        )

        column DECIDED_BY (
            type: plainText
            heading {
                heading: By
            }
            layout {
                sequence: 40
            }
        )

        column DECISION_DATE (
            type: plainText
            heading {
                heading: When
            }
            layout {
                sequence: 50
            }
        )

        column COMMENTS (
            type: plainText
            heading {
                heading: Comments
            }
            layout {
                sequence: 60
            }
        )

    )

    region workflow-diagram (
        name: Workflow
        type: workflowDiagram
        layout {
            sequence: 100
            slot: BODY
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        settings {
            workflowId: P211_WORKFLOW_ID
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P211_WORKFLOW_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @buttons
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from xxcmp_cases where case_id = :P211_CASE_ID and case_status = 'INVESTIGATION'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button submit-approval (
        buttonName: SUBMIT_APPROVAL
        label: Submit for Approval
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Submit the case for approval? It can no longer be changed.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from xxcmp_cases where case_id = :P211_CASE_ID and case_status = 'INVESTIGATION'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

