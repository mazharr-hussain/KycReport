page 153 (
    name: Descriptive Flexfield
    alias: DESCRIPTIVE-FLEXFIELD
    title: Descriptive Flexfield
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: onlyForSuccess
    }
    help {
        helpText:
            ```
            EBS structure: flexfield (table) > context > segment (reserved column + value set). Character segments use ATTRIBUTEn, numbers ATTRIBUTE_NUMBERn, dates ATTRIBUTE_DATEn, date-times ATTRIBUTE_TIMESTAMPn. Global columns cannot be reused by other contexts.
            ```
    }

    region breadcrumb (
        name: Descriptive Flexfield
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Flexfield
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_DF_FLEXFIELDS
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    pageItem P153_DESCRIPTIVE_FLEXFIELD_CODE (
        type: textField
        label {
            label: Flexfield Code
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 60
        }
        source {
            formRegion: @form
            column: DESCRIPTIVE_FLEXFIELD_CODE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P153_SAVED = 'Y'
                ```
        }
        help {
            helpText: Enter the flexfield Code.
        }
    )

    pageItem P153_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P153_SAVED
                  from XXFND_DF_FLEXFIELDS
                 where DESCRIPTIVE_FLEXFIELD_CODE = :P153_DESCRIPTIVE_FLEXFIELD_CODE;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P153_FLEXFIELD_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 240
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select flexfield_name from xxfnd_df_flexfields_tl where descriptive_flexfield_code = :P153_DESCRIPTIVE_FLEXFIELD_CODE and language_code = 'en'
                ```
            used: always
        }
        help {
            helpText: Enter the name.
        }
    )

