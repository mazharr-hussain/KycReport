    region segments (
        name: Segments
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.descriptive_flexfield_code, s.context_code, s.segment_code, s.column_name, s.sequence_number,
                       s.prompt, s.help_text, s.value_set_code, s.required_flag, s.default_type, s.default_value,
                       s.read_only_flag, s.display_flag, s.enabled_flag
                  from xxfnd_df_segments s
                 where s.descriptive_flexfield_code = :P153_DESCRIPTIVE_FLEXFIELD_CODE
                ```
            pageItemsToSubmit: P153_DESCRIPTIVE_FLEXFIELD_CODE
        }
        layout {
            sequence: 40
            slot: BODY
        }
