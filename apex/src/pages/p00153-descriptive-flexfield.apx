    pageItem P153_PREVIEW_CONTEXT (
        type: selectList
        label {
            label: Preview Context
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select context_name as display_value, context_code as return_value
                  from xxfnd_df_contexts
                 where descriptive_flexfield_code = :P153_DESCRIPTIVE_FLEXFIELD_CODE and global_flag = 'N' and enabled_flag = 'Y'
                 order by context_name
                ```
            displayNullValue: true
            nullDisplayValue: - Global only -
        }
        layout {
            sequence: 10
            region: @preview
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Choose the preview Context.
        }
    )

    region preview (
        name: Preview
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.render(
                           p_table_name      => :P153_TABLE_NAME,
                           p_pk_value        => null,
                           p_context_code    => :P153_PREVIEW_CONTEXT,
                           p_reference_value => :P153_PREVIEW_CONTEXT,
                           p_read_only       => 'Y');
                ```
            pageItemsToSubmit: [
                P153_TABLE_NAME
                P153_PREVIEW_CONTEXT
            ]
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: preview
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P153_SAVED
        }
    )

    dynamicAction refresh-preview (
        name: Refresh preview on change
        execution {
            sequence: 30
        }
        when {
            event: change
            selectionType: items
            items: P153_PREVIEW_CONTEXT
        }

        action refresh-preview-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preview
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-name (
        name: Save flexfield name
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                merge into xxfnd_df_flexfields_tl t
                using (select :P153_DESCRIPTIVE_FLEXFIELD_CODE code, 'en' lang from dual) s
                   on (t.descriptive_flexfield_code = s.code and t.language_code = s.lang)
                 when matched then update set t.flexfield_name = :P153_FLEXFIELD_NAME
                 when not matched then insert (descriptive_flexfield_code, language_code, flexfield_name)
                                       values (s.code, s.lang, :P153_FLEXFIELD_NAME);
                -- Every flexfield has a protected GLOBAL context.
                merge into xxfnd_df_contexts c
                using (select :P153_DESCRIPTIVE_FLEXFIELD_CODE code from dual) s
                   on (c.descriptive_flexfield_code = s.code and c.context_code = 'GLOBAL')
                 when not matched then insert (descriptive_flexfield_code, context_code, context_name, global_flag, protected_flag)
                                       values (s.code, 'GLOBAL', 'Global Data Elements', 'Y', 'Y');
                ```
        }
        execution {
            sequence: 15
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-contexts (
        name: Save contexts
        type: interactiveGridAutoRowProcessing
        editableRegion: @contexts
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-segments (
        name: Save segments
        type: interactiveGridAutoRowProcessing
        editableRegion: @segments
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process generate-view (
        name: Generate DFV view
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_dff_setup_pkg.generate_dfv_view(:P153_DESCRIPTIVE_FLEXFIELD_CODE);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        successMessage {
            successMessage: Reporting view regenerated.
        }
        serverSideCondition {
            whenButtonPressed: @gen-view
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
