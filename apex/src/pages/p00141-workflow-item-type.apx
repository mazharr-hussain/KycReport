page 141 (
    name: Workflow Item Type
    alias: WORKFLOW-ITEM-TYPE
    title: Workflow Item Type
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            What a workflow runs against (EBS item type).
            ```
    }

    region form (
        name: Workflow Item Type
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_WF_ITEM_TYPES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P141_ITEM_TYPE (
        type: textField
        label {
            label: Item Type
            alignment: left
        }
        layout {
            sequence: 1
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @form
            column: ITEM_TYPE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P141_SAVED = 'Y'
                ```
        }
        help {
            inlineHelpText: Upper case, no spaces. Cannot be changed once saved.
        }
    )

    pageItem P141_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P141_SAVED
                  from XXFND_WF_ITEM_TYPES
                 where ITEM_TYPE = :P141_ITEM_TYPE;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P141_ITEM_TYPE_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 240
        }
        source {
            formRegion: @form
            column: ITEM_TYPE_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the name.
        }
    )

    pageItem P141_APPLICATION_CODE (
        type: textField
        label {
            label: Application Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: KYC
        }
        help {
            helpText: Enter the application Code.
        }
    )

    pageItem P141_ENTITY_NAME (
        type: selectList
        label {
            label: Entity
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-entities
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ENTITY_NAME
            dataType: varchar2
        }
        help {
            helpText: Choose the entity.
        }
    )

    pageItem P141_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Enter the description.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P141_SAVED
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_SAVED
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P141_SAVED
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
