page 120 (
    name: Integration Endpoints
    alias: INTEGRATION-ENDPOINTS
    title: Integration Endpoints
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            External (non-Oracle) systems. Secrets are held only in APEX Web Credentials; this page stores the credential's static ID.
            ```
    }

    region breadcrumb (
        name: Integration Endpoints
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Integration Endpoints
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 121, p_items => 'P121_ENDPOINT_CODE', p_values => to_char(q.endpoint_code), p_clear_cache => '121') as open_url
                  from (

                            select e.endpoint_code, e.endpoint_name,
                                   xxfnd_util_pkg.lookup_meaning('ENDPOINT_TYPE', e.endpoint_type) as endpoint_type,
                                   e.base_url, e.web_credential_static_id,
                                   xxfnd_util_pkg.lookup_meaning('ENDPOINT_STATUS', e.status_code) as status_code
                              from xxfnd_integration_endpoints e
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column ENDPOINT_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#ENDPOINT_CODE#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column ENDPOINT_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ENDPOINT_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column BASE_URL (
            type: plainText
            heading {
                heading: Base URL
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column WEB_CREDENTIAL_STATIC_ID (
            type: plainText
            heading {
                heading: Web Credential
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column STATUS_CODE (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Endpoint
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 121
                clearCache: 121
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
