page 163 (
    name: Conclusion Templates
    alias: CONCLUSION-TEMPLATES
    title: Conclusion Templates
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @rules-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Conclusion Templates
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Conclusion Templates
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 164, p_items => 'P164_RISK_TIER', p_values => to_char(q.risk_tier), p_clear_cache => '164') as open_url
                  from (

                            select c.risk_tier, xxfnd_util_pkg.lookup_meaning('RISK_TIER', c.risk_tier) as risk_tier_name,
                                   c.template_name, c.enabled_flag, c.last_update_date
                              from xxcmp_conclusion_templates c
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column RISK_TIER (
            type: hidden
            heading {
                heading: Risk Tier
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
                primaryKey: true
            }
        )

        column RISK_TIER_NAME (
            type: plainText
            heading {
                heading: Risk Tier
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#RISK_TIER_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column TEMPLATE_NAME (
            type: plainText
            heading {
                heading: Template
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column LAST_UPDATE_DATE (
            type: plainText
            heading {
                heading: Updated
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Template
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 164
                clearCache: 164
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @rules-admin
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
