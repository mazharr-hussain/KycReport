page 10030 (
    name: Activity Reports
    alias: ACTIVITY-REPORTS
    title: Activity Reports
    pageGroup: @features
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @feature-activity-reporting
    }
    help {
        helpText: Every page view in the last 30 days.
    }

    region breadcrumb (
        name: Activity Reports
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Page Views - Last 30 Days
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.view_date,
                       l.apex_user,
                       l.page_id,
                       l.page_name,
                       l.elapsed_time,
                       l.rows_queried,
                       l.error_message
                  from apex_workspace_activity_log l
                 where l.application_id = :APP_ID
                   and l.view_date > sysdate - 30
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column VIEW_DATE (
            type: plainText
            heading {
                heading: When
            }
            layout {
                sequence: 10
            }
            appearance {
            }
            source {
                dataType: DATE
            }
        )

        column APEX_USER (
            type: plainText
            heading {
                heading: User
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column PAGE_ID (
            type: plainText
            heading {
                heading: Page
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column PAGE_NAME (
            type: plainText
            heading {
                heading: Page Name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ELAPSED_TIME (
            type: plainText
            heading {
                heading: Seconds
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G990D000
            }
            source {
                dataType: NUMBER
            }
        )

        column ROWS_QUERIED (
            type: plainText
            heading {
                heading: Rows
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column ERROR_MESSAGE (
            type: plainText
            heading {
                heading: Error
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    region reports-menu (
        name: More Reports
        type: list
        source {
            list: @activity-menu
        }
        layout {
            sequence: 15
            slot: BODY
        }
        componentAppearance {
            listTemplate: @/badge-list
            templateOptions: #DEFAULT#
        }
    )

)
