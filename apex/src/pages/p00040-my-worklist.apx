page 40 (
    name: My Worklist
    alias: MY-WORKLIST
    title: My Worklist
    pageGroup: @workflow
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Workflow steps you can act on now, including steps delegated to you.
    }

    region breadcrumb (
        name: My Worklist
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: My Worklist
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.wf_item_id,
                       i.item_type_name,
                       i.current_activity_name,
                       i.entity_name,
                       i.pk1_value,
                       i.performer_role_code,
                       i.started_date,
                       i.last_transition_date,
                       apex_page.get_url(
                       p_page   => case i.entity_name when 'XXCMP_RFIS' then 31 else 42 end,
                       p_items  => case i.entity_name when 'XXCMP_RFIS' then 'P31_RFI_ID' else 'P42_WF_ITEM_ID' end,
                       p_values => case i.entity_name when 'XXCMP_RFIS' then i.pk1_value else to_char(i.wf_item_id) end) as open_url
                  from xxfnd_wf_items_v i
                 where i.item_status = 'ACTIVE'
                   and i.current_activity_type in ('TASK','APPROVAL')
                   and xxfnd_wf_pkg.can_act(i.wf_item_id) = 'Y'
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Nothing is waiting for you.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column WF_ITEM_ID (
            type: hidden
            heading {
                heading: Wf Item Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column ITEM_TYPE_NAME (
            type: plainText
            heading {
                heading: Process
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column CURRENT_ACTIVITY_NAME (
            type: plainText
            heading {
                heading: Step
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#CURRENT_ACTIVITY_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column ENTITY_NAME (
            type: plainText
            heading {
                heading: Record Type
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column PK1_VALUE (
            type: plainText
            heading {
                heading: Record
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column PERFORMER_ROLE_CODE (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column STARTED_DATE (
            type: plainText
            heading {
                heading: Started
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column LAST_TRANSITION_DATE (
            type: plainText
            heading {
                heading: Waiting Since
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

    )

)
