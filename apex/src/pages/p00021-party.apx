        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: party
        }
    )

    pageItem P21_PARTY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @party
            slot: regionBody
