    validation VAL_PARTY_EXISTS (
        name: Party already exists
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                    l_id number;
                    l_no varchar2(30);
                begin
                    l_id := xxcmp_kyc_pkg.exact_party_match(:P21_PARTY_TYPE, :P21_PARTY_NAME,
                                :P21_REGISTRATION_NUMBER, :P21_JURISDICTION, to_date(:P21_DATE_OF_BIRTH));
                    if l_id is not null then
                        select party_number into l_no from xxcmp_parties where party_id = l_id;
                        return 'This party already exists as ' || l_no || '. Open the existing record instead of creating a new one.';
                    end if;
                    return null;
                end;
                ```
        }
        error {
            associatedItem: @P21_PARTY_NAME
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation VAL_P21_DFF (
        name: Validate additional information
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.validate('XXCMP_PARTIES', :P21_DFF_JSON, :P21_DFF_CONTEXT, :P21_PARTY_ID, p_reference_value => :P21_PARTY_TYPE);
                ```
        }
        error {
            associatedItem: @P21_DFF_CONTEXT
        }
    )

    process p21-dff-save (
        name: Save Additional Information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_dff_pkg.save('XXCMP_PARTIES', :P21_PARTY_ID, :P21_DFF_JSON, :P21_DFF_CONTEXT, p_reference_value => :P21_PARTY_TYPE);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process initialize-party (
        name: Initialize party
        type: formInitialization
