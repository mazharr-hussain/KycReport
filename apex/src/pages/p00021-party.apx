                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    dynamicAction bind-party_dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        comments {
            comments: P21_DFF_JSON and P21_DFF_CONTEXT are unrestricted because this script fills them in the browser before submit; XXFND_DFF_PKG re-validates every value on the server.
        }

        action bind-party_dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    xxfndDff.bind('party_dff', 'P21_DFF_JSON', 'P21_DFF_CONTEXT');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    region matches (
        name: Possible Existing Matches
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.party_id,
                       p.party_number,
                       p.party_name,
                       p.registration_number,
                       xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction) as jurisdiction,
                       case when p.registration_number is not null
                             and upper(replace(p.registration_number, ' ')) = upper(replace(:P21_REGISTRATION_NUMBER, ' '))
                            then 'Same registration number'
                            else round(xxcmp_kyc_pkg.name_similarity(p.party_name, :P21_PARTY_NAME)) || '% name match'
                       end as match_reason
                  from xxcmp_parties p
                 where p.party_id <> nvl(to_number(:P21_PARTY_ID), -1)
                   and p.party_type = :P21_PARTY_TYPE
                   and :P21_PARTY_NAME is not null
                   and (   (p.registration_number is not null
                            and upper(replace(p.registration_number, ' ')) = upper(replace(:P21_REGISTRATION_NUMBER, ' ')))
                        or xxcmp_kyc_pkg.name_similarity(p.party_name, :P21_PARTY_NAME) >= 85)
                 order by xxcmp_kyc_pkg.name_similarity(p.party_name, :P21_PARTY_NAME) desc
                 fetch first 10 rows only
                ```
            pageItemsToSubmit: [
                P21_PARTY_ID
                P21_PARTY_TYPE
                P21_PARTY_NAME
                P21_REGISTRATION_NUMBER
            ]
        }
        layout {
            sequence: 25
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: matches
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 10
        }
        messages {
            whenNoDataFound: No similar parties found.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_NUMBER (
            type: link
            heading {
                heading: Number
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 21
                    items: {
                        P21_PARTY_ID: #PARTY_ID#
                    }
                    clearCache: 21
                }
                linkText: #PARTY_NUMBER#
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration No.
            }
            layout {
                sequence: 40
            }
        )

        column JURISDICTION (
            type: plainText
            heading {
                heading: Jurisdiction
            }
            layout {
                sequence: 50
            }
        )

        column MATCH_REASON (
            type: plainText
            heading {
                heading: Why It Matches
            }
            layout {
                sequence: 60
            }
        )

    )

