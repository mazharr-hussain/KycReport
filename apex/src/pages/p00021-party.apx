page 21 (
    name: Party
    alias: PARTY
    title: Party
    pageGroup: @parties
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```
            Maintain one party: identity, additional information, contacts, ownership and documents. Possible matches are shown while you type so duplicates are caught before saving.
            ```
    }

    region breadcrumb (
        name: Party
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region party (
        name: Party Details
        type: form
        source {
            location: localDatabase
            type: tableView
