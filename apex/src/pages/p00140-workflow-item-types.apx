page 140 (
    name: Workflow Item Types
    alias: WORKFLOW-ITEM-TYPES
    title: Workflow Item Types
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Workflow Item Types
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Workflow Item Types
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 141, p_items => 'P141_ITEM_TYPE', p_values => to_char(q.item_type), p_clear_cache => '141') as open_url
                  from (

                            select t.item_type, t.item_type_name, t.entity_name, t.application_code, t.description
                              from xxfnd_wf_item_types t
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column ITEM_TYPE (
            type: plainText
            heading {
                heading: Item Type
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#ITEM_TYPE#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column ITEM_TYPE_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ENTITY_NAME (
            type: plainText
            heading {
                heading: Entity
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Item Type
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 141
                clearCache: 141
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
