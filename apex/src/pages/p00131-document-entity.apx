page 131 (
    name: Document Entity
    alias: DOCUMENT-ENTITY
    title: Document Entity
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Register a table so its rows can carry attachments.
    }

    region form (
        name: Document Entity
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_DOCUMENT_ENTITIES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P131_ENTITY_NAME (
        type: textField
        label {
            label: Entity Name
            alignment: left
        }
        layout {
            sequence: 1
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 60
        }
        source {
            formRegion: @form
            column: ENTITY_NAME
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P131_SAVED = 'Y'
                ```
        }
        help {
            inlineHelpText: Upper case, no spaces. Cannot be changed once saved.
        }
    )

    pageItem P131_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P131_SAVED
                  from XXFND_DOCUMENT_ENTITIES
                 where ENTITY_NAME = :P131_ENTITY_NAME;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P131_USER_ENTITY_NAME (
        type: textField
        label {
            label: Display Name
            alignment: left
        }
        layout {
            sequence: 5
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 240
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select user_entity_name from xxfnd_document_entities_tl where entity_name = :P131_ENTITY_NAME and language_code = 'en'
                ```
            used: always
        }
        help {
            helpText: Enter the display Name.
        }
    )

    pageItem P131_APPLICATION_CODE (
        type: textField
        label {
            label: Application Code
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: KYC
        }
        help {
            helpText: Enter the application Code.
        }
    )

    pageItem P131_TABLE_NAME (
        type: textField
        label {
            label: Table
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 128
        }
        source {
            formRegion: @form
            column: TABLE_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the table.
        }
    )

    pageItem P131_PK1_COLUMN (
        type: textField
        label {
            label: Key Column 1
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 128
        }
        source {
            formRegion: @form
            column: PK1_COLUMN
            dataType: varchar2
        }
        help {
            helpText: Enter the key Column 1.
        }
    )

    pageItem P131_PK2_COLUMN (
        type: textField
        label {
            label: Key Column 2
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 128
        }
        source {
            formRegion: @form
            column: PK2_COLUMN
            dataType: varchar2
        }
        help {
            helpText: Enter the key Column 2.
        }
    )

    pageItem P131_PK3_COLUMN (
        type: textField
        label {
            label: Key Column 3
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 128
        }
        source {
            formRegion: @form
            column: PK3_COLUMN
            dataType: varchar2
        }
        help {
            helpText: Enter the key Column 3.
        }
    )

    pageItem P131_PK4_COLUMN (
        type: textField
        label {
            label: Key Column 4
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 128
        }
        source {
            formRegion: @form
            column: PK4_COLUMN
            dataType: varchar2
        }
        help {
            helpText: Enter the key Column 4.
        }
    )

    pageItem P131_PK5_COLUMN (
        type: textField
        label {
            label: Key Column 5
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 128
        }
        source {
            formRegion: @form
            column: PK5_COLUMN
            dataType: varchar2
        }
        help {
            helpText: Enter the key Column 5.
        }
    )

    pageItem P131_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Choose the enabled.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P131_SAVED
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P131_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P131_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process save-name (
        name: Save display name
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                merge into xxfnd_document_entities_tl t
                using (select :P131_ENTITY_NAME entity_name, 'en' language_code from dual) s
                   on (t.entity_name = s.entity_name and t.language_code = s.language_code)
                 when matched then update set t.user_entity_name = :P131_USER_ENTITY_NAME
                 when not matched then insert (entity_name, language_code, user_entity_name)
                                       values (s.entity_name, 'en', :P131_USER_ENTITY_NAME);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
