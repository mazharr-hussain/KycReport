page 104 (
    name: Employee
    alias: EMPLOYEE
    title: Employee
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: onlyForSuccess
    }
    help {
        helpText: Fusion-sourced people are read-only except for access; local people are fully editable.
    }

    region breadcrumb (
        name: Employee
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Employee
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_EMPLOYEES
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    pageItem P104_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: EMPLOYEE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P104_SOURCE_TYPE (
        type: selectList
        label {
            label: Source
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-employee-source
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: SOURCE_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: LOCAL
        }
        readOnly {
            type: always
        }
        help {
            helpText: Choose the source.
        }
    )

    pageItem P104_USER_NAME (
        type: textField
        label {
            label: User Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @form
            column: USER_NAME
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_SOURCE_TYPE = 'FUSION'
                ```
        }
        help {
            inlineHelpText: The sign-in name, usually the work email.
        }
    )

    pageItem P104_FULL_NAME (
        type: textField
        label {
            label: Full Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 240
        }
        source {
            formRegion: @form
            column: FULL_NAME
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_SOURCE_TYPE = 'FUSION'
                ```
        }
        help {
            helpText: Enter the full Name.
        }
    )

    pageItem P104_EMAIL_ADDRESS (
        type: textField
        label {
            label: Email
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 320
        }
        source {
            formRegion: @form
            column: EMAIL_ADDRESS
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_SOURCE_TYPE = 'FUSION'
                ```
        }
        help {
            helpText: Enter the email.
        }
    )

    pageItem P104_DEPARTMENT_NAME (
        type: textField
        label {
            label: Department
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 240
        }
        source {
            formRegion: @form
            column: DEPARTMENT_NAME
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_SOURCE_TYPE = 'FUSION'
                ```
        }
        help {
            helpText: Enter the department.
        }
    )

    pageItem P104_JOB_TITLE (
        type: textField
        label {
            label: Job Title
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 240
        }
        source {
            formRegion: @form
            column: JOB_TITLE
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_SOURCE_TYPE = 'FUSION'
                ```
        }
        help {
            helpText: Enter the job Title.
        }
    )

    pageItem P104_FUSION_PERSON_NUMBER (
        type: displayOnly
        label {
            label: Fusion Person Number
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: FUSION_PERSON_NUMBER
            dataType: varchar2
        }
    )

    pageItem P104_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Choose the enabled.
        }
    )

    pageItem P104_START_DATE_ACTIVE (
        type: datePicker
        label {
            label: Active From
            alignment: left
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: START_DATE_ACTIVE
            dataType: date
        }
        help {
            helpText: Choose the active From.
        }
    )

    pageItem P104_END_DATE_ACTIVE (
        type: datePicker
        label {
            label: Active To
            alignment: left
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: END_DATE_ACTIVE
            dataType: date
        }
        help {
            helpText: Choose the active To.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @form
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 103
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @form
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P104_EMPLOYEE_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @form
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_EMPLOYEE_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    region roles (
        name: Roles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ur.user_role_id, ur.employee_id, ur.role_code, ur.start_date_active, ur.end_date_active,
                       ur.enabled_flag
                  from xxfnd_user_roles ur
                 where ur.employee_id = :P104_EMPLOYEE_ID
                ```
            pageItemsToSubmit: P104_EMPLOYEE_ID
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: roles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No data found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_EMPLOYEE_ID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column USER_ROLE_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: USER_ROLE_ID
                dataType: number
                primaryKey: true
            }
        )

        column EMPLOYEE_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: EMPLOYEE_ID
                dataType: number
            }
            default {
                type: item
                item: P104_EMPLOYEE_ID
            }
        )

        column ROLE_CODE (
            type: selectList
            heading {
                heading: Role
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @lov-roles
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: ROLE_CODE
                dataType: varchar2
            }
        )

        column START_DATE_ACTIVE (
            type: datePicker
            heading {
                heading: From
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: START_DATE_ACTIVE
                dataType: date
            }
        )

        column END_DATE_ACTIVE (
            type: datePicker
            heading {
                heading: To
            }
            layout {
                sequence: 60
            }
            source {
                type: databaseColumn
                databaseColumn: END_DATE_ACTIVE
                dataType: date
            }
        )

        column ENABLED_FLAG (
            type: switch
            heading {
                heading: Enabled
            }
            layout {
                sequence: 70
            }
            source {
                type: databaseColumn
                databaseColumn: ENABLED_FLAG
                dataType: varchar2
            }
            default {
                type: static
                staticValue: Y
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-roles (
        name: Save roles
        type: interactiveGridAutoRowProcessing
        editableRegion: @roles
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
