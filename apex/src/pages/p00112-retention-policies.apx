page 112 (
    name: Retention Policies
    alias: RETENTION-POLICIES
    title: Retention Policies
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Retention Policies
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Retention Policies
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 113, p_items => 'P113_RETENTION_POLICY_ID', p_values => to_char(q.retention_policy_id), p_clear_cache => '113') as open_url
                  from (

                            select r.retention_policy_id, r.table_name,
                                   nvl(xxfnd_util_pkg.lookup_meaning('JURISDICTION', r.jurisdiction), 'All') as jurisdiction,
                                   r.retention_years,
                                   xxfnd_util_pkg.lookup_meaning('RETENTION_ACTION', r.action_at_expiry) as action_at_expiry,
                                   r.enabled_flag
                              from xxfnd_retention_policies r
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column RETENTION_POLICY_ID (
            type: hidden
            heading {
                heading: Retention Policy Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column TABLE_NAME (
            type: plainText
            heading {
                heading: Table
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#TABLE_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column JURISDICTION (
            type: plainText
            heading {
                heading: Jurisdiction
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column RETENTION_YEARS (
            type: plainText
            heading {
                heading: Years
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column ACTION_AT_EXPIRY (
            type: plainText
            heading {
                heading: At Expiry
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Policy
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 113
                clearCache: 113
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
