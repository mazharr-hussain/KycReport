page 201 (
    name: Create Request - Counterparty
    alias: CREATE-REQUEST
    title: Create Request - Counterparty
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Step 1 of 3: who is the counterparty. The request is saved as a draft; you can come back to it from KYC Requests.
            ```
    }

    region breadcrumb (
        name: Create Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Create Request
        type: list
        source {
            list: @request-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region counterparty (
        name: Counterparty
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: counterparty
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P201_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @counterparty
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_PARTY_TYPE (
        type: radioGroup
        label {
            label: Counterparty Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'PARTY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
        }
        layout {
            sequence: 10
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: ORGANIZATION
        }
        help {
            helpText: An organisation (company, trust, government entity) or an individual.
        }
    )

    pageItem P201_PARTY_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 360
        }
        help {
            helpText: Legal name of the organisation, or full name of the individual.
        }
    )

    pageItem P201_REGISTRATION_NUMBER (
        type: textField
        label {
            label: Registration Number
            alignment: left
        }
        layout {
            sequence: 30
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        help {
            helpText: Organisations: commercial registration or company number.
        }
    )

    pageItem P201_ENTITY_TYPE (
        type: selectList
        label {
            label: Entity Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'ENTITY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Organisations: legal form.
        }
    )

    pageItem P201_JURISDICTION (
        type: selectList
        label {
            label: Jurisdiction
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 50
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Country of incorporation, or of residence for an individual.
        }
    )

    pageItem P201_DATE_OF_BIRTH (
        type: datePicker
        label {
            label: Date of Birth
            alignment: left
        }
        layout {
            sequence: 60
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Individuals only.
        }
    )

    pageItem P201_NATIONALITY (
        type: selectList
        label {
            label: Nationality
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 70
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Individuals only.
        }
    )

    pageItem P201_REQUESTING_DEPARTMENT (
        type: selectList
        label {
            label: Requesting Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'REQUESTING_DEPARTMENT' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 80
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P201_JUSTIFICATION (
        type: textarea
        label {
            label: Business Purpose
            alignment: left
        }
        layout {
            sequence: 90
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 4000
        }
        help {
            helpText: Why the organisation wants to deal with this counterparty.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process load-request (
        name: Load draft
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select party_type, party_name, registration_number, entity_type, jurisdiction,
                       date_of_birth, nationality, requesting_department, justification
                  into :P201_PARTY_TYPE, :P201_PARTY_NAME, :P201_REGISTRATION_NUMBER, :P201_ENTITY_TYPE, :P201_JURISDICTION,
                       :P201_DATE_OF_BIRTH, :P201_NATIONALITY, :P201_REQUESTING_DEPARTMENT, :P201_JUSTIFICATION
                  from xxcmp_requests
                 where request_id = :P201_REQUEST_ID and request_status = 'DRAFT';
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_REQUEST_ID
        }
    )

    process save-request (
        name: Save counterparty
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                if :P201_REQUEST_ID is null then
                    :P201_REQUEST_ID := xxcmp_request_pkg.create_request(
                        p_party_type            => :P201_PARTY_TYPE,
                        p_party_name            => :P201_PARTY_NAME,
                        p_registration_number   => :P201_REGISTRATION_NUMBER,
                        p_jurisdiction          => :P201_JURISDICTION,
                        p_entity_type           => :P201_ENTITY_TYPE,
                        p_date_of_birth         => to_date(:P201_DATE_OF_BIRTH),
                        p_nationality           => :P201_NATIONALITY,
                        p_requesting_department => :P201_REQUESTING_DEPARTMENT,
                        p_justification         => :P201_JUSTIFICATION);
                else
                    update xxcmp_requests
                       set party_type = :P201_PARTY_TYPE, party_name = :P201_PARTY_NAME,
                           registration_number = :P201_REGISTRATION_NUMBER, entity_type = :P201_ENTITY_TYPE,
                           jurisdiction = :P201_JURISDICTION, date_of_birth = to_date(:P201_DATE_OF_BIRTH),
                           nationality = :P201_NATIONALITY, requesting_department = :P201_REQUESTING_DEPARTMENT,
                           justification = :P201_JUSTIFICATION
                     where request_id = :P201_REQUEST_ID and request_status = 'DRAFT';
                end if;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: To questionnaire
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 202
                items: {
                    P202_REQUEST_ID: &P201_REQUEST_ID.
                }
                clearCache: 202
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
