page 202 (
    name: Create Request - Questionnaire
    alias: CREATE-REQUEST-QUESTIONNAIRE
    title: Create Request - Questionnaire
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Step 2 of 3: answer every question. The answers decide whether a KYC review is needed.
            ```
    }

    region breadcrumb (
        name: Create Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Create Request
        type: list
        source {
            list: @request-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P202_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @buttons
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    region answers (
        name: Questionnaire
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.answer_id,
                       a.question_id,
                       (select q.display_sequence from xxcmp_questions q where q.question_id = a.question_id) as display_sequence,
                       (select q.section_name from xxcmp_questions q where q.question_id = a.question_id) as section_name,
                       (select q.question_text from xxcmp_questions q where q.question_id = a.question_id) as question_text,
                       (select case q.required_flag when 'Y' then 'Required' end from xxcmp_questions q where q.question_id = a.question_id) as required,
                       a.answer_option_id,
                       a.answer_text
                  from xxcmp_request_answers a
                 where a.request_id = :P202_REQUEST_ID
                   and a.respondent_type = 'REQUESTER'
                ```
            pageItemsToSubmit: P202_REQUEST_ID
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: answers
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: This questionnaire has no questions.
        }
        toolbar {
            controls: [
                searchField
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @SECTION_NAME
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @QUESTION_TEXT
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @REQUIRED
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ANSWER_OPTION_ID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ANSWER_TEXT
                layout {
                    sequence: 5
                }
            )
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column ANSWER_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_ID
                dataType: number
                primaryKey: true
            }
        )

        column QUESTION_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_ID
                dataType: number
            }
        )

        column DISPLAY_SEQUENCE (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: DISPLAY_SEQUENCE
                dataType: number
                queryOnly: true
            }
        )

        column SECTION_NAME (
            type: displayOnly
            heading {
                heading: Section
            }
            layout {
                sequence: 40
            }
            source {
                type: databaseColumn
                databaseColumn: SECTION_NAME
                dataType: varchar2
                queryOnly: true
            }
        )

        column QUESTION_TEXT (
            type: displayOnly
            heading {
                heading: Question
            }
            layout {
                sequence: 50
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_TEXT
                dataType: varchar2
                queryOnly: true
            }
        )

        column REQUIRED (
            type: displayOnly
            heading {
                heading: Required
            }
            layout {
                sequence: 60
            }
            source {
                type: databaseColumn
                databaseColumn: REQUIRED
                dataType: varchar2
                queryOnly: true
            }
        )

        column ANSWER_OPTION_ID (
            type: selectList
            heading {
                heading: Answer
            }
            layout {
                sequence: 70
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select answer_label as display_value, answer_option_id as return_value
                      from xxcmp_answer_options
                     where question_id = :QUESTION_ID
                       and approval_status = 'APPROVED'
                       and enabled_flag = 'Y'
                     order by display_sequence
                    ```
                displayNullValue: true
                nullDisplayValue: - Select -
            }
            cascadingLov {
                parentColumns: QUESTION_ID
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_OPTION_ID
                dataType: number
            }
        )

        column ANSWER_TEXT (
            type: textField
            heading {
                heading: Comment / Free-text Answer
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 4000
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_TEXT
                dataType: varchar2
            }
        )

    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 10
            region: @buttons
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                items: {
                    P201_REQUEST_ID: &P202_REQUEST_ID.
                }
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process save-answers (
        name: Save answers
        type: interactiveGridAutoRowProcessing
        editableRegion: @answers
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: To review
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 203
                items: {
                    P203_REQUEST_ID: &P202_REQUEST_ID.
                }
                clearCache: 203
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
