page 10021 (
    name: Feature
    alias: FEATURE
    title: Feature
    pageGroup: @features
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @feature-configuration
    }
    help {
        helpText: Include shows the feature; Exclude hides it everywhere.
    }

    region feature (
        name: Feature
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: feature
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10021_BUILD_OPTION_ID (
        type: hidden
        layout {
            sequence: 1
            region: @feature
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10021_NAME (
        type: displayOnly
        label {
            label: Feature
            alignment: left
        }
        layout {
            sequence: 10
            region: @feature
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select build_option_name from apex_application_build_options
                 where application_id = :APP_ID and build_option_id = :P10021_BUILD_OPTION_ID
                ```
            used: always
        }
    )

    pageItem P10021_STATUS (
        type: radioGroup
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Include' as display_value, 'INCLUDE' as return_value from dual union all
                select 'Exclude', 'EXCLUDE' from dual
                ```
        }
        layout {
            sequence: 20
            region: @feature
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select upper(build_option_status) from apex_application_build_options
                 where application_id = :APP_ID and build_option_id = :P10021_BUILD_OPTION_ID
                ```
            used: always
        }
        help {
            helpText: Choose the status.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Apply
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process set-status (
        name: Set feature status
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_util.set_build_option_status(
                    p_application_id => :APP_ID,
                    p_id             => :P10021_BUILD_OPTION_ID,
                    p_build_status   => :P10021_STATUS);
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Feature updated.
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

)
