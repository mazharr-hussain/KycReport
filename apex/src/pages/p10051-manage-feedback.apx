page 10051 (
    name: Manage Feedback
    alias: MANAGE-FEEDBACK
    title: Manage Feedback
    pageGroup: @features
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @feature-feedback
    }
    help {
        helpText: Feedback submitted by users.
    }

    region breadcrumb (
        name: Manage Feedback
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Manage Feedback
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 10052, p_items => 'P10052_FEEDBACK_ID', p_values => to_char(q.feedback_id), p_clear_cache => '10052') as open_url
                  from (

                            select f.feedback_id,
                                   f.page_id,
                                   f.page_name,
                                   f.feedback,
                                   f.feedback_type,
                                   f.feedback_status
                              from apex_team_feedback f
                             where f.application_id = :APP_ID
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column FEEDBACK_ID (
            type: hidden
            heading {
                heading: Feedback Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column PAGE_ID (
            type: plainText
            heading {
                heading: Page
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#PAGE_ID#</a>
                    ```
            }
            source {
                dataType: NUMBER
            }
        )

        column PAGE_NAME (
            type: plainText
            heading {
                heading: Page Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column FEEDBACK (
            type: plainText
            heading {
                heading: Feedback
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column FEEDBACK_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column FEEDBACK_STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-feedback (
        name: Refresh after follow-up
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-feedback-go (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
