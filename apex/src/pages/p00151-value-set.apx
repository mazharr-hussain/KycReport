page 151 (
    name: Value Set
    alias: VALUE-SET
    title: Value Set
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: How a segment is validated.
    }

    region form (
        name: Value Set
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_VALUE_SETS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P151_VALUE_SET_CODE (
        type: textField
        label {
            label: Value Set Code
            alignment: left
        }
        layout {
            sequence: 1
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 60
        }
        source {
            formRegion: @form
            column: VALUE_SET_CODE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P151_SAVED = 'Y'
                ```
        }
        help {
            inlineHelpText: Upper case, no spaces. Cannot be changed once saved.
        }
    )

    pageItem P151_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P151_SAVED
                  from XXFND_VALUE_SETS
                 where VALUE_SET_CODE = :P151_VALUE_SET_CODE;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P151_VALUE_SET_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 240
        }
        source {
            formRegion: @form
            column: VALUE_SET_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the name.
        }
    )

    pageItem P151_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Enter the description.
        }
    )

    pageItem P151_VALIDATION_TYPE (
        type: selectList
        label {
            label: Validation
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-vs-validation-type
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: VALIDATION_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: NONE
        }
        help {
            helpText: Choose the validation.
        }
    )

    pageItem P151_FORMAT_TYPE (
        type: selectList
        label {
            label: Format
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-vs-format-type
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: FORMAT_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: CHAR
        }
        help {
            helpText: Choose the format.
        }
    )

    pageItem P151_MAXIMUM_SIZE (
        type: numberField
        label {
            label: Maximum Size
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: MAXIMUM_SIZE
            dataType: number
        }
        help {
            helpText: Enter the maximum Size.
        }
    )

    pageItem P151_NUMBER_PRECISION (
        type: numberField
        label {
            label: Decimal Places
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: NUMBER_PRECISION
            dataType: number
        }
        help {
            helpText: Enter the decimal Places.
        }
    )

    pageItem P151_MINIMUM_VALUE (
        type: textField
        label {
            label: Minimum Value
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 150
        }
        source {
            formRegion: @form
            column: MINIMUM_VALUE
            dataType: varchar2
        }
        help {
            helpText: Enter the minimum Value.
        }
    )

    pageItem P151_MAXIMUM_VALUE (
        type: textField
        label {
            label: Maximum Value
            alignment: left
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 150
        }
        source {
            formRegion: @form
            column: MAXIMUM_VALUE
            dataType: varchar2
        }
        help {
            helpText: Enter the maximum Value.
        }
    )

    pageItem P151_UPPERCASE_ONLY_FLAG (
        type: switch
        label {
            label: Upper Case Only
            alignment: left
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: UPPERCASE_ONLY_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        help {
            helpText: Choose the upper Case Only.
        }
    )

    pageItem P151_LOOKUP_TYPE (
        type: selectList
        label {
            label: Lookup Type
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-lookup-types
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: LOOKUP_TYPE
            dataType: varchar2
        }
        help {
            helpText: Independent and dependent value sets take their values from this lookup type.
        }
    )

    pageItem P151_PARENT_VALUE_SET_CODE (
        type: selectList
        label {
            label: Parent Value Set
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-value-sets
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 110
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: PARENT_VALUE_SET_CODE
            dataType: varchar2
        }
        help {
            helpText:
                ```
                Dependent only: values are filtered by the parent's value through the lookup parent columns.
                ```
        }
    )

    pageItem P151_TABLE_QUERY (
        type: textarea
        label {
            label: Table Query
            alignment: left
        }
        layout {
            sequence: 120
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 6
        }
        source {
            formRegion: @form
            column: TABLE_QUERY
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
        help {
            helpText:
                ```
                Table validation only. Must return RETURN_VALUE and DISPLAY_VALUE; may use :CONTEXT_CODE once.
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P151_SAVED
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P151_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P151_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
