page 143 (
    name: Workflow Process
    alias: WORKFLOW-PROCESS
    title: Workflow Process
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: onlyForSuccess
    }
    help {
        helpText: Steps, the transitions between them, and KYC-specific step controls for one process version. Save the steps before adding transitions that use them.
    }

    region breadcrumb (
        name: Workflow Process
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Process Version
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_WF_PROCESSES
            includeRowidColumn: true
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    pageItem P143_ROWID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ROWID
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P143_ITEM_TYPE (
        type: selectList
        label {
            label: Item Type
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-item-types
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ITEM_TYPE
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P143_ROWID is not null
                ```
        }
        help {
            helpText: Choose the item Type.
        }
    )

    pageItem P143_PROCESS_CODE (
        type: textField
        label {
            label: Process Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @form
            column: PROCESS_CODE
            dataType: varchar2
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P143_ROWID is not null
                ```
        }
        help {
            helpText: Enter the process Code.
        }
    )

    pageItem P143_VERSION_NUMBER (
        type: numberField
        label {
            label: Version
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: VERSION_NUMBER
            dataType: number
        }
        default {
            type: static
            staticValue: 1
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P143_ROWID is not null
                ```
        }
        help {
            helpText: Enter the version.
        }
    )

    pageItem P143_PROCESS_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 240
        }
        source {
            formRegion: @form
            column: PROCESS_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the name.
        }
    )

    pageItem P143_ACTIVE_FLAG (
        type: displayOnly
        label {
            label: Active
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: ACTIVE_FLAG
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P143_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Enter the description.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @form
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 142
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @form
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P143_ROWID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @form
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_ROWID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button activate (
        buttonName: ACTIVATE
        label: Make Active Version
        layout {
            sequence: 40
            region: @form
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: New items will use this version. Running items keep their version.
            style: warning
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P143_ROWID is not null and nvl(:P143_ACTIVE_FLAG, 'N') = 'N'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    region activities (
        name: Steps
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.activity_id, a.item_type, a.process_code, a.version_number, a.activity_code, a.activity_name,
                       a.activity_type, a.performer_role_code, a.notification_template_code, a.timeout_hours,
                       a.start_flag, a.end_flag, a.display_sequence
                  from xxfnd_wf_activities a
                 where a.item_type = :P143_ITEM_TYPE and process_code = :P143_PROCESS_CODE
                       and version_number = to_number(:P143_VERSION_NUMBER)
                ```
            pageItemsToSubmit: [
                P143_ITEM_TYPE
                P143_PROCESS_CODE
                P143_VERSION_NUMBER
            ]
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: activities
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No data found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_ROWID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column ACTIVITY_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: ACTIVITY_ID
                dataType: number
                primaryKey: true
            }
        )

        column ITEM_TYPE (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: ITEM_TYPE
                dataType: varchar2
            }
            default {
                type: item
                item: P143_ITEM_TYPE
            }
        )

        column PROCESS_CODE (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                type: databaseColumn
                databaseColumn: PROCESS_CODE
                dataType: varchar2
            }
            default {
                type: item
                item: P143_PROCESS_CODE
            }
        )

        column VERSION_NUMBER (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                type: databaseColumn
                databaseColumn: VERSION_NUMBER
                dataType: number
            }
            default {
                type: item
                item: P143_VERSION_NUMBER
            }
        )

        column ACTIVITY_CODE (
            type: textField
            heading {
                heading: Code
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                type: databaseColumn
                databaseColumn: ACTIVITY_CODE
                dataType: varchar2
            }
        )

        column ACTIVITY_NAME (
            type: textField
            heading {
                heading: Name
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
                maxLength: 240
            }
            source {
                type: databaseColumn
                databaseColumn: ACTIVITY_NAME
                dataType: varchar2
            }
        )

        column ACTIVITY_TYPE (
            type: selectList
            heading {
                heading: Type
            }
            layout {
                sequence: 80
            }
            lov {
                type: sharedComponent
                lov: @lov-wf-activity-type
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: ACTIVITY_TYPE
                dataType: varchar2
            }
        )

        column PERFORMER_ROLE_CODE (
            type: selectList
            heading {
                heading: Performer Role
            }
            layout {
                sequence: 90
            }
            lov {
                type: sharedComponent
                lov: @lov-roles
            }
            source {
                type: databaseColumn
                databaseColumn: PERFORMER_ROLE_CODE
                dataType: varchar2
            }
        )

        column NOTIFICATION_TEMPLATE_CODE (
            type: selectList
            heading {
                heading: Notification
            }
            layout {
                sequence: 100
            }
            lov {
                type: sharedComponent
                lov: @lov-templates
            }
            source {
                type: databaseColumn
                databaseColumn: NOTIFICATION_TEMPLATE_CODE
                dataType: varchar2
            }
        )

        column TIMEOUT_HOURS (
            type: numberField
            heading {
                heading: Timeout Hours
            }
            layout {
                sequence: 110
            }
            source {
                type: databaseColumn
                databaseColumn: TIMEOUT_HOURS
                dataType: number
            }
        )

        column START_FLAG (
            type: switch
            heading {
                heading: Start
            }
            layout {
                sequence: 120
            }
            source {
                type: databaseColumn
                databaseColumn: START_FLAG
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
        )

        column END_FLAG (
            type: switch
            heading {
                heading: End
            }
            layout {
                sequence: 130
            }
            source {
                type: databaseColumn
                databaseColumn: END_FLAG
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
        )

        column DISPLAY_SEQUENCE (
            type: numberField
            heading {
                heading: Sequence
            }
            layout {
                sequence: 140
            }
            source {
                type: databaseColumn
                databaseColumn: DISPLAY_SEQUENCE
                dataType: number
            }
        )

    )

    region transitions (
        name: Transitions
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.transition_id, t.from_activity_id, t.result_code, t.to_activity_id
                  from xxfnd_wf_transitions t
                 where t.from_activity_id in (select a.activity_id from xxfnd_wf_activities a where a.item_type = :P143_ITEM_TYPE and process_code = :P143_PROCESS_CODE
                       and version_number = to_number(:P143_VERSION_NUMBER))
                ```
            pageItemsToSubmit: [
                P143_ITEM_TYPE
                P143_PROCESS_CODE
                P143_VERSION_NUMBER
            ]
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: transitions
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No data found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_ROWID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column TRANSITION_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: TRANSITION_ID
                dataType: number
                primaryKey: true
            }
        )

        column FROM_ACTIVITY_ID (
            type: selectList
            heading {
                heading: From Step
            }
            layout {
                sequence: 30
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select activity_name as display_value, activity_id as return_value
                      from xxfnd_wf_activities where item_type = :P143_ITEM_TYPE and process_code = :P143_PROCESS_CODE
                       and version_number = to_number(:P143_VERSION_NUMBER) order by display_sequence
                    ```
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: FROM_ACTIVITY_ID
                dataType: number
            }
        )

        column RESULT_CODE (
            type: selectList
            heading {
                heading: Result
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @lov-wf-result
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: RESULT_CODE
                dataType: varchar2
            }
        )

        column TO_ACTIVITY_ID (
            type: selectList
            heading {
                heading: To Step
            }
            layout {
                sequence: 50
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select activity_name as display_value, activity_id as return_value
                      from xxfnd_wf_activities where item_type = :P143_ITEM_TYPE and process_code = :P143_PROCESS_CODE
                       and version_number = to_number(:P143_VERSION_NUMBER) order by display_sequence
                    ```
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: TO_ACTIVITY_ID
                dataType: number
            }
        )

    )

    region controls (
        name: KYC Step Controls
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.activity_id, c.requires_sar_assessment_flag
                  from xxcmp_wf_activity_controls c
                 where c.activity_id in (select a.activity_id from xxfnd_wf_activities a where a.item_type = :P143_ITEM_TYPE and process_code = :P143_PROCESS_CODE
                       and version_number = to_number(:P143_VERSION_NUMBER))
                ```
            pageItemsToSubmit: [
                P143_ITEM_TYPE
                P143_PROCESS_CODE
                P143_VERSION_NUMBER
            ]
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: controls
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No data found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P143_ROWID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column ACTIVITY_ID (
            type: selectList
            heading {
                heading: Step
            }
            layout {
                sequence: 20
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select activity_name as display_value, activity_id as return_value
                      from xxfnd_wf_activities where item_type = :P143_ITEM_TYPE and process_code = :P143_PROCESS_CODE
                       and version_number = to_number(:P143_VERSION_NUMBER) order by display_sequence
                    ```
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: ACTIVITY_ID
                dataType: number
                primaryKey: true
            }
        )

        column REQUIRES_SAR_ASSESSMENT_FLAG (
            type: switch
            heading {
                heading: Requires SAR Assessment
            }
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: REQUIRES_SAR_ASSESSMENT_FLAG
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-activities (
        name: Save activities
        type: interactiveGridAutoRowProcessing
        editableRegion: @activities
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-transitions (
        name: Save transitions
        type: interactiveGridAutoRowProcessing
        editableRegion: @transitions
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-controls (
        name: Save controls
        type: interactiveGridAutoRowProcessing
        editableRegion: @controls
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process activate-version (
        name: Activate version
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_wf_pkg.activate_version(:P143_ITEM_TYPE, :P143_PROCESS_CODE, to_number(:P143_VERSION_NUMBER));
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        successMessage {
            successMessage: This version is now active.
        }
        serverSideCondition {
            whenButtonPressed: @activate
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
