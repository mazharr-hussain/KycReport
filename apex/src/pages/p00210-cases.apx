page 210 (
    name: Cases
    alias: CASES
    title: Cases
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The Compliance case workbench: open cases with their SLA status, and closed cases with their next review. Cases are opened when a request passes the document checklist, by a periodic review, or here with Create Case.
            ```
    }

    region breadcrumb (
        name: Cases
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Cases
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 211, p_items => 'P211_CASE_ID', p_values => to_char(q.case_id), p_clear_cache => '211') as open_url
                  from (
                        select c.case_id,
                               c.case_number,
                               p.party_name,
                               xxfnd_util_pkg.lookup_meaning('CASE_STATUS', c.case_status) as case_status,
                               c.assigned_to,
                               xxfnd_util_pkg.lookup_meaning('RISK_TIER', c.risk_tier) as risk_tier,
                               case when c.enhanced_kyc_flag = 'Y' then 'Enhanced' end as kyc_level,
                               c.sla_due_date,
                               case when c.closed_date is not null then 'Closed'
                                    when c.sla_due_date < trunc(sysdate) then 'Overdue'
                                    when c.sla_due_date <= trunc(sysdate) + 2 then 'Due soon'
                                    else 'On time' end as sla_status,
                               r.request_number,
                               xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type) as request_type,
                               c.next_review_date,
                               c.creation_date
                          from xxcmp_cases c
                          join xxcmp_parties p on p.party_id = c.party_id
                          join xxcmp_requests r on r.request_id = c.request_id
                       ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column CASE_ID (
            type: hidden
            heading {
                heading: Case Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column CASE_NUMBER (
            type: plainText
            heading {
                heading: Case
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#CASE_NUMBER#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column CASE_STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column SLA_STATUS (
            type: plainText
            heading {
                heading: SLA
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column SLA_DUE_DATE (
            type: plainText
            heading {
                heading: SLA Due
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
        )

        column ASSIGNED_TO (
            type: plainText
            heading {
                heading: Assigned To
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column RISK_TIER (
            type: plainText
            heading {
                heading: Risk
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column KYC_LEVEL (
            type: plainText
            heading {
                heading: KYC Level
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column REQUEST_NUMBER (
            type: plainText
            heading {
                heading: Request
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        column REQUEST_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
        )

        column NEXT_REVIEW_DATE (
            type: plainText
            heading {
                heading: Next Review
            }
            layout {
                sequence: 120
            }
            source {
                dataType: DATE
            }
        )

        column CREATION_DATE (
            type: plainText
            heading {
                heading: Opened
            }
            layout {
                sequence: 130
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Case
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 216
                clearCache: 216
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
