page 212 (
    name: Case Decision
    alias: CASE-DECISION
    title: Case Decision
    pageGroup: @kyc
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 900
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Approve or reject one approval level of a case. The investigating officer and earlier approvers cannot decide; a Suspicious Activity Report determination is required where the approval matrix asks for it; every mandatory document must be verified.
            ```
    }

    region decision (
        name: Case Decision
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: decision
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P212_TASK_ID (
        type: hidden
        layout {
            sequence: 1
            region: @decision
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P212_CASE_ID (
        type: hidden
        layout {
            sequence: 2
            region: @decision
            slot: regionBody
        }
    )

    pageItem P212_SAR_GATE (
        type: hidden
        layout {
            sequence: 3
            region: @decision
            slot: regionBody
        }
    )

    pageItem P212_CASE (
        type: displayOnly
        label {
            label: Case
            alignment: left
        }
        layout {
            sequence: 10
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.case_number || ' - ' || p.party_name || ' (' || p.party_number || ')'
                  from xxcmp_cases c join xxcmp_parties p on p.party_id = c.party_id where c.case_id = :P212_CASE_ID
                ```
            used: always
        }
    )

    pageItem P212_LEVEL (
        type: displayOnly
        label {
            label: Approval Level
            alignment: left
        }
        layout {
            sequence: 20
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.current_level || ' of ' || xxcmp_case_pkg.required_levels(c.case_id)
                       || ' - ' || (select role_name from xxfnd_roles where role_code = xxcmp_case_pkg.level_role(c.case_id, c.current_level))
                  from xxcmp_cases c where c.case_id = :P212_CASE_ID
                ```
            used: always
        }
    )

    pageItem P212_RISK (
        type: displayOnly
        label {
            label: Risk
            alignment: left
        }
        layout {
            sequence: 30
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('RISK_TIER', risk_tier)
                       || case when enhanced_kyc_flag = 'Y' then ' - Enhanced KYC' end || case when pep_flag = 'Y' then ' - PEP' end
                  from xxcmp_cases where case_id = :P212_CASE_ID
                ```
            used: always
        }
    )

    pageItem P212_INVESTIGATOR (
        type: displayOnly
        label {
            label: Investigated By
            alignment: left
        }
        layout {
            sequence: 40
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select assigned_to from xxcmp_cases where case_id = :P212_CASE_ID
                ```
            used: always
        }
    )

    pageItem P212_SCREENING (
        type: displayOnly
        label {
            label: Screening
            alignment: left
        }
        layout {
            sequence: 50
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(*) || ' check(s); ' || count(case when match_status = 'CONFIRMED_MATCH' then 1 end) || ' confirmed match(es); '
                       || count(case when pep_flag = 'Y' then 1 end) || ' PEP flag(s)'
                  from xxcmp_screenings where case_id = :P212_CASE_ID
                ```
            used: always
        }
    )

    pageItem P212_READINESS (
        type: displayOnly
        label {
            label: Ready to Approve
            alignment: left
        }
        layout {
            sequence: 60
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(xxcmp_case_pkg.approval_error(:P212_CASE_ID), 'Yes') from dual
                ```
            used: always
        }
    )

    pageItem P212_SAR_REQUIRED_FLAG (
        type: radioGroup
        label {
            label: Suspicious Activity Report Required
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Yes' as display_value, 'Y' as return_value from dual union all select 'No', 'N' from dual
                ```
        }
        layout {
            sequence: 70
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Required before approval for high-risk and Enhanced KYC cases.
        }
    )

    pageItem P212_SAR_NOTES (
        type: textarea
        label {
            label: SAR Notes
            alignment: left
        }
        layout {
            sequence: 80
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P212_CONDITIONS (
        type: textarea
        label {
            label: Conditions of Approval
            alignment: left
        }
        layout {
            sequence: 90
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P212_NEXT_REVIEW_DATE (
        type: datePicker
        label {
            label: Next Review Date
            alignment: left
        }
        layout {
            sequence: 100
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Calculated from the risk tier (sooner for a PEP); change it only with a reason in the comment.
        }
    )

    pageItem P212_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 110
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Recorded with the decision; required when rejecting.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Reject this case?
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                apex_human_task.is_allowed(p_task_id => :P212_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                or apex_human_task.is_allowed(p_task_id => :P212_TASK_ID, p_operation => apex_human_task.c_task_op_claim)
                ```
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                apex_human_task.is_allowed(p_task_id => :P212_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                or apex_human_task.is_allowed(p_task_id => :P212_TASK_ID, p_operation => apex_human_task.c_task_op_claim)
                ```
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load-task (
        name: Load case
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select to_number(detail_pk) into :P212_CASE_ID
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'SINGLE_TASK',
                                   p_task_id        => :P212_TASK_ID,
                                   p_application_id => :APP_ID ) )
                 where task_def_static_id = 'CASE_APPROVAL';
                select sar_required_flag, sar_notes, conditions,
                       to_char(nvl(next_review_date, xxcmp_case_pkg.next_review_date(case_id)), 'DD-MON-YYYY'),
                       xxcmp_case_pkg.sar_gate(case_id)
                  into :P212_SAR_REQUIRED_FLAG, :P212_SAR_NOTES, :P212_CONDITIONS, :P212_NEXT_REVIEW_DATE, :P212_SAR_GATE
                  from xxcmp_cases where case_id = :P212_CASE_ID;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

    validation reject-reason (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P212_COMMENT is null then 'Enter why the case is rejected.' end;
                ```
        }
        error {
            associatedItem: @P212_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT
        }
    )

    validation sar-answered (
        name: SAR determination
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P212_SAR_GATE = 'Y' and :P212_SAR_REQUIRED_FLAG is null then 'Record whether a Suspicious Activity Report is required.' end;
                ```
        }
        error {
            associatedItem: @P212_SAR_REQUIRED_FLAG
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE
        }
    )

    process save-decision-data (
        name: Save SAR, conditions and review date
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                update xxcmp_cases
                   set sar_required_flag = :P212_SAR_REQUIRED_FLAG,
                       sar_notes         = :P212_SAR_NOTES,
                       conditions        = :P212_CONDITIONS,
                       next_review_date  = to_date(:P212_NEXT_REVIEW_DATE, 'DD-MON-YYYY')
                 where case_id = :P212_CASE_ID;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,REJECT
        }
    )

    process check-approval (
        name: Check the case can be approved
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_error varchar2(4000) := xxcmp_case_pkg.approval_error(:P212_CASE_ID);
                begin
                    if l_error is not null then
                        raise_application_error(-20615, l_error);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 15
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
    )

    process add-comment (
        name: Record comment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P212_TASK_ID, p_text => :P212_COMMENT);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P212_COMMENT
        }
    )

    process approve-task (
        name: Approve
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.approve_task(p_task_id => :P212_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Case approved at this level.
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
    )

    process reject-task (
        name: Reject
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P212_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Case rejected.
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,REJECT
        }
    )

)
