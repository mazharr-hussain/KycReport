upgradeScript 00-deployment-framework (
    execution {
        sequence: 5
    }
    script {
        contentFile: 00-deployment-framework.sql
    }
    serverSideCondition {
        type: rowsReturned
        sqlQuery:
            ```sql
            select 1 from all_objects where owner = 'XXFUSION' and object_name = 'XXFND_SHARE_PKG'
               and not exists (select 1 from user_tables
                                where table_name in ('XXFND_LOOKUP_TYPES', 'XXCMP_SHARED_FKS'))
            ```
    }
)

