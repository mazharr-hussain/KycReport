workflow KYC_CASE (
    name: KYC Case
    title: KYC case &APEX$WORKFLOW_DETAIL_PK.
    comments {
        comments: Module 2: investigation by the officer, then one or two approval levels from the approval matrix (risk tier; Enhanced KYC needs two); approval or rejection closes the case and completes the request. Release 73 (version 1.1): with the workflow switched off for the process (COMMON Workflow Processes) the case is auto-approved after the investigation. Release 74 (version 1.2): any number of approval levels from the common Approval Setup (transaction type KYC_CASE, ad-hoc approvers included): the approval task repeats while a level is left.
    }

    version 1.0 (
        settings {
            state: inactive
        }

        activity Start (
            name: Start
            type: workflowStart
            layout {
                sequence: 10
            }
            advanced {
                diagram: {"position":{"x":60,"y":200},"z":10}
            }

            connection (
                name: Investigate
                activity {
                    to: @Investigate
                }
            )

        )

        activity Investigate (
            name: Investigation
            type: humanTaskCreate
            humanTask {
                definition: @CASE_INVESTIGATION
                taskIdItem: V_INVESTIGATION_TASK_ID
                detailsPkItem: APEX$WORKFLOW_DETAIL_PK
            }
            layout {
                sequence: 20
            }
            advanced {
                diagram: {"position":{"x":200,"y":180},"z":20}
            }

            connection (
                name: Submitted
                activity {
                    to: @StartApproval
                }
            )

        )

        activity StartApproval (
            name: Start approval
            type: executeCode
            source {
                plsqlCode: xxcmp_case_pkg.start_approval(:APEX$WORKFLOW_DETAIL_PK);
            }
            layout {
                sequence: 30
            }
            advanced {
                diagram: {"position":{"x":400,"y":180},"z":30}
            }

            connection (
                name: Level 1
                activity {
                    to: @Level1
                }
            )

        )

        activity Level1 (
            name: Approval level 1
            type: humanTaskCreate
            humanTask {
                definition: @CASE_APPROVAL
                taskIdItem: V_LEVEL1_TASK_ID
                detailsPkItem: APEX$WORKFLOW_DETAIL_PK
            }
            result {
                outcome: V_LEVEL1_OUTCOME
                owner: V_LEVEL1_APPROVER
            }
            layout {
                sequence: 40
            }
            advanced {
                diagram: {"position":{"x":600,"y":180},"z":40}
            }

            connection (
                name: Decided
                activity {
                    to: @Level1Outcome
                }
            )

        )

        activity Level1Outcome (
            name: Level 1 approved?
            type: switch
            switch {
                type: checkWorkflowVar
            }
            compare {
                compareVar: V_LEVEL1_OUTCOME
            }
            layout {
                sequence: 50
            }
            advanced {
                diagram: {"position":{"x":800,"y":180},"z":50}
            }

            connection (
                name: Approved
                execution {
                    sequence: 10
                }
                condition {
                    operator: =
                    value: APPROVED
                }
                activity {
                    to: @MoreLevels
                }
            )

            connection (
                name: Rejected
                execution {
                    sequence: 20
                }
                condition {
                    operator: =
                    value: REJECTED
                }
                activity {
                    to: @RejectCase
                }
            )

        )

        activity MoreLevels (
            name: Second level required?
            type: switch
            condition {
                conditionType: functionBody
                plsqlFunctionBody: return xxcmp_case_pkg.has_next_level(:APEX$WORKFLOW_DETAIL_PK) = 'Y';
            }
            layout {
                sequence: 60
            }
            advanced {
                diagram: {"position":{"x":1000,"y":120},"z":60}
            }

            connection (
                name: Yes
                condition {
                    when: true
                }
                activity {
                    to: @Level2
                }
            )

            connection (
                name: No
                condition {
                    when: false
                }
                activity {
                    to: @ApproveCase
                }
            )

        )

        activity Level2 (
            name: Approval level 2
            type: humanTaskCreate
            humanTask {
                definition: @CASE_APPROVAL
                taskIdItem: V_LEVEL2_TASK_ID
                detailsPkItem: APEX$WORKFLOW_DETAIL_PK
            }
            result {
                outcome: V_LEVEL2_OUTCOME
                owner: V_LEVEL2_APPROVER
            }
            layout {
                sequence: 70
            }
            advanced {
                diagram: {"position":{"x":1200,"y":60},"z":70}
            }

            connection (
                name: Decided
                activity {
                    to: @Level2Outcome
                }
            )

        )

        activity Level2Outcome (
            name: Level 2 approved?
            type: switch
            switch {
                type: checkWorkflowVar
            }
            compare {
                compareVar: V_LEVEL2_OUTCOME
            }
            layout {
                sequence: 80
            }
            advanced {
                diagram: {"position":{"x":1400,"y":60},"z":80}
            }

            connection (
                name: Approved
                execution {
                    sequence: 10
                }
                condition {
                    operator: =
                    value: APPROVED
                }
                activity {
                    to: @ApproveCase
                }
            )

            connection (
                name: Rejected
                execution {
                    sequence: 20
                }
                condition {
                    operator: =
                    value: REJECTED
                }
                activity {
                    to: @RejectCase
                }
            )

        )

        activity ApproveCase (
            name: Approve and close case
            type: executeCode
            source {
                plsqlCode: xxcmp_case_pkg.approve_case(:APEX$WORKFLOW_DETAIL_PK);
            }
            layout {
                sequence: 90
            }
            advanced {
                diagram: {"position":{"x":1400,"y":200},"z":90}
            }

            connection (
                name: Done
                activity {
                    to: @End
                }
            )

        )

        activity RejectCase (
            name: Reject and close case
            type: executeCode
            source {
                plsqlCode: xxcmp_case_pkg.reject_case(:APEX$WORKFLOW_DETAIL_PK);
            }
            layout {
                sequence: 100
            }
            advanced {
                diagram: {"position":{"x":1000,"y":320},"z":100}
            }

            connection (
                name: Done
                activity {
                    to: @End
                }
            )

        )

        activity End (
            name: End
            type: workflowEnd
            layout {
                sequence: 110
            }
            advanced {
                diagram: {"position":{"x":1600,"y":200},"z":110}
            }

        )

        variable V_INVESTIGATION_TASK_ID (
            label {
                label: Investigation task
            }
        )

        variable V_LEVEL1_TASK_ID (
            label {
                label: Level 1 task
            }
        )

        variable V_LEVEL1_OUTCOME (
            label {
                label: Level 1 outcome
            }
        )

        variable V_LEVEL1_APPROVER (
            label {
                label: Level 1 approver
            }
        )

        variable V_LEVEL2_TASK_ID (
            label {
                label: Level 2 task
            }
        )

        variable V_LEVEL2_OUTCOME (
            label {
                label: Level 2 outcome
            }
        )

        variable V_LEVEL2_APPROVER (
            label {
                label: Level 2 approver
            }
        )

        participant (
            name: Workflow administrators
            type: admin
            value {
                type: expression
                plsqlExpression: xxfnd_task_pkg.business_admins
            }
        )

    )

