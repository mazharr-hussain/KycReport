appProcess DOWNLOAD_DOCUMENT (
    name: DOWNLOAD_DOCUMENT
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            declare
                l_allowed pls_integer;
            begin
                if xxfnd_privilege_pkg.has_privilege('PARTIES', 'VIEW') or xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                   or xxfnd_privilege_pkg.has_privilege('ATTACHMENTS', 'VIEW') then
                    l_allowed := 1;
                else
                    -- Requesters: only documents on requests for information addressed to them and on
                    -- their own KYC requests (XXCMP_REQUESTS rows are filtered by data security).
                    select count(*)
                      into l_allowed
                      from xxfnd_documents d
                      join xxfnd_attached_documents ad
                        on ad.document_id in (select x.document_id from xxfnd_documents x
                                               where nvl(x.base_document_id, x.document_id)
                                                   = nvl(d.base_document_id, d.document_id))
                     where d.document_id = :G_DOCUMENT_ID
                       and (   (ad.entity_name = 'XXCMP_RFIS'
                                and exists (select 1 from xxfnd_rfis r
                                             where to_char(r.rfi_id) = ad.pk1_value
                                               and upper(r.recipient_user_name) = :APP_USER))
                            or (ad.entity_name = 'XXCMP_REQUESTS'
                                and exists (select 1 from xxcmp_requests q
                                             where to_char(q.request_id) = ad.pk1_value
                                               and xxfnd_privilege_pkg.has_privilege('KYC_REQUESTS', 'VIEW')))
                            -- the party of their own request (party details step and request screens)
                            or (ad.entity_name = 'XXCMP_PARTIES'
                                and exists (select 1 from xxcmp_requests q
                                             where to_char(q.party_id) = ad.pk1_value
                                               and xxfnd_privilege_pkg.has_privilege('KYC_REQUESTS', 'VIEW'))));
                end if;
                if l_allowed = 0 then
                    raise_application_error(-20330, 'You are not allowed to open this document.');
                end if;
                xxfnd_attach_pkg.download(:G_DOCUMENT_ID);
            end;
            ```
    }
    execution {
        sequence: 10
        point: ajaxCallback
    }
    security {
        authorizationScheme: @kyc-user
    }
)

appProcess PARTY_MATCHES (
    name: PARTY_MATCHES
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            -- Similar parties for the party form (Global Page dialog before saving): JSON array, strongest first.
            htp.p(xxcmp_party_pkg.party_candidates_json(apex_application.g_x01, apex_application.g_x02, apex_application.g_x03,
                                                         to_date(apex_application.g_x04), apex_application.g_x05,
                                                         to_number(apex_application.g_x06)));
            ```
    }
    execution {
        sequence: 20
        point: ajaxCallback
    }
    security {
        authorizationScheme: @kyc-user
    }
)

appProcess PERSON_CARD (
    name: PERSON_CARD
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            -- Hover card of an employee for list cells (kyc-app.js kycPerson): x01 = user name; returns the card HTML.
            htp.p(xxfnd_ui_pkg.person_card(apex_application.g_x01));
            ```
    }
    execution {
        sequence: 30
        point: ajaxCallback
    }
    security {
        authorizationScheme: @kyc-user
    }
)
