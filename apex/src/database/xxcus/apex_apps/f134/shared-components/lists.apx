list navigation-bar (
    name: Navigation Bar

    entry feedback (
        label: Feedback
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                type: otherApp
                app: COMMON
                page: 173
                items: {
                    P173_APPLICATION_ID: &APP_ID.
                    P173_PAGE_ID: &APP_PAGE_ID.
                }
                clearCache: 173
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                apex_util.get_build_option_status(p_application_id => :APP_ID, p_build_option_name => 'Feature - Feedback') = 'INCLUDE'
                ```
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry customize (
        label: Customize
        layout {
            sequence: 15
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: #customize-theme
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                apex_util.get_build_option_status(p_application_id => :APP_ID, p_build_option_name => 'Feature - Theme Style Selection') = 'INCLUDE'
                ```
        }
    )

    entry about (
        label: About
        layout {
            sequence: 18
            parentEntry: @app-user
        }
        link {
            target: {
                page: 10010
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                apex_util.get_build_option_status(p_application_id => :APP_ID, p_build_option_name => 'Feature - About Page') = 'INCLUDE'
                ```
        }
    )

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

