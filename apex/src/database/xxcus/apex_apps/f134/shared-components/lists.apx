list admin-basic-setup (
    name: Administration - Basic Setup
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- One entry per feature of this group that the user may open (see XXFND_ADMIN_MENU_V).
            select null                                  as lvl,
                   feature_name                          as label,
                   apex_page.get_url(p_page => home_page_id) as target,
                   'NO'                                  as is_current,
                   icon_css                              as image,
                   null                                  as image_attribute,
                   null                                  as image_alt,
                   description                           as a01
              from xxfnd_admin_menu_v
             where feature_group = 'BASIC_SETUP'
             order by display_sequence
            ```
    }
)

