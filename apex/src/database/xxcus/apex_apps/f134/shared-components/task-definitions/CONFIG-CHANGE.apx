taskDefinition CONFIG_CHANGE (
    name: Configuration Change Approval
    type: approval
    task {
        subject: &CHANGE_TYPE.: &CHANGE_TITLE.
        initiatorCanComplete: false
    }
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- always one row: the task stays manageable after the change is withdrawn or decided
            select nvl(c.change_type, 'Configuration change') as change_type,
                   nvl(c.change_title, :APEX$TASK_PK)         as change_title,
                   c.change_summary,
                   c.submitted_by
              from dual
              left join xxfnd_config_changes_v c on c.detail_pk = :APEX$TASK_PK
            ```
    }
    advanced {
        detailsPage: {
            page: 172
            items: {
                P172_TASK_ID: &TASK_ID.
            }
            clearCache: 172
        }
        vacationRuleProcedureName: xxfnd_workflow_pkg.vacation_rule
    }
    comments {
        comments: Maker-checker for risk scoring answers, mandatory document rules and integration purposes. Created by XXFND_APPROVAL_PKG.REQUEST; the maker cannot approve (initiator cannot complete, and XXFND_APPROVAL_PKG refuses it).
    }

    action notify-owners (
        name: Notify potential owners
        type: executeCode
        source {
            plsqlCode: xxfnd_workflow_pkg.notify_created(:APEX$TASK_ID);
        }
        execution {
            onEvent: create
            sequence: 10
        }
    )

    action apply-change (
        name: Apply the change
        type: executeCode
        source {
            plsqlCode: xxfnd_approval_pkg.approve_change(:APEX$TASK_PK);
        }
        execution {
            onEvent: complete
            outcome: approved
            sequence: 20
        }
    )

    action reject-change (
        name: Reject the change
        type: executeCode
        source {
            plsqlCode: xxfnd_approval_pkg.reject_change(:APEX$TASK_PK, xxfnd_workflow_pkg.last_comment(:APEX$TASK_ID));
        }
        execution {
            onEvent: complete
            outcome: rejected
            sequence: 30
        }
    )

    participant (
        value {
            type: expression
            plsqlExpression: xxfnd_workflow_pkg.users_with_privilege('CHANGE_APPROVALS', 'MANAGE')
        }
    )

    participant (
        type: businessAdministrator
        value {
            type: expression
            plsqlExpression: xxfnd_workflow_pkg.business_admins
        }
    )

)
