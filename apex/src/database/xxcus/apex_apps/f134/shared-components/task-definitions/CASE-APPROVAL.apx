taskDefinition CASE_APPROVAL (
    name: Case Approval
    type: approval
    task {
        subject: Approve &CASE_NUMBER. - &PARTY_NAME. (level &CURRENT_LEVEL.)
        initiatorCanComplete: true
    }
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select nvl(c.case_number, 'Case ' || :APEX$TASK_PK) as case_number, p.party_name, c.current_level, c.risk_tier
              from dual
              left join xxcmp_cases c on c.case_id = to_number(:APEX$TASK_PK)
              left join xxcmp_parties p on p.party_id = c.party_id
            ```
    }
    advanced {
        detailsPage: {
            page: 212
            items: {
                P212_TASK_ID: &TASK_ID.
            }
            clearCache: 212
        }
        vacationRuleProcedureName: xxfnd_task_pkg.vacation_rule
    }
    comments {
        comments: One approval level of a case (approval matrix: risk tier, Enhanced KYC). Participants hold the level role and did not investigate or already decide the case, and have no segregation-of-duties conflict. Created by the KYC_CASE workflow.
    }

    action notify-owners (
        name: Notify potential owners
        type: executeCode
        source {
            plsqlCode: xxfnd_task_pkg.notify_created(:APEX$TASK_ID);
        }
        execution {
            onEvent: create
            sequence: 10
        }
    )

    action record-approval (
        name: Record approval
        type: executeCode
        source {
            plsqlCode: xxcmp_case_pkg.record_decision(to_number(:APEX$TASK_PK), 'APPROVED', xxfnd_task_pkg.last_comment(:APEX$TASK_ID), :APEX$TASK_ID);
        }
        execution {
            onEvent: complete
            outcome: approved
            sequence: 20
        }
    )

    action record-rejection (
        name: Record rejection
        type: executeCode
        source {
            plsqlCode: xxcmp_case_pkg.record_decision(to_number(:APEX$TASK_PK), 'REJECTED', xxfnd_task_pkg.last_comment(:APEX$TASK_ID), :APEX$TASK_ID);
        }
        execution {
            onEvent: complete
            outcome: rejected
            sequence: 30
        }
    )

    participant (
        value {
            type: expression
            plsqlExpression: xxcmp_case_pkg.level_approvers(to_number(:APEX$TASK_PK))
        }
    )

    participant (
        type: businessAdministrator
        value {
            type: expression
            plsqlExpression: xxfnd_task_pkg.business_admins
        }
    )

)
