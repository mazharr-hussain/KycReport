lov lov-case-officers (
    name: CASE_OFFICERS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 75: who may be given a case (one rule: XXCMP_CASE_PKG.IS_CASE_OFFICER); Assign on 211 and 205,
            -- and the Approve popup on 206
            select e.full_name as display_value, upper(e.user_name) as return_value
              from xxhr_employees e
             where e.user_name is not null
               and xxcmp_case_pkg.is_case_officer(e.user_name) = 'Y'
             order by 1
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
