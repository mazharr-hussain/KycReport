lov lov-jurisdiction (
    name: JURISDICTION
    subscription {
        master: @/135/lov-jurisdiction
    }
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select meaning as display_value,
                   lookup_code as return_value
              from xxfnd_lookup_values_vl
             where lookup_type = 'JURISDICTION'
               and active_flag = 'Y'
             order by display_sequence, meaning
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

