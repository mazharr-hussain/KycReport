authentication oracle-apex-accounts (
    name: Oracle APEX Accounts
    type: oracleApexAccounts
    loginProcessing {
        postAuthenticationProcedureName: xxfnd_security_pkg.map_login_user
    }
)


authentication oracle-database-accounts (
    name: Oracle Database Accounts
    type: databaseAccounts
    loginProcessing {
        postAuthenticationProcedureName: xxfnd_security_pkg.map_login_user
    }
)


authentication oci-iam-identity-domain (
    name: OCI IAM Identity Domain (SSO)
    type: socialSignIn
    settings {
        credentialStore: @apex-fa-iabwbn-dev1-dbms-cred
        authProvider: openidConnect
        discoveryUrl: #FA_IABWBN-DEV1_DISCOVERY_URL#
        scope: profile,email,offline_access,groups,#FA_IABWBN-DEV1_OAUTH_SCOPE#
        username: #sub#
        convertUsernameToUpperCase: true
        additionalUserAttrs: given_name,middle_name,family_name,locale,zoneinfo,email
        verifyAttrs: true
    }
    loginProcessing {
        postAuthenticationProcedureName: xxfnd_security_pkg.map_login_user
        switchInSession: true
    }
)
