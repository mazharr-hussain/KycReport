page 146 (
    name: Task Deadline
    alias: TASK-DEADLINE
    title: Task Deadline
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Due date, reminder and escalation for one kind of task. Applies to tasks created from now on.
            ```
    }

    region form (
        name: Task Deadline
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_TASK_SETTINGS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P146_TASK_DEFINITION (
        type: selectList
        label {
            label: Task
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-task-definitions
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: TASK_DEFINITION
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from xxfnd_task_settings where task_definition = :P146_TASK_DEFINITION
                ```
        }
        help {
            helpText: The APEX task definition.
        }
    )

    pageItem P146_DUE_DAYS (
        type: numberField
        label {
            label: Due (days)
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: DUE_DAYS
            dataType: number
        }
        help {
            helpText: Days from creation until the task is due. Empty = no due date.
        }
    )

    pageItem P146_REMINDER_DAYS_BEFORE (
        type: numberField
        label {
            label: Reminder (days before due)
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: REMINDER_DAYS_BEFORE
            dataType: number
        }
        help {
            helpText: Days before the due date when the owners are reminded. Empty = no reminder.
        }
    )

    pageItem P146_ESCALATION_ROLE_CODE (
        type: selectList
        label {
            label: Escalate To
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-roles
            displayNullValue: true
            nullDisplayValue: - No escalation -
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ESCALATION_ROLE_CODE
            dataType: varchar2
        }
        help {
            helpText: Role whose members are told when the task is overdue.
        }
    )

    pageItem P146_NOTIFY_ON_CREATE_FLAG (
        type: switch
        label {
            label: E-mail on Creation
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: NOTIFY_ON_CREATE_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: E-mail the potential owners when a task is created.
        }
    )

    pageItem P146_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P146_TASK_DEFINITION
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P146_TASK_DEFINITION
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P146_TASK_DEFINITION
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
