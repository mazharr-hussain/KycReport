page 213 (
    name: Screening
    alias: SCREENING
    title: Screening
    pageGroup: @kyc
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            One screening check (registry, sanctions, PEP or adverse media) on the party or a related party. A confirmed match or a PEP flag puts the case into Enhanced KYC.
            ```
    }

    region form (
        name: Screening
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_SCREENINGS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P213_SCREENING_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: SCREENING_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P213_CASE_ID (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: CASE_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P213_PARTY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: PARTY_ID
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                -- the case's party (no choice on the screen)
                select coalesce(to_number(:P213_SCREEN_PARTY_ID), party_id) from xxcmp_cases where case_id = :P213_CASE_ID
                ```
        }
    )

    pageItem P213_SCREEN_PARTY_ID (
        type: hidden
        layout {
            sequence: 3
            region: @form
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
        help {
            helpText: The owner / related party to screen, from the Screen link of the case's Owners and Officers (empty = the case's party).
        }
    )

    pageItem P213_SCREENING_TYPE (
        type: selectList
        label {
            label: Check
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'SCREENING_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: SCREENING_TYPE
            dataType: varchar2
        }
    )

    pageItem P213_MATCH_STATUS (
        type: selectList
        label {
            label: Result
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'SCREENING_MATCH_STATUS' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: MATCH_STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: NO_MATCH
        }
    )

    pageItem P213_RISK_TIER (
        type: selectList
        label {
            label: Risk Level
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'RISK_TIER' and enabled_flag = 'Y'
                 order by display_sequence
                ```
            displayNullValue: true
            nullDisplayValue: -
        }
        layout {
            sequence: 35
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: RISK_TIER
            dataType: varchar2
        }
        help {
            helpText: The risk level of this party from the screening (shown per party in the case's Owners and Officers and in the report).
        }
    )

    pageItem P213_PARTY_NAME (
        type: displayOnly
        label {
            label: Party
            alignment: left
        }
        layout {
            sequence: 11
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select party_name || ' (' || party_number || ')' from xxcmp_parties where party_id = :P213_PARTY_ID
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- only when an owner / related party is screened (the case's own party needs no label)
                select 1 from xxcmp_cases where case_id = :P213_CASE_ID and party_id <> :P213_PARTY_ID
                ```
        }
    )

    pageItem P213_PEP_FLAG (
        type: switch
        label {
            label: PEP
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: PEP_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P213_SANCTIONS_FLAG (
        type: switch
        label {
            label: Sanctions
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: SANCTIONS_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P213_ADVERSE_MEDIA_FLAG (
        type: switch
        label {
            label: Adverse Media
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            startNewRow: false
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ADVERSE_MEDIA_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P213_SCREENED_DATE (
        type: datePicker
        label {
            label: Screened On
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: SCREENED_DATE
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select trunc(sysdate) from dual
                ```
        }
    )

    pageItem P213_SOURCE_REFERENCE (
        type: textField
        label {
            label: Source / Reference
            alignment: left
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: SOURCE_REFERENCE
            dataType: varchar2
        }
    )

    pageItem P213_RESULT_NOTES (
        type: textarea
        label {
            label: Conclusion
            alignment: left
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @form
            column: RESULT_NOTES
            dataType: varchar2
        }
    )

    pageItem P213_CAPTURE_METHOD (
        type: displayOnly
        label {
            label: Captured
            alignment: left
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: CAPTURE_METHOD
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MANUAL
        }
    )

    pageItem P213_ENDPOINT_CODE (
        type: displayOnly
        label {
            label: Provider
            alignment: left
        }
        layout {
            sequence: 110
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: ENDPOINT_CODE
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_ENDPOINT_CODE
        }
        help {
            helpText: Release 74: the screening provider that returned this result (COMMON Integration setup). Empty for a screening recorded by hand.
        }
    )

    pageItem P213_ORIGINAL_RESPONSE (
        type: displayOnly
        label {
            label: Provider Response
            alignment: left
        }
        layout {
            sequence: 120
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: ORIGINAL_RESPONSE
            dataType: clob
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_ENDPOINT_CODE
        }
        help {
            helpText: The provider's result as received, kept unchanged; the fields above can be corrected by a person.
        }
    )

    pageItem P213_REVIEWED_BY (
        type: displayOnly
        label {
            label: Reviewed By
            alignment: left
        }
        layout {
            sequence: 130
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: REVIEWED_BY
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_ENDPOINT_CODE
        }
    )

    button review (
        buttonName: REVIEW
        label: Mark as Reviewed
        layout {
            sequence: 35
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P213_ENDPOINT_CODE is not null and :P213_REVIEWED_BY is null
                ```
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process review-screening (
        name: Reviewed by a person
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 74 (R14): a person confirms a result from the screening provider
                xxcmp_case_pkg.review_screening(:P213_SCREENING_ID);
                ```
        }
        execution {
            sequence: 15
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REVIEW
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process screening-saved (
        name: Changed by a person
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 74 (R14): a provider result a person changed is marked (its original response stays unchanged)
                xxcmp_case_pkg.screening_saved(:P213_SCREENING_ID);
                ```
        }
        execution {
            sequence: 16
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P213_SCREENING_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_SCREENING_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P213_SCREENING_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process apply-screening (
        name: Enhanced KYC from screening
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.apply_screening(:P213_CASE_ID);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE,REVIEW
        }
    )

)
