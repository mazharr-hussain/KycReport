page 0 (
    name: Global Page

    region feature-tabs (
        name: Feature Tabs
        type: list
        source {
            list: @feature-tabs
        }
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/tabs
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: feature-tabs
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Only on a tab page of a feature that has more than one tab.
                select 1
                  from xxfnd_feature_pages c
                 where c.app_alias = :APP_ALIAS
                   and c.page_id   = :APP_PAGE_ID
                   and c.tab_label is not null
                   and (select count(*) from xxfnd_feature_pages t
                         where t.app_alias = c.app_alias and t.feature_code = c.feature_code
                           and t.tab_label is not null) > 1
                ```
        }
    )


    region party-form (
        name: Party Details
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party-form
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 23, 24, 201)
                ```
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
        comments {
            comments: The one party form (common region). Pages 21 (read only), 23 (new owner / officer), 24 (Party dialog) and 201 (Create Request, new counterparty) fill it with XXCMP_PARTY_PKG.LOAD_ITEMS and save it with their own process; the rules are XXCMP_PARTY_PKG.PARTY_ERROR. Change the party form here, once.
        }
    )

    pageItem P0_PARTY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @party-form
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P0_PARTY_READ_ONLY (
        type: hidden
        layout {
            sequence: 2
            region: @party-form
            slot: regionBody
        }
    )

    pageItem P0_PARTY_NUMBER (
        type: displayOnly
        label {
            label: Party Number
            alignment: left
        }
        layout {
            sequence: 10
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_TYPE (
        type: radioGroup
        label {
            label: Party Type
            alignment: left
        }
        layout {
            sequence: 20
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'PARTY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: false
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :APP_PAGE_ID <> 201
                ```
        }
    )

    pageItem P0_PARTY_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 360
        }
    )

    pageItem P0_PARTY_JURISDICTION (
        type: selectList
        label {
            label: Country
            alignment: left
        }
        layout {
            sequence: 40
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
    )

    pageItem P0_PARTY_REGISTRATION_NUMBER (
        type: textField
        label {
            label: Registration No.
            alignment: left
        }
        layout {
            sequence: 50
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P0_PARTY_ENTITY_TYPE (
        type: selectList
        label {
            label: Entity Type
            alignment: left
        }
        layout {
            sequence: 60
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = xxcmp_party_pkg.entity_lookup(:P0_PARTY_TYPE) and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P0_PARTY_TYPE
        }
    )

    pageItem P0_PARTY_INCORPORATION_DATE (
        type: datePicker
        label {
            label: Incorporation Date
            alignment: left
        }
        layout {
            sequence: 70
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P0_PARTY_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        layout {
            sequence: 80
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
    )

    pageItem P0_PARTY_PHONE (
        type: textField
        label {
            label: Phone
            alignment: left
        }
        layout {
            sequence: 90
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
