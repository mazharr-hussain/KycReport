    pageItem P0_PARTY_LAST_VERIFIED_DATE (
        type: displayOnly
        label {
            label: Last Verified
            alignment: left
        }
        layout {
            sequence: 150
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 24) and :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 160
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 24) and :P0_PARTY_ID is not null
                ```
        }
    )

    pageItem P0_PARTY_MATCH_ACK (
        type: switch
        label {
            label: None of the Possible Matches is this party
            alignment: left
        }
        layout {
            sequence: 170
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 23, 24, 201) and nvl(:P0_PARTY_READ_ONLY, 'N') <> 'Y'
                ```
        }
        help {
            helpText: Required when Possible Matches lists similar parties: confirm that none of them is this party. A party with the same number and country is always refused.
        }
    )

    region possible_matches (
        name: Possible Matches
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_number,
                       j.party_name, j.country, j.status, j.score, j.reg_match, j.reasons,
                       case when :APP_PAGE_ID = 201 then 'Use this party' end as use_party
                  from json_table(xxcmp_request_pkg.party_candidates_json(:P0_PARTY_TYPE, :P0_PARTY_NAME, :P0_PARTY_REGISTRATION_NUMBER,
                                      to_date(:P0_PARTY_INCORPORATION_DATE), :P0_PARTY_JURISDICTION, to_number(:P0_PARTY_ID)), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  status varchar2(80) path '$.status',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: [
                P0_PARTY_ID
                P0_PARTY_TYPE
                P0_PARTY_NAME
                P0_PARTY_REGISTRATION_NUMBER
                P0_PARTY_INCORPORATION_DATE
                P0_PARTY_JURISDICTION
            ]
        }
        layout {
            sequence: 35
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: possible_matches
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 23, 24, 201) and nvl(:P0_PARTY_READ_ONLY, 'N') <> 'Y'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this party.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 20
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration / ID No.
            }
            layout {
                sequence: 30
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 40
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 50
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Party Status
            }
            layout {
                sequence: 55
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 60
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 70
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 80
            }
        )

        column USE_PARTY (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-use-party" data-party="#PARTY_ID#" data-status="#STATUS#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#USE_PARTY#</a>
                    ```
            }
        )

    )

    region party-summary (
        name: Party
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_party_pkg.summary_html(to_number(:P0_SUMMARY_PARTY_ID), to_number(:P0_REQUEST_ID));
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
                P0_SUMMARY_PARTY_ID
            ]
        }
        layout {
            sequence: 25
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_card
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (201, 203, 205)
                ```
        }
        comments {
            comments: Common request summary region (Global Page), shown on 201, 203 and 205. The page sets P0_REQUEST_ID / P0_SUMMARY_PARTY_ID.
        }
    )

    pageItem P0_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @party-summary
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
    )

    pageItem P0_SUMMARY_PARTY_ID (
        type: hidden
        layout {
            sequence: 2
            region: @party-summary
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
    )

    region approval-path (
        name: Approval Path
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_approval_pkg.path_html(to_number(:P0_REQUEST_ID));
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
                P0_SUMMARY_PARTY_ID
            ]
        }
        layout {
            sequence: 62
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: approval_path
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (203, 205) and :P0_REQUEST_ID is not null
                ```
        }
        comments {
            comments: Common request summary region (Global Page), shown on 201, 203 and 205. The page sets P0_REQUEST_ID / P0_SUMMARY_PARTY_ID.
        }
    )

    region request-history (
        name: History
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_approval_pkg.history_html(to_number(:P0_REQUEST_ID));
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
                P0_SUMMARY_PARTY_ID
            ]
        }
        layout {
            sequence: 64
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request_history
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID = 205 and :P0_REQUEST_ID is not null
                ```
        }
        comments {
            comments: Common request summary region (Global Page), shown on 201, 203 and 205. The page sets P0_REQUEST_ID / P0_SUMMARY_PARTY_ID.
        }
    )

    button edit-party (
        buttonName: EDIT_PARTY
        label: Edit Party
        layout {
            sequence: 10
            region: @party-summary
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                items: {
                    P24_PARTY_ID: &P0_SUMMARY_PARTY_ID.
                }
                clearCache: 24
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID = 205 and :P0_SUMMARY_PARTY_ID is not null and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE')
                and xxcmp_party_pkg.is_enabled(:P0_SUMMARY_PARTY_ID) = 'Y'
                ```
        }
    )

    dynamicAction refresh-matches (
        name: Look for similar parties
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 23, 24, 201) and nvl(:P0_PARTY_READ_ONLY, 'N') <> 'Y'
                ```
        }
        when {
            event: change
            selectionType: items
            items: P0_PARTY_TYPE,P0_PARTY_NAME,P0_PARTY_REGISTRATION_NUMBER,P0_PARTY_INCORPORATION_DATE,P0_PARTY_JURISDICTION
        }

        action refresh-matches-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @possible_matches
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-party-card (
        name: Refresh the party card
        execution {
            sequence: 80
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @party-summary
        }

        action refresh-party-card-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party-summary
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction party-form-labels (
        name: Party form - labels by party type
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P0_PARTY_TYPE
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 23, 24, 201)
                ```
        }

        action party-form-labels-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // one column per organisation / individual pair: the label follows the party type
                    var person = apex.item("P0_PARTY_TYPE").getValue() === "PERSON",
                        labels = { P0_PARTY_JURISDICTION: ["Country", "Nationality"],
                                   P0_PARTY_REGISTRATION_NUMBER: ["Registration No.", "ID Number"],
                                   P0_PARTY_ENTITY_TYPE: ["Entity Type", "ID Type"],
                                   P0_PARTY_INCORPORATION_DATE: ["Incorporation Date", "Date of Birth"] };
                    Object.keys(labels).forEach(function (item) {
                        $("#" + item + "_LABEL").text(labels[item][person ? 1 : 0]);
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

)
