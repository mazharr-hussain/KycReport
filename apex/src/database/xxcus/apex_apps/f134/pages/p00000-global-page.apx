    region party-owners (
        name: Owners and Officers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_relationship_id, j.direction, j.related_party, j.relationship_type, j.ownership_percentage, j.start_date, j.end_date,
                       case when xxcmp_party_pkg.can_edit_details(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y' and (:APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y')) then apex_page.get_url(p_page => 23, p_items => 'P23_PARTY_RELATIONSHIP_ID,P23_OBJECT_PARTY_ID', p_values => to_char(j.party_relationship_id) || ',' || :P0_SUMMARY_PARTY_ID, p_clear_cache => '23') end as edit_url
                  from json_table(xxcmp_party_pkg.owners_json(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID), '$[*]'
                         columns (party_relationship_id number path '$.party_relationship_id', direction varchar2(100) path '$.direction',
                                  related_party varchar2(400) path '$.related_party', relationship_type varchar2(240) path '$.relationship_type',
                                  ownership_percentage number path '$.ownership_percentage', start_date varchar2(20) path '$.start_date',
                                  end_date varchar2(20) path '$.end_date')) j
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
            ]
        }
        layout {
