page 0 (
    name: Global Page

    region feature-tabs (
        name: Feature Tabs
        type: list
        source {
            list: @feature-tabs
        }
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/tabs
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: feature-tabs
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Only on a tab page of a feature that has more than one tab.
                select 1
                  from xxfnd_feature_pages c
                 where c.app_alias = :APP_ALIAS
                   and c.page_id   = :APP_PAGE_ID
                   and c.tab_label is not null
                   and (select count(*) from xxfnd_feature_pages t
                         where t.app_alias = c.app_alias and t.feature_code = c.feature_code
                           and t.tab_label is not null) > 1
                ```
        }
    )


    region party-form (
        name: Party Details
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party-form
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (23, 24, 201)
                ```
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
        comments {
            comments: The one party form (common region). Pages 23 (new owner / officer), 24 (Party wizard step 1) and 201 (Create Request, new counterparty) fill it with XXCMP_PARTY_PKG.LOAD_ITEMS and save it with their own process; the rules are XXCMP_PARTY_PKG.PARTY_ERROR. Change the party form here, once.
        }
    )

    pageItem P0_PARTY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @party-form
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P0_PARTY_READ_ONLY (
        type: hidden
        layout {
            sequence: 2
            region: @party-form
            slot: regionBody
        }
    )

    pageItem P0_PARTY_NUMBER (
        type: displayOnly
        label {
            label: Party Number
            alignment: left
        }
        layout {
            sequence: 10
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_TYPE (
        type: radioGroup
        label {
            label: Party Type
            alignment: left
        }
        layout {
            sequence: 20
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'PARTY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: false
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :APP_PAGE_ID <> 201
                ```
        }
    )

    pageItem P0_PARTY_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 360
        }
    )

    pageItem P0_PARTY_JURISDICTION (
        type: selectList
        label {
            label: Country
            alignment: left
        }
        layout {
            sequence: 40
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
    )

    pageItem P0_PARTY_REGISTRATION_NUMBER (
        type: textField
        label {
            label: Registration No.
            alignment: left
        }
        layout {
            sequence: 50
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P0_PARTY_ENTITY_TYPE (
        type: selectList
        label {
            label: Entity Type
            alignment: left
        }
        layout {
            sequence: 60
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = xxcmp_party_pkg.entity_lookup(:P0_PARTY_TYPE) and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P0_PARTY_TYPE
        }
    )

    pageItem P0_PARTY_REGISTRATION_TYPE (
        type: selectList
        label {
            label: Registration Type
            alignment: left
        }
        layout {
            sequence: 45
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = xxcmp_party_pkg.registration_lookup(:P0_PARTY_TYPE) and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P0_PARTY_TYPE
        }
    )

    pageItem P0_PARTY_INCORPORATION_DATE (
        type: datePicker
        label {
            label: Incorporation Date
            alignment: left
        }
        layout {
            sequence: 70
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P0_PARTY_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        layout {
            sequence: 80
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
    )

    pageItem P0_PARTY_PHONE (
        type: textField
        label {
            label: Phone
            alignment: left
        }
        layout {
            sequence: 90
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 50
        }
    )

    pageItem P0_PARTY_WEBSITE (
        type: textField
        label {
            label: Website
            alignment: left
        }
        layout {
            sequence: 100
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
    )

    pageItem P0_PARTY_FAX (
        type: textField
        label {
            label: Fax
            alignment: left
        }
        layout {
            sequence: 110
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 50
        }
    )

    pageItem P0_PARTY_ADDRESS (
        type: textarea
        label {
            label: Headquarters Address
            alignment: left
        }
        layout {
            sequence: 115
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            resizable: true
            autoHeight: true
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P0_PARTY_STATUS (
        type: displayOnly
        label {
            label: Party Status
            alignment: left
        }
        layout {
            sequence: 120
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_NEXT_KYC_DATE (
        type: displayOnly
        label {
            label: Next KYC Date
            alignment: left
        }
        layout {
            sequence: 130
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_DATA_PROVENANCE (
        type: selectList
        label {
            label: Data Provenance
            alignment: left
        }
        layout {
            sequence: 140
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'DATA_PROVENANCE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 24)
                ```
        }
    )

    pageItem P0_PARTY_LAST_VERIFIED_DATE (
        type: displayOnly
        label {
            label: Last Verified
            alignment: left
        }
        layout {
            sequence: 150
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 24) and :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 160
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 24) and :P0_PARTY_ID is not null
                ```
        }
    )

    pageItem P0_PARTY_MATCH_ACK (
        type: hidden
        layout {
            sequence: 170
            region: @party-form
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        comments {
            comments: Answer of the similar-parties dialog (Global Page dynamic action party-match-dialog): Y = none of the possible matches is this party, N = a possible match exists. Stored on a request as MATCH_ACK_FLAG; empty = not answered (the save is stopped).
        }
    )

    region request-context (
        name: Request Context
        type: staticContent
        layout {
            sequence: 1
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 25, 201, 203, 204, 205, 206, 211)
                ```
        }
        comments {
            comments: Holds the context of the common Party and Request regions: P0_SUMMARY_PARTY_ID (the party shown), P0_REQUEST_ID (the request, empty on the party screens). Each page sets them before header.
        }
    )

    pageItem P0_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @request-context
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
    )

    pageItem P0_SUMMARY_PARTY_ID (
        type: hidden
        layout {
            sequence: 2
            region: @request-context
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
    )

    region possible_matches (
        name: Possible Matches
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_type, j.registration_number,
                       j.party_name, j.country, j.status, j.score, j.reg_match, j.reasons,
                       case when :APP_PAGE_ID = 201 then 'Use this party' end as use_party
                  from json_table(xxcmp_request_pkg.party_candidates_json(:P0_PARTY_TYPE, :P0_PARTY_NAME, :P0_PARTY_REGISTRATION_NUMBER,
                                      to_date(:P0_PARTY_INCORPORATION_DATE), :P0_PARTY_JURISDICTION, to_number(:P0_PARTY_ID)), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_type varchar2(240) path '$.registration_type',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  status varchar2(80) path '$.status',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: [
                P0_PARTY_ID
                P0_PARTY_TYPE
                P0_PARTY_NAME
                P0_PARTY_REGISTRATION_NUMBER
                P0_PARTY_INCORPORATION_DATE
                P0_PARTY_JURISDICTION
            ]
        }
        layout {
            sequence: 35
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: possible_matches
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (23, 24, 201) and nvl(:P0_PARTY_READ_ONLY, 'N') <> 'Y'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this party.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 20
            }
        )

        column REGISTRATION_TYPE (
            type: plainText
            heading {
                heading: Registration / ID Type
            }
            layout {
                sequence: 25
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration / ID No.
            }
            layout {
                sequence: 30
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 40
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 50
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Party Status
            }
            layout {
                sequence: 55
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 60
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 70
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 80
            }
        )

        column USE_PARTY (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-use-party" data-party="#PARTY_ID#" data-status="#STATUS#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#USE_PARTY#</a>
                    ```
            }
        )

    )

    region party-summary (
        name: Party
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_party_pkg.summary_html(to_number(:P0_SUMMARY_PARTY_ID), to_number(:P0_REQUEST_ID));
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
                P0_SUMMARY_PARTY_ID
            ]
        }
        layout {
            sequence: 25
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_card
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 201, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('PARTY', 'REVIEW')))
                ```
        }
        comments {
            comments: Common Party region (Global Page): the party in full on the party and request screens (no party status on a request).
        }
    )






    region party-dff (
        name: Additional Information
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_party_pkg.dff_html(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID, :P0_PARTY_DFF_CONTEXT,
                                                case when :APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y') then 'Y' else 'N' end);
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
                P0_PARTY_DFF_CONTEXT
            ]
        }
        layout {
            sequence: 26
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_dff
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('PARTY', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null
                -- hidden when the party type has no Additional Information fields
                and dbms_lob.instr(xxcmp_party_pkg.dff_html(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID, :P0_PARTY_DFF_CONTEXT, 'N'), 't-Form-fieldContainer') > 0
                ```
        }
    )

    pageItem P0_PARTY_DFF_JSON (
        type: hidden
        layout {
            sequence: 900
            region: @party-dff
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Unrestricted on purpose: filled in the browser before submit by xxfnd-dff.js (dynamic action bind-party-dff); XXCMP_PARTY_PKG.DFF_ERROR / SAVE_DFF re-validate every value on the server.
        }
    )

    pageItem P0_PARTY_DFF_CONTEXT (
        type: hidden
        layout {
            sequence: 901
            region: @party-dff
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Unrestricted on purpose: filled in the browser before submit by xxfnd-dff.js (dynamic action bind-party-dff); XXCMP_PARTY_PKG.DFF_ERROR / SAVE_DFF re-validate every value on the server.
        }
    )

    dynamicAction bind-party-dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (25, 204, 211)
                ```
        }

        action bind-party-dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    if (window.xxfndDff) { xxfndDff.bind('party_dff', 'P0_PARTY_DFF_JSON', 'P0_PARTY_DFF_CONTEXT'); }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    region party-contacts (
        name: Contact Persons
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.party_contact_id, c.contact_name, c.job_title, c.email, c.phone,
                       case c.primary_flag when 'Y' then 'Y' end as primary_contact,
                       case c.enabled_flag when 'N' then 'Y' end as enabled,
                       case when xxcmp_party_pkg.can_edit_details(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y' and (:APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y')) then apex_page.get_url(p_page => 22, p_items => 'P22_PARTY_CONTACT_ID,P22_PARTY_ID', p_values => to_char(c.party_contact_id) || ',' || :P0_SUMMARY_PARTY_ID, p_clear_cache => '22') end as edit_url
                  from xxcmp_party_contacts c
                 where c.party_id = :P0_SUMMARY_PARTY_ID
                   and xxcmp_party_pkg.can_view(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y'
                 order by c.primary_flag desc, c.contact_name
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 27
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_contacts
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('PARTY', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
