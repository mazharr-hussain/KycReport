    dynamicAction refresh-matches (
        name: Look for similar parties
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (23, 24, 201) and nvl(:P0_PARTY_READ_ONLY, 'N') <> 'Y'
                ```
        }
        when {
            event: change
            selectionType: items
            items: P0_PARTY_TYPE,P0_PARTY_NAME,P0_PARTY_REGISTRATION_NUMBER,P0_PARTY_INCORPORATION_DATE,P0_PARTY_JURISDICTION
        }

        action refresh-matches-reset (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    apex.item("P0_PARTY_MATCH_ACK").setValue("");   // asked again on the next save
                    ```
            }
            execution {
                sequence: 5
                fireOnInit: false
            }
        )

        action refresh-matches-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @possible_matches
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )



    dynamicAction party-form-labels (
        name: Party form - labels by party type
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P0_PARTY_TYPE
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (23, 24, 201)
                ```
        }

        action party-form-labels-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // one column per organisation / individual pair: the label follows the party type
                    var person = apex.item("P0_PARTY_TYPE").getValue() === "PERSON",
                        labels = { P0_PARTY_JURISDICTION: ["Country", "Nationality"],
                                   P0_PARTY_REGISTRATION_NUMBER: ["Registration No.", "ID Number"],
                                   P0_PARTY_REGISTRATION_TYPE: ["Registration Type", "ID Type"],
                                   P0_PARTY_INCORPORATION_DATE: ["Incorporation Date", "Date of Birth"],
                                   P0_PARTY_ADDRESS: ["Headquarters Address", "Address"] };
                    Object.keys(labels).forEach(function (item) {
                        $("#" + item + "_LABEL").text(labels[item][person ? 1 : 0]);
                    });
                    // order: organisation = Entity Type before Name, Registration Type before Registration No.;
                    // individual = no entity type (category of organisations only), ID Type before ID Number
                    var row = function (item) { return $("#" + item + "_CONTAINER").closest(".row"); };
                    row("P0_PARTY_ENTITY_TYPE").insertBefore(row("P0_PARTY_NAME"))[person ? "hide" : "show"]();
                    if (person) { apex.item("P0_PARTY_ENTITY_TYPE").setValue(""); }
                    row("P0_PARTY_REGISTRATION_TYPE").insertBefore(row("P0_PARTY_REGISTRATION_NUMBER"));
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

)
