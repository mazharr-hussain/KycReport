            sequence: 110
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 50
        }
    )

    pageItem P0_PARTY_STATUS (
        type: displayOnly
        label {
            label: Party Status
            alignment: left
        }
        layout {
            sequence: 120
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_NEXT_KYC_DATE (
        type: displayOnly
        label {
            label: Next KYC Date
            alignment: left
        }
        layout {
            sequence: 130
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_PARTY_ID is not null and :P0_PARTY_READ_ONLY = 'Y'
                ```
        }
    )

    pageItem P0_PARTY_DATA_PROVENANCE (
        type: selectList
        label {
            label: Data Provenance
            alignment: left
        }
        layout {
            sequence: 140
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
