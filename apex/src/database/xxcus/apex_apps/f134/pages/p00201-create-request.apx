page 201 (
    name: Create Request - Counterparty
    alias: CREATE-REQUEST
    title: Create Request - Counterparty
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Step 1 of 3: who is the counterparty. Choose it from the existing parties, or enter a new one with its contact details (the other details are optional): the system then looks for parties that may be the same (name, registration or identity number, date of incorporation or birth, country). A counterparty with the same registration number and country as an existing party must use that party. Compliance decides at the checklist review whether a similar party is the same. Save as Draft keeps the request to finish later.
            ```
    }

    region breadcrumb (
        name: Create Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Create Request
        type: list
        source {
            list: @request-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region counterparty (
        name: Counterparty
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: counterparty
        }
    )

    region new_party (
        name: New Counterparty
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: new_party
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P201_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @counterparty
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_PARTY_TYPE (
        type: radioGroup
        label {
            label: Counterparty Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'PARTY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: ORGANIZATION
        }
        help {
            helpText: An organisation (company, trust, government entity) or an individual.
        }
    )

    pageItem P201_PARTY_SELECTION (
        type: radioGroup
        label {
            label: Counterparty
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Existing counterparty' as display_value, 'EXISTING' as return_value from dual
                union all select 'New counterparty', 'NEW' from dual
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: NEW
        }
        help {
            helpText: Existing: the counterparty is already a party (choose it). New: not yet known to the organisation.
        }
    )

    pageItem P201_PARTY_ID (
        type: popupLov
        label {
            label: Existing Counterparty
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_name || ' (' || j.party_number || nvl2(j.country, ', ' || j.country, null) || ')' as display_value,
                       j.party_id as return_value
                  from json_table(xxcmp_request_pkg.party_directory_json(:P201_PARTY_TYPE), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country')) j
                 order by j.party_name
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P201_PARTY_TYPE
        }
        layout {
            sequence: 30
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Search by name or party number.
        }
    )

    pageItem P201_PARTY_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 360
        }
        help {
            helpText: Legal name of the organisation, or full name of the individual.
        }
    )

    pageItem P201_REGISTRATION_NUMBER (
        type: textField
        label {
            label: Registration Number
            alignment: left
        }
        layout {
            sequence: 20
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        help {
            helpText: Commercial registration or company number.
        }
    )

    pageItem P201_ENTITY_TYPE (
        type: selectList
        label {
            label: Entity Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'ENTITY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Legal form of the organisation.
        }
    )

    pageItem P201_INCORPORATION_DATE (
        type: datePicker
        label {
            label: Date of Incorporation
            alignment: left
        }
        layout {
            sequence: 40
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_DATE_OF_BIRTH (
        type: datePicker
        label {
            label: Date of Birth
            alignment: left
        }
        layout {
            sequence: 50
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_NATIONALITY (
        type: selectList
        label {
            label: Nationality
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 60
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_ID_TYPE (
        type: selectList
        label {
            label: Identity Document
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'ID_DOCUMENT_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 70
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_ID_NUMBER (
        type: textField
        label {
            label: Identity Document Number
            alignment: left
        }
        layout {
            sequence: 80
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P201_JURISDICTION (
        type: selectList
        label {
            label: Country
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 90
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Country of incorporation for an organisation, country of residence for an individual.
        }
    )

    pageItem P201_CONTACT_NAME (
        type: textField
        label {
            label: Contact Person
            alignment: left
        }
        layout {
            sequence: 92
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 240
        }
        help {
            helpText: Who the organisation deals with at the counterparty (or the individual).
        }
    )

    pageItem P201_CONTACT_EMAIL (
        type: textField
        label {
            label: Contact Email
            alignment: left
        }
        layout {
            sequence: 94
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
    )

    pageItem P201_CONTACT_PHONE (
        type: textField
        label {
            label: Contact Phone
            alignment: left
        }
        layout {
            sequence: 96
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 50
        }
    )

    pageItem P201_MATCH_ACK (
        type: switch
        label {
            label: None of the listed parties is this counterparty
            alignment: left
        }
        layout {
            sequence: 100
            region: @new_party
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        help {
            helpText: Tick when you are sure none of the similar parties is the counterparty. Compliance still checks it.
        }
    )

    pageItem P201_REQUESTING_DEPARTMENT (
        type: selectList
        label {
            label: Requesting Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'REQUESTING_DEPARTMENT' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select xxcmp_request_pkg.default_department from dual
                ```
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.can_choose_department = 'N' and xxcmp_request_pkg.default_department is not null
                ```
        }
        help {
            helpText: The department of your employee profile. Compliance can raise requests for any department.
        }
    )

    pageItem P201_JUSTIFICATION (
        type: textarea
        label {
            label: Business Purpose
            alignment: left
        }
        layout {
            sequence: 50
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 4000
        }
        help {
            helpText: Why the organisation wants to deal with this counterparty.
        }
    )

    region possible_matches (
        name: Existing Parties That May Be This Counterparty
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_number,
                       j.party_name, j.country, j.score, j.reg_match, j.reasons,
                       'Use this party' as use_party
                  from json_table(xxcmp_request_pkg.party_candidates_json(:P201_PARTY_TYPE, :P201_PARTY_NAME, :P201_REGISTRATION_NUMBER,
                                      :P201_ID_NUMBER, case :P201_PARTY_TYPE when 'ORGANIZATION' then to_date(:P201_INCORPORATION_DATE) else to_date(:P201_DATE_OF_BIRTH) end, :P201_JURISDICTION), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: [
                P201_PARTY_TYPE
                P201_PARTY_NAME
                P201_REGISTRATION_NUMBER
                P201_ID_NUMBER
                P201_INCORPORATION_DATE
                P201_DATE_OF_BIRTH
                P201_JURISDICTION
            ]
        }
        layout {
            sequence: 35
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: possible_matches
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this counterparty.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 20
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration No
            }
            layout {
                sequence: 30
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 40
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 50
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 60
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 70
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 80
            }
        )

        column USE_PARTY (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-use-party" data-party="#PARTY_ID#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#USE_PARTY#</a>
                    ```
            }
        )

    )

    dynamicAction existing-or-new (
        name: existing-or-new
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_SELECTION
        }
        clientSideCondition {
            type: item=value
            item: P201_PARTY_SELECTION
            value: EXISTING
        }

        action existing-or-new-0 (
            action: show
            affectedElements {
                selectionType: items
                items: P201_PARTY_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action existing-or-new-1 (
            action: hide
            affectedElements {
                selectionType: region
                region: @new_party
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action existing-or-new-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_PARTY_ID
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

        action existing-or-new-3 (
            action: show
            affectedElements {
                selectionType: region
                region: @new_party
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction existing-or-new-matches (
        name: existing-or-new-matches
        execution {
            sequence: 11
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_SELECTION
        }
        clientSideCondition {
            type: item=value
            item: P201_PARTY_SELECTION
            value: EXISTING
        }

        action existing-or-new-matches-1 (
            action: hide
            affectedElements {
                selectionType: region
                region: @possible_matches
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action existing-or-new-matches-3 (
            action: show
            affectedElements {
                selectionType: region
                region: @possible_matches
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction fields-by-type (
        name: fields-by-type
        execution {
            sequence: 20
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_TYPE
        }
        clientSideCondition {
            type: item=value
            item: P201_PARTY_TYPE
            value: ORGANIZATION
        }

        action fields-by-type-0 (
            action: show
            affectedElements {
                selectionType: items
                items: P201_REGISTRATION_NUMBER,P201_ENTITY_TYPE,P201_INCORPORATION_DATE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action fields-by-type-1 (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_DATE_OF_BIRTH,P201_NATIONALITY,P201_ID_TYPE,P201_ID_NUMBER
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action fields-by-type-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_REGISTRATION_NUMBER,P201_ENTITY_TYPE,P201_INCORPORATION_DATE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

        action fields-by-type-3 (
            action: show
            affectedElements {
                selectionType: items
                items: P201_DATE_OF_BIRTH,P201_NATIONALITY,P201_ID_TYPE,P201_ID_NUMBER
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction refresh-matches (
        name: Look for similar parties
        execution {
            sequence: 30
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_TYPE,P201_PARTY_NAME,P201_REGISTRATION_NUMBER,P201_ID_NUMBER,P201_INCORPORATION_DATE,P201_DATE_OF_BIRTH,P201_JURISDICTION
        }

        action refresh-matches-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @possible_matches
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction match-ack-visibility (
        name: Confirmation only when there are similar parties
        execution {
            sequence: 40
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @possible_matches
        }

        action match-ack-visibility-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var found = $("#possible_matches a.kyc-use-party").length > 0;
                    apex.item("P201_MATCH_ACK").show();
                    if (!found) { apex.item("P201_MATCH_ACK").hide(); }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

    dynamicAction use-party (
        name: Use an existing party
        execution {
            sequence: 50
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-use-party
        }

        action use-party-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var a = $(this.triggeringElement);
                    this.browserEvent.preventDefault();
                    apex.item("P201_PARTY_SELECTION").setValue("EXISTING");
                    apex.item("P201_PARTY_ID").setValue(String(a.data("party")), a.data("label"));
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save as Draft
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            executeValidations: false
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process load-request (
        name: Load draft
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select party_selection, party_id, party_type, party_name, registration_number, entity_type,
                       incorporation_date, date_of_birth, nationality, id_type, id_number, jurisdiction, match_ack_flag,
                       requesting_department, justification, contact_name, contact_email, contact_phone
                  into :P201_PARTY_SELECTION, :P201_PARTY_ID, :P201_PARTY_TYPE, :P201_PARTY_NAME, :P201_REGISTRATION_NUMBER, :P201_ENTITY_TYPE,
                       :P201_INCORPORATION_DATE, :P201_DATE_OF_BIRTH, :P201_NATIONALITY, :P201_ID_TYPE, :P201_ID_NUMBER, :P201_JURISDICTION,
                       :P201_MATCH_ACK, :P201_REQUESTING_DEPARTMENT, :P201_JUSTIFICATION, :P201_CONTACT_NAME, :P201_CONTACT_EMAIL,
                       :P201_CONTACT_PHONE
                  from xxcmp_requests
                 where request_id = :P201_REQUEST_ID and request_status = 'DRAFT';
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_REQUEST_ID
        }
    )

    validation check-1 (
        name: Choose the existing counterparty.
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'EXISTING' and :P201_PARTY_ID is null then
                    return 'Choose the existing counterparty.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_PARTY_ID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-2 (
        name: Enter the name.
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and trim(:P201_PARTY_NAME) is null then
                    return 'Enter the name.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_PARTY_NAME
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-3 (
        name: The date of incorporation cannot be in the future.
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and :P201_PARTY_TYPE = 'ORGANIZATION' and to_date(:P201_INCORPORATION_DATE) > trunc(sysdate) then
                    return 'The date of incorporation cannot be in the future.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_INCORPORATION_DATE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-4 (
        name: The date of birth cannot be in the future.
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and :P201_PARTY_TYPE = 'PERSON' and to_date(:P201_DATE_OF_BIRTH) > trunc(sysdate) then
                    return 'The date of birth cannot be in the future.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_DATE_OF_BIRTH
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-5 (
        name: Enter the contact person.
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and trim(:P201_CONTACT_NAME) is null then
                    return 'Enter the contact person.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_CONTACT_NAME
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-6 (
        name: Enter the contact email.
        execution {
            sequence: 60
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and trim(:P201_CONTACT_EMAIL) is null then
                    return 'Enter the contact email.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_CONTACT_EMAIL
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-7 (
        name: Enter a valid contact email.
        execution {
            sequence: 70
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and not regexp_like(trim(:P201_CONTACT_EMAIL), '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$') then
                    return 'Enter a valid contact email.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_CONTACT_EMAIL
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-8 (
        name: Enter the contact phone.
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and trim(:P201_CONTACT_PHONE) is null then
                    return 'Enter the contact phone.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_CONTACT_PHONE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-9 (
        name: Existing parties may be this counterparty: choose one with Use this party, or confirm that none of them is.
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_SELECTION = 'NEW' and nvl(:P201_MATCH_ACK, 'N') <> 'Y'
                   and xxcmp_request_pkg.party_candidate_count(:P201_PARTY_TYPE, :P201_PARTY_NAME, :P201_REGISTRATION_NUMBER,
                         :P201_ID_NUMBER, case :P201_PARTY_TYPE when 'ORGANIZATION' then to_date(:P201_INCORPORATION_DATE) else to_date(:P201_DATE_OF_BIRTH) end, :P201_JURISDICTION) > 0 then
                    return 'Existing parties may be this counterparty: choose one with Use this party, or confirm that none of them is.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_MATCH_ACK
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation check-exact (
        name: Party already exists
        execution {
            sequence: 5
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                    l_party varchar2(30);
                begin
                    if :P201_PARTY_SELECTION = 'NEW' then
                        l_party := xxcmp_request_pkg.exact_party_number(:P201_PARTY_TYPE, :P201_REGISTRATION_NUMBER, :P201_ID_NUMBER,
                                                                        :P201_JURISDICTION);
                        if l_party is not null then
                            return 'Party ' || l_party || ' already has this registration number and country: use this party.';
                        end if;
                    end if;
                    return null;
                end;
                ```
        }
        error {
            associatedItem: @P201_REGISTRATION_NUMBER
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    process save-request (
        name: Save counterparty
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_request_id number := to_number(:P201_REQUEST_ID);
                begin
                    -- one rule set for the page and the database; Save as Draft only needs the type and a name or party
                    xxcmp_request_pkg.save_counterparty(
                        p_request_id            => l_request_id,
                        p_party_selection       => :P201_PARTY_SELECTION,
                        p_party_id              => to_number(:P201_PARTY_ID),
                        p_party_type            => :P201_PARTY_TYPE,
                        p_party_name            => :P201_PARTY_NAME,
                        p_registration_number   => :P201_REGISTRATION_NUMBER,
                        p_entity_type           => :P201_ENTITY_TYPE,
                        p_incorporation_date    => to_date(:P201_INCORPORATION_DATE),
                        p_id_type               => :P201_ID_TYPE,
                        p_id_number             => :P201_ID_NUMBER,
                        p_jurisdiction          => :P201_JURISDICTION,
                        p_date_of_birth         => to_date(:P201_DATE_OF_BIRTH),
                        p_nationality           => :P201_NATIONALITY,
                        p_requesting_department => :P201_REQUESTING_DEPARTMENT,
                        p_justification         => :P201_JUSTIFICATION,
                        p_match_ack             => nvl(:P201_MATCH_ACK, 'N'),
                        p_draft                 => case when :REQUEST = 'SAVE_DRAFT' then 'Y' else 'N' end,
                        p_contact_name          => :P201_CONTACT_NAME,
                        p_contact_email         => :P201_CONTACT_EMAIL,
                        p_contact_phone         => :P201_CONTACT_PHONE);
                    :P201_REQUEST_ID := l_request_id;
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Request saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT,SAVE_DRAFT
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: Draft saved
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 200
                clearCache: 200
            }
        }
        serverSideCondition {
            whenButtonPressed: @save-draft
        }
    )

    branch (
        name: To questionnaire
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 202
                items: {
                    P202_REQUEST_ID: &P201_REQUEST_ID.
                }
                clearCache: 202
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
