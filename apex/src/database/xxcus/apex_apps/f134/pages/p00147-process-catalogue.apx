page 147 (
    name: Process Catalogue
    alias: PROCESS-CATALOGUE
    title: Process Catalogue
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The workflows and task definitions of this application. Their shape is maintained by developers (App Builder) and deployed as a release; their parameters are maintained on the other Workflow Setup tabs.
            ```
    }

    region breadcrumb (
        name: Process Catalogue
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Process Catalogue
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Workflow' as component_type,
                       w.name,
                       w.static_id,
                       w.title as description,
                       cast(null as varchar2(30)) as task_type,
                       w.last_updated_on
                  from apex_appl_workflows w
                 where w.application_id = :APP_ID
                union all
                select 'Task Definition',
                       t.name,
                       t.static_id,
                       t.subject,
                       t.task_type,
                       t.last_updated_on
                  from apex_appl_taskdefs t
                 where t.application_id = :APP_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column COMPONENT_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column STATIC_ID (
            type: plainText
            heading {
                heading: Static ID
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Title / Subject
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column TASK_TYPE (
            type: plainText
            heading {
                heading: Task Type
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column LAST_UPDATED_ON (
            type: plainText
            heading {
                heading: Last Changed
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
