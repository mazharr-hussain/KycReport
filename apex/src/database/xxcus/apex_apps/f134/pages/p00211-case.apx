    process add-note (
        name: Add note
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                insert into xxcmp_case_notes (case_id, note_text) values (:P211_CASE_ID, :P211_NEW_NOTE);
                :P211_NEW_NOTE := null;
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Note added.
        }
        serverSideCondition {
            whenButtonPressed: @add-note
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    region case-funds (
        name: Source of Funds and Wealth
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R19): guided source of funds / wealth - each source with the evidence expected and seen
                select f.case_funds_id,
                       xxfnd_util_pkg.lookup_meaning('FUNDS_TYPE', f.funds_type) as funds_type,
                       xxfnd_util_pkg.lookup_meaning('FUNDS_CATEGORY', f.category) as category,
                       ltrim(to_char(f.amount, 'FM999G999G999G990D00') || ' ' || f.currency_code) as amount,
                       xxcmp_case_pkg.expected_evidence_text(f.category) as expected,
                       xxfnd_util_pkg.lookup_meaning('FUNDS_EVIDENCE_TYPE', f.evidence_type) as evidence,
                       ltrim(f.bank_name || nvl2(f.account_reference, ' · ' || f.account_reference, null)
                             || nvl2(f.period_from, ' · ' || to_char(f.period_from, 'DD-MON-YYYY') || ' - ' || to_char(f.period_to, 'DD-MON-YYYY'), null), ' ·') as bank_data,
                       case when f.verified_flag = 'Y' then 'Verified' when f.evidence_type is null then 'Evidence missing' else 'To verify' end as state,
                       case when f.verified_flag = 'Y' then 'success' when f.evidence_type is null then 'danger' else 'warning' end as state_tone,
                       xxfnd_util_pkg.lookup_meaning('DATA_SOURCE', f.source) as source,
                       f.creation_date,
                       apex_page.get_url(p_page => 218, p_items => 'P218_CASE_FUNDS_ID,P218_CASE_ID,P218_PARTY_ID',
                                         p_values => to_char(f.case_funds_id) || ',' || f.case_id || ',' || f.party_id, p_clear_cache => '218') as open_url
                  from xxcmp_case_funds f
                 where f.case_id = :P211_CASE_ID
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
                P211_TASK_ID
            ]
        }
        layout {
            sequence: 55
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_funds
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('RISK', 'REVIEW')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No source of funds or wealth recorded yet.
        }
        comments {
            comments: Release 74 (R19): guided source of funds / wealth - the evidence expected for each source, the evidence and bank data seen (by hand now, from a bank data provider later).
        }

        column CATEGORY (
            type: plainText
            heading {
                heading: Source
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#"><strong>#CATEGORY#</strong></a><br><span class="u-color-subtle">#FUNDS_TYPE#</span>
                    ```
            }
        )

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
            }
            layout {
                sequence: 20
            }
        )

        column EXPECTED (
            type: plainText
            heading {
                heading: Evidence Expected
            }
            layout {
                sequence: 30
            }
        )

        column EVIDENCE (
            type: plainText
            heading {
                heading: Evidence Seen
            }
            layout {
                sequence: 40
            }
        )

        column BANK_DATA (
            type: plainText
            heading {
                heading: Bank Data
            }
            layout {
                sequence: 50
            }
        )

        column STATE (
            type: plainText
            heading {
                heading: State
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-badge kyc-badge--#STATE_TONE#">#STATE#</span>
                    ```
            }
        )

        column SOURCE (
            type: plainText
            heading {
                heading: Source
            }
            layout {
                sequence: 70
            }
        )

        column CASE_FUNDS_ID (
            type: hidden
            layout {
                sequence: 80
            }
        )

        column FUNDS_TYPE (
            type: hidden
            layout {
                sequence: 81
            }
        )

        column STATE_TONE (
            type: hidden
            layout {
                sequence: 82
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 83
            }
        )

        column CREATION_DATE (
            type: hidden
            layout {
                sequence: 84
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    button add-funds (
        buttonName: ADD_FUNDS
        label: Add Source
        layout {
            sequence: 5
            region: @case-funds
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 218
                items: {
                    P218_CASE_ID: &P211_CASE_ID.
                    P218_PARTY_ID: &P211_PARTY_ID.
                }
                clearCache: 218
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

