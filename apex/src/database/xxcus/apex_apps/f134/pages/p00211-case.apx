    pageItem P211_DEC_ADD_USER (
        type: popupLov
        label {
            label: Approver to Add
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(full_name, user_name) || ' (' || user_name || ')' as display_value, user_name as return_value
                  from xxfnd_employees
                 where user_name is not null
                 order by 1
                ```
        }
        layout {
            sequence: 130
            region: @case-decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Release 74: for Add Approver - the person who approves next, after you (the Comment says why).
        }
    )

    validation decision-info-question (
        name: Information to request
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_DEC_COMMENT is null then 'Enter the information you need from the requester.' end;
                ```
        }
        error {
            associatedItem: @P211_DEC_COMMENT
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'REQUEST_INFO'
                ```
        }
    )

    validation decision-add-user (
        name: Approver to add
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_DEC_ADD_USER is null then xxfnd_error_pkg.message('XXFND_APPROVAL_APPROVER_REQUIRED') end;
                ```
        }
        error {
            associatedItem: @P211_DEC_ADD_USER
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'ADD_APPROVER'
                ```
        }
    )

    validation decision-reject-reason (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_DEC_COMMENT is null then 'Enter why the case is rejected.' end;
                ```
        }
        error {
            associatedItem: @P211_DEC_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT,REJECT_TOP
        }
    )

    validation decision-sar (
        name: SAR determination
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_DEC_SAR_GATE = 'Y' and :P211_DEC_SAR_REQUIRED_FLAG is null then 'Record whether a Suspicious Activity Report is required.' end;
                ```
        }
        error {
            associatedItem: @P211_DEC_SAR_REQUIRED_FLAG
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process save-decision-data (
        name: Save SAR, conditions and review date
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                update xxcmp_cases
                   set sar_required_flag = :P211_DEC_SAR_REQUIRED_FLAG,
                       sar_notes         = :P211_DEC_SAR_NOTES,
                       conditions        = :P211_DEC_CONDITIONS,
                       next_review_date  = to_date(:P211_DEC_NEXT_REVIEW_DATE, 'DD-MON-YYYY')
                 where case_id = :P211_CASE_ID;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP,REJECT,REJECT_TOP
        }
    )

    process check-approval (
        name: Check the case can be approved
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_error varchar2(4000) := xxcmp_case_pkg.approval_error(:P211_CASE_ID);
                begin
                    if l_error is not null then
                        raise_application_error(-20615, l_error);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 15
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process add-decision-comment (
        name: Record comment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P211_TASK_ID, p_text => :P211_DEC_COMMENT);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_DEC_COMMENT is not null and :REQUEST in ('APPROVE', 'APPROVE_TOP', 'REJECT', 'REJECT_TOP', 'ADD_APPROVER')
                ```
        }
    )

    process approve-task (
        name: Approve
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.approve_task(p_task_id => :P211_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Case approved at this level.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process reject-task (
        name: Reject
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P211_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Case rejected.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT,REJECT_TOP
        }
    )

    process attach-decision-file (
        name: Keep the attachment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := xxfnd_attach_pkg.add_file(
                                p_entity_name    => 'XXCMP_CASES',
                                p_pk1_value      => :P211_CASE_ID,
                                p_category_code  => 'OTHER',
                                p_temp_file_name => :P211_DEC_FILE,
                                p_title          => initcap(replace(replace(:REQUEST, '_TOP'), '_', ' ')) || ' - ' || :APP_USER,
                                p_description    => substr(:P211_DEC_COMMENT, 1, 4000),
                                p_page_id        => 211);
                end;
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_DEC_FILE is not null and :REQUEST in ('APPROVE', 'APPROVE_TOP', 'REJECT', 'REJECT_TOP', 'REQUEST_INFO', 'ADD_APPROVER')
                ```
        }
    )

    process request-info (
        name: Request information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 74: the question goes to the requester (task initiator); the case is Pending Information
                -- until they submit it (task actions)
                for t in (select 1 from apex_tasks where task_id = :P211_TASK_ID and state_code = 'UNASSIGNED') loop
                    apex_human_task.claim_task(p_task_id => :P211_TASK_ID);
                end loop;
                apex_human_task.request_more_information(p_task_id => :P211_TASK_ID, p_text => :P211_DEC_COMMENT);
                ```
        }
        execution {
            sequence: 35
            point: processing
        }
        successMessage {
            successMessage: Information requested: the case is Pending Information until the requester answers.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'REQUEST_INFO'
                ```
        }
    )

    process add-approver (
        name: Add an approver
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 74: the current approver adds an approver after them (Approval Setup, ad-hoc)
                xxfnd_approval_rule_pkg.add_approver('KYC_CASE', :P211_CASE_ID, 'USER', p_user_name => :P211_DEC_ADD_USER,
                                                     p_position => 'NEXT', p_comment => :P211_DEC_COMMENT);
                ```
        }
        execution {
            sequence: 36
            point: processing
        }
        successMessage {
            successMessage: Approver added: they approve after you.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'ADD_APPROVER'
                ```
        }
    )

    button request-info (
        buttonName: REQUEST_INFO
        label: Request Information
        layout {
            sequence: 22
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                and xxfnd_task_pkg.can_request_info(:P211_TASK_ID) = 'Y'
                ```
        }
    )

    button add-approver (
        buttonName: ADD_APPROVER
        label: Add Approver
        layout {
            sequence: 24
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                and xxfnd_approval_rule_pkg.is_started('KYC_CASE', :P211_CASE_ID) = 'Y'
                ```
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @decision-buttons
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Reject this case?
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )


    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 30
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )


    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @case
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Save case
        type: formAutoRowProcessing
        formRegion: @case
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Case saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,NEXT_SECTION,SUBMIT_APPROVAL
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-findings (
        name: Save questionnaire
        type: interactiveGridAutoRowProcessing
        editableRegion: @findings
        execution {
            sequence: 15
            point: processing
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process apply-screening (
        name: Enhanced KYC from screening
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.apply_screening(:P211_CASE_ID);
                ```
        }
        execution {
            sequence: 18
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,NEXT_SECTION,SUBMIT_APPROVAL
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process submit-for-approval (
        name: Submit for approval
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.submit_for_approval(:P211_CASE_ID);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Case submitted for approval.
        }
