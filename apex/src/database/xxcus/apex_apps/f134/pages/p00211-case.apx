page 211 (
    name: Case
    alias: CASE
    title: Case
    pageGroup: @kyc
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // the investigation questionnaire opens ready to type (the grid toolbar with its Edit button is hidden)
            var findings = apex.region('findings');
            if (findings && findings.call('getViews', 'grid').model.getOption('editable')) {
                findings.call('getActions').set('edit', true);
            }
            ```
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The case screen: the officer works through the sections on the left (Summary, Party, Contacts and Ownership, Screening, Documents, Risk Assessment, Notes and RFIs) and submits on Review and Submit. Each section saves on its own. The party sections are the common Global Page regions. Approvers open the case from their task in review mode and decide at the top or the bottom.
            ```
    }

    region breadcrumb (
        name: Case
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region top-buttons (
        name: Case Actions
        type: staticContent
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: top_buttons
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 990
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: kyc-actionbar
        }
        advanced {
            htmlDomId: buttons
        }
    )

    region section-nav (
        name: Sections · progress &P211_PROGRESS.
        type: list
        source {
            list: @case-sections
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_02
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/links-list
            templateOptions: [
                #DEFAULT#
                t-LinksList--showIcons
            ]
        }
        advanced {
            htmlDomId: case_sections
        }
    )

    pageItem P211_PROGRESS (
        type: hidden
        layout {
            sequence: 4
            region: @section-nav
            slot: regionBody
        }
    )

    region case-history (
        name: Approval History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum as seq, h.step_no, h.step_name, h.assigned_to, h.action, h.action_by,
                       to_char(h.action_date, 'DD-MON-YYYY HH24:MI') as action_date, h.comments
                  from table(xxcmp_case_pkg.case_history_rows(to_number(:P211_CASE_ID))) h
                 order by seq
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 95
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_history
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('REVIEW')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No history yet.
        }

        column SEQ (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column STEP_NAME (
            type: plainText
            heading {
                heading: Step
            }
            layout {
                sequence: 20
            }
        )

        column ASSIGNED_TO (
            type: plainText
            heading {
                heading: Approver
            }
            layout {
                sequence: 30
            }
        )

        column ACTION (
            type: plainText
            heading {
                heading: Action / Status
            }
            layout {
                sequence: 40
            }
        )

        column ACTION_BY (
            type: plainText
            heading {
                heading: By
            }
            layout {
                sequence: 50
            }
        )

        column ACTION_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 60
            }
        )

        column COMMENTS (
            type: plainText
            heading {
                heading: Comments
            }
            layout {
                sequence: 70
            }
        )

        column STEP_NO (
            type: hidden
            layout {
                sequence: 80
            }
        )

    )

    region case-decision (
        name: Decision
        type: staticContent
        layout {
            sequence: 96
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_decision
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL' and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve) or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )

    region decision-buttons (
        name: Decision Buttons
        type: staticContent
        layout {
            sequence: 989
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: kyc-actionbar
        }
        advanced {
            htmlDomId: decision_buttons
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL' and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve) or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )

    region case (
        name: &P211_SECTION_LABEL.
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_CASES
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        advanced {
            htmlDomId: case
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N' or :P211_SECTION = 'REVIEW'
                ```
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                -- release 29: the form keeps the case keys on Summary / Risk / Review; its fields show only in an editable Risk
                -- Assessment (the summary grid shows the rest) and the region hides itself without visible fields (kyc-app.css)
                :P211_SECTION in ('SUMMARY', 'RISK', 'REVIEW')
                ```
        }
    )

    region case-header (
        name: Case Header
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R7, R11): the case header card from data (no HTML from PL/SQL); data security applies
                select c.case_number || ' · ' || p.party_name as title,
                       xxfnd_ui_pkg.status_label('CASE', c.case_status) as status_label,
                       xxfnd_ui_pkg.status_tone('CASE', c.case_status) as status_tone,
                       xxfnd_ui_pkg.status_label('RISK', c.risk_tier) as risk_label,
                       xxfnd_ui_pkg.status_tone('RISK', c.risk_tier) as risk_tone,
                       case when c.enhanced_kyc_flag = 'Y' then 'Enhanced KYC' end as edd_label,
                       case when c.pep_flag = 'Y' then 'PEP' end as pep_label,
                       case when c.closed_date is null then
                           case when c.sla_due_date < trunc(sysdate) then 'Overdue'
                                when c.sla_due_date <= trunc(sysdate) + 2 then 'Due soon' else 'On time' end
                           || ' · SLA ' || to_char(c.sla_due_date, 'DD-MON-YYYY') end as sla_label,
                       case when c.sla_due_date < trunc(sysdate) then 'danger'
                            when c.sla_due_date <= trunc(sysdate) + 2 then 'warning' else 'success' end as sla_tone,
                       ltrim(xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction)
                             || nvl2(c.business_relationship, ' · ' || xxfnd_util_pkg.lookup_meaning('BUSINESS_RELATIONSHIP', c.business_relationship), null)
                             || nvl2(r.request_number, ' · request ' || r.request_number, null), ' ·') as info_line,
                       c.assigned_to,
                       nvl(xxfnd_ui_pkg.person_name(c.assigned_to), 'nobody') as assigned_name,
                       case c.case_status
                           when 'PENDING_APPROVAL' then 'Pending approval (level ' || nvl(c.current_level, 1) || ')'
                           when 'PENDING_INFORMATION' then 'Pending information from the requester (level ' || nvl(c.current_level, 1) || ')'
                       end as pending_line,
                       a.owner as approver,
                       xxfnd_ui_pkg.person_name(a.owner) as approver_name,
                       to_char(a.since, 'DD-MON-YYYY HH24:MI') as approver_since
                  from xxcmp_cases c
                  join xxcmp_parties p on p.party_id = c.party_id
                  left join xxcmp_requests r on r.request_id = c.request_id
                 outer apply (select max(t.actual_owner) keep (dense_rank last order by t.created_on) as owner,
                                     max(t.created_on) as since
                                from apex_tasks t
                               where t.detail_pk = to_char(c.case_id) and t.task_def_static_id = 'CASE_APPROVAL'
                                 and t.state_code in ('UNASSIGNED', 'ASSIGNED')
                                 and c.case_status = 'PENDING_APPROVAL') a
                 where c.case_id = :P211_CASE_ID
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
            ]
        }
        layout {
            sequence: 1
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_header
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        heading {
            type: none
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 1
        }
        messages {
            whenNoDataFound: The case is not available.
        }

        column TITLE (
            type: plainText
            heading {
                heading: Case
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="kyc-hcard"><div class="kyc-hcard-top"><span class="kyc-hcard-title">#TITLE#</span><span class="kyc-badge kyc-badge--#STATUS_TONE#">#STATUS_LABEL#</span>{if RISK_LABEL/}<span class="kyc-badge kyc-badge--#RISK_TONE#">#RISK_LABEL#</span>{endif/}{if EDD_LABEL/}<span class="kyc-badge kyc-badge--warning">#EDD_LABEL#</span>{endif/}{if PEP_LABEL/}<span class="kyc-badge kyc-badge--danger">#PEP_LABEL#</span>{endif/}{if SLA_LABEL/}<span class="kyc-badge kyc-badge--#SLA_TONE#">#SLA_LABEL#</span>{endif/}</div><div class="kyc-hcard-line">#INFO_LINE# · assigned to {if ASSIGNED_TO/}<span class="kyc-person" tabindex="0" data-user="#ASSIGNED_TO#">#ASSIGNED_NAME#</span>{else/}<span class="u-color-subtle">nobody</span>{endif/}</div>{if PENDING_LINE/}<div class="kyc-hcard-line">#PENDING_LINE#{if APPROVER/} with <b><span class="kyc-person" tabindex="0" data-user="#APPROVER#">#APPROVER_NAME#</span></b>{endif/}{if APPROVER_SINCE/} since #APPROVER_SINCE#{endif/} · the case is read only</div>{endif/}</div>
                    ```
            }
        )

        column STATUS_LABEL (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column STATUS_TONE (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column RISK_LABEL (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column RISK_TONE (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column EDD_LABEL (
            type: hidden
            layout {
                sequence: 60
            }
        )

        column PEP_LABEL (
            type: hidden
            layout {
                sequence: 70
            }
        )

        column SLA_LABEL (
            type: hidden
            layout {
                sequence: 80
            }
        )

        column SLA_TONE (
            type: hidden
            layout {
                sequence: 90
            }
        )

        column INFO_LINE (
            type: hidden
            layout {
                sequence: 100
            }
        )

        column ASSIGNED_TO (
            type: hidden
            layout {
                sequence: 110
            }
        )

        column ASSIGNED_NAME (
            type: hidden
            layout {
                sequence: 120
            }
        )

        column PENDING_LINE (
            type: hidden
            layout {
                sequence: 130
            }
        )

        column APPROVER (
            type: hidden
            layout {
                sequence: 140
            }
        )

        column APPROVER_NAME (
            type: hidden
            layout {
                sequence: 150
            }
        )

        column APPROVER_SINCE (
            type: hidden
            layout {
                sequence: 160
            }
        )

    )

    region case-summary (
        name: &P211_SECTION_LABEL.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R7, R11): the case summary as data (XXCMP_CASE_PKG.CASE_SUMMARY_JSON)
                select j.label, j.value, j.tone, j.url, j.link_text, j.user_name, j.seq, j.group_name
                  from json_table(xxcmp_case_pkg.case_summary_json(to_number(:P211_CASE_ID), to_number(:P211_TASK_ID)), '$[*]'
                           columns (group_name varchar2(30)   path '$.group_name',
                                    seq        number         path '$.seq',
                                    label      varchar2(100)  path '$.label',
                                    value      varchar2(4000) path '$.value',
                                    tone       varchar2(30)   path '$.tone',
                                    url        varchar2(4000) path '$.url',
                                    link_text  varchar2(200)  path '$.link_text',
                                    user_name  varchar2(255)  path '$.user_name')) j
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
                P211_TASK_ID
            ]
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_summary
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('SUMMARY', 'REVIEW') or (:P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N')
                ```
        }
        componentAppearance {
            template: @/value-attribute-pairs-row
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        messages {
            whenNoDataFound: The case is not available.
        }

        column LABEL (
            type: plainText
            heading {
                heading: Label
            }
            layout {
                sequence: 10
            }
        )

        column VALUE (
            type: plainText
            heading {
                heading: Value
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {case TONE/}{when missing/}<span class="kyc-missing">#VALUE# – <a href="#URL#">#LINK_TEXT#</a></span>{otherwise/}{if TONE/}<span class="kyc-badge kyc-badge--#TONE#">#VALUE#</span>{else/}{if USER_NAME/}<span class="kyc-person" tabindex="0" data-user="#USER_NAME#">#VALUE#</span>{else/}#VALUE#{endif/}{endif/}{endcase/}
                    ```
            }
        )

        column TONE (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column URL (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column LINK_TEXT (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column USER_NAME (
            type: hidden
            layout {
                sequence: 60
            }
        )

        column SEQ (
            type: hidden
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )

        column GROUP_NAME (
            type: hidden
            layout {
                sequence: 80
            }
        )

    )

