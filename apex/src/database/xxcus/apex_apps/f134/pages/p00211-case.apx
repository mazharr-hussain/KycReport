            sequence: 8
            region: @buttons
            slot: regionBody
        }
        comments {
            comments: CASE_APPROVAL when an approver opened the case from the task: review mode with the decision.
        }
    )

    pageItem P211_CASE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: CASE_ID
            dataType: number
            primaryKey: true
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P211_TASK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @case
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P211_PARTY_ID (
        type: hidden
        layout {
            sequence: 3
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: PARTY_ID
            dataType: number
        }
        sessionState {
            storage: session
        }
    )

    pageItem P211_WORKFLOW_ID (
        type: hidden
        layout {
            sequence: 4
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: WORKFLOW_ID
            dataType: number
        }
    )

    pageItem P211_CASE_NUMBER (
        type: displayOnly
        label {
            label: Case
            alignment: left
        }
        layout {
            sequence: 10
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: CASE_NUMBER
            dataType: varchar2
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )
    pageItem P211_PARTY (
        type: displayOnly
        label {
            label: Party
            alignment: left
        }
        layout {
            sequence: 20
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.party_number || ' - ' || p.party_name
                       || nvl2(p.jurisdiction, ' (' || xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction) || ')', null)
                  from xxcmp_cases c join xxcmp_parties p on p.party_id = c.party_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 30
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('CASE_STATUS', case_status)
                       || case when case_status = 'PENDING_APPROVAL' then ' (level ' || current_level || ')' end
                       || nvl2(closed_date, ' - closed ' || to_char(closed_date, 'DD-Mon-YYYY'), null)
                  from xxcmp_cases where case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_SLA (
        type: displayOnly
        label {
            label: SLA Due
            alignment: left
        }
        layout {
            sequence: 40
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(sla_due_date, 'DD-Mon-YYYY')
                       || case when closed_date is null and sla_due_date < trunc(sysdate) then ' - OVERDUE' end
                  from xxcmp_cases where case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_REQUEST (
        type: displayOnly
        label {
            label: Request
            alignment: left
        }
        layout {
            sequence: 50
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select r.request_number || ' - '
                       || xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type)
                       || ' - intake score ' || nvl(to_char(r.intake_score), '-') || ' (reference only)'
                  from xxcmp_cases c join xxcmp_requests r on r.request_id = c.request_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_ASSIGNED_TO (
        type: selectList
        label {
            label: Assigned To
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct e.full_name || ' (' || ur.user_name || ')' as display_value, ur.user_name as return_value
                  from xxfnd_user_roles_v ur
                  join xxfnd_employees e on e.user_name = ur.user_name
                 where ur.role_code in ('COMPLIANCE_OFFICER','COMPLIANCE_MANAGER','HEAD_OF_COMPLIANCE') and ur.active_flag = 'Y'
                 order by 1
                ```
            displayNullValue: true
            nullDisplayValue: - Unassigned -
        }
        layout {
            sequence: 60
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @case
            column: ASSIGNED_TO
            dataType: varchar2
        }
        help {
            helpText: The investigating officer. A manager can reassign the case.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )
