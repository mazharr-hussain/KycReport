        name: Note entered
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_NEW_NOTE is null then 'Enter the note.' end;
                ```
        }
        error {
            associatedItem: @P211_NEW_NOTE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ADD_NOTE
        }
    )

    process open-from-task (
        name: Open from task
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select to_number(detail_pk) into :P211_CASE_ID
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'SINGLE_TASK',
                                   p_task_id        => :P211_TASK_ID,
                                   p_application_id => :APP_ID ) )
                 where task_def_static_id in ('CASE_INVESTIGATION', 'CASE_APPROVAL');
                select max(task_def_static_id) into :P211_TASK_TYPE from apex_tasks
                 where task_id = :P211_TASK_ID and task_def_static_id = 'CASE_APPROVAL';
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P211_TASK_ID
        }
    )

    process set-section (
        name: Section and the common party regions
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_list apex_t_varchar2 := apex_string.split(xxcmp_case_pkg.c_sections, ':');
                begin
                    if :P211_TASK_TYPE = 'CASE_APPROVAL' or :P211_SECTION is null and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N' then
                        :P211_SECTION := 'REVIEW';
                    end if;
                    :P211_SECTION := nvl(:P211_SECTION, 'SUMMARY');
                    :P211_SECTION_LABEL := xxfnd_util_pkg.lookup_meaning('CASE_SECTION', :P211_SECTION);
                    :P211_PROGRESS := xxcmp_case_pkg.section_progress(:P211_CASE_ID);
                    :P211_NEXT_SECTION := :P211_SECTION;
                    for i in 1 .. l_list.count - 1 loop
                        if l_list(i) = :P211_SECTION then
                            :P211_NEXT_SECTION := l_list(i + 1);
                        end if;
                    end loop;
                    -- the party regions of the Global Page: Compliance edits through Parties - Manage (no request context)
                    :P0_REQUEST_ID := null;
                    :P0_CASE_ID := :P211_CASE_ID;
                    -- release 73: a case the user cannot see (data security) or that does not exist: a clear message, not ORA-01403
                    select max(party_id) into :P0_SUMMARY_PARTY_ID from xxcmp_cases where case_id = :P211_CASE_ID;
                    if :P0_SUMMARY_PARTY_ID is null then
                        raise_application_error(-20611, 'Case not found, or you are not allowed to see it.');
                    end if;
                    :P0_PARTY_DFF_CONTEXT := null;
                end;
                ```
        }
        execution {
            sequence: 8
            point: beforeHeader
        }
    )

    branch (
        name: Next section
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 211
                items: {
                    P211_CASE_ID: &P211_CASE_ID.
                    P211_TASK_ID: &P211_TASK_ID.
                    P211_SECTION: &P211_NEXT_SECTION.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT_SECTION
        }
    )

    process load-decision (
        name: Load the decision
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select sar_required_flag, sar_notes, conditions,
                       to_char(nvl(next_review_date, xxcmp_case_pkg.next_review_date(case_id)), 'DD-MON-YYYY'),
                       xxcmp_case_pkg.sar_gate(case_id)
                  into :P211_DEC_SAR_REQUIRED_FLAG, :P211_DEC_SAR_NOTES, :P211_DEC_CONDITIONS, :P211_DEC_NEXT_REVIEW_DATE, :P211_DEC_SAR_GATE
                  from xxcmp_cases where case_id = :P211_CASE_ID;
                ```
        }
        execution {
            sequence: 9
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                ```
        }
    )

