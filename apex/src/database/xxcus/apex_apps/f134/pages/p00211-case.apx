    region findings (
        name: Investigation Questionnaire
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.answer_id,
                       a.question_id,
                       (select q.section_name from xxcmp_questions q where q.question_id = a.question_id) as section_name,
                       (select q.question_text from xxcmp_questions q where q.question_id = a.question_id) as question_text,
                       a.answer_option_id,
                       a.answer_text
                  from xxcmp_request_answers a
                 where a.case_id = :P211_CASE_ID
                   and a.respondent_type = 'OFFICER'
                   -- the Enhanced Due Diligence questions only when the case is Enhanced KYC
                   and (nvl((select q.section_name from xxcmp_questions q where q.question_id = a.question_id), '#') <> 'Enhanced Due Diligence'
                        or (select c.enhanced_kyc_flag from xxcmp_cases c where c.case_id = a.case_id) = 'Y')
                 order by (select q.display_sequence from xxcmp_questions q where q.question_id = a.question_id)
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: findings
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: No investigation questions are configured.
        }
        toolbar {
            show: false
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @SECTION_NAME
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @QUESTION_TEXT
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ANSWER_OPTION_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ANSWER_TEXT
                layout {
                    sequence: 4
                }
            )
        )
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N' or :P211_SECTION = 'REVIEW'
                ```
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('RISK', 'REVIEW')
                ```
        }

        column ANSWER_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_ID
                dataType: number
                primaryKey: true
            }
        )

        column QUESTION_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_ID
                dataType: number
            }
        )

        column SECTION_NAME (
            type: displayOnly
            heading {
                heading: Section
            }
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: SECTION_NAME
                dataType: varchar2
                queryOnly: true
            }
        )

        column QUESTION_TEXT (
            type: displayOnly
            heading {
                heading: Question
            }
            layout {
                sequence: 40
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_TEXT
                dataType: varchar2
                queryOnly: true
            }
        )

        column ANSWER_OPTION_ID (
            type: selectList
            heading {
                heading: Choice
            }
            layout {
                sequence: 50
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                      from xxcmp_answer_options o
                      join xxcmp_questions q on q.question_id = o.question_id
                      join xxcmp_questionnaires qn on qn.questionnaire_code = q.questionnaire_code
                     where qn.audience = 'OFFICER' and o.enabled_flag = 'Y'
                    ```
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select answer_label as display_value, answer_option_id as return_value
                      from xxcmp_answer_options
                     where question_id = :QUESTION_ID and approval_status = 'APPROVED' and enabled_flag = 'Y'
                     order by display_sequence
                    ```
                displayNullValue: true
                nullDisplayValue: -
            }
            cascadingLov {
                parentColumns: QUESTION_ID
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_OPTION_ID
                dataType: number
            }
        )

        column ANSWER_TEXT (
            type: textarea
            heading {
                heading: Answer
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_TEXT
                dataType: varchar2
            }
        )

    )

    region screenings (
        name: Screenings
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.screening_id,
                       xxfnd_util_pkg.lookup_meaning('SCREENING_TYPE', s.screening_type) as screening_type,
                       p.party_name,
                       xxfnd_util_pkg.lookup_meaning('SCREENING_MATCH_STATUS', s.match_status) as match_status,
                       xxfnd_util_pkg.lookup_meaning('RISK_TIER', s.risk_tier) as risk_tier,
                       rtrim(case when s.pep_flag = 'Y' then 'PEP, ' end || case when s.sanctions_flag = 'Y' then 'Sanctions, ' end
                             || case when s.adverse_media_flag = 'Y' then 'Adverse media, ' end, ', ') as flags,
                       -- release 74 (R14): by hand or from the provider; a provider's result shows whether a person reviewed it
                       xxfnd_util_pkg.lookup_meaning('DATA_SOURCE', s.capture_method)
                       || case when s.capture_method = 'API' then
                              case when s.reviewed_by is null then ' · not reviewed'
                                   else ' · reviewed by ' || xxfnd_ui_pkg.person_name(s.reviewed_by) end
                              || case when s.changed_by_person_flag = 'Y' then ' · changed by a person' end end as capture_method,
                       s.screened_date, s.result_notes,
                       apex_page.get_url(p_page => 213, p_items => 'P213_SCREENING_ID,P213_CASE_ID', p_values => to_char(s.screening_id) || ',' || :P211_CASE_ID, p_clear_cache => '213') as open_url
                  from xxcmp_screenings s
                  join xxcmp_parties p on p.party_id = s.party_id
                 where s.case_id = :P211_CASE_ID
                 order by s.screened_date desc, s.screening_id desc
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: screenings
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No screening recorded yet.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('SCREENING', 'REVIEW')
                ```
        }

        column SCREENING_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column SCREENING_TYPE (
            type: plainText
            heading {
                heading: Check
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#SCREENING_TYPE#</a>
                    ```
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 30
            }
        )

        column MATCH_STATUS (
            type: plainText
            heading {
                heading: Result
            }
            layout {
                sequence: 40
            }
        )

        column RISK_TIER (
            type: plainText
            heading {
                heading: Risk Level
            }
            layout {
                sequence: 35
            }
        )

        column FLAGS (
            type: plainText
            heading {
                heading: Flags
            }
            layout {
                sequence: 50
            }
        )

        column CAPTURE_METHOD (
            type: plainText
            heading {
                heading: Source
            }
            layout {
                sequence: 60
            }
        )

        column SCREENED_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 70
            }
        )

        column RESULT_NOTES (
            type: plainText
            heading {
                heading: Conclusion
            }
            layout {
                sequence: 80
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 90
            }
        )

    )

    region party_documents (
        name: Documents and Verification
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.attached_document_id,
                       a.title, a.category_name, a.document_date, a.expiry_date,
                       case when a.expired_flag = 'Y' then 'Expired' end as expired,
                       case a.entity_name when 'XXCMP_REQUESTS' then 'Request' when 'XXCMP_CASES' then 'Case' else 'Party' end as attached_to,
                       nvl(xxfnd_util_pkg.lookup_meaning('DOC_VERIFICATION_STATUS', v.verification_status), 'Not verified') as verification,
                       v.notes,
                       case when a.datatype_code = 'FILE' then
                           apex_page.get_url(p_page => 1, p_request => 'APPLICATION_PROCESS=DOWNLOAD_DOCUMENT',
                                             p_items => 'G_DOCUMENT_ID', p_values => to_char(a.document_id)) end as download_url,
                       apex_page.get_url(p_page => 215, p_items => 'P215_VERIFICATION_ID,P215_CASE_ID,P215_ATTACHED_DOCUMENT_ID', p_values => to_char(v.verification_id) || ',' || :P211_CASE_ID || ',' || to_char(a.attached_document_id), p_clear_cache => '215') as verify_url
                  from xxfnd_attached_documents_v a
                  left join xxcmp_doc_verifications v on v.attached_document_id = a.attached_document_id and v.case_id = :P211_CASE_ID
                 where (a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = :P211_PARTY_ID)
                    or (a.entity_name = 'XXCMP_CASES' and a.pk1_value = :P211_CASE_ID)
                    or (a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = (select to_char(request_id) from xxcmp_cases where case_id = :P211_CASE_ID))
                 order by a.category_name, a.creation_date
                ```
            pageItemsToSubmit: P211_CASE_ID,P211_PARTY_ID
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_documents
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No documents on the party, the request or the case.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('DOCUMENTS', 'REVIEW')
                ```
        }

        column ATTACHED_DOCUMENT_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#DOWNLOAD_URL#">#TITLE#</a>
                    ```
            }
        )

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
        )

        column ATTACHED_TO (
            type: plainText
            heading {
                heading: On
            }
            layout {
                sequence: 40
            }
        )

        column DOCUMENT_DATE (
            type: plainText
            heading {
                heading: Dated
            }
            layout {
                sequence: 50
            }
        )

        column EXPIRY_DATE (
            type: plainText
            heading {
                heading: Expires
            }
            layout {
                sequence: 60
            }
        )

        column EXPIRED (
            type: plainText
            heading {
                heading: Expired
            }
            layout {
                sequence: 70
            }
        )

        column VERIFICATION (
            type: plainText
