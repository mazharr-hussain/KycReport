    pageItem P211_DEC_SCREENING (
        type: displayOnly
        label {
            label: Screening
            alignment: left
        }
        layout {
            sequence: 50
            region: @case-decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(*) || ' check(s); ' || count(case when match_status = 'CONFIRMED_MATCH' then 1 end) || ' confirmed match(es); '
                       || count(case when pep_flag = 'Y' then 1 end) || ' PEP flag(s)'
                  from xxcmp_screenings where case_id = :P211_CASE_ID
                ```
            used: always
        }
    )

    pageItem P211_DEC_READINESS (
        type: displayOnly
        label {
            label: Ready to Approve
            alignment: left
        }
        layout {
            sequence: 60
            region: @case-decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(xxcmp_case_pkg.approval_error(:P211_CASE_ID), 'Yes') from dual
                ```
            used: always
        }
    )

    pageItem P211_DEC_SAR_REQUIRED_FLAG (
        type: radioGroup
        label {
            label: Suspicious Activity Report Required
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Yes' as display_value, 'Y' as return_value from dual union all select 'No', 'N' from dual
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @case-decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        help {
            helpText: Required before approval for high-risk and Enhanced KYC cases.
        }
    )

