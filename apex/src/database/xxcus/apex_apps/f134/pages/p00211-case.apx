    region case-fiu-reports (
        name: FIU Reports (goAML)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R14): FIU / goAML reports of the case (filed by hand now)
                select r.fiu_report_id,
                       xxfnd_util_pkg.lookup_meaning('FIU_REPORT_TYPE', r.report_type) as report_type,
                       xxfnd_util_pkg.lookup_meaning('FIU_REPORT_STATUS', r.report_status) as report_status,
                       decode(r.report_status, 'FILED', 'success', 'APPROVED', 'info', 'CANCELLED', 'neutral', 'warning') as status_tone,
                       xxfnd_ui_pkg.person_name(r.prepared_by) as prepared_by,
                       xxfnd_ui_pkg.person_name(r.approved_by) as approved_by,
                       r.goaml_reference,
                       r.filed_date,
                       r.creation_date,
                       apex_page.get_url(p_page => 219, p_items => 'P219_FIU_REPORT_ID,P219_CASE_ID,P219_PARTY_ID',
                                         p_values => to_char(r.fiu_report_id) || ',' || r.case_id || ',' || r.party_id, p_clear_cache => '219') as open_url
                  from xxcmp_fiu_reports r
                 where r.case_id = :P211_CASE_ID
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
                P211_TASK_ID
            ]
        }
        layout {
            sequence: 56
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_fiu_reports
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('RISK', 'REVIEW') and xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No FIU report.
        }
        comments {
            comments: Release 74 (R14): suspicious transaction / activity reports to the FIU - prepared, approved by a second person, filed in goAML by hand (a goAML integration later).
        }

        column REPORT_TYPE (
            type: plainText
            heading {
                heading: Report
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#"><strong>#REPORT_TYPE#</strong></a>
                    ```
            }
        )

        column REPORT_STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-badge kyc-badge--#STATUS_TONE#">#REPORT_STATUS#</span>
                    ```
            }
        )

        column PREPARED_BY (
            type: plainText
            heading {
                heading: Prepared By
            }
            layout {
                sequence: 30
            }
        )

        column APPROVED_BY (
            type: plainText
            heading {
                heading: Approved By
            }
            layout {
                sequence: 40
            }
        )

        column GOAML_REFERENCE (
            type: plainText
            heading {
                heading: goAML Reference
            }
            layout {
                sequence: 50
            }
        )

        column FILED_DATE (
            type: plainText
            heading {
                heading: Filed On
            }
            layout {
                sequence: 60
            }
        )

        column FIU_REPORT_ID (
            type: hidden
            layout {
                sequence: 70
            }
        )

        column STATUS_TONE (
            type: hidden
            layout {
                sequence: 71
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 72
            }
        )

        column CREATION_DATE (
            type: hidden
            layout {
                sequence: 73
            }
            sorting {
                defaultSequence: 1
                direction: desc
            }
        )

    )

