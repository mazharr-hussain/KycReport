    region notes (
        name: Notes and Requests for Information
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from (
                    select 'Note' as kind, n.note_text as text, p.party_name as detail, null as status, n.created_by as by_user,
                           to_char(n.creation_date, 'DD-MON-YYYY HH24:MI') as at_time, n.creation_date as sort_date, null as open_url
                      from xxcmp_case_notes n
                      left join xxcmp_parties p on p.party_id = n.related_party_id
                     where n.case_id = :P211_CASE_ID
                    union all
                    select 'RFI ' || r.rfi_number, xxfnd_util_pkg.lookup_meaning('RFI_CATEGORY', r.rfi_category),
                           case r.continue_other_work_flag when 'N' then 'Pauses the case' end
                           || nvl2(r.due_date, ' - due ' || to_char(r.due_date, 'DD-MON-YYYY'), null)
                           || nvl2(r.responded_date, ' - answered ' || to_char(r.responded_date, 'DD-MON-YYYY'), null),
                           xxfnd_util_pkg.lookup_meaning('RFI_STATUS', r.rfi_status), r.created_by,
                           to_char(r.creation_date, 'DD-MON-YYYY HH24:MI'), r.creation_date,
                           apex_page.get_url(p_page => 31, p_items => 'P31_RFI_ID', p_values => to_char(r.rfi_id), p_clear_cache => '31')
                      from xxfnd_rfis r
                     where (r.entity_name = 'XXCMP_CASES' and r.pk1_value = :P211_CASE_ID)
                        or (r.entity_name = 'XXCMP_REQUESTS' and r.pk1_value = (select to_char(request_id) from xxcmp_cases where case_id = :P211_CASE_ID))
                )
                 where :P211_NOTE_FILTER is null
                    or (:P211_NOTE_FILTER = 'NOTES' and kind = 'Note')
                    or (:P211_NOTE_FILTER = 'RFIS' and kind like 'RFI%')
                    or (:P211_NOTE_FILTER = 'OPEN' and kind like 'RFI%' and status in (select meaning from xxfnd_lookup_values
                                                                                         where lookup_type = 'RFI_STATUS'
                                                                                           and lookup_code in ('WAITING_FOR_INFORMATION', 'ON_HOLD_PENDING')))
                 order by sort_date desc
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
                P211_NOTE_FILTER
            ]
        }
        layout {
            sequence: 70
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: notes
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('NOTES', 'REVIEW')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No notes or requests for information yet.
        }

        column KIND (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
