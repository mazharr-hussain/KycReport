            }
            layout {
                sequence: 502
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
        )

        column EDIT_URL (
            type: hidden
            heading {
