page 20 (
    name: Parties
    alias: PARTIES
    title: Parties
    pageGroup: @parties
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Every company and person the organization deals with. Open a party to see contacts, ownership, documents and additional information.
    }

    region breadcrumb (
        name: Parties
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Parties
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       xxfnd_ui_pkg.status_tone('PARTY', q.party_status_code) as status_tone,
                       apex_page.get_url(p_page => 21, p_items => 'P21_PARTY_ID', p_values => to_char(q.party_id), p_clear_cache => '21') as open_url,
                       case when xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE') and q.enabled_flag = 'Y'
                            then apex_page.get_url(p_page => 24, p_items => 'P24_PARTY_ID', p_values => to_char(q.party_id),
                                                   p_clear_cache => '24,25,21') end as edit_url,
                       case when xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE') and q.enabled_flag = 'Y' then 'Edit' end as edit
                  from (

                    select p.party_id,
                           p.party_number,
                           p.party_name,
                           (select listagg(distinct xxfnd_util_pkg.lookup_meaning('BUSINESS_RELATIONSHIP', r.business_relationship), ', ')
                                     within group (order by 1)
                              from xxcmp_requests r
                             where r.party_id = p.party_id and r.business_relationship is not null
                               and r.request_status not in ('CANCELLED', 'DRAFT')) as business_relationships,
                           xxfnd_util_pkg.lookup_meaning('PARTY_TYPE', p.party_type) as party_type,
                           p.registration_number,
                           xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction) as jurisdiction,
                           xxfnd_util_pkg.lookup_meaning(xxcmp_party_pkg.entity_lookup(p.party_type), p.entity_type) as entity_type,
                           p.incorporation_date,
                           p.email,
                           p.phone,
                           (select max(c.contact_name) keep (dense_rank first order by c.primary_flag desc, c.party_contact_id)
                              from xxcmp_party_contacts c where c.party_id = p.party_id and c.enabled_flag = 'Y') as primary_contact,
                           xxfnd_util_pkg.lookup_meaning('PARTY_STATUS', p.party_status) as party_status,
                           p.party_status as party_status_code,
                           p.next_kyc_date,
                           xxfnd_util_pkg.lookup_meaning('DATA_PROVENANCE', p.data_provenance) as data_provenance,
                           p.last_verified_date,
                           p.enabled_flag,
                           (select m.party_number from xxcmp_parties m where m.party_id = p.merged_into_party_id) as merged_into,
                           p.created_by,
                           p.creation_date,
                           p.last_updated_by,
                           p.last_update_date
                      from xxcmp_parties p
                ) q
                 order by q.party_number
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        download {
            formats: [
                csv
                html
                excel
            ]
        }

        column PARTY_ID (
            type: hidden
            heading {
                heading: Party Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Number
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#PARTY_NUMBER#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column BUSINESS_RELATIONSHIPS (
            type: plainText
            heading {
                heading: Business Relationships
            }
            layout {
                sequence: 35
            }
            source {
                dataType: STRING
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column PARTY_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration No. / ID Number
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column JURISDICTION (
