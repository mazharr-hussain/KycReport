        savedReport PRIMARY (
            visibility: primaryDefault
            view {
                default: report
            }

            displayColumn PARTY_NUMBER (
                layout {
                    sequence: 1
                }
            )

            displayColumn BUSINESS_RELATIONSHIPS (
                layout {
                    sequence: 3
                }
            )

            displayColumn PARTY_NAME (
                layout {
                    sequence: 2
                }
            )

            displayColumn PARTY_TYPE (
                layout {
                    sequence: 3
                }
            )

            displayColumn REGISTRATION_NUMBER (
                layout {
                    sequence: 4
                }
            )

            displayColumn JURISDICTION (
