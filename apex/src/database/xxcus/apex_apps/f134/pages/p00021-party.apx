page 21 (
    name: Party
    alias: PARTY
    title: Party
    pageGroup: @parties
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    readOnly {
        type: expression
        language: plsql
        plsqlExpression:
            ```plsql
            :P21_PARTY_ID is not null and nvl(:P21_MODE, 'VIEW') <> 'EDIT'
            ```
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            One party: identity, main contact details, additional information, contact persons, ownership and documents. Opens read only. Edit (Parties - Manage) makes the party form editable (Save) and shows the buttons to add contact persons, owners / officers and documents. Compliance can merge this party into a similar one.
            ```
    }

    region breadcrumb (
        name: Party
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

