    dynamicAction merge-into (
        name: Merge into an existing party
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-merge-into
        }

        action merge-into-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var a = $(this.triggeringElement);
                    this.browserEvent.preventDefault();
                    apex.message.confirm("Merge this party into " + a.data("label") + "? Its requests, cases, contacts, "
                        + "ownership and documents move there and this party is disabled.", function (ok) {
                        if (ok) {
                            apex.page.submit({ request: "MERGE", set: { P21_MERGE_INTO_ID: String(a.data("party")) },
                                               validate: false });
                        }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    region missing-docs (
        name: Mandatory Documents
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                    l_missing apex_t_varchar2;
                    l_html    varchar2(32767);
                    l_name    varchar2(240);
                    l_party   xxcmp_parties%rowtype;
                begin
                    select * into l_party from xxcmp_parties where party_id = :P21_PARTY_ID;
                    l_missing := xxcmp_kyc_pkg.missing_categories('XXCMP_PARTIES', to_char(l_party.party_id),
                                                                  l_party.jurisdiction, l_party.entity_type);
                    if l_missing.count = 0 then
                        return '<p class="u-success-text">All mandatory documents are on file.</p>';
                    end if;
                    l_html := '<p>Still needed:</p><ul>';
                    for i in 1 .. l_missing.count loop
                        select max(category_name) into l_name
                          from xxfnd_document_categories_vl
                         where category_code = l_missing(i);
                        l_html := l_html || '<li>' || apex_escape.html(nvl(l_name, l_missing(i))) || '</li>';
                    end loop;
                    return l_html || '</ul>';
                end;
                ```
            pageItemsToSubmit: P21_PARTY_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: missing-docs
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_PARTY_ID
        }
    )

