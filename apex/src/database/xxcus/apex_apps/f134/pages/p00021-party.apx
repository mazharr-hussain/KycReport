                       case when :P21_MODE = 'EDIT' then 'Edit' end as edit,
                       c.created_by, c.creation_date, c.last_updated_by, c.last_update_date
                  from xxcmp_party_contacts c
                 where c.party_id = :P21_PARTY_ID
