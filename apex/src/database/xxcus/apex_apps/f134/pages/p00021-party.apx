    validation party-rules (
        name: Party form rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the rules of the common party form, the same on every page that uses it
                return xxcmp_party_pkg.party_error(to_number(:P21_PARTY_ID), :P0_PARTY_TYPE, :P0_PARTY_NAME,
                           :P0_PARTY_JURISDICTION, :P0_PARTY_REGISTRATION_NUMBER, :P0_PARTY_ENTITY_TYPE,
                           to_date(:P0_PARTY_INCORPORATION_DATE), :P0_PARTY_EMAIL, :P0_PARTY_PHONE,
                           'N', nvl(:P0_PARTY_MATCH_ACK, 'N'));
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SAVE_TOP
        }
    )

    validation party-dff (
        name: Validate additional information
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.validate('XXCMP_PARTIES', :P21_DFF_JSON, :P21_DFF_CONTEXT, :P21_PARTY_ID, p_reference_value => :P0_PARTY_TYPE);
                ```
        }
        error {
            associatedItem: @P21_DFF_CONTEXT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SAVE_TOP
        }
    )

    process save-party (
        name: Save party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number := to_number(:P21_PARTY_ID);
                begin
                    xxcmp_party_pkg.save_party(
                        p_party_id            => l_id,
                        p_party_type          => :P0_PARTY_TYPE,
                        p_party_name          => :P0_PARTY_NAME,
                        p_jurisdiction        => :P0_PARTY_JURISDICTION,
                        p_registration_number => :P0_PARTY_REGISTRATION_NUMBER,
                        p_entity_type         => :P0_PARTY_ENTITY_TYPE,
                        p_incorporation_date  => to_date(:P0_PARTY_INCORPORATION_DATE),
                        p_email               => :P0_PARTY_EMAIL,
                        p_phone               => :P0_PARTY_PHONE,
                        p_website             => :P0_PARTY_WEBSITE,
                        p_fax                 => :P0_PARTY_FAX,
                        p_data_provenance     => :P0_PARTY_DATA_PROVENANCE,
                        p_enabled_flag        => :P0_PARTY_ENABLED_FLAG,
                        p_match_ack           => nvl(:P0_PARTY_MATCH_ACK, 'N'));
                    xxfnd_dff_pkg.save('XXCMP_PARTIES', l_id, :P21_DFF_JSON, :P21_DFF_CONTEXT, p_reference_value => :P0_PARTY_TYPE);
                end;
                ```
        }
        execution {
            sequence: 6
            point: processing
        }
        successMessage {
            successMessage: Party saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SAVE_TOP
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    branch (
        name: Stay on the party (edit)
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 21
                items: {
                    P21_PARTY_ID: &P21_PARTY_ID.
                    P21_MODE: EDIT
                }
                clearCache: 21
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SAVE_TOP
        }
    )

    process merge-party (
        name: Merge into another party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_party_pkg.merge_parties(:P21_PARTY_ID, to_number(:P21_MERGE_INTO_ID));
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        successMessage {
            successMessage: The party was merged: you are now on the party it was merged into.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )

    branch (
        name: To the kept party
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 21
                items: {
                    P21_PARTY_ID: &P21_MERGE_INTO_ID.
                }
                clearCache: 21
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )

    process initialize-party (
        name: Load the party into the common party form (editable in Edit mode)
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_party_pkg.load_items(to_number(:P21_PARTY_ID),
                    case when :P21_MODE = 'EDIT' and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE')
                          and xxcmp_party_pkg.is_enabled(:P21_PARTY_ID) = 'Y' then 'N' else 'Y' end);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

)
