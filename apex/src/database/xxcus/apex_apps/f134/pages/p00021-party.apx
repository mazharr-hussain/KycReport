    region relationships (
        name: Ownership and Control
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.party_relationship_id,
                       case when r.object_party_id = :P21_PARTY_ID then 'Holds interest in this party'
                            else 'This party holds interest in' end as direction,
                       o.party_name || ' (' || o.party_number || ')' as related_party,
                       xxfnd_util_pkg.lookup_meaning('RELATIONSHIP_TYPE', r.relationship_type) as relationship_type,
                       r.ownership_percentage,
                       r.start_date,
                       r.end_date,
                       case when :P21_MODE = 'EDIT'
                            then apex_page.get_url(p_page => 23, p_items => 'P23_PARTY_RELATIONSHIP_ID,P23_OBJECT_PARTY_ID',
                                                   p_values => to_char(r.party_relationship_id) || ',' || :P21_PARTY_ID,
                                                   p_clear_cache => '23') end as edit_url,
                       case when :P21_MODE = 'EDIT' then 'Edit' end as edit,
                       r.created_by, r.creation_date, r.last_updated_by, r.last_update_date
                  from xxcmp_party_relationships r
                  join xxcmp_parties o
                    on o.party_id = case when r.object_party_id = :P21_PARTY_ID then r.subject_party_id
                                         else r.object_party_id end
                 where :P21_PARTY_ID in (r.object_party_id, r.subject_party_id)
                ```
            pageItemsToSubmit: P21_PARTY_ID,P21_MODE
        }
        layout {
            sequence: 60
            slot: BODY
        }
