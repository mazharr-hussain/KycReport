page 200 (
    name: KYC Requests
    alias: KYC-REQUESTS
    title: KYC Requests
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            KYC requests you may see: your own, or all of them for the Compliance team. Create Request starts a new one.
            ```
    }

    region breadcrumb (
        name: KYC Requests
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: KYC Requests
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       xxfnd_ui_pkg.status_tone('REQUEST', q.request_status) as stage_tone,
                       xxfnd_ui_pkg.person_name(q.pending_with) as pending_with_name,
                       xxfnd_ui_pkg.person_name(q.requester_user_name) as requester_name,
                       case when q.case_id is not null then
                           apex_page.get_url(p_page => 211, p_items => 'P211_CASE_ID', p_values => to_char(q.case_id), p_clear_cache => '211')
                       end as case_url,
                       apex_page.get_url(p_page => 205, p_items => 'P205_REQUEST_ID', p_values => to_char(q.request_id), p_clear_cache => '205') as open_url,
                       -- the requester's action by status: Edit (Draft, Information Needed; Cancel is on the edit screen),
                       -- Withdraw (waiting for approval: back to Draft)
                       case when upper(q.requester_user_name) <> upper(:APP_USER) then null
                            when q.request_status in ('DRAFT', 'INFO_NEEDED', 'REJECTED')
                            then apex_page.get_url(p_page => 201, p_items => 'P201_REQUEST_ID', p_values => to_char(q.request_id), p_clear_cache => '201,202,203,204')
                            when q.request_status = 'IN_PROGRESS' and q.case_number is null then '#'
                       end as edit_url,
                       case when upper(q.requester_user_name) <> upper(:APP_USER) then null
                            when q.request_status in ('DRAFT', 'INFO_NEEDED', 'REJECTED') then 'Edit'
                            when q.request_status = 'IN_PROGRESS' and q.case_number is null then 'Withdraw'
                       end as edit
                  from (
                        select r.request_id,
                               r.request_number,
                               r.party_name,
                               xxfnd_util_pkg.lookup_meaning('BUSINESS_RELATIONSHIP', r.business_relationship) as business_relationship,
                               xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type) as request_type,
                               xxcmp_request_pkg.stage(r.request_id) as stage,
                               xxcmp_request_pkg.kyc_required(r.request_id) as kyc_required,
                               xxcmp_request_pkg.pending_with(r.request_id) as pending_with,
                               r.last_action_date,
                               xxfnd_util_pkg.lookup_meaning('KYC_INTAKE_OUTCOME', r.intake_outcome) as intake_outcome,
                               r.intake_score,
                               xxfnd_util_pkg.lookup_meaning('REQUESTING_DEPARTMENT', r.requesting_department) as department,
                               r.requester_user_name,
                               r.request_status,
                               r.submitted_date,
                               (select c.case_number from xxcmp_cases c where c.request_id = r.request_id) as case_number,
                               (select c.case_id from xxcmp_cases c where c.request_id = r.request_id) as case_id,
                               r.created_by, r.creation_date, r.last_updated_by, r.last_update_date
                          from xxcmp_requests r
                       ) q
                 order by q.request_number desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        download {
            formats: [
                csv
                html
                excel
            ]
        }

        column REQUEST_ID (
            type: hidden
            heading {
                heading: Request Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column REQUEST_NUMBER (
            type: plainText
            heading {
                heading: Request
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#REQUEST_NUMBER#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column BUSINESS_RELATIONSHIP (
            type: plainText
            heading {
                heading: Relationship
            }
            layout {
                sequence: 35
            }
            source {
                dataType: STRING
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Counterparty
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column REQUEST_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column STAGE (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-badge kyc-badge--#STAGE_TONE#">#STAGE#</span>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column KYC_REQUIRED (
            type: plainText
            heading {
                heading: KYC Required
            }
            layout {
                sequence: 64
            }
            source {
                dataType: STRING
            }
        )


        column PENDING_WITH (
            type: plainText
            heading {
                heading: Pending With
            }
            layout {
                sequence: 66
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-person" tabindex="0" data-user="#PENDING_WITH#">#PENDING_WITH_NAME#</span>
                    ```
            }
            source {
                dataType: STRING
            }
        )


        column LAST_ACTION_DATE (
            type: plainText
            heading {
                heading: Action Date
            }
            layout {
                sequence: 68
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
        )


        column INTAKE_OUTCOME (
            type: plainText
            heading {
                heading: Intake Outcome
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column INTAKE_SCORE (
            type: plainText
            heading {
                heading: Intake Score
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )

        column DEPARTMENT (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column REQUESTER_USER_NAME (
            type: plainText
            heading {
                heading: Requested By
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-person" tabindex="0" data-user="#REQUESTER_USER_NAME#">#REQUESTER_NAME#</span>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column SUBMITTED_DATE (
            type: plainText
            heading {
                heading: Submitted
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

        column CASE_NUMBER (
            type: plainText
            heading {
                heading: Case
            }
            layout {
                sequence: 110
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#CASE_URL#">#CASE_NUMBER#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column EDIT (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 115
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#EDIT_URL#" class="kyc-row-action" data-id="#REQUEST_ID#" data-action="#EDIT#">#EDIT#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
        )

        column EDIT_URL (
            type: hidden
            heading {
                heading: Edit Url
            }
            layout {
                sequence: 125
            }
            source {
                dataType: STRING
            }
        )

        column REQUEST_STATUS (
            type: hidden
            heading {
                heading: Status Code
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
        )

        column STAGE_TONE (
            type: hidden
            heading {
                heading: Stage Tone
            }
            layout {
                sequence: 131
            }
            source {
                dataType: STRING
            }
        )

        column PENDING_WITH_NAME (
            type: hidden
            heading {
                heading: Pending With Name
            }
            layout {
                sequence: 132
            }
            source {
                dataType: STRING
            }
        )

        column REQUESTER_NAME (
            type: hidden
            heading {
                heading: Requester Name
            }
            layout {
                sequence: 133
            }
            source {
                dataType: STRING
            }
        )

        column CASE_URL (
            type: hidden
            heading {
                heading: Case Url
            }
            layout {
                sequence: 134
            }
            source {
                dataType: STRING
            }
        )

        column CASE_ID (
            type: hidden
            heading {
                heading: Case Id
            }
            layout {
                sequence: 135
            }
            source {
                dataType: NUMBER
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 400
            }
            source {
                dataType: STRING
            }
        )


        column CREATION_DATE (
            type: plainText
            heading {
                heading: Created On
            }
            layout {
                sequence: 410
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
        )


        column LAST_UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 420
            }
            source {
                dataType: STRING
            }
        )


        column LAST_UPDATE_DATE (
            type: plainText
            heading {
                heading: Updated On
            }
            layout {
                sequence: 430
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
        )


        savedReport PRIMARY (
            visibility: primaryDefault
            view {
                default: report
            }

            displayColumn REQUEST_NUMBER (
                layout {
                    sequence: 1
                }
            )

            displayColumn BUSINESS_RELATIONSHIP (
                layout {
                    sequence: 2
                }
            )

            displayColumn PARTY_NAME (
                layout {
                    sequence: 2
                }
            )

            displayColumn STAGE (
                layout {
                    sequence: 3
                }
            )


            displayColumn PENDING_WITH (
                layout {
                    sequence: 5
                }
            )

            displayColumn LAST_ACTION_DATE (
                layout {
                    sequence: 6
                }
            )



            displayColumn CASE_NUMBER (
                layout {
                    sequence: 9
                }
            )

            displayColumn EDIT (
                layout {
                    sequence: 10
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create Request
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction withdraw (
        name: Withdraw a request
        execution {
            sequence: 30
            eventScope: dynamic
            staticContainer: #report
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-row-action[data-action="Withdraw"]
        }

        action withdraw-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var id = $(this.triggeringElement).data("id");
                    this.browserEvent.preventDefault();
                    apex.message.confirm("Withdraw this request from approval? It goes back to Draft: you can then edit or cancel it.", function (ok) {
                        if (!ok) { return; }
                        apex.server.process("WITHDRAW", { x01: id }, { dataType: "text" }).done(function (err) {
                            err = $.trim(err);    // the reply ends with a line break even when there is no error
                            if (err) {
                                apex.message.alert(err);
                            } else {
                                apex.message.showPageSuccess("Request withdrawn: it is back in Draft.");
                            }
                            apex.region("report").refresh();
                        });
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process withdraw (
        name: WITHDRAW
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id    number := to_number(apex_application.g_x01);
                    l_error varchar2(4000) := xxcmp_request_pkg.withdraw_error(l_id);
                begin
                    if l_error is null then
                        xxcmp_request_pkg.withdraw(l_id);
                    end if;
                    htp.p(l_error);
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )

)
