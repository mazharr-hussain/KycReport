        buttonName: RESPOND
        label: Respond
        layout {
            sequence: 10
            region: @respond
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation response-given (
        name: Answer given
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when trim(:P205_RESPONSE) is null then 'Enter your answer for Compliance.' end;
                ```
        }
        error {
            associatedItem: @P205_RESPONSE
        }
        serverSideCondition {
            whenButtonPressed: @respond
        }
    )

    process respond-task (
        name: Answer Compliance
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- the task event Submit Information moves the request back to In Progress (task action)
                apex_human_task.submit_information(p_task_id => :P205_INFO_TASK_ID, p_text => :P205_RESPONSE);
                ```
        }
        execution {
            sequence: 50
            point: processing
        }
        successMessage {
            successMessage: Your answer was sent: the request is back with Compliance.
        }
        serverSideCondition {
            whenButtonPressed: @respond
        }
    )

    process cancel-request-process (
        name: Cancel the request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_request_pkg.cancel(:P205_REQUEST_ID);
                ```
        }
        execution {
            sequence: 60
            point: processing
        }
        successMessage {
            successMessage: Request cancelled.
        }
        serverSideCondition {
            whenButtonPressed: @cancel-request
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process find-info-task (
        name: The requester's information request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- Compliance asked this requester for information: the task waits for their answer
                select max(t.task_id) into :P205_INFO_TASK_ID
                  from apex_tasks t
                  join xxcmp_requests r on to_char(r.request_id) = t.detail_pk
                 where t.detail_pk = :P205_REQUEST_ID
                   and t.task_def_static_id = 'DOC_CHECKLIST_REVIEW'
                   and t.state_code = 'INFO_REQUESTED'
                   and upper(r.requester_user_name) = upper(:APP_USER);
                ```
        }
        execution {
            sequence: 8
            point: beforeHeader
        }
    )

    button open-case (
        buttonName: OPEN_CASE
        label: Open Case
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                items: {
                    P211_CASE_ID: &P205_CASE_ID.
                }
                clearCache: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P205_CASE_ID is not null and xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }
    )

    validation reject-reason (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P205_COMMENT is null then 'Enter why the request is rejected.' end;
                ```
        }
        error {
            associatedItem: @P205_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT
        }
    )

    validation info-question (
        name: Information requested
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P205_COMMENT is null then 'Enter the information you need from the requester.' end;
                ```
        }
        error {
            associatedItem: @P205_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REQUEST_INFO
        }
    )

    process open-from-task (
        name: Open from task
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select to_number(detail_pk) into :P205_REQUEST_ID
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'SINGLE_TASK',
                                   p_task_id        => :P205_TASK_ID,
                                   p_application_id => :APP_ID ) )
                 where task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'COUNTERPARTY_MATCH');
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P205_TASK_ID
        }
    )

    process find-my-task (
        name: My open task on this request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- opened from KYC Requests (not My Tasks): use the approver's own open task on this request
                select max(t.task_id) into :P205_TASK_ID
                  from table ( apex_human_task.get_tasks ( p_context => 'MY_TASKS', p_application_id => :APP_ID ) ) t
                 where t.detail_pk = :P205_REQUEST_ID
                   and t.task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'COUNTERPARTY_MATCH')
                   and t.state_code in ('ASSIGNED', 'UNASSIGNED');
                ```
        }
        execution {
            sequence: 7
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P205_TASK_ID
        }
    )

    process load-case (
        name: Load case
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select max(case_id) into :P205_CASE_ID from xxcmp_cases where request_id = :P205_REQUEST_ID;
                -- the breadcrumb shows the request number before the page items are rendered
                select max(request_number), max(party_id) into :P205_REQUEST_NUMBER, :P205_PARTY_ID
                  from xxcmp_requests where request_id = :P205_REQUEST_ID;
                ```
        }
        execution {
            sequence: 6
            point: beforeHeader
        }
    )

    process add-comment (
        name: Record comment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P205_TASK_ID, p_text => :P205_COMMENT);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P205_COMMENT
        }
    )

    process approve-task (
        name: Approve checklist
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.approve_task(p_task_id => :P205_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Checklist approved: the case will be opened.
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
    )

    process reject-task (
        name: Reject request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P205_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Request rejected.
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    process request-info-task (
        name: Request information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- the question goes to the requester (task initiator); an unclaimed task is claimed first
                for t in (select 1 from apex_tasks where task_id = :P205_TASK_ID and state_code = 'UNASSIGNED') loop
                    apex_human_task.claim_task(p_task_id => :P205_TASK_ID);
                end loop;
                apex_human_task.request_more_information(p_task_id => :P205_TASK_ID, p_text => :P205_COMMENT);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Information requested: the requester answers in My Tasks, then the task comes back to you.
        }
        serverSideCondition {
            whenButtonPressed: @request-info
        }
    )

)
