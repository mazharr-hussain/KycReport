    dynamicAction refresh-request_attachments (
        name: Refresh request_attachments
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @request_attachments
        }

        action refresh-request_attachments-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @request_attachments
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )
    region approval_history (
        name: Approval
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.task_def_name as step,
                       t.state as status,
                       coalesce(t.actual_owner,
                                (select listagg(p.participant, ', ') within group (order by p.participant)
                                   from apex_task_participants p
                                  where p.task_id = t.task_id and p.participant_type = 'POTENTIAL_OWNER')) as assigned_to,
                       t.outcome,
                       t.created_on as started,
                       case when t.state_code in ('COMPLETED', 'CANCELED', 'ERRORED', 'EXPIRED') then t.last_updated_on end as finished,
                       (select max(h.event_creator) keep (dense_rank last order by h.event_timestamp)
                          from apex_task_history h where h.task_id = t.task_id and h.event_type_code in ('COMPLETE', 'APPROVE', 'REJECT')) as decided_by
                  from apex_tasks t
                 where t.application_id = :APP_ID
                   and t.detail_pk = :P205_REQUEST_ID
                   and t.task_def_static_id in ('COUNTERPARTY_MATCH', 'DOC_CHECKLIST_REVIEW')
                 order by t.created_on
                ```
            pageItemsToSubmit: P205_REQUEST_ID
        }
        layout {
            sequence: 65
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: approval_history
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No approval step yet: the request is a draft, or it was closed at intake (see Stage).
        }

        column STEP (
            type: plainText
            heading {
                heading: Step
            }
            layout {
                sequence: 10
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
        )

        column ASSIGNED_TO (
            type: plainText
            heading {
                heading: With
            }
            layout {
                sequence: 30
            }
        )

        column OUTCOME (
            type: plainText
            heading {
                heading: Outcome
            }
            layout {
                sequence: 40
            }
        )

        column STARTED (
            type: plainText
            heading {
                heading: Started
            }
            layout {
                sequence: 50
            }
        )

        column FINISHED (
            type: plainText
            heading {
                heading: Finished
            }
            layout {
                sequence: 60
            }
        )

        column DECIDED_BY (
            type: plainText
            heading {
                heading: Decided By
            }
            layout {
                sequence: 70
            }
        )

    )

    region decision (
        name: Checklist Decision
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Approve approves the request and its party and opens the case for investigation. Reject closes the request. Request Information sends your question to the requester; the request is Information Needed until they respond.</p>
                ```
        }
        layout {
            sequence: 70
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: decision
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P205_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P205_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P205_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    pageItem P205_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 10
            region: @decision
            slot: regionBody
