page 205 (
    name: KYC Request
    alias: KYC-REQUEST
    title: KYC Request
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            A KYC request: where it stands, the answers and the documents. Compliance reviews the document checklist here.
            ```
    }

    region breadcrumb (
        name: KYC Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region request (
        name: Request
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P205_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P205_TASK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P205_CASE_ID (
        type: hidden
        layout {
            sequence: 3
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P205_PARTY_ID (
        type: hidden
        layout {
            sequence: 4
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P205_REQUEST_NUMBER (
        type: displayOnly
        label {
            label: Request
            alignment: left
        }
        layout {
            sequence: 10
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select request_number from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_STAGE (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 20
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxcmp_request_pkg.stage(:P205_REQUEST_ID) from dual
                ```
            used: always
        }
    )

    pageItem P205_KYC_REQUIRED (
        type: displayOnly
        label {
            label: KYC Required
            alignment: left
        }
        layout {
            sequence: 22
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxcmp_request_pkg.kyc_required(:P205_REQUEST_ID) from dual
                ```
            used: always
        }
    )

    pageItem P205_PENDING_WITH (
        type: displayOnly
        label {
            label: Pending With
            alignment: left
        }
        layout {
            sequence: 24
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxcmp_request_pkg.pending_with(:P205_REQUEST_ID) from dual
                ```
            used: always
        }
    )

    pageItem P205_ACTION_DATE (
        type: displayOnly
        label {
            label: Action Date
            alignment: left
        }
        layout {
            sequence: 26
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(last_action_date, 'DD-MON-YYYY HH24:MI') from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_COUNTERPARTY (
        type: displayOnly
        label {
            label: Counterparty
            alignment: left
        }
        layout {
            sequence: 30
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select party_name || ' (' || xxfnd_util_pkg.lookup_meaning('PARTY_TYPE', party_type)
                       || nvl2(registration_number, ', ' || registration_number, null)
                       || nvl2(jurisdiction, ', ' || xxfnd_util_pkg.lookup_meaning('JURISDICTION', jurisdiction), null) || ')'
                  from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_REQUEST_TYPE (
        type: displayOnly
        label {
            label: Type
            alignment: left
        }
        layout {
            sequence: 40
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', request_type) from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_INTAKE (
        type: displayOnly
        label {
            label: Intake Result
            alignment: left
        }
        layout {
            sequence: 50
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('KYC_INTAKE_OUTCOME', intake_outcome)
                       || nvl2(intake_score, ' (score ' || intake_score || case when intake_critical_flag = 'Y' then ', critical answer' end || ')', null)
                  from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_REQUESTED_BY (
        type: displayOnly
        label {
            label: Requested By
            alignment: left
        }
        layout {
            sequence: 60
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select requester_user_name || nvl2(requesting_department, ' - '
                       || xxfnd_util_pkg.lookup_meaning('REQUESTING_DEPARTMENT', requesting_department), null)
                  from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_JUSTIFICATION (
        type: displayOnly
        label {
            label: Business Justification
            alignment: left
        }
        layout {
            sequence: 70
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select justification from xxcmp_requests where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_PARTY (
        type: displayOnly
        label {
            label: Party
            alignment: left
        }
        layout {
            sequence: 80
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case when p.party_id is not null then p.party_number || ' - ' || p.party_name
                            when r.party_id is not null then 'Linked to a party'
                            else 'Not decided yet' end
                       || nvl2(r.match_status, ' (' || xxfnd_util_pkg.lookup_meaning('REQUEST_MATCH_STATUS', r.match_status) || ')', null)
                  from xxcmp_requests r
                  left join xxcmp_parties p on p.party_id = r.party_id
                 where r.request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P205_CASE_NUMBER (
        type: displayOnly
        label {
            label: Case
            alignment: left
        }
        layout {
            sequence: 90
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select max(case_number) from xxcmp_cases where request_id = :P205_REQUEST_ID
                ```
            used: always
        }
    )

    region party_card (
        name: Party
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_party_pkg.card_html(:P205_PARTY_ID);
                ```
            pageItemsToSubmit: P205_PARTY_ID
        }
        layout {
            sequence: 25
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_card
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P205_PARTY_ID
        }
    )

    button edit-party (
        buttonName: EDIT_PARTY
        label: Edit Party
        layout {
            sequence: 10
            region: @party_card
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                items: {
                    P24_PARTY_ID: &P205_PARTY_ID.
                }
                clearCache: 24
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P205_PARTY_ID is not null and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE')
                and xxcmp_party_pkg.is_enabled(:P205_PARTY_ID) = 'Y'
                ```
        }
    )

    dynamicAction refresh-party-card (
        name: Refresh the party card
        execution {
            sequence: 80
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @party_card
        }

        action refresh-party-card-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party_card
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    region answer_summary (
        name: Answers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select q.question_text from xxcmp_questions q where q.question_id = a.question_id) as question,
                       coalesce((select o.answer_label from xxcmp_answer_options o where o.answer_option_id = a.answer_option_id), a.answer_text, '-') as answer,
                       a.risk_points
                  from xxcmp_request_answers a
                 where a.request_id = :P205_REQUEST_ID and a.respondent_type = 'REQUESTER'
                 order by (select q.display_sequence from xxcmp_questions q where q.question_id = a.question_id)
                ```
            pageItemsToSubmit: P205_REQUEST_ID
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: answer_summary
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No data found.
        }

        column QUESTION (
            type: plainText
            heading {
                heading: Question
            }
            layout {
                sequence: 10
            }
        )

        column ANSWER (
            type: plainText
            heading {
                heading: Answer
            }
            layout {
                sequence: 20
            }
        )

        column RISK_POINTS (
            type: plainText
            heading {
                heading: Points
            }
            layout {
                sequence: 30
            }
        )

    )

    region checklist (
        name: Document Checklist
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.column_value as category_code,
                       (select nvl(tl.category_name, dc.category_name) from xxfnd_document_categories dc
                          left join xxfnd_document_categories_tl tl on tl.category_code = dc.category_code and tl.language_code = xxfnd_util_pkg.current_lang
                         where dc.category_code = c.column_value) as category,
                       case when exists (select 1 from xxfnd_attached_documents_v a
                                          where a.category_code = c.column_value and nvl(a.expired_flag, 'N') = 'N'
                                            and ((a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = :P205_REQUEST_ID)
                                              or (a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = (select to_char(party_id) from xxcmp_requests where request_id = :P205_REQUEST_ID))))
                            then 'Present' else 'Missing' end as status
                  from table(xxcmp_kyc_pkg.mandatory_categories('XXCMP_PARTIES',
                                 (select jurisdiction from xxcmp_requests where request_id = :P205_REQUEST_ID),
                                 (select entity_type from xxcmp_requests where request_id = :P205_REQUEST_ID))) c
                ```
            pageItemsToSubmit: P205_REQUEST_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: checklist
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No mandatory documents are configured for this counterparty.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }

        column CATEGORY_CODE (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Mandatory Document
            }
            layout {
                sequence: 20
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

    )

    region counterparty_matching (
        name: Possible Duplicate Parties
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>The counterparty was created as a new (Pending) party with the request. If it is an existing party, merge it into that party: the request, its documents and contacts move there and the duplicate is disabled.</p>
                ```
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: counterparty_matching
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Compliance, while the request's own new party is still Pending
                select 1
                  from xxcmp_requests r
                  join xxcmp_parties p on p.party_id = r.party_id
                 where r.request_id = :P205_REQUEST_ID and r.party_selection = 'NEW' and p.party_status = 'PENDING'
                   and p.enabled_flag = 'Y' and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE')
                ```
        }
    )

    pageItem P205_MERGE_PARTY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Set by the Merge link just before submit. XXCMP_PARTY_PKG.MERGE_PARTIES re-checks the privilege, the party types and that both parties are enabled.
        }
        layout {
            sequence: 1
            region: @counterparty_matching
            slot: regionBody
        }
    )

    pageItem P205_MATCH_NOTE (
        type: textarea
        label {
            label: Merge Note
            alignment: left
        }
        layout {
            sequence: 10
            region: @counterparty_matching
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Why the counterparty is this existing party.
        }
    )

    region match_candidates (
        name: Existing Parties That May Be This Counterparty
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_number,
                       j.party_name, j.country, j.status, j.score, j.reg_match, j.reasons,
                       apex_page.get_url(p_page => 21, p_items => 'P21_PARTY_ID', p_values => to_char(j.party_id), p_clear_cache => '21') as party_url,
                       'Merge into this party' as merge
                  from json_table(xxcmp_request_pkg.request_candidates_json(:P205_REQUEST_ID), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  status varchar2(80) path '$.status',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: P205_REQUEST_ID
        }
        layout {
            sequence: 20
            slot: BODY
            parentRegion: @counterparty_matching
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: match_candidates
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this counterparty any more.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_URL (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#PARTY_URL#" target="_blank">#PARTY_NUMBER#</a>
                    ```
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration / ID No.
            }
            layout {
                sequence: 40
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Party Status
            }
            layout {
                sequence: 65
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 50
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 60
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 70
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 80
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 90
            }
        )

        column MERGE (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-merge-party" data-party="#PARTY_ID#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#MERGE#</a>
                    ```
            }
        )

    )

    dynamicAction merge-party (
        name: Merge into an existing party
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-merge-party
        }

        action merge-party-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var a = $(this.triggeringElement);
                    this.browserEvent.preventDefault();
                    apex.message.confirm("Merge this counterparty's party into " + a.data("label") + "? The request, documents and contacts move there.", function (ok) {
                        if (ok) {
                            apex.page.submit({ request: "MERGE", set: { P205_MERGE_PARTY_ID: String(a.data("party")) } });
                        }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process merge-party (
        name: Merge into existing party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_party number;
                begin
                    select party_id into l_party from xxcmp_requests where request_id = :P205_REQUEST_ID;
                    xxcmp_party_pkg.merge_parties(l_party, to_number(:P205_MERGE_PARTY_ID), :P205_MATCH_NOTE);
                end;
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        successMessage {
            successMessage: The counterparty's party was merged into the existing party.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )

    region request_attachments (
        name: Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.attached_document_id, a.title, a.category_name, a.document_date, a.expiry_date,
                       case when a.expired_flag = 'Y' then 'Expired' end as expired, a.created_by, a.creation_date
                  from xxfnd_attached_documents_v a
                 where a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = :P205_REQUEST_ID
                 order by a.seq_num, a.creation_date
                ```
            pageItemsToSubmit: P205_REQUEST_ID
        }
        layout {
            sequence: 60
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
