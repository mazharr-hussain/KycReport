    region respond (
        name: Information Needed
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the question Compliance asked (the latest comment on the checklist task)
                declare
                    l_text varchar2(4000);
                begin
                    select max(c.text) keep (dense_rank last order by c.created_on) into l_text
                      from apex_task_comments c
                     where c.task_id = :P205_INFO_TASK_ID;
                    return '<p>Compliance asked:</p><blockquote>' || apex_escape.html(nvl(l_text, '-')) || '</blockquote>'
                           || '<p>Edit the request if needed, then answer here: the request goes back to Compliance.</p>';
                end;
                ```
            pageItemsToSubmit: P205_INFO_TASK_ID
        }
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: respond
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P205_INFO_TASK_ID
        }
    )

    pageItem P205_INFO_TASK_ID (
        type: hidden
        layout {
            sequence: 1
            region: @buttons
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P205_RESPONSE (
        type: textarea
        label {
            label: Your Answer
            alignment: left
        }
        layout {
            sequence: 10
            region: @respond
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
