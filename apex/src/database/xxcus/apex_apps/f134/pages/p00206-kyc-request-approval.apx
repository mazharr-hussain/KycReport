            helpText: Optional: a document that goes with your comment (kept with the request's documents).
        }
    )

    pageItem P206_INFO_QUESTION (
        type: displayOnly
        label {
            label: Information Requested
            alignment: left
        }
        layout {
            sequence: 4
            region: @decision-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
