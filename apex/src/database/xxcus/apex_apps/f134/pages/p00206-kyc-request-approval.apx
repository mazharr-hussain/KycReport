    button open-case (
        buttonName: OPEN_CASE
        label: Open Case
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                items: {
                    P211_CASE_ID: &P206_CASE_ID.
                }
                clearCache: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P206_CASE_ID is not null and xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }
    )

    region decision-dialog (
        name: Decision
        type: staticContent
        layout {
            sequence: 99
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: decision_dialog
        }
    )

    pageItem P206_DECISION (
        type: hidden
        layout {
            sequence: 1
            region: @decision-dialog
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P206_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 10
            region: @decision-dialog
            slot: regionBody
