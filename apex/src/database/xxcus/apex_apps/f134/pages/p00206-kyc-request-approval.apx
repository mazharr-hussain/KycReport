        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 4
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Recorded on the task; required when rejecting or requesting information.
        }
    )

    pageItem P206_ADD_USER (
        type: popupLov
        label {
            label: Approver to Add
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(full_name, user_name) || ' (' || user_name || ')' as display_value, user_name as return_value
                  from xxfnd_employees
                 where user_name is not null
                 order by 1
                ```
        }
        layout {
            sequence: 5
            region: @decision-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Release 74: the person who approves next, after you (the Comment says why).
        }
    )

    pageItem P206_FILE (
