            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button confirm (
        buttonName: CONFIRM
        label: Confirm
        layout {
            sequence: 10
            region: @decision-dialog
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide-confirm
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    validation reject-reason (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P206_COMMENT is null then 'Enter why the request is rejected.' end;
                ```
        }
        error {
            associatedItem: @P206_COMMENT
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'REJECT'
                ```
        }
    )

    validation info-question (
        name: Information requested
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P206_COMMENT is null then 'Enter the information you need from the requester.' end;
                ```
        }
        error {
            associatedItem: @P206_COMMENT
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'REQUEST_INFO'
                ```
        }
    )

    process open-from-task (
        name: Open from task
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_def apex_tasks.task_def_static_id%type;
                    l_pk  apex_tasks.detail_pk%type;
                begin
                    select task_def_static_id, detail_pk into l_def, l_pk
                      from table ( apex_human_task.get_tasks (
                                       p_context        => 'SINGLE_TASK',
                                       p_task_id        => :P206_TASK_ID,
                                       p_application_id => :APP_ID ) )
                     where task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'COUNTERPARTY_MATCH', 'CASE_APPROVAL');
                    -- release 74: a case approver asked the requester for information: answered on the request
                    :P206_REQUEST_ID := case when l_def = 'CASE_APPROVAL' then xxcmp_case_pkg.request_of(to_number(l_pk))
                                             else to_number(l_pk) end;
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P206_TASK_ID
        }
    )

    process find-my-task (
        name: My open task on this request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- opened from KYC Requests (not My Tasks): use the approver's own open task on this request
                select max(t.task_id) into :P206_TASK_ID
                  from table ( apex_human_task.get_tasks ( p_context => 'MY_TASKS', p_application_id => :APP_ID ) ) t
                 where t.detail_pk = :P206_REQUEST_ID
                   and t.task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'COUNTERPARTY_MATCH')
                   and t.state_code in ('ASSIGNED', 'UNASSIGNED');
                ```
        }
        execution {
            sequence: 7
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P206_TASK_ID
        }
    )

    process find-info-task (
        name: The requester's open question
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 74: an approver asked the requester for information: the requester answers here (Submit Information)
                :P206_INFO_TASK_ID := nvl(xxfnd_task_pkg.info_task('DOC_CHECKLIST_REVIEW', :P206_REQUEST_ID),
                                          xxcmp_case_pkg.info_task(:P206_REQUEST_ID));
                :P206_INFO_QUESTION := xxfnd_task_pkg.last_comment(:P206_INFO_TASK_ID);
                ```
        }
        execution {
            sequence: 8
            point: beforeHeader
        }
    )

    process load-case (
        name: Load case
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select max(case_id) into :P206_CASE_ID from xxcmp_cases where request_id = :P206_REQUEST_ID;
                -- the breadcrumb shows the request number before the page items are rendered
                select max(request_number), max(party_id) into :P206_REQUEST_NUMBER, :P206_PARTY_ID
                  from xxcmp_requests where request_id = :P206_REQUEST_ID;
                -- the common Party / Approval Path / History regions (Global Page)
                :P0_REQUEST_ID := :P206_REQUEST_ID;
                :P0_SUMMARY_PARTY_ID := :P206_PARTY_ID;
                ```
        }
        execution {
            sequence: 6
            point: beforeHeader
        }
    )

    process add-comment (
        name: Record comment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P206_TASK_ID, p_text => :P206_COMMENT);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P206_COMMENT is not null and :P206_TASK_ID is not null and nvl(:P206_DECISION, '#') not in ('SUBMIT_INFO', 'REQUEST_INFO')
                ```
        }
    )

    process approve-task (
        name: Approve checklist
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.approve_task(p_task_id => :P206_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Approved.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'APPROVE'
                ```
        }
    )

    process reject-task (
        name: Reject request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P206_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Request rejected.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'REJECT'
                ```
        }
    )

    process request-info-task (
        name: Request information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- the question goes to the requester (task initiator); an unclaimed task is claimed first
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and state_code = 'UNASSIGNED') loop
                    apex_human_task.claim_task(p_task_id => :P206_TASK_ID);
                end loop;
                if xxcmp_request_pkg.can_request_info(:P206_TASK_ID) = 'N' then
                    -- release 73: the approver is the requester (APEX cannot ask the initiator from the initiator):
                    -- the request goes back to the requester with the question; resubmitting starts the approval again
                    xxcmp_request_pkg.return_for_info(:P206_REQUEST_ID, :P206_TASK_ID, :P206_COMMENT);
                else
                    apex_human_task.request_more_information(p_task_id => :P206_TASK_ID, p_text => :P206_COMMENT);
                end if;
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Information requested: the requester answers, then the request comes back for approval.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'REQUEST_INFO'
                ```
        }
    )

    process add-approver (
        name: Add an approver
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                if :P206_ADD_USER is null then
                    xxfnd_error_pkg.raise_error('XXFND_APPROVAL_APPROVER_REQUIRED');
                end if;
                xxfnd_approval_rule_pkg.add_approver('KYC_REQUEST', :P206_REQUEST_ID, 'USER', p_user_name => :P206_ADD_USER,
                                                     p_position => 'NEXT', p_comment => :P206_COMMENT);
                ```
        }
        execution {
            sequence: 50
            point: processing
        }
        successMessage {
            successMessage: Approver added: they approve after you.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'ADD_APPROVER'
                ```
        }
    )

    process submit-info (
        name: Submit information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- the task goes back to the approver; the request is In Progress again (task action)
                apex_human_task.submit_information(p_task_id => :P206_INFO_TASK_ID, p_text => :P206_COMMENT);
                ```
        }
        execution {
            sequence: 60
            point: processing
        }
        successMessage {
            successMessage: Information submitted: the request is back with the approver.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_DECISION = 'SUBMIT_INFO' and :P206_INFO_TASK_ID is not null
                ```
        }
    )

    process attach-file (
        name: Keep the attachment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := xxfnd_attach_pkg.add_file(
                                p_entity_name    => 'XXCMP_REQUESTS',
                                p_pk1_value      => :P206_REQUEST_ID,
                                p_category_code  => 'OTHER',
                                p_temp_file_name => :P206_FILE,
                                p_title          => initcap(replace(:P206_DECISION, '_', ' ')) || ' - ' || :APP_USER,
                                p_description    => substr(:P206_COMMENT, 1, 4000),
                                p_page_id        => 206);
                end;
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CONFIRM' and :P206_FILE is not null
                ```
        }
    )

)
