page 206 (
    name: KYC Request Approval
    alias: KYC-REQUEST-APPROVAL
    title: KYC Request Approval
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The approval screen of a KYC request, opened from the task: the same summary as the request (party, details, answers, documents, approval history) with the decision: Approve, Reject, Request Information (a comment is required to reject or request information) and Merge for a duplicate party.
            ```
    }

    region breadcrumb (
        name: KYC Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region request (
        name: Request Items
        type: staticContent
        layout {
            sequence: 19
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request
        }
    )

    region request-details (
        name: Request
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R11): the request's details as data (XXCMP_REQUEST_UI_PKG.DETAILS_JSON)
                select j.label, j.value, j.tone, j.url, j.user_name, j.seq, j.group_name
                  from json_table(xxcmp_request_ui_pkg.details_json(to_number(:P206_REQUEST_ID)), '$[*]'
                           columns (group_name varchar2(30)   path '$.group_name',
                                    seq        number         path '$.seq',
                                    label      varchar2(100)  path '$.label',
                                    value      varchar2(4000) path '$.value',
                                    tone       varchar2(30)   path '$.tone',
                                    url        varchar2(4000) path '$.url',
                                    user_name  varchar2(255)  path '$.user_name')) j
                ```
            pageItemsToSubmit: [
                P206_REQUEST_ID
            ]
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request_details
        }
        componentAppearance {
            template: @/value-attribute-pairs-row
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        messages {
            whenNoDataFound: The request is not available.
        }

        column LABEL (
            type: plainText
            heading {
                heading: Label
            }
            layout {
                sequence: 10
            }
        )

        column VALUE (
            type: plainText
            heading {
                heading: Value
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if TONE/}<span class="kyc-badge kyc-badge--#TONE#">#VALUE#</span>{else/}{if URL/}<a href="#URL#">#VALUE#</a>{else/}{if USER_NAME/}<span class="kyc-person" tabindex="0" data-user="#USER_NAME#">#VALUE#</span>{else/}#VALUE#{endif/}{endif/}{endif/}
                    ```
            }
        )

        column TONE (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column URL (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column USER_NAME (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column SEQ (
            type: hidden
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )

        column GROUP_NAME (
            type: hidden
            layout {
                sequence: 70
            }
        )

    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P206_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_TASK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_CASE_ID (
        type: hidden
        layout {
            sequence: 3
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_PARTY_ID (
        type: hidden
        layout {
            sequence: 4
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_REQUEST_NUMBER (
        type: hidden
        layout {
            sequence: 10
            region: @request
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select request_number from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )
















    region checklist (
        name: Document Checklist
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.column_value as category_code,
                       (select nvl(tl.category_name, dc.category_name) from xxfnd_document_categories dc
                          left join xxfnd_document_categories_tl tl on tl.category_code = dc.category_code and tl.language_code = xxfnd_util_pkg.current_lang
                         where dc.category_code = c.column_value) as category,
                       case when exists (select 1 from xxfnd_attached_documents_v a
                                          where a.category_code = c.column_value and nvl(a.expired_flag, 'N') = 'N'
                                            and ((a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = :P206_REQUEST_ID)
                                              or (a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = (select to_char(party_id) from xxcmp_requests where request_id = :P206_REQUEST_ID))))
                            then 'Present' else 'Missing' end as status
                  from table(xxcmp_doc_rule_pkg.mandatory_categories('XXCMP_PARTIES',
                                 (select jurisdiction from xxcmp_requests where request_id = :P206_REQUEST_ID),
                                 (select case when party_type = 'PERSON' then registration_type else entity_type end from xxcmp_requests where request_id = :P206_REQUEST_ID))) c
                ```
            pageItemsToSubmit: P206_REQUEST_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: checklist
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No mandatory documents are configured for this counterparty.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }

        column CATEGORY_CODE (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Mandatory Document
            }
            layout {
                sequence: 20
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

    )

    region counterparty_matching (
        name: Possible Duplicate Parties
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>The counterparty was created as a new (Pending) party with the request. If it is an existing party, merge it into that party: the request, its documents and contacts move there and the duplicate is disabled.</p>
                ```
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: counterparty_matching
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Compliance, while the request's own new party is still Pending
                select 1
                  from xxcmp_requests r
                  join xxcmp_parties p on p.party_id = r.party_id
                 where r.request_id = :P206_REQUEST_ID and r.party_selection = 'NEW' and p.party_status = 'PENDING'
                   and p.enabled_flag = 'Y' and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE')
                ```
        }
    )

    pageItem P206_MERGE_PARTY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Set by the Merge link just before submit. XXCMP_PARTY_PKG.MERGE_PARTIES re-checks the privilege, the party types and that both parties are enabled.
        }
        layout {
            sequence: 1
            region: @counterparty_matching
            slot: regionBody
        }
    )

    region match_candidates (
        name: Existing Parties That May Be This Counterparty
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_number,
                       j.party_name, j.country, j.status, j.score, j.reg_match, j.reasons,
                       apex_page.get_url(p_page => 21, p_items => 'P21_PARTY_ID', p_values => to_char(j.party_id), p_clear_cache => '21') as party_url,
                       'Merge into this party' as merge
                  from json_table(xxcmp_request_pkg.request_candidates_json(:P206_REQUEST_ID), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  status varchar2(80) path '$.status',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: P206_REQUEST_ID
        }
        layout {
            sequence: 20
            slot: BODY
            parentRegion: @counterparty_matching
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: match_candidates
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this counterparty any more.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_URL (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#PARTY_URL#" target="_blank">#PARTY_NUMBER#</a>
                    ```
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration / ID No.
            }
            layout {
                sequence: 40
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Party Status
            }
            layout {
                sequence: 65
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 50
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 60
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 70
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 80
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 90
            }
        )

        column MERGE (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-merge-party" data-party="#PARTY_ID#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#MERGE#</a>
                    ```
            }
        )

    )

    region merge-dialog (
        name: Merge into an Existing Party
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Merge this counterparty's party into <strong id="merge_target"></strong>? The request, its documents and contacts move there and the duplicate is disabled.</p>
                ```
        }
        layout {
            sequence: 95
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: merge_dialog
        }
    )

    pageItem P206_MATCH_NOTE (
        type: textarea
        label {
            label: Merge Note
            alignment: left
        }
        layout {
            sequence: 10
            region: @merge-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Why the counterparty is this existing party.
        }
    )

    button merge (
        buttonName: MERGE
        label: Merge
        layout {
            sequence: 20
            region: @merge-dialog
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button merge-cancel (
        buttonName: MERGE_CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @merge-dialog
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction merge-cancel (
        name: Close the merge dialog
        execution {
            sequence: 65
        }
        when {
            event: click
            selectionType: button
            button: @merge-cancel
        }

        action merge-cancel-close (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @merge-dialog
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation merge-note (
        name: Merge note given
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when trim(:P206_MATCH_NOTE) is null then 'Enter why the counterparty is this existing party.' end;
                ```
        }
        error {
            associatedItem: @P206_MATCH_NOTE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )

    dynamicAction merge-party (
        name: Merge into an existing party
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-merge-party
        }

        action merge-party-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var a = $(this.triggeringElement);
                    this.browserEvent.preventDefault();
                    apex.item("P206_MERGE_PARTY_ID").setValue(String(a.data("party")));
                    $("#merge_target").text(a.data("label"));
                    apex.item("P206_MATCH_NOTE").setValue("");
                    apex.theme.openRegion("merge_dialog");
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process merge-party (
        name: Merge into existing party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_party number;
                begin
                    select party_id into l_party from xxcmp_requests where request_id = :P206_REQUEST_ID;
                    xxcmp_party_pkg.merge_parties(l_party, to_number(:P206_MERGE_PARTY_ID), :P206_MATCH_NOTE);
                end;
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        successMessage {
            successMessage: The counterparty's party was merged into the existing party.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )




    region decision-buttons (
        name: Decision
        type: staticContent
        layout {
            sequence: 990
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: kyc-actionbar
        }
        advanced {
            htmlDomId: decision_buttons
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- release 74: also for the requester answering an approver's question (Submit Information)
                if :P206_INFO_TASK_ID is not null then
                    return true;
                end if;
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )



    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 30
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-APPROVE
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button approve-top (
        buttonName: APPROVE_TOP
        label: Approve
        layout {
            sequence: 50
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-APPROVE
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 10
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-REJECT
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button reject-top (
        buttonName: REJECT_TOP
        label: Reject
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-REJECT
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button request-info (
        buttonName: REQUEST_INFO
        label: Request Information
        layout {
            sequence: 20
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-REQUEST_INFO
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                -- the question goes to the requester (release 73: also when the approver is the requester)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button request-info-top (
        buttonName: REQUEST_INFO_TOP
        label: Request Information
        layout {
            sequence: 40
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-REQUEST_INFO
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                -- the question goes to the requester (release 73: also when the approver is the requester)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button add-approver (
        buttonName: ADD_APPROVER
        label: Add Approver
        layout {
            sequence: 25
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-ADD_APPROVER
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- release 74: the current approver adds an approver after them (Approval Setup, ad-hoc)
                if xxfnd_approval_rule_pkg.is_started('KYC_REQUEST', :P206_REQUEST_ID) = 'N' then
                    return false;
                end if;
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW'
                             and state_code in ('ASSIGNED', 'UNASSIGNED')) loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button add-approver-top (
        buttonName: ADD_APPROVER_TOP
        label: Add Approver
        layout {
            sequence: 45
            region: @buttons
            slot: NEXT
