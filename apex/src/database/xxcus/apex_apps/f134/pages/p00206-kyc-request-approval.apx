            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-decide kyc-decide-SUBMIT_INFO
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
