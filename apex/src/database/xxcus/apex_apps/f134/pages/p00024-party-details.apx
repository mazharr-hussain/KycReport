page 24 (
    name: Party Details
    alias: PARTY-DETAILS
    title: Party
    pageGroup: @parties
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The one place to create or change a party: identity, main contact details (email, phone, website, fax) and additional information. Opened from Parties (Create Party), the Party page, and the request and case pages (Edit Party). Contact persons, ownership and documents are on the Party page.
            ```
    }

    region form (
        name: Party Details
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_PARTIES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_PARTY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: PARTY_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P24_PARTY_NUMBER (
        type: displayOnly
        label {
            label: Party Number
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @form
            column: PARTY_NUMBER
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P24_PARTY_TYPE (
        type: selectList
        label {
            label: Party Type
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-party-type
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: PARTY_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: ORGANIZATION
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P24_PARTY_ID is not null
                ```
        }
        help {
            helpText: Choose the party Type.
        }
    )

    pageItem P24_PARTY_NAME (
        type: textField
