page 24 (
    name: Party Information
    alias: PARTY-DETAILS
    title: Party
    pageGroup: @parties
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Step 1 of 3 of the party wizard (create or edit): the party information in the common party form (Global Page). Next saves it and goes to the party details (step 2); the review (step 3) is the Party page. Opened from Parties (Create Party, Edit), the Party page and the case page (Edit Party).
            ```
    }

    region breadcrumb (
        name: Party
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Party
        type: list
        source {
            list: @party-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_PARTY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @buttons
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                items: {
                    P21_PARTY_ID: &P24_PARTY_ID.
                }
                clearCache: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Next
        layout {
            sequence: 40
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_PARTY_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Next
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P24_PARTY_ID is not null and xxcmp_party_pkg.is_enabled(:P24_PARTY_ID) = 'Y'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    validation VAL_PARTY (
        name: Party form rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the rules of the common party form, the same on every page that uses it
                return xxcmp_party_pkg.party_error(to_number(:P24_PARTY_ID), :P0_PARTY_TYPE, :P0_PARTY_NAME,
                           :P0_PARTY_JURISDICTION, :P0_PARTY_REGISTRATION_NUMBER, :P0_PARTY_ENTITY_TYPE,
                           to_date(:P0_PARTY_INCORPORATION_DATE), :P0_PARTY_EMAIL, :P0_PARTY_PHONE,
                           'N', :P0_PARTY_MATCH_ACK);
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process load-party (
        name: Load the party into the common party form
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_party_pkg.load_items(to_number(:P24_PARTY_ID));
                :P0_REQUEST_ID := null;
                :P0_SUMMARY_PARTY_ID := :P24_PARTY_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-party (
        name: Save party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number := to_number(:P24_PARTY_ID);
                begin
                    xxcmp_party_pkg.save_party(
                        p_party_id            => l_id,
                        p_party_type          => :P0_PARTY_TYPE,
                        p_party_name          => :P0_PARTY_NAME,
                        p_jurisdiction        => :P0_PARTY_JURISDICTION,
                        p_registration_number => :P0_PARTY_REGISTRATION_NUMBER,
                        p_entity_type         => :P0_PARTY_ENTITY_TYPE,
                        p_incorporation_date  => to_date(:P0_PARTY_INCORPORATION_DATE),
                        p_email               => :P0_PARTY_EMAIL,
                        p_phone               => :P0_PARTY_PHONE,
                        p_website             => :P0_PARTY_WEBSITE,
                        p_fax                 => :P0_PARTY_FAX,
                        p_data_provenance     => :P0_PARTY_DATA_PROVENANCE,
                        p_enabled_flag        => :P0_PARTY_ENABLED_FLAG,
                        p_match_ack           => :P0_PARTY_MATCH_ACK);
                    :P24_PARTY_ID := l_id;
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Party saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    branch (
        name: To party details
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 25
                items: {
                    P25_PARTY_ID: &P24_PARTY_ID.
                }
                clearCache: 25
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

)
