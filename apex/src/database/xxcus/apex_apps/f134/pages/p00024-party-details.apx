        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 360
        }
        source {
            formRegion: @form
            column: PARTY_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the name.
        }
    )

