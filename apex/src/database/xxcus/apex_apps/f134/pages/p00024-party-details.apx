page 24 (
    name: Party Details
    alias: PARTY-DETAILS
    title: Party
    pageGroup: @parties
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The one place for Compliance to create or change a party: the common party region (Global Page) plus additional information. Opened from Parties (Create Party), the Party page, and the request and case pages (Edit Party). Contact persons, ownership and documents are on the Party page.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_PARTY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @buttons
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    region party_dff (
        name: Additional Information
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.render(
                           p_table_name   => 'XXCMP_PARTIES',
                           p_pk_value     => :P24_PARTY_ID,
                           p_reference_value => :P0_PARTY_TYPE,
                           p_context_code => :P24_DFF_CONTEXT);
                ```
            pageItemsToSubmit: [
                P24_PARTY_ID
                P24_DFF_CONTEXT
                P0_PARTY_TYPE
            ]
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_dff
        }
    )

    pageItem P24_DFF_JSON (
        type: hidden
        layout {
            sequence: 900
            region: @buttons
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    pageItem P24_DFF_CONTEXT (
        type: hidden
        layout {
            sequence: 901
            region: @buttons
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    dynamicAction bind-party_dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        comments {
            comments: P24_DFF_JSON and P24_DFF_CONTEXT are unrestricted because this script fills them in the browser before submit; XXFND_DFF_PKG re-validates every value on the server.
        }

        action bind-party_dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    xxfndDff.bind('party_dff', 'P24_DFF_JSON', 'P24_DFF_CONTEXT');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-party-dff (
        name: Refresh party_dff on change
        execution {
            sequence: 45
        }
        when {
            event: change
            selectionType: items
            items: P0_PARTY_TYPE
        }

        action refresh-party-dff-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party_dff
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_PARTY_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P24_PARTY_ID is not null and xxcmp_party_pkg.is_enabled(:P24_PARTY_ID) = 'Y'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation VAL_PARTY (
        name: Party form rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the rules of the common party form, the same on every page that uses it
                return xxcmp_party_pkg.party_error(to_number(:P24_PARTY_ID), :P0_PARTY_TYPE, :P0_PARTY_NAME,
                           :P0_PARTY_JURISDICTION, :P0_PARTY_REGISTRATION_NUMBER, :P0_PARTY_ENTITY_TYPE,
                           to_date(:P0_PARTY_INCORPORATION_DATE), :P0_PARTY_EMAIL, :P0_PARTY_PHONE,
                           'N', nvl(:P0_PARTY_MATCH_ACK, 'N'));
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation VAL_P24_DFF (
        name: Validate additional information
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.validate('XXCMP_PARTIES', :P24_DFF_JSON, :P24_DFF_CONTEXT, :P24_PARTY_ID, p_reference_value => :P0_PARTY_TYPE);
                ```
        }
        error {
            associatedItem: @P24_DFF_CONTEXT
        }
    )

    process load-party (
        name: Load the party into the common party form
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_party_pkg.load_items(to_number(:P24_PARTY_ID));
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-party (
        name: Save party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number := to_number(:P24_PARTY_ID);
                begin
                    xxcmp_party_pkg.save_party(
                        p_party_id            => l_id,
                        p_party_type          => :P0_PARTY_TYPE,
                        p_party_name          => :P0_PARTY_NAME,
                        p_jurisdiction        => :P0_PARTY_JURISDICTION,
                        p_registration_number => :P0_PARTY_REGISTRATION_NUMBER,
                        p_entity_type         => :P0_PARTY_ENTITY_TYPE,
                        p_incorporation_date  => to_date(:P0_PARTY_INCORPORATION_DATE),
                        p_email               => :P0_PARTY_EMAIL,
                        p_phone               => :P0_PARTY_PHONE,
                        p_website             => :P0_PARTY_WEBSITE,
                        p_fax                 => :P0_PARTY_FAX,
                        p_data_provenance     => :P0_PARTY_DATA_PROVENANCE,
                        p_enabled_flag        => :P0_PARTY_ENABLED_FLAG,
                        p_match_ack           => nvl(:P0_PARTY_MATCH_ACK, 'N'));
                    :P24_PARTY_ID := l_id;
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Party saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process p21-dff-save (
        name: Save Additional Information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_dff_pkg.save('XXCMP_PARTIES', :P24_PARTY_ID, :P24_DFF_JSON, :P24_DFF_CONTEXT, p_reference_value => :P0_PARTY_TYPE);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

    branch (
        name: Open the new party
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 21
                items: {
                    P21_PARTY_ID: &P24_PARTY_ID.
                }
                clearCache: 21
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)
