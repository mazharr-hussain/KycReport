    region party_dff (
        name: Additional Information
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.render(
                           p_table_name   => 'XXCMP_PARTIES',
                           p_pk_value     => :P24_PARTY_ID,
                           p_reference_value => :P24_PARTY_TYPE,
                           p_context_code => :P24_DFF_CONTEXT);
                ```
            pageItemsToSubmit: [
                P24_PARTY_ID
                P24_DFF_CONTEXT
                P24_PARTY_TYPE
            ]
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_dff
        }
    )

    pageItem P24_DFF_JSON (
        type: hidden
        layout {
            sequence: 900
            region: @form
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    pageItem P24_DFF_CONTEXT (
        type: hidden
        layout {
            sequence: 901
            region: @form
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by xxfnd-dff.js, which the same-page dynamic action 'Bind additional information' attaches. XXFND_DFF_PKG.VALIDATE/SAVE re-validate every value on the server.
                ```
        }
    )

    dynamicAction bind-party_dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        comments {
            comments: P24_DFF_JSON and P24_DFF_CONTEXT are unrestricted because this script fills them in the browser before submit; XXFND_DFF_PKG re-validates every value on the server.
        }

        action bind-party_dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    xxfndDff.bind('party_dff', 'P24_DFF_JSON', 'P24_DFF_CONTEXT');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-party-dff (
        name: Refresh party_dff on change
        execution {
            sequence: 45
        }
        when {
            event: change
            selectionType: items
            items: P24_PARTY_TYPE
        }

        action refresh-party-dff-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party_dff
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction party-type-fields (
        name: Show fields for P24_PARTY_TYPE
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P24_PARTY_TYPE
        }
        clientSideCondition {
            type: item=value
            item: P24_PARTY_TYPE
            value: ORGANIZATION
        }

        action party-type-fields-show-t (
            action: show
            affectedElements {
                selectionType: items
                items: P24_REGISTRATION_NUMBER,P24_ENTITY_TYPE,P24_INCORPORATION_DATE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action party-type-fields-hide-t (
            action: hide
            affectedElements {
                selectionType: items
                items: P24_DATE_OF_BIRTH,P24_NATIONALITY,P24_ID_TYPE,P24_ID_NUMBER
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action party-type-fields-show-f (
            action: show
            affectedElements {
                selectionType: items
                items: P24_DATE_OF_BIRTH,P24_NATIONALITY,P24_ID_TYPE,P24_ID_NUMBER
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

        action party-type-fields-hide-f (
            action: hide
            affectedElements {
                selectionType: items
                items: P24_REGISTRATION_NUMBER,P24_ENTITY_TYPE,P24_INCORPORATION_DATE
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_PARTY_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: CHANGE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P24_PARTY_ID is not null and xxcmp_party_pkg.is_enabled(:P24_PARTY_ID) = 'Y'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation VAL_PARTY_EXISTS (
        name: Party already exists
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                    l_id number;
                    l_no varchar2(30);
                begin
                    l_id := xxcmp_kyc_pkg.exact_party_match(:P24_PARTY_TYPE, :P24_PARTY_NAME,
                                :P24_REGISTRATION_NUMBER, :P24_JURISDICTION, to_date(:P24_DATE_OF_BIRTH));
                    if l_id is not null then
                        select party_number into l_no from xxcmp_parties where party_id = l_id;
                        return 'This party already exists as ' || l_no || '. Open the existing record instead of creating a new one.';
                    end if;
                    return null;
                end;
                ```
        }
        error {
            associatedItem: @P24_PARTY_NAME
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation VAL_P24_DFF (
        name: Validate additional information
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_dff_pkg.validate('XXCMP_PARTIES', :P24_DFF_JSON, :P24_DFF_CONTEXT, :P24_PARTY_ID, p_reference_value => :P24_PARTY_TYPE);
                ```
        }
        error {
            associatedItem: @P24_DFF_CONTEXT
        }
    )

    process p21-dff-save (
        name: Save Additional Information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_dff_pkg.save('XXCMP_PARTIES', :P24_PARTY_ID, :P24_DFF_JSON, :P24_DFF_CONTEXT, p_reference_value => :P24_PARTY_TYPE);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process party
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Party saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

    branch (
        name: Open the new party
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 21
                items: {
                    P21_PARTY_ID: &P24_PARTY_ID.
                }
                clearCache: 21
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)
