page 34 (
    name: E-mail
    alias: EMAIL
    title: E-mail
    pageGroup: @kyc
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Release 74 (R27): send an e-mail to an outside person from the case or the request for information, or record an e-mail they sent. Every e-mail is kept with the record. E-mails go out through the application now; Outlook will send and receive them once that integration is built.
    }

    region form (
        name: E-mail
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P34_ENTITY_NAME (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P34_PK1_VALUE (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P34_RFI_ID (
        type: hidden
        layout {
            sequence: 3
            region: @form
            slot: regionBody
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P34_PARTY_ID (
        type: hidden
        layout {
            sequence: 4
            region: @form
            slot: regionBody
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P34_DIRECTION (
        type: hidden
        layout {
            sequence: 5
            region: @form
            slot: regionBody
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P34_CONTACT (
        type: selectList
        label {
            label: Contact Person
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.contact_name || ' <' || c.email || '>' as display_value, c.email as return_value
                  from xxcmp_party_contacts c
                 where c.party_id = :P34_PARTY_ID and c.enabled_flag = 'Y' and c.email is not null
                 order by c.primary_flag desc, c.contact_name
                ```
            displayNullValue: true
            nullDisplayValue: - Choose a contact person or type the address -
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'OUT'
                ```
        }
        help {
            helpText: The contact persons of the party with an e-mail address; choosing one fills To.
        }
    )

    pageItem P34_TO (
        type: textField
        label {
            label: To
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'OUT'
                ```
        }
        help {
            helpText: One or more addresses, separated by commas.
        }
    )

    pageItem P34_CC (
        type: textField
        label {
            label: Cc
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'OUT'
                ```
        }
    )

    pageItem P34_FROM (
        type: textField
        label {
            label: From
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'IN'
                ```
        }
        help {
            helpText: The address the e-mail came from.
        }
    )

    pageItem P34_RECEIVED_DATE (
        type: datePicker
        label {
            label: Received On
            alignment: left
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select trunc(sysdate) from dual
                ```
        }
        layout {
            sequence: 25
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'IN'
                ```
        }
    )

    pageItem P34_SUBJECT (
        type: textField
        label {
            label: Subject
            alignment: left
        }
        validation {
            maxLength: 500
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P34_BODY (
        type: textarea
        label {
            label: Message
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 10
        }
        sessionState {
            dataType: clob
        }
        help {
            helpText: Plain text. For a received e-mail, paste its text.
        }
    )

    pageItem P34_FILE (
        type: fileUpload
        label {
            label: Attachment
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: Drop a file here
            dropzoneDesc: or click to browse
        }
        storage {
            type: appTempFiles
        }
        help {
            helpText: Optional: sent with the e-mail (or received with it) and kept with it.
        }
    )

    validation email-rules (
        name: E-mail rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxfnd_notify_pkg.email_error(:P34_DIRECTION, case :P34_DIRECTION when 'OUT' then :P34_TO else :P34_FROM end,
                                                           :P34_SUBJECT, :P34_BODY);
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SEND,RECORD
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button send (
        buttonName: SEND
        label: Send
        layout {
            sequence: 20
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-send
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'OUT'
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button record (
        buttonName: RECORD
        label: Record E-mail
        layout {
            sequence: 30
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P34_DIRECTION = 'IN'
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction contact-to (
        name: Contact person fills To
        execution {
            sequence: 20
        }
        when {
            event: change
            selectionType: items
            items: P34_CONTACT
        }

        action contact-to-set (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $v('P34_CONTACT')
            }
            affectedElements {
                selectionType: items
                items: P34_TO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process send-email (
        name: Send the e-mail
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := xxfnd_notify_pkg.send_email(
                                p_application_code => 'KYC',
                                p_entity_name      => :P34_ENTITY_NAME,
                                p_pk1_value        => :P34_PK1_VALUE,
                                p_to               => :P34_TO,
                                p_subject          => :P34_SUBJECT,
                                p_body             => :P34_BODY,
                                p_cc               => :P34_CC,
                                p_rfi_id           => :P34_RFI_ID,
                                p_temp_file_name   => :P34_FILE);
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: E-mail sent and kept with the record.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SEND
        }
    )

    process record-email (
        name: Record the received e-mail
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := xxfnd_notify_pkg.record_received(
                                p_application_code => 'KYC',
                                p_entity_name      => :P34_ENTITY_NAME,
                                p_pk1_value        => :P34_PK1_VALUE,
                                p_from             => :P34_FROM,
                                p_subject          => :P34_SUBJECT,
                                p_body             => :P34_BODY,
                                p_received_date    => to_date(:P34_RECEIVED_DATE, :APP_NLS_DATE_FORMAT),
                                p_rfi_id           => :P34_RFI_ID,
                                p_temp_file_name   => :P34_FILE);
                end;
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: E-mail recorded with the record.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: RECORD
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SEND,RECORD
        }
    )

)
