page 203 (
    name: Create Request - Review and Submit
    alias: CREATE-REQUEST-SUBMIT
    title: Create Request - Review and Submit
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Step 3 of 3: attach the documents you have and submit. You will see the outcome on the request.
            ```
    }

    region breadcrumb (
        name: Create Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Create Request
        type: list
        source {
            list: @request-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region summary (
        name: Summary
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: summary
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P203_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @summary
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P203_REQUEST_NUMBER (
        type: displayOnly
        label {
            label: Request
            alignment: left
        }
        layout {
            sequence: 10
            region: @summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select request_number from xxcmp_requests where request_id = :P203_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P203_COUNTERPARTY (
        type: displayOnly
        label {
            label: Counterparty
            alignment: left
        }
        layout {
            sequence: 20
            region: @summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select party_name || ' (' || xxfnd_util_pkg.lookup_meaning('PARTY_TYPE', party_type)
                       || nvl2(jurisdiction, ', ' || xxfnd_util_pkg.lookup_meaning('JURISDICTION', jurisdiction), null) || ')'
                  from xxcmp_requests where request_id = :P203_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P203_SUBMIT_CHECK (
        type: displayOnly
        label {
            label: Ready to Submit
            alignment: left
        }
        layout {
            sequence: 30
            region: @summary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(xxcmp_request_pkg.submit_error(:P203_REQUEST_ID), 'Yes') from dual
                ```
            used: always
        }
    )

    region answer_summary (
        name: Answers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select q.question_text from xxcmp_questions q where q.question_id = a.question_id) as question,
                       coalesce((select o.answer_label from xxcmp_answer_options o where o.answer_option_id = a.answer_option_id), a.answer_text, '-') as answer
                  from xxcmp_request_answers a
                 where a.request_id = :P203_REQUEST_ID and a.respondent_type = 'REQUESTER'
                 order by (select q.display_sequence from xxcmp_questions q where q.question_id = a.question_id)
                ```
            pageItemsToSubmit: P203_REQUEST_ID
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: answer_summary
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No data found.
        }

        column QUESTION (
            type: plainText
            heading {
                heading: Question
            }
            layout {
                sequence: 10
            }
        )

        column ANSWER (
            type: plainText
            heading {
                heading: Answer
            }
            layout {
                sequence: 20
            }
        )

    )

    region request_attachments (
        name: Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.attached_document_id, a.title, a.category_name, a.document_date, a.expiry_date, a.created_by, a.creation_date
                  from xxfnd_attached_documents_v a
                 where a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = :P203_REQUEST_ID
                 order by a.seq_num, a.creation_date
                ```
            pageItemsToSubmit: P203_REQUEST_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request_attachments
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No documents attached yet.
        }

        column ATTACHED_DOCUMENT_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 20
            }
        )

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
        )

        column DOCUMENT_DATE (
            type: plainText
            heading {
                heading: Document Date
            }
            layout {
                sequence: 40
            }
        )

        column EXPIRY_DATE (
            type: plainText
            heading {
                heading: Expires
            }
            layout {
                sequence: 50
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Added By
            }
            layout {
                sequence: 60
            }
        )

        column CREATION_DATE (
            type: plainText
            heading {
                heading: Added On
            }
            layout {
                sequence: 70
            }
        )

    )

    button request_attachments-add (
        buttonName: REQUEST_ATTACHMENTS_ADD
        label: Add Document
        layout {
            sequence: 10
            region: @request_attachments
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_ENTITY_NAME: XXCMP_REQUESTS
                    P90_PK1_VALUE: &P203_REQUEST_ID.
                    P90_SOURCE_PAGE: 203
                    P90_SOURCE_REGION: request_attachments
                }
                clearCache: 90
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxfnd_attach_pkg.block_permission(:APP_ALIAS, 203, 'request_attachments', 'XXCMP_REQUESTS', 'INSERT') = 'Y'
                ```
        }
    )

    dynamicAction refresh-request_attachments (
        name: Refresh request_attachments
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @request_attachments
        }

        action refresh-request_attachments-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @request_attachments
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )
    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 10
            region: @buttons
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 202
                items: {
                    P202_REQUEST_ID: &P203_REQUEST_ID.
                }
                clearCache: 202
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save as Draft
        layout {
            sequence: 15
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit Request
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                -- a request in Information Needed is answered on the request page (Respond), not submitted again
                xxcmp_request_pkg.stage(:P203_REQUEST_ID) = xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_STATUS', 'DRAFT')
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    validation submit-check (
        name: Request complete
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_request_pkg.submit_error(:P203_REQUEST_ID);
                ```
        }
        error {
            associatedItem: @P203_SUBMIT_CHECK
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SUBMIT
        }
    )

    process submit-request (
        name: Submit request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_request_pkg.submit(:P203_REQUEST_ID);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Request submitted.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: To the request
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 205
                items: {
                    P205_REQUEST_ID: &P203_REQUEST_ID.
                }
                clearCache: 205
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)
