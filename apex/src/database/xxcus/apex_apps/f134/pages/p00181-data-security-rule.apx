page 181 (
    name: Data Security Rule
    alias: DATA-SECURITY-RULE
    title: Data Security Rule
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            All rows: the role sees every row. Own records: only rows whose column holds the user name.
            Column in list: only rows whose column holds one of the values (comma-separated, e.g. AE,SA).
            ```
    }

    region form (
        name: Data Security Rule
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_DATA_SECURITY_RULES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P181_RULE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: RULE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P181_ROLE_CODE (
        type: selectList
        label {
            label: Role
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-roles
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ROLE_CODE
            dataType: varchar2
        }
        help {
            helpText: The role this rule applies to.
        }
    )

    pageItem P181_TABLE_NAME (
        type: selectList
        label {
            label: Table
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select table_name as display_value, table_name as return_value
                  from user_tables
                 where table_name like 'XXCMP\_%' escape '\'
                 order by table_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: TABLE_NAME
            dataType: varchar2
        }
        help {
            helpText: The business table whose rows this rule filters.
        }
    )

    pageItem P181_RULE_TYPE (
        type: selectList
        label {
            label: Rule
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from (select 'All rows' as display_value, 'ALL_ROWS' as return_value, 1 as seq from dual union all
                        select 'Own records', 'OWN_RECORDS', 2 from dual union all
                        select 'Column in list', 'COLUMN_IN_LIST', 3 from dual)
                 order by seq
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: RULE_TYPE
            dataType: varchar2
        }
        help {
            helpText: All rows, own records (column holds the user name) or column in list.
        }
    )

    pageItem P181_COLUMN_NAME (
        type: selectList
        label {
            label: Column
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select column_name as display_value, column_name as return_value
                  from user_tab_columns
                 where table_name = :P181_TABLE_NAME
                   and data_type in ('VARCHAR2','CHAR','NUMBER')
                 order by column_id
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P181_TABLE_NAME
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: COLUMN_NAME
            dataType: varchar2
        }
        help {
            helpText: Required for Own records and Column in list.
        }
    )

    pageItem P181_VALUE_LIST (
        type: textField
        label {
            label: Values
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @form
            column: VALUE_LIST
            dataType: varchar2
        }
        help {
            inlineHelpText: Column in list only, comma-separated, e.g. AE,SA
        }
    )

    pageItem P181_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Why this role has this access.
        }
    )

    pageItem P181_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Disabled rules are ignored.
        }
    )

    validation rule-columns (
        name: Column and values match the rule
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P181_RULE_TYPE = 'ALL_ROWS' and (:P181_COLUMN_NAME is not null or :P181_VALUE_LIST is not null) then
                    return 'All rows takes no column and no values.';
                elsif :P181_RULE_TYPE in ('OWN_RECORDS','COLUMN_IN_LIST') and :P181_COLUMN_NAME is null then
                    return 'Choose the column.';
                elsif :P181_RULE_TYPE = 'OWN_RECORDS' and :P181_VALUE_LIST is not null then
                    return 'Own records takes no values.';
                elsif :P181_RULE_TYPE = 'COLUMN_IN_LIST' and :P181_VALUE_LIST is null then
                    return 'Enter the values.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P181_RULE_TYPE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation rule-unique (
        name: Rule not defined yet
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from xxfnd_data_security_rules
                 where role_code = :P181_ROLE_CODE and table_name = :P181_TABLE_NAME
                   and rule_type = :P181_RULE_TYPE and nvl(column_name, '#') = nvl(:P181_COLUMN_NAME, '#')
                   and rule_id <> nvl(to_number(:P181_RULE_ID), -1)
                ```
        }
        error {
            errorMessage: This role already has this rule.
            associatedItem: @P181_RULE_TYPE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P181_RULE_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P181_RULE_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P181_RULE_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process apply-policies (
        name: Apply data security policies
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- A table gets its policy the first time a rule refers to it.
                xxfnd_vpd_pkg.apply_policies;
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
