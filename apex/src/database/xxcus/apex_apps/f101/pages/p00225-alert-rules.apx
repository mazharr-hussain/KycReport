page 225 (
    name: Alert Rules
    alias: ALERT-RULES
    title: Alert Rules
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            What the daily monitoring run watches: reviews coming due or overdue, investigations past their SLA, party documents expiring, adverse screenings after approval. Each rule says how many days ahead (or of grace), for which risk tier, which role is told, and whether an early review starts by itself.
            ```
    }

    region breadcrumb (
        name: Alert Rules
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Alert Rules
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 226, p_items => 'P226_ALERT_RULE_ID', p_values => to_char(q.alert_rule_id), p_clear_cache => '226') as edit_url
                  from (
                        select r.alert_rule_id,
                               r.rule_code,
                               r.rule_name,
                               xxfnd_util_pkg.lookup_meaning('ALERT_TYPE', r.alert_type) as alert_type,
                               r.days_before,
                               nvl(xxfnd_util_pkg.lookup_meaning('RISK_TIER', r.risk_tier), 'All') as risk_tier,
                               (select role_name from xxfnd_roles x where x.role_code = r.recipient_role_code) as recipients,
                               case r.notify_flag when 'Y' then 'Yes' else 'No' end as notify,
                               case r.start_review_flag when 'Y' then 'Yes' else 'No' end as start_review,
                               case r.enabled_flag when 'Y' then 'Yes' else 'No' end as enabled,
                               (select count(*) from xxcmp_alerts a where a.alert_rule_id = r.alert_rule_id and a.alert_status = 'OPEN') as open_alerts
                          from xxcmp_alert_rules r
                       ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column ALERT_RULE_ID (
            type: hidden
            heading {
                heading: Alert Rule Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column RULE_NAME (
            type: plainText
            heading {
                heading: Rule
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#EDIT_URL#">#RULE_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column RULE_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column ALERT_TYPE (
            type: plainText
            heading {
                heading: Watches
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column DAYS_BEFORE (
            type: plainText
            heading {
                heading: Days
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
        )

        column RISK_TIER (
            type: plainText
            heading {
                heading: Risk Tier
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column RECIPIENTS (
            type: plainText
            heading {
                heading: Alerted Role
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column NOTIFY (
            type: plainText
            heading {
                heading: E-mail
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column START_REVIEW (
            type: plainText
            heading {
                heading: Starts Review
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column ENABLED (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_ALERTS (
            type: plainText
            heading {
                heading: Open Alerts
            }
            layout {
                sequence: 110
            }
            source {
                dataType: NUMBER
            }
        )

        column EDIT_URL (
            type: hidden
            heading {
                heading: Edit Url
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Rule
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 226
                clearCache: 226
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
