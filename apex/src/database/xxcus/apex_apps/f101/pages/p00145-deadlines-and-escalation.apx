page 145 (
    name: Deadlines and Escalation
    alias: DEADLINES-AND-ESCALATION
    title: Deadlines and Escalation
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            When each kind of task is due, when its owners get a reminder, and which role receives it once overdue. The daily Task deadlines automation sends the reminders and escalations.
            ```
    }

    region breadcrumb (
        name: Deadlines and Escalation
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Deadlines and Escalation
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 146, p_items => 'P146_TASK_DEFINITION', p_values => q.task_definition, p_clear_cache => '146') as open_url
                  from (
                        select s.task_definition,
                               nvl(t.name, s.task_definition) as task_name,
                               s.due_days,
                               s.reminder_days_before,
                               r.role_name as escalation_role,
                               s.notify_on_create_flag,
                               s.description
                          from xxfnd_task_settings s
                          left join apex_appl_taskdefs t on t.static_id = s.task_definition and t.application_id = :APP_ID
                          left join xxfnd_roles r on r.role_code = s.escalation_role_code
                       ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column TASK_DEFINITION (
            type: hidden
            heading {
                heading: Task Definition
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
                primaryKey: true
            }
        )

        column TASK_NAME (
            type: plainText
            heading {
                heading: Task
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#TASK_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column DUE_DAYS (
            type: plainText
            heading {
                heading: Due (days)
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
        )

        column REMINDER_DAYS_BEFORE (
            type: plainText
            heading {
                heading: Reminder (days before)
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
        )

        column ESCALATION_ROLE (
            type: plainText
            heading {
                heading: Escalate To
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column NOTIFY_ON_CREATE_FLAG (
            type: plainText
            heading {
                heading: E-mail on Creation
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Add Task Deadline
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 146
                clearCache: 146
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
