page 20 (
    name: Parties
    alias: PARTIES
    title: Parties
    pageGroup: @parties
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Every company and person the organization deals with. Open a party to see contacts, ownership, documents and additional information.
    }

    region breadcrumb (
        name: Parties
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Parties
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 21, p_items => 'P21_PARTY_ID', p_values => to_char(q.party_id), p_clear_cache => '21') as open_url,
                       case when xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE') and q.enabled_flag = 'Y'
                            then apex_page.get_url(p_page => 21, p_items => 'P21_PARTY_ID,P21_MODE',
                                                   p_values => to_char(q.party_id) || ',EDIT', p_clear_cache => '21') end as edit_url,
                       case when xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE') and q.enabled_flag = 'Y' then 'Edit' end as edit
                  from (

                    select p.party_id,
                           p.party_number,
                           p.party_name,
                           xxfnd_util_pkg.lookup_meaning('PARTY_TYPE', p.party_type) as party_type,
                           p.registration_number,
                           xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction) as jurisdiction,
                           xxfnd_util_pkg.lookup_meaning('ENTITY_TYPE', p.entity_type) as entity_type,
                           xxfnd_util_pkg.lookup_meaning('DATA_PROVENANCE', p.data_provenance) as data_provenance,
                           p.last_verified_date,
                           p.enabled_flag,
                           p.last_update_date
                      from xxcmp_parties p
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column PARTY_ID (
            type: hidden
            heading {
                heading: Party Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Number
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#PARTY_NUMBER#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column PARTY_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration No.
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column JURISDICTION (
            type: plainText
            heading {
                heading: Jurisdiction
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column ENTITY_TYPE (
            type: plainText
            heading {
                heading: Entity Type
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column DATA_PROVENANCE (
            type: plainText
            heading {
                heading: Provenance
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column LAST_VERIFIED_DATE (
            type: plainText
            heading {
                heading: Last Verified
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        column LAST_UPDATE_DATE (
            type: plainText
            heading {
                heading: Updated
            }
            layout {
                sequence: 110
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

        column EDIT (
            type: plainText
            heading {
                heading: Edit
            }
            layout {
                sequence: 115
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#EDIT_URL#">#EDIT#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
        )

        column EDIT_URL (
            type: hidden
            heading {
                heading: Edit Url
            }
            layout {
                sequence: 125
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Party
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                clearCache: 24
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

)
