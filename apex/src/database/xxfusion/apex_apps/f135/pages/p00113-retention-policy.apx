page 113 (
    name: Retention Policy
    alias: RETENTION-POLICY
    title: Retention Policy
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: How long records are kept, optionally per jurisdiction.
    }

    region form (
        name: Retention Policy
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_RETENTION_POLICIES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P113_RETENTION_POLICY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: RETENTION_POLICY_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P113_APPLICATION_CODE (
        type: selectList
        label {
            label: Application
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-applications
            displayNullValue: true
            nullDisplayValue: Shared (every application)
        }
        layout {
            sequence: 15
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nullif(:G_ADMIN_APP, 'ALL')
                ```
        }
        help {
            inlineHelpText: Empty: shared by every application.
        }
    )

    pageItem P113_TABLE_NAME (
        type: textField
        label {
            label: Table
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 128
        }
        source {
            formRegion: @form
            column: TABLE_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the table.
        }
    )

    pageItem P113_JURISDICTION (
        type: selectList
        label {
            label: Jurisdiction
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-jurisdiction
            displayNullValue: true
            nullDisplayValue: - All -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: JURISDICTION
            dataType: varchar2
        }
        help {
            helpText: Choose the jurisdiction.
        }
    )

    pageItem P113_RETENTION_YEARS (
        type: numberField
        label {
            label: Retention in Years
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: RETENTION_YEARS
            dataType: number
        }
        help {
            helpText: Enter the retention in Years.
        }
    )

    pageItem P113_ACTION_AT_EXPIRY (
        type: selectList
        label {
            label: Action at Expiry
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-retention-action
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ACTION_AT_EXPIRY
            dataType: varchar2
        }
        help {
            helpText: Choose the action at Expiry.
        }
    )

    pageItem P113_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Choose the enabled.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P113_RETENTION_POLICY_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P113_RETENTION_POLICY_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P113_RETENTION_POLICY_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
