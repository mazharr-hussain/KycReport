page 10021 (
    name: Optional Feature
    alias: OPTIONAL-FEATURE
    title: Optional Feature
    pageGroup: @features
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Include shows the feature; Exclude hides it everywhere.
    }

    region feature (
        name: Optional Feature
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: feature
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10021_APPLICATION_CODE (
        type: hidden
        layout {
            sequence: 2
            region: @feature
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10021_BUILD_OPTION_ID (
        type: hidden
        layout {
            sequence: 1
            region: @feature
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10021_NAME (
        type: displayOnly
        label {
            label: Feature
            alignment: left
        }
        layout {
            sequence: 10
            region: @feature
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select build_option_name from apex_application_build_options
                 where application_id = xxfnd_application_pkg.apex_app_id(:P10021_APPLICATION_CODE) and build_option_id = :P10021_BUILD_OPTION_ID
                ```
            used: always
        }
    )

    pageItem P10021_STATUS (
        type: radioGroup
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Include' as display_value, 'INCLUDE' as return_value from dual union all
                select 'Exclude', 'EXCLUDE' from dual
                ```
        }
        layout {
            sequence: 20
            region: @feature
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select upper(build_option_status) from apex_application_build_options
                 where application_id = xxfnd_application_pkg.apex_app_id(:P10021_APPLICATION_CODE) and build_option_id = :P10021_BUILD_OPTION_ID
                ```
            used: always
        }
        help {
            helpText: Choose the status.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Apply
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process set-status (
        name: Set feature status
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 80: the Optional Features package (no APEX API code on the page)
                xxfnd_app_setting_pkg.set_feature_status(:P10021_APPLICATION_CODE, to_number(:P10021_BUILD_OPTION_ID), :P10021_STATUS);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Feature updated.
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

)
