page 137 (
    name: Storage Rule
    alias: STORAGE-RULE
    title: Storage Rule
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: UCM needs a security group; SharePoint needs the site and drive IDs.
    }

    region form (
        name: Storage Rule
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_STORAGE_CONFIG
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P137_STORAGE_CONFIG_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: STORAGE_CONFIG_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P137_APPLICATION_CODE (
        type: selectList
        label {
            label: Application
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-applications
            displayNullValue: true
            nullDisplayValue: All applications (instance)
        }
        layout {
            sequence: 15
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :G_ADMIN_LOCK = 'Y'   -- release 73: delegated - the application that opened the screen
                ```
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nullif(:G_ADMIN_APP, 'ALL')
                ```
        }
        help {
            inlineHelpText: The setup type decides which applications, and whether all applications (instance), may be chosen.
        }
    )

    pageItem P137_ENTITY_NAME (
        type: selectList
        label {
            label: Entity
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-entities
            displayNullValue: true
            nullDisplayValue: - Any -
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENTITY_NAME
            dataType: varchar2
        }
        help {
            helpText: Choose the entity.
        }
    )

    pageItem P137_CATEGORY_CODE (
        type: selectList
        label {
            label: Category
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-categories
            displayNullValue: true
            nullDisplayValue: - Any -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: CATEGORY_CODE
            dataType: varchar2
        }
        help {
            helpText: Choose the category.
        }
    )

    pageItem P137_STORAGE_TYPE (
        type: selectList
        label {
            label: Store
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-storage-type
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: STORAGE_TYPE
            dataType: varchar2
        }
        help {
            helpText: Choose the store.
        }
    )

    pageItem P137_ENDPOINT_CODE (
        type: selectList
        label {
            label: Endpoint
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-endpoints
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ENDPOINT_CODE
            dataType: varchar2
        }
        help {
            helpText: Choose the endpoint.
        }
    )

    pageItem P137_FOLDER_PATH_TEMPLATE (
        type: textField
        label {
            label: Folder Template
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: FOLDER_PATH_TEMPLATE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: /#ENTITY_NAME#/#PK1_VALUE#
        }
        help {
            helpText:
                ```
                Tokens: #ENTITY_NAME#, #PK1_VALUE#..#PK5_VALUE#, #CATEGORY_CODE#, #YYYY#.
                ```
        }
    )

    pageItem P137_UCM_SECURITY_GROUP (
        type: textField
        label {
            label: UCM Security Group
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form
            column: UCM_SECURITY_GROUP
            dataType: varchar2
        }
        help {
            helpText: Enter the uCM Security Group.
        }
    )

    pageItem P137_UCM_DOC_TYPE (
        type: textField
        label {
            label: UCM Document Type
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form
            column: UCM_DOC_TYPE
            dataType: varchar2
        }
        help {
            helpText: Enter the uCM Document Type.
        }
    )

    pageItem P137_UCM_DOC_ACCOUNT (
        type: textField
        label {
            label: UCM Account
            alignment: left
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form
            column: UCM_DOC_ACCOUNT
            dataType: varchar2
        }
        help {
            helpText: Enter the uCM Account.
        }
    )

    pageItem P137_SHAREPOINT_SITE_ID (
        type: textField
        label {
            label: SharePoint Site ID
            alignment: left
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form
            column: SHAREPOINT_SITE_ID
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        help {
            helpText: Enter the sharePoint Site ID.
        }
    )

    pageItem P137_SHAREPOINT_DRIVE_ID (
        type: textField
        label {
            label: SharePoint Drive ID
            alignment: left
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form
            column: SHAREPOINT_DRIVE_ID
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        help {
            helpText: Enter the sharePoint Drive ID.
        }
    )

    pageItem P137_PRIORITY (
        type: numberField
        label {
            label: Priority
            alignment: left
        }
        layout {
            sequence: 110
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: PRIORITY
            dataType: number
        }
        default {
            type: static
            staticValue: 100
        }
        help {
            helpText: Enter the priority.
        }
    )

    pageItem P137_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 120
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Choose the enabled.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P137_STORAGE_CONFIG_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_STORAGE_CONFIG_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_STORAGE_CONFIG_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
