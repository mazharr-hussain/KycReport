page 137 (
    name: Application Storage
    alias: STORAGE-RULE
    title: Application Storage
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The one storage editor of an application (release 86; P137_APPLICATION_CODE, opened from the Storage tab and from the
            application journey). Application default: a storage server of the workspace with the application's site and document
            library (SharePoint), bucket (OCI Object Storage) or security group, account and document type (UCM), and the folder;
            no server = the database. Categories: every field may override the application's (empty = as the application; the
            server may be another one, or Database). Folder tokens: #CATEGORY#, #ENTITY_NAME#, #PK1_VALUE#, #YYYY#; default
            /#CATEGORY#/#ENTITY_NAME#/#PK1_VALUE#. While the setup is incomplete the documents are kept in the database
            (state "INCOMPLETE - using database"); documents already stored keep their place.
            ```
    }

    region application (
        name: Application Default
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: application-default
        }
    )

    region categories (
        name: Categories
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 86: each category the application uses, its overrides and the value each field takes
                select v.category_code, v.category_name,
                       case when v.server_type = 'DATABASE' then 'DATABASE'
                            else v.server_code end                                  as server_code,
                       v.site, v.library, v.bucket, v.security_group, v.account, v.document_type, v.folder,
                       nvl(v.effective_server_name, 'Database')
                         || case v.effective_server_type
                                 when 'SHAREPOINT'     then ' - ' || v.effective_site || ' / ' || v.effective_library
                                 when 'OBJECT_STORAGE' then ' - ' || v.effective_bucket
                                 when 'UCM'            then ' - ' || v.effective_security_group
                            end
                         || case when v.effective_server_code is not null then ' - ' || v.effective_folder end as effective_storage,
                       v.state || case when v.incomplete_reason is not null then ': needs ' || v.incomplete_reason end as state
                  from xxfnd_app_storage_v v
                 where v.application_code = :P137_APPLICATION_CODE
                   and v.category_code is not null
                ```
            pageItemsToSubmit: P137_APPLICATION_CODE
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: categories
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: scroll
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No document category for this application.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @CATEGORY_NAME
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @SERVER_CODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SITE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @LIBRARY
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @BUCKET
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @SECURITY_GROUP
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ACCOUNT
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @DOCUMENT_TYPE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @FOLDER
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @EFFECTIVE_STORAGE
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @STATE
                layout {
                    sequence: 11
                }
            )
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column CATEGORY_CODE (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: CATEGORY_CODE
                dataType: varchar2
                primaryKey: true
            }
        )

        column CATEGORY_NAME (
            type: displayOnly
            heading {
                heading: Category
            }
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: CATEGORY_NAME
                dataType: varchar2
            }
        )

        column SERVER_CODE (
            type: selectList
            heading {
                heading: Server
            }
            layout {
                sequence: 30
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select display_value, return_value
                      from (select 'Database' as display_value, 'DATABASE' as return_value, 0 as seq from dual
                            union all
                            select server_name || ' (' || server_type_name || ')', server_code, 1
                              from xxfnd_servers_v
                             where usage = 'STORAGE')
                     order by seq, display_value
                    ```
                displayNullValue: true
                nullDisplayValue: As the application
            }
            source {
                type: databaseColumn
                databaseColumn: SERVER_CODE
                dataType: varchar2
            }
            help {
                helpText: Empty = the application's server; Database = this category in the database; or another storage server.
            }
        )

        column SITE (
            type: textField
            heading {
                heading: Site
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 500
            }
            source {
                type: databaseColumn
                databaseColumn: SITE
                dataType: varchar2
            }
        )

        column LIBRARY (
            type: textField
            heading {
                heading: Document Library
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 500
            }
            source {
                type: databaseColumn
                databaseColumn: LIBRARY
                dataType: varchar2
            }
        )

        column BUCKET (
            type: textField
            heading {
                heading: Bucket
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 255
            }
            source {
                type: databaseColumn
                databaseColumn: BUCKET
                dataType: varchar2
            }
        )

        column SECURITY_GROUP (
            type: textField
            heading {
                heading: Security Group
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 100
            }
            source {
                type: databaseColumn
                databaseColumn: SECURITY_GROUP
                dataType: varchar2
            }
        )

        column ACCOUNT (
            type: textField
            heading {
                heading: Account
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 100
            }
            source {
                type: databaseColumn
                databaseColumn: ACCOUNT
                dataType: varchar2
            }
        )

        column DOCUMENT_TYPE (
            type: textField
            heading {
                heading: Document Type
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 100
            }
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_TYPE
                dataType: varchar2
            }
        )

        column FOLDER (
            type: textField
            heading {
                heading: Folder
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 1000
            }
            source {
                type: databaseColumn
                databaseColumn: FOLDER
                dataType: varchar2
            }
        )

        column EFFECTIVE_STORAGE (
            type: displayOnly
            heading {
                heading: Stored In
            }
            layout {
                sequence: 110
            }
            source {
                type: databaseColumn
                databaseColumn: EFFECTIVE_STORAGE
                dataType: varchar2
                queryOnly: true
            }
        )

        column STATE (
            type: displayOnly
            heading {
                heading: State
            }
            layout {
                sequence: 120
            }
            source {
                type: databaseColumn
                databaseColumn: STATE
                dataType: varchar2
                queryOnly: true
            }
        )
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P137_APPLICATION_CODE (
        type: hidden
        layout {
            sequence: 1
            region: @application
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P137_SERVER_TYPE (
        type: hidden
        layout {
            sequence: 2
            region: @application
            slot: regionBody
        }
    )

    pageItem P137_APPLICATION_NAME (
        type: displayOnly
        label {
            label: Application
            alignment: left
        }
        layout {
            sequence: 5
            region: @application
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        help {
            helpText: 'The application whose storage this is (COMMON = the instance).'
        }
    )

    pageItem P137_SERVER_CODE (
        type: selectList
        label {
            label: Server
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select server_name || ' (' || server_type_name || case when status <> 'OK' then ' - ' || status_text end || ')' as display_value,
                       server_code as return_value
                  from xxfnd_servers_v
                 where usage = 'STORAGE'
                 order by server_name
                ```
            displayNullValue: true
            nullDisplayValue: Database (no server)
        }
        layout {
            sequence: 10
            region: @application
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: 'A storage server of the workspace (Servers tab); empty = the database.'
        }
    )

    pageItem P137_SITE (
        type: textField
        label {
            label: SharePoint Site
            alignment: left
        }
        layout {
            sequence: 20
            region: @application
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        help {
            helpText: 'SharePoint: the site (Microsoft Graph site ID).'
        }
    )

    pageItem P137_LIBRARY (
        type: textField
        label {
            label: Document Library
            alignment: left
        }
        layout {
            sequence: 30
            region: @application
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        help {
            helpText: 'SharePoint: the document library (Microsoft Graph drive ID).'
        }
    )

    pageItem P137_BUCKET (
        type: textField
        label {
            label: Bucket
            alignment: left
        }
        layout {
            sequence: 40
            region: @application
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
        help {
            helpText: 'OCI Object Storage: the bucket.'
        }
    )

    pageItem P137_SECURITY_GROUP (
        type: textField
        label {
            label: Security Group
            alignment: left
        }
        layout {
            sequence: 50
            region: @application
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        help {
            helpText: 'UCM: the security group (required).'
        }
    )

    pageItem P137_ACCOUNT (
        type: textField
        label {
            label: Account
            alignment: left
        }
        layout {
            sequence: 60
            region: @application
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        help {
            helpText: 'UCM: the account (optional).'
        }
    )

    pageItem P137_DOCUMENT_TYPE (
        type: textField
        label {
            label: Document Type
            alignment: left
        }
        layout {
            sequence: 70
            region: @application
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        help {
            helpText: 'UCM: the document type (default Document).'
        }
    )

    pageItem P137_FOLDER (
        type: textField
        label {
            label: Folder
            alignment: left
        }
        layout {
            sequence: 80
            region: @application
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: 'Folder of new files; empty = /#CATEGORY#/#ENTITY_NAME#/#PK1_VALUE#. Tokens: #CATEGORY#, #ENTITY_NAME#, #PK1_VALUE#..#PK5_VALUE#, #YYYY#.'
        }
    )

    pageItem P137_STATE (
        type: displayOnly
        label {
            label: State
            alignment: left
        }
        layout {
            sequence: 90
            region: @application
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        help {
            helpText: 'OK, or INCOMPLETE - using database with what is missing.'
        }
    )

    process load-application (
        name: Load the application default
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 86: the application line of XXFND_APP_STORAGE_V (reads only)
                for v in (select application_name, server_code, site, library, bucket, security_group, account,
                                 document_type, folder, effective_server_type,
                                 state || case when incomplete_reason is not null then ': needs ' || incomplete_reason end as state
                            from xxfnd_app_storage_v
                           where application_code = :P137_APPLICATION_CODE and category_code is null) loop
                    :P137_APPLICATION_NAME := v.application_name;
                    :P137_SERVER_CODE      := v.server_code;
                    :P137_SERVER_TYPE      := case when v.server_code is not null then v.effective_server_type end;
                    :P137_SITE             := v.site;
                    :P137_LIBRARY          := v.library;
                    :P137_BUCKET           := v.bucket;
                    :P137_SECURITY_GROUP   := v.security_group;
                    :P137_ACCOUNT          := v.account;
                    :P137_DOCUMENT_TYPE    := v.document_type;
                    :P137_FOLDER           := v.folder;
                    :P137_STATE            := v.state;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    process save-application (
        name: Save the application default
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 86: saved by the attachments package (no DML in the page)
                xxfnd_attach_pkg.save_app_storage(
                    p_application_code => :P137_APPLICATION_CODE,
                    p_server_code      => :P137_SERVER_CODE,
                    p_site             => :P137_SITE,
                    p_library          => :P137_LIBRARY,
                    p_bucket           => :P137_BUCKET,
                    p_security_group   => :P137_SECURITY_GROUP,
                    p_account          => :P137_ACCOUNT,
                    p_document_type    => :P137_DOCUMENT_TYPE,
                    p_folder           => :P137_FOLDER);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Storage saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-categories (
        name: Save the category overrides
        type: interactiveGridAutoRowProcessing
        editableRegion: @categories
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                -- release 86: each changed category through the attachments package (no DML in the page)
                xxfnd_attach_pkg.save_category_storage(
                    p_application_code => :P137_APPLICATION_CODE,
                    p_category_code    => :CATEGORY_CODE,
                    p_server_code      => :SERVER_CODE,
                    p_site             => :SITE,
                    p_library          => :LIBRARY,
                    p_bucket           => :BUCKET,
                    p_security_group   => :SECURITY_GROUP,
                    p_account          => :ACCOUNT,
                    p_document_type    => :DOCUMENT_TYPE,
                    p_folder           => :FOLDER);
                ```
        }
        lockRow {
            preventLostUpdates: false
            lockRow: false
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction server-type (
        name: The server decides the fields
        execution {
            sequence: 20
        }
        when {
            event: change
            selectionType: items
            items: P137_SERVER_CODE
        }

        action server-type-set (
            action: setValue
            settings {
                type: sqlQuery
                itemsToSubmit: P137_SERVER_CODE
                sqlQuery:
                    ```sql
                    select max(server_type) from xxfnd_servers where server_code = :P137_SERVER_CODE
                    ```
            }
            affectedElements {
                selectionType: items
                items: P137_SERVER_TYPE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction show-sharepoint (
        name: Fields of the server type - sharepoint
        execution {
            sequence: 30
        }
        when {
            event: change
            selectionType: items
            items: P137_SERVER_TYPE
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: apex.items.P137_SERVER_TYPE.value === 'SHAREPOINT'
        }

        action show-sharepoint-show (
            action: show
            affectedElements {
                selectionType: items
                items: P137_SITE,P137_LIBRARY
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-sharepoint-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P137_SITE,P137_LIBRARY
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction show-object-storage (
        name: Fields of the server type - object-storage
        execution {
            sequence: 40
        }
        when {
            event: change
            selectionType: items
            items: P137_SERVER_TYPE
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: apex.items.P137_SERVER_TYPE.value === 'OBJECT_STORAGE'
        }

        action show-object-storage-show (
            action: show
            affectedElements {
                selectionType: items
                items: P137_BUCKET
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-object-storage-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P137_BUCKET
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction show-ucm (
        name: Fields of the server type - ucm
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P137_SERVER_TYPE
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: apex.items.P137_SERVER_TYPE.value === 'UCM'
        }

        action show-ucm-show (
            action: show
            affectedElements {
                selectionType: items
                items: P137_SECURITY_GROUP,P137_ACCOUNT,P137_DOCUMENT_TYPE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-ucm-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P137_SECURITY_GROUP,P137_ACCOUNT,P137_DOCUMENT_TYPE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    dynamicAction show-folder (
        name: Fields of the server type - folder
        execution {
            sequence: 60
        }
        when {
            event: change
            selectionType: items
            items: P137_SERVER_TYPE
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: apex.items.P137_SERVER_TYPE.value !== ''
        }

        action show-folder-show (
            action: show
            affectedElements {
                selectionType: items
                items: P137_FOLDER
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action show-folder-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P137_FOLDER
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )
)
