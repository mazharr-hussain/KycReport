page 160 (
    name: Applications
    alias: APPLICATIONS
    title: Applications
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: The applications that use the common setup. Open one to switch its common functions on and see its setup.
    }

    region breadcrumb (
        name: Applications
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Applications
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 161, p_items => 'P161_APPLICATION_ID,G_ADMIN_APP',
                                         p_values => to_char(q.application_id) || ',' || q.application_code,
                                         p_clear_cache => '161') as open_url
                  from (
                            select a.application_id, a.application_code, a.application_name, a.apex_app_alias,
                                   a.apex_application_id, a.schema_name, a.enabled_flag,
                                   (select count(*) from xxfnd_application_functions f
                                     where f.application_code = a.application_code and f.enabled_flag = 'Y') as functions_on
                              from xxfnd_applications a
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#APPLICATION_CODE#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column APPLICATION_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column APEX_APP_ALIAS (
            type: plainText
            heading {
                heading: APEX Alias
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column APEX_APPLICATION_ID (
            type: plainText
            heading {
                heading: APEX Application
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
        )

        column SCHEMA_NAME (
            type: plainText
            heading {
                heading: Schema
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column FUNCTIONS_ON (
            type: plainText
            heading {
                heading: Functions On
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )

        column APPLICATION_ID (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Register Application
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 161
                clearCache: 161
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

)
