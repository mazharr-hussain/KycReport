page 166 (
    name: Application
    alias: APPLICATION
    title: &P166_APPLICATION_CODE.
    pageGroup: @administration
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            One registered application, section by section, in the order of the registration journey: Application, Roles,
            Users, Shared functions, Setup types, Processes, Notifications, Document storage and Integrations. The menu on
            the left shows the state of each section and jumps to it. Edit opens the journey at the first step (each
            section's Edit opens its own step); Add, Edit and Remove inside a section open the screen that keeps that
            setup (Role, Assign, Setup Type, Storage, Purpose). Disable keeps the application with its data but stops it
            being chosen on the setup screens. Delete is offered only for a disabled application that no data refers to;
            otherwise the reason is shown.
            ```
    }

    region breadcrumb (
        name: Application
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region section-nav (
        name: Sections
        type: list
        source {
            list: @application-journey
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_02
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/links-list
            templateOptions: [
                #DEFAULT#
                t-LinksList--showIcons
                t-LinksList--showBadge
            ]
        }
        advanced {
            htmlDomId: jrn-sections
        }
        comments {
            comments: Release 86 - the section menu: the shared list application-journey (also the Wizard Progress of page 165) with each section's state as the badge.
        }
    )

    region header (
        name: Application Header
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 86: the header card - the application, its APEX application and schema, its status
                select a.application_code,
                       a.application_name || ' (' || a.application_code || ')' as title,
                       'APEX application ' || nvl(to_char(a.apex_application_id), '-')
                       || nvl2(a.apex_app_alias, ' · alias ' || a.apex_app_alias, null)
                       || nvl2(a.schema_name, ' · schema ' || a.schema_name, null)
                       || ' · e-mail ' || case a.email_enabled_flag when 'Y' then 'on' else 'off' end as description,
                       a.description as misc,
                       case a.enabled_flag when 'Y' then 'Enabled' else 'Disabled' end as badge_text,
                       case a.enabled_flag when 'Y' then 'success' else 'warning' end as badge_state
                  from xxfnd_applications a
                 where a.application_code = :P166_APPLICATION_CODE
                ```
            pageItemsToSubmit: P166_APPLICATION_CODE
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        advanced {
            htmlDomId: jrn-header
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            description: &DESCRIPTION.
            miscellaneous: &MISC.
            displayBadge: true
        }
        plugin-badge {
            label: Status
            value: BADGE_TEXT
            state: BADGE_STATE
            style: outline
        }
        messages {
            whenNoDataFound: The application is not registered.
        }

        column APPLICATION_CODE (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: APPLICATION_CODE
                dataType: varchar2
                primaryKey: true
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column DESCRIPTION (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column MISC (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MISC
                dataType: varchar2
            }
        )

        column BADGE_TEXT (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BADGE_TEXT
                dataType: varchar2
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )
    )

    region actions (
        name: Actions
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: jrn-actions
        }
    )

    pageItem P166_APPLICATION_CODE (
        type: hidden
        layout {
            sequence: 10
            region: @actions
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        comments {
            comments: The application shown (XXFND_APPLICATIONS.APPLICATION_CODE), from the Applications list or the journey.
        }
    )

    pageItem P166_ENABLED_FLAG (
        type: hidden
        layout {
            sequence: 20
            region: @actions
            slot: regionBody
        }
        comments {
            comments: Y when the application is enabled (decides Disable or Enable).
        }
    )

    pageItem P166_DELETE_BLOCKER (
        type: displayOnly
        label {
            label: Delete
            alignment: left
        }
        layout {
            sequence: 30
            region: @actions
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P166_DELETE_BLOCKER
        }
        security {
            authorizationScheme: @page-manage
        }
        help {
            helpText: Why the application cannot be deleted now (XXFND_APPLICATION_PKG.DELETE_BLOCKER). An application can be deleted only when it is disabled and no data refers to it - tasks, information requests, communications, documents, notifications, roles with users or setup rows.
        }
    )

    button edit (
        buttonName: EDIT
        label: Edit
        layout {
            sequence: 10
            region: @actions
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 165
                items: {
                    P165_APPLICATION_CODE: &P166_APPLICATION_CODE.
                    P165_STEP: 1
                }
                clearCache: 165
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button disable (
        buttonName: DISABLE
        label: Disable
        layout {
            sequence: 20
            region: @actions
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Disable &P166_APPLICATION_CODE.? It is kept with its data but can no longer be chosen on the setup screens.
            style: warning
        }
        serverSideCondition {
            type: item=value
            item: P166_ENABLED_FLAG
            value: Y
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button enable (
        buttonName: ENABLE
        label: Enable
        layout {
            sequence: 30
            region: @actions
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P166_ENABLED_FLAG
            value: Y
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @actions
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Delete &P166_APPLICATION_CODE.? Its registration and standard rows are removed; this cannot be undone.
            style: danger
        }
        serverSideCondition {
            type: itemIsNull
            item: P166_DELETE_BLOCKER
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    process load (
        name: Load the application
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 86: the application of the page, for the header, the actions and the shared sections (P0_JRN_APP)
                select max(enabled_flag) into :P166_ENABLED_FLAG
                  from xxfnd_applications
                 where application_code = :P166_APPLICATION_CODE;
                if :P166_ENABLED_FLAG is null then
                    raise_application_error(-20185, 'The application is not registered.');
                end if;
                :P0_JRN_APP := :P166_APPLICATION_CODE;
                :P0_JRN_KEY := null;
                :P166_DELETE_BLOCKER := xxfnd_application_pkg.delete_blocker(:P166_APPLICATION_CODE);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process disable (
        name: Disable
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_application_pkg.set_enabled(:P166_APPLICATION_CODE, 'N');
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Application &P166_APPLICATION_CODE. disabled.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DISABLE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process enable (
        name: Enable
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_application_pkg.set_enabled(:P166_APPLICATION_CODE, 'Y');
                ```
        }
        execution {
            sequence: 15
            point: processing
        }
        successMessage {
            successMessage: Application &P166_APPLICATION_CODE. enabled.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ENABLE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process delete (
        name: Delete the application
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- refused with the reason (XXFND_APPLICATION_PKG.DELETE_BLOCKER) when data still refers to it
                xxfnd_application_pkg.delete_application(:P166_APPLICATION_CODE);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Application &P166_APPLICATION_CODE. deleted.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    branch (
        name: After delete: the Applications list
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 160
                clearCache: 166
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

    branch (
        name: Back to the application
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 166
            }
        }
    )

)
