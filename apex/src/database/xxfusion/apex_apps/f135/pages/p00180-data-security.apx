page 180 (
    name: Data Security
    alias: DATA-SECURITY
    title: Data Security
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Which rows each role can see. A user sees the rows allowed by any rule of any of their active roles;
            a table with rules shows nothing to a user whose roles have no rule for it.
            ```
    }

    region breadcrumb (
        name: Data Security
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Data Security Rules
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 181, p_items => 'P181_RULE_ID', p_values => to_char(q.rule_id), p_clear_cache => '181') as open_url
                  from (
                            select d.rule_id,
                                   r.role_name,
                                   d.table_name,
                                   case d.rule_type
                                        when 'ALL_ROWS'       then 'All rows'
                                        when 'OWN_RECORDS'    then 'Own records'
                                        when 'COLUMN_IN_LIST' then 'Column in list'
                                   end as rule_type,
                                   d.column_name,
                                   d.value_list,
                                   d.description,
                                   d.enabled_flag
                              from xxfnd_data_security_rules d
                              join xxfnd_roles r on r.role_code = d.role_code
                             where (:G_ADMIN_APP = 'ALL' or r.application_code = :G_ADMIN_APP)   -- the application filter (ALL: every application)
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column RULE_ID (
            type: hidden
            heading {
                heading: Rule Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#ROLE_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column TABLE_NAME (
            type: plainText
            heading {
                heading: Table
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column RULE_TYPE (
            type: plainText
            heading {
                heading: Rule
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column COLUMN_NAME (
            type: plainText
            heading {
                heading: Column
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column VALUE_LIST (
            type: plainText
            heading {
                heading: Values
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Rule
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 181
                clearCache: 181
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
