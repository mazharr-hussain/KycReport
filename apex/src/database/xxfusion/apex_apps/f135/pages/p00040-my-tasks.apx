page 40 (
    name: My Tasks
    alias: MY-TASKS
    title: My Tasks
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @signed-in-user
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Your open tasks from every application in one list (approvals, requests for information and other tasks). Open a
            task to work on it in its own application; you stay signed in. Filter by Application to see one application only.
            ```
    }

    region breadcrumb (
        name: My Tasks
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tasks (
        name: My Tasks
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 82 (D20): the user's tasks of every application of the workspace (no application filter)
                select t.task_id,
                       t.details_app_name   as application_name,
                       t.subject,
                       t.task_def_name      as task_type,
                       t.state,
                       t.priority_level     as priority,
                       t.due_on,
                       t.initiator,
                       t.created_on,
                       -- release 90 (C12): the link with its checksum, also for another application's task page
                       apex_util.prepare_url(t.details_link_target) as open_url
                  from table(apex_human_task.get_tasks(p_context => 'MY_TASKS', p_application_id => null)) t
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tasks
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: You have no open task.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column TASK_ID (
            type: hidden
            heading {
                heading: Task
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column APPLICATION_NAME (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column SUBJECT (
            type: plainText
            heading {
                heading: Task
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#SUBJECT#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column TASK_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column STATE (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column PRIORITY (
            type: plainText
            heading {
                heading: Priority
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column DUE_ON (
            type: plainText
            heading {
                heading: Due
            }
            layout {
                sequence: 70
            }
            source {
                dataType: DATE
            }
        )

        column INITIATOR (
            type: plainText
            heading {
                heading: Initiated By
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )
    )

    process from-app (
        name: Application the user came from
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 97 (UI issue 11): the name at the top and the Home link follow the application My Tasks was
                -- opened from (the referring page); opened from a COMMON page, they are COMMON's; a refresh of My Tasks
                -- keeps them
                declare
                    l_ref   varchar2(4000) := owa_util.get_cgi_env('HTTP_REFERER');
                    l_alias varchar2(255)  := upper(coalesce(regexp_substr(l_ref, '/r/[^/]+/([^/?#]+)', 1, 1, 'i', 1),
                                                             regexp_substr(l_ref, 'f\?p=([^:&]+)', 1, 1, 'i', 1)));
                begin
                    if l_alias is not null and l_alias not in (upper(:APP_ALIAS), to_char(:APP_ID)) then
                        :G_FROM_APP_NAME := null;
                        :G_HOME_URL      := null;
                        for a in (select a.application_id, a.application_name, a.home_link
                                    from apex_applications a
                                   where (upper(a.alias) = l_alias or to_char(a.application_id) = l_alias)
                                     and a.workspace = (select c.workspace from apex_applications c where c.application_id = :APP_ID)) loop
                            :G_FROM_APP_NAME := a.application_name;
                            :G_HOME_URL      := apex_page.get_url(p_application => a.application_id,
                                                    p_page => nvl(regexp_substr(a.home_link, 'f\?p=[^:]*:([^:&]+)', 1, 1, 'i', 1), '1'));
                        end loop;
                    elsif l_alias is not null and lower(l_ref) not like '%my-tasks%' and l_ref not like '%:40:%' then
                        :G_FROM_APP_NAME := null;
                        :G_HOME_URL      := null;
                    end if;
                    :G_APP_TITLE := nvl(:G_FROM_APP_NAME, :G_APP_TITLE);
                    :G_HOME_URL  := nvl(:G_HOME_URL, apex_page.get_url(p_page => 1));
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
)
