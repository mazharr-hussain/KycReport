page 104 (
    name: User
    alias: USER
    title: User
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            A user of every application: a local user (user name and password kept by APEX) or an employee who signs in
            with the company account. The user is on top; the tabs show the roles and privileges and the data access
            the user has. Release 96: the user's applications; their roles (with the roles inside them); and per role the
            data access values (e.g. Department = Finance, Procurement, with a different value for one screen when
            needed). Data access is given only through roles. A role of an application that keeps its users itself is
            shown read-only (change it in that application).
            ```
    }

    region breadcrumb (
        name: User
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region user (
        name: &P104_TITLE.
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: user
        }
    )

    pageItem P104_USER_ID (
        type: hidden
        layout {
            sequence: 1
            region: @user
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P104_TITLE (
        type: hidden
        layout {
            sequence: 2
            region: @user
            slot: regionBody
        }
        default {
            type: static
            staticValue: New User
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        comments {
            comments: Release 96 (UI issue 12) - the user's name in the breadcrumb and title.
        }
    )

    pageItem P104_REMOVE_ID (
        type: hidden
        layout {
            sequence: 2
            region: @user
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P104_USER_TYPE (
        type: radioGroup
        label {
            label: Kind of User
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Local user (user name and password);LOCAL,Employee (company sign-in);SSO
            displayExtraValues: false
            displayNullValue: false
        }
        default {
            type: static
            staticValue: LOCAL
        }
        layout {
            sequence: 10
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: true
            columnSpan: 4
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        readOnly {
            type: itemIsNotNull
            item: P104_USER_ID
        }
        help {
            helpText: Local: the user signs in with a user name and a password kept by APEX. Employee: the person signs in with the company account (single sign-on).
        }
    )
    pageItem P104_EMPLOYEE_ID (
        type: popupLov
        label {
            label: Employee
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.full_name || ' (' || e.email_address || ')' as display_value, e.employee_id as return_value
                  -- employees that have no user yet (release 91: the query starts with SELECT, otherwise an item's LOV
                  -- is run as PL/SQL and fails with PLS-00428)
                  from xxfnd_employees e
                 where e.enabled_flag = 'Y'
                   and not exists (select 1 from xxfnd_users u where u.employee_id = e.employee_id)
                 order by 1
                ```
        }
        layout {
            sequence: 20
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: itemIsNull
            item: P104_USER_ID
        }
        help {
            helpText: The employee (from Fusion HCM or created locally) who becomes a user; only employees without a user are listed.
        }
    )
    pageItem P104_USER_NAME (
        type: textField
        label {
            label: User Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        readOnly {
            type: itemIsNotNull
            item: P104_USER_ID
        }
        help {
            helpText: The sign-in name, in capitals. An employee user gets the employees user name.
        }
    )
    pageItem P104_EMPLOYEE (
        type: displayOnly
        label {
            label: Employee
            alignment: left
        }
        layout {
            sequence: 35
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_USER_ID
        }
        help {
            helpText: The employee this user is, with department and job (from Fusion HCM).
        }
    )
    pageItem P104_FULL_NAME (
        type: textField
        label {
            label: Full Name
            alignment: left
        }
        layout {
            sequence: 40
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: true
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_USER_TYPE = 'SSO'
                ```
        }
        help {
            helpText: The name shown on screens and in e-mails. For an employee it comes from Fusion HCM.
        }
    )
    pageItem P104_EMAIL (
        type: textField
        label {
            label: E-mail
            alignment: left
        }
        layout {
            sequence: 50
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_USER_TYPE = 'SSO'
                ```
        }
        help {
            helpText: Where notifications are sent. For an employee it comes from Fusion HCM.
        }
    )
    pageItem P104_PASSWORD (
        type: password
        label {
            label: Password
            alignment: left
        }
        layout {
            sequence: 60
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nvl(:P104_USER_TYPE, 'LOCAL') = 'LOCAL'
                ```
        }
        help {
            helpText: Local users only: the first password, or a new one with Reset Password. The user changes it at the next sign-in.
        }
    )
    pageItem P104_LANGUAGE_CODE (
        type: selectList
        label {
            label: Language
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'LANGUAGE' and enabled_flag = 'Y'
                 order by display_sequence
                ```
        }
        default {
            type: static
            staticValue: en
        }
        layout {
            sequence: 70
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: true
            columnSpan: 4
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: The language of the notifications this user receives; English when a text has no translation.
        }
    )
    pageItem P104_END_DATE (
        type: datePicker
        label {
            label: Active Until
            alignment: left
        }
        layout {
            sequence: 80
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        help {
            helpText: Leave empty for no end. After this date the user cannot sign in and holds no access.
        }
    )
    pageItem P104_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 90
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_USER_ID
        }
        help {
            helpText: Enabled users can sign in. Disable keeps the user and the history; Enable gives the access back.
        }
    )
    pageItem P104_DESCRIPTION (
        type: textarea
        label {
            label: Notes
            alignment: left
        }
        layout {
            sequence: 100
            region: @user
            slot: regionBody
            alignment: left
            startNewRow: true
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        help {
            helpText: Why this user exists or anything an administrator should know.
        }
    )
    button cancel (
        buttonName: CANCEL
        label: Back to Users
        layout {
            sequence: 10
            region: @user
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 103
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )
    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @user
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
        security {
            authorizationScheme: @page-create
        }
        serverSideCondition {
            type: itemIsNull
            item: P104_USER_ID
        }
    )
    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @user
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
        security {
            authorizationScheme: @page-manage
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_USER_ID
        }
    )
    button reset-password (
        buttonName: RESET_PASSWORD
        label: Reset Password
        layout {
            sequence: 15
            region: @user
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
        }
        confirmation {
            message: Set the new password from the Password field? The user changes it at the next sign-in.
        }
        security {
            authorizationScheme: @page-manage
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_USER_ID is not null and :P104_USER_TYPE = 'LOCAL'
                ```
        }
    )
    button disable (
        buttonName: DISABLE
        label: Disable
        layout {
            sequence: 16
            region: @user
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
        }
        confirmation {
            message: Disable this user? The user can no longer sign in; roles and history are kept.
        }
        security {
            authorizationScheme: @page-manage
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_USER_ID is not null and :P104_STATUS = 'Enabled'
                ```
        }
    )
    button enable (
        buttonName: ENABLE
        label: Enable
        layout {
            sequence: 17
            region: @user
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
        security {
            authorizationScheme: @page-manage
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P104_USER_ID is not null and :P104_STATUS = 'Disabled'
                ```
        }
    )

    region access (
        name: Access
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        advanced {
            htmlDomId: access
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_USER_ID
        }
    )

    region tab-roles (
        name: Roles
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @access
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tab_roles
        }
    )
    region tab-privileges (
        name: Privileges
        type: staticContent
        layout {
            sequence: 15
            parentRegion: @access
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tab_privileges
        }
    )
    region tab-data (
        name: Data access
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @access
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tab_data
        }
    )
    region applications (
        name: Applications
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ua.user_application_id, a.application_name || ' (' || ua.application_code || ')' as application,
                       ua.start_date_active, ua.end_date_active,
                       case when ua.enabled_flag = 'Y' and (ua.end_date_active is null or ua.end_date_active >= trunc(sysdate))
                            then 'Active' else 'Ended' end as status,
                       (select count(*) from xxfnd_user_roles_v ur
                         where ur.user_id = ua.user_id and ur.application_code = ua.application_code and ur.active_flag = 'Y') as roles,
                       ua.application_code,
                       case when ua.enabled_flag = 'Y' and (ua.end_date_active is null or ua.end_date_active >= trunc(sysdate))
                             and xxfnd_user_pkg.managed_in_application(ua.application_code) = 'N'
                             and xxfnd_privilege_pkg.can_change(ua.application_code) = 'Y' then 'End' end as end_access
                  -- release 96: the applications the user may use (a role of an application gives access to it); End ends the
                  -- access and the user's roles there
                  from xxfnd_user_applications ua
                  join xxfnd_applications a on a.application_code = ua.application_code
                 where ua.user_id = :P104_USER_ID
                   and (:G_ADMIN_APP = 'ALL' or ua.application_code in (:G_ADMIN_APP, 'COMMON'))
                 order by a.application_name
                ```
            pageItemsToSubmit: [
                P104_USER_ID
            ]
        }
        layout {
            sequence: 5
            parentRegion: @tab-roles
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: user_applications
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                -- release 98 (UI issue 15): the user's applications are managed in COMMON only, not in an application administrator's scope
                :G_ADMIN_APP = 'ALL'
                ```
        }
        messages {
            whenNoDataFound: No application yet: assigning a role of an application gives access to it.
        }

        column USER_APPLICATION_ID (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column APPLICATION (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 10
            }
        )

        column START_DATE_ACTIVE (
            type: plainText
            heading {
                heading: Since
            }
            layout {
                sequence: 20
            }
        )

        column END_DATE_ACTIVE (
            type: plainText
            heading {
                heading: Until
            }
            layout {
                sequence: 30
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
        )

        column ROLES (
            type: plainText
            heading {
                heading: Roles
            }
            layout {
                sequence: 50
            }
        )

        column APPLICATION_CODE (
            type: hidden
            layout {
                sequence: 55
            }
        )

        column END_ACCESS (
            type: link
            heading {
                heading: Action
            }
            layout {
                sequence: 60
            }
            link {
                target: {
                    type: url
                    url: javascript:apex.confirm('End the user\'s access to this application and its roles there?',{request:'END_APP',set:{'P104_REMOVE_ID':'#APPLICATION_CODE#'}});
                }
                linkText: #END_ACCESS#
            }
        )
    )

    region roles (
        name: Roles
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ur.user_role_id,
                       ur.role_name,
                       ur.application_code,
                       ur.start_date_active,
                       (select count(*) from xxfnd_role_privileges rp
                         where rp.role_code in (select t.role_code from xxfnd_user_role_tree_v t
                                                 where t.user_role_id = ur.user_role_id)) as privileges,
                       (select listagg(distinct x.dimension_code || ' = ' || x.value_code, ', ')
                                 within group (order by x.dimension_code)
                          from xxfnd_user_data_access_v x
                         where x.user_role_id = ur.user_role_id and x.access_level = 'VALUES' and x.value_code is not null)
                           as data_values,
                       case when xxfnd_user_pkg.managed_in_application(ur.application_code) = 'Y'
                            then 'Managed in ' || ur.application_code end as managed,
                       apex_page.get_url(p_page => 184, p_items => 'P184_USER_ROLE_ID', p_values => ur.user_role_id,
                                         p_clear_cache => '184') as data_url,
                       'Values' as data_link,
                       case when xxfnd_user_pkg.managed_in_application(ur.application_code) = 'N'
                             and xxfnd_privilege_pkg.can_change(ur.application_code) = 'Y' then 'Remove' end as remove
                  -- release 96: the user's roles (with the roles inside them: privileges); per role its data access
                  -- values (Data Access opens them); a role of an application that keeps its users itself is read-only
                  from xxfnd_user_roles_v ur
                 where ur.user_id = :P104_USER_ID
                   and ur.active_flag = 'Y'
                   and (:G_ADMIN_APP = 'ALL' or ur.application_code in (:G_ADMIN_APP, 'COMMON'))
                 order by ur.application_code, ur.role_name
                ```
            pageItemsToSubmit: [
                P104_USER_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-roles
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: user_roles
        }
        messages {
            whenNoDataFound: No role yet: Assign Roles gives the user access.
        }

        column USER_ROLE_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 20
            }
        )

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 30
            }
        )

        column START_DATE_ACTIVE (
            type: plainText
            heading {
                heading: Since
            }
            layout {
                sequence: 40
            }
        )

        column PRIVILEGES (
            type: plainText
            heading {
                heading: Privileges
            }
            layout {
                sequence: 50
            }
        )

        column DATA_VALUES (
            type: plainText
            heading {
                heading: Data Access Values
            }
            layout {
                sequence: 55
            }
        )

        column MANAGED (
            type: plainText
            heading {
                heading: Managed
            }
            layout {
                sequence: 56
            }
        )

        column DATA_URL (
            type: hidden
            layout {
                sequence: 57
            }
        )

        column DATA_LINK (
            type: link
            heading {
                heading: Data Access
            }
            layout {
                sequence: 58
            }
            link {
                target: {
                    type: url
                    url: #DATA_URL#
                }
                linkText: Values
            }
        )

        column REMOVE (
            type: link
            heading {
                heading: Action
            }
            layout {
                sequence: 60
            }
            link {
                target: {
                    type: url
                    url: javascript:apex.confirm('Remove this role from the user?',{request:'REMOVE_ROLE',set:{'P104_REMOVE_ID':'#USER_ROLE_ID#'}});
                }
                linkText: #REMOVE#
            }
        )
    )
    region privileges (
        name: Privileges
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 98 (UI issue 16): every privilege the user holds, with the assigned role that gives it (and the role
                -- inside it, when it comes from there) and its application; filter on Role or Application
                select distinct f.feature_name, p.action_code, p.privilege_code,
                       ar.role_name,
                       case when t.role_code <> t.assigned_role_code then gr.role_name end as through_role,
                       ar.application_code
                  from xxfnd_user_role_tree_v t
                  join xxfnd_roles ar           on ar.role_code = t.assigned_role_code
                  join xxfnd_roles gr           on gr.role_code = t.role_code
                  join xxfnd_role_privileges rp on rp.role_code = t.role_code
                  join xxfnd_privileges p       on p.privilege_code = rp.privilege_code
                  join xxfnd_features f         on f.feature_code = p.feature_code
                 where t.user_id = :P104_USER_ID
                   and t.active_flag = 'Y'
                   and (:G_ADMIN_APP = 'ALL' or ar.application_code in (:G_ADMIN_APP, 'COMMON'))
                ```
            pageItemsToSubmit: [
                P104_USER_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-privileges
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: user_privileges
        }
        componentAppearance {
            showNullValuesAs: -
        }
