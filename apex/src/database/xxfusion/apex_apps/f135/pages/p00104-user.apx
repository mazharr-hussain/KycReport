    region effective (
        name: Effective Data Access
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.object_name, x.application_code,
                       case x.access_level when 'ALL' then 'All records' when 'VALUES' then 'Given values' else 'Own records' end as access_level,
                       x.dimension_code,
                       listagg(distinct x.value_code, ', ') within group (order by x.value_code) as value_list,
                       max(x.value_scope) as value_scope,
                       listagg(distinct r.role_name, ', ') within group (order by r.role_name) as granted_through
                  -- release 96: which records the user sees per data object (XXFND_USER_DATA_ACCESS_V), through which roles;
                  -- for given values: the object's own values (override) or the default of the dimension
                  from xxfnd_user_data_access_v x
                  join xxfnd_roles r on r.role_code = x.assigned_role_code
                 where x.user_id = :P104_USER_ID
                   and (:G_ADMIN_APP = 'ALL' or x.application_code in (:G_ADMIN_APP, 'COMMON'))
                 group by x.object_name, x.application_code, x.access_level, x.dimension_code
                 order by x.object_name, x.access_level
                ```
            pageItemsToSubmit: [
                P104_USER_ID
            ]
        }
        layout {
            sequence: 20
            parentRegion: @tab-data
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: user_effective
        }
        messages {
            whenNoDataFound: No data access: the user sees no records of the secured tables.
        }

        column OBJECT_NAME (
            type: plainText
            heading {
                heading: Data Object
            }
            layout {
                sequence: 10
            }
        )

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 15
            }
        )

        column ACCESS_LEVEL (
            type: plainText
            heading {
                heading: Records
            }
            layout {
                sequence: 20
            }
        )

        column DIMENSION_CODE (
            type: plainText
            heading {
                heading: Dimension
            }
            layout {
                sequence: 30
            }
        )

        column VALUE_LIST (
            type: plainText
            heading {
                heading: Values
            }
            layout {
                sequence: 40
            }
        )

        column VALUE_SCOPE (
            type: plainText
            heading {
                heading: Values From
            }
            layout {
                sequence: 45
            }
        )

        column GRANTED_THROUGH (
            type: plainText
            heading {
                heading: Through Roles
            }
            layout {
                sequence: 50
            }
        )
    )
    button assign-roles (
        buttonName: ASSIGN_ROLES
        label: Assign Roles
        layout {
            sequence: 10
            region: @roles
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 183
                items: {
                    P183_TARGET: USER
                    P183_TARGET_ID: &P104_USER_ID.
                    P183_PICK: ROLE
                }
                clearCache: 183
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )
    dynamicAction refresh-after-assign (
        name: Refresh after the Assign dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @access
        }

        action refresh-after-assign-refresh-1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @roles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-after-assign-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @privileges
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-after-assign-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @effective
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )
    process load (
        name: Load the user
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 79: the user on top (XXFND_USERS with the linked employee)
                select u.user_type, u.user_name, coalesce(e.full_name, u.full_name), coalesce(e.email_address, u.email_address),
                       u.language_code, u.end_date_active, u.description,
                       case u.enabled_flag when 'Y' then 'Enabled' else 'Disabled' end,
                       case when e.employee_id is not null
                            then e.full_name || nvl2(e.department_name, ', ' || e.department_name, null)
                                 || nvl2(e.job_title, ', ' || e.job_title, null) end
                  into :P104_USER_TYPE, :P104_USER_NAME, :P104_FULL_NAME, :P104_EMAIL,
                       :P104_LANGUAGE_CODE, :P104_END_DATE, :P104_DESCRIPTION, :P104_STATUS, :P104_EMPLOYEE
                  from xxfnd_users u
                  left join xxfnd_employees e on e.employee_id = u.employee_id
                 where u.user_id = :P104_USER_ID;
                -- release 96 (UI issue 12): the title and breadcrumb name the user
                :P104_TITLE := :P104_FULL_NAME || ' (' || :P104_USER_NAME || ')';
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_USER_ID
        }
    )
    process create-user (
        name: Create the user
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 79: XXFND_USER_PKG creates the user (local: with its APEX account; employee: linked to the employee)
                begin
                    if :P104_USER_TYPE = 'SSO' then
                        if :P104_EMPLOYEE_ID is null then
                            raise_application_error(-20075, 'Choose the employee.');
                        end if;
                        :P104_USER_ID := xxfnd_user_pkg.employee_user(to_number(:P104_EMPLOYEE_ID));
                    else
                        :P104_USER_ID := xxfnd_user_pkg.create_local_user(:P104_USER_NAME, :P104_FULL_NAME, :P104_EMAIL, :P104_PASSWORD);
                    end if;
                    xxfnd_user_pkg.save_user(to_number(:P104_USER_ID), :P104_FULL_NAME, :P104_EMAIL, :P104_LANGUAGE_CODE,
                                             :P104_END_DATE, :P104_DESCRIPTION);
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: User created. Assign roles and data access in the tabs.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
        security {
            authorizationScheme: @page-submit
        }
    )
    process save-user (
        name: Save the user
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_user_pkg.save_user(to_number(:P104_USER_ID), :P104_FULL_NAME, :P104_EMAIL, :P104_LANGUAGE_CODE,
                                         :P104_END_DATE, :P104_DESCRIPTION);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )
    process reset-password (
        name: Reset the password
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                if :P104_PASSWORD is null then
                    raise_application_error(-20076, 'Enter the new password in the Password field.');
                end if;
                xxfnd_user_pkg.reset_password(to_number(:P104_USER_ID), :P104_PASSWORD);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Password reset. The user changes it at the next sign-in.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: RESET_PASSWORD
        }
        security {
            authorizationScheme: @page-submit
        }
    )
    process set-enabled (
        name: Enable or disable
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_user_pkg.set_enabled(to_number(:P104_USER_ID), case :REQUEST when 'ENABLE' then 'Y' else 'N' end);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ENABLE,DISABLE
        }
        security {
            authorizationScheme: @page-submit
        }
    )
    process remove-role (
        name: Remove a role
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_user_pkg.unassign_role(to_number(:P104_REMOVE_ID));
                ```
        }
        execution {
            sequence: 50
            point: processing
        }
        successMessage {
            successMessage: Role removed.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REMOVE_ROLE
        }
        security {
            authorizationScheme: @page-submit
        }
    )
    process end-application (
        name: End the access to an application
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 96: ends the access and the user's roles of that application (XXFND_USER_PKG)
                xxfnd_user_pkg.end_application(to_number(:P104_USER_ID), :P104_REMOVE_ID);
                ```
        }
        execution {
            sequence: 60
            point: processing
        }
        successMessage {
            successMessage: Access ended.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: END_APP
        }
        security {
            authorizationScheme: @page-submit
        }
    )
    branch (
        name: Back to the user
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 104
                items: {
                    P104_USER_ID: &P104_USER_ID.
                }
                clearCache: 104
            }
        }
    )

)
