page 136 (
    name: Document Storage
    alias: DOCUMENT-STORAGE
    title: Document Storage
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Where files are stored. The most specific rule wins: entity and category, then entity, then category, then the default.
            ```
    }

    region breadcrumb (
        name: Document Storage
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Document Storage
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 137, p_items => 'P137_STORAGE_CONFIG_ID', p_values => to_char(q.storage_config_id), p_clear_cache => '137') as open_url
                  from (

                            select s.storage_config_id,
                                   nvl(s.entity_name, 'Any') as entity_name,
                                   nvl(s.category_code, 'Any') as category_code,
                                   xxfnd_util_pkg.lookup_meaning('STORAGE_TYPE', s.storage_type) as storage_type,
                                   s.endpoint_code, s.folder_path_template, s.priority, s.enabled_flag
                              from xxfnd_storage_config s
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column STORAGE_CONFIG_ID (
            type: hidden
            heading {
                heading: Storage Config Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column ENTITY_NAME (
            type: plainText
            heading {
                heading: Entity
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#ENTITY_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column CATEGORY_CODE (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column STORAGE_TYPE (
            type: plainText
            heading {
                heading: Store
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ENDPOINT_CODE (
            type: plainText
            heading {
                heading: Endpoint
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column FOLDER_PATH_TEMPLATE (
            type: plainText
            heading {
                heading: Folder
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column PRIORITY (
            type: plainText
            heading {
                heading: Priority
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Storage Rule
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 137
                clearCache: 137
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
