page 99 (
    name: Open Setup
    alias: OPEN-SETUP
    title: Open Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @app-user
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    help {
        helpText: Entry point for another application: opens a COMMON setup page for that application (G_ADMIN_APP, G_ADMIN_LOCK, P99_PAGE).
    }

    pageItem P99_PAGE (
        type: hidden
        layout {
            sequence: 10
            slot: BODY
        }
    )

    process open (
        name: Open the setup page
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 68: a setup page of the Administration page group, for an application the user administers
                -- (SET_ADMIN_APP has already kept G_ADMIN_APP to one); anything else opens Administration
                declare
                    l_page number;
                begin
                    select max(page_id) into l_page
                      from apex_application_pages
                     where application_id = :APP_ID
                       and page_id = to_number(:P99_PAGE default null on conversion error)
                       and page_group = 'Administration';
                    apex_util.redirect_url(apex_page.get_url(p_page => nvl(l_page, 100)));
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
)
