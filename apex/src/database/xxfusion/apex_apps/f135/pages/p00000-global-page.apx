page 0 (
    name: Global Page

    region feature-tabs (
        name: Feature Tabs
        type: list
        source {
            list: @feature-tabs
        }
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/tabs
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: feature-tabs
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Only on a tab page of a feature that has more than one tab.
                select 1
                  from xxfnd_feature_pages c
                 where c.app_alias = :APP_ALIAS
                   and c.page_id   = :APP_PAGE_ID
                   and c.tab_label is not null
                   and (select count(*) from xxfnd_feature_pages t
                         where t.app_alias = c.app_alias and t.feature_code = c.feature_code
                           and t.tab_label is not null) > 1
                ```
        }
    )

    region admin-scope (
        name: Application
        type: staticContent
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: admin-scope
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- release 61: setup screens (Administration page group), unless another application opened COMMON for itself
                select 1
                  from apex_application_pages
                 where application_id = :APP_ID
                   and page_id = :APP_PAGE_ID
                   and page_group in ('Administration', 'Application Features')   -- release 71: also feature configuration / settings
                   and nvl(:G_ADMIN_LOCK, 'N') <> 'Y'
                ```
        }
    )

    pageItem P0_ADMIN_APP (
        type: selectList
        label {
            label: Application
            alignment: left
        }
        layout {
            sequence: 10
            region: @admin-scope
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: item
            item: G_ADMIN_APP
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from (select 'All applications' as display_value, 'ALL' as return_value, 0 as seq, null as sort_name from dual
                        union all
                        select application_name || ' (' || application_code || ')', application_code,
                               decode(application_code, 'COMMON', 2, 1), application_name
                          from xxfnd_admin_applications_v)
                 order by seq, sort_name
                ```
            displayNullValue: false
        }
        help {
            helpText: All applications, or one application: then only its rows and the shared rows are shown, and new rows belong to it.
        }
    )

    dynamicAction change-admin-app (
        name: Change application
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P0_ADMIN_APP
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :G_ADMIN_APP := xxfnd_admin_scope_pkg.default_application(:P0_ADMIN_APP);
                    ```
                itemsToSubmit: P0_ADMIN_APP
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.navigation.redirect(window.location.href);
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )
    )
)
