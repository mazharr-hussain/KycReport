page 123 (
    name: Integration Purpose
    alias: INTEGRATION-PURPOSE
    title: Integration Purpose
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Maker-checker controlled: saving an approved purpose sends it back for approval.
            ```
    }

    region form (
        name: Integration Purpose
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_INTEGRATION_PURPOSES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P123_PURPOSE_CODE (
        type: textField
        label {
            label: Purpose Code
            alignment: left
        }
        layout {
            sequence: 1
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @form
            column: PURPOSE_CODE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P123_SAVED = 'Y'
                ```
        }
        help {
            inlineHelpText: Upper case, no spaces. Cannot be changed once saved.
        }
    )

    pageItem P123_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P123_SAVED
                  from XXFND_INTEGRATION_PURPOSES
                 where PURPOSE_CODE = :P123_PURPOSE_CODE;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P123_PURPOSE_NAME (
        type: textField
        label {
            label: Purpose
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @form
            column: PURPOSE_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the purpose.
        }
    )

    pageItem P123_APPLICATION_CODE (
        type: selectList
        label {
            label: Application
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-applications
            displayNullValue: true
            nullDisplayValue: Shared (every application)
        }
        layout {
            sequence: 15
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nullif(:G_ADMIN_APP, 'ALL')
                ```
        }
        help {
            inlineHelpText: Empty: shared by every application.
        }
    )

    pageItem P123_CAPTURE_METHOD (
        type: selectList
        label {
            label: Capture Method
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-capture-method
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: CAPTURE_METHOD
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MANUAL
        }
        help {
            helpText: Choose the capture Method.
        }
    )

    pageItem P123_ENDPOINT_CODE (
        type: selectList
        label {
            label: Endpoint
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-endpoints
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENDPOINT_CODE
            dataType: varchar2
        }
        help {
            helpText: Required for automatic capture.
        }
    )

    pageItem P123_APPROVAL_STATUS (
        type: selectList
        label {
            label: Approval Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-approval-status
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: APPROVAL_STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        readOnly {
            type: always
        }
        help {
            helpText: Choose the approval Status.
        }
    )

    pageItem P123_CHANGE_REASON (
        type: textField
        label {
            label: Reason for Change
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Recorded in the audit log with this change.
        }
    )

    process set-change-reason (
        name: Set change reason
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_audit_pkg.set_change_reason(:P123_CHANGE_REASON);
                ```
        }
        execution {
            sequence: 1
            point: processing
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P123_SAVED
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P123_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P123_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    button submit-approval (
        buttonName: SUBMIT_APPROVAL
        label: Submit for Approval
        layout {
            sequence: 35
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P123_APPROVAL_STATUS in ('DRAFT','REJECTED')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    process submit-for-approval (
        name: Submit for approval
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_config_approval_pkg.request('XXFND_INTEGRATION_PURPOSES', :P123_PURPOSE_CODE);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Submitted for approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit-approval
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog-submitted (
        name: Close Dialog after submit
        type: closeDialog
        execution {
            sequence: 95
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SUBMIT_APPROVAL
        }
    )

)
