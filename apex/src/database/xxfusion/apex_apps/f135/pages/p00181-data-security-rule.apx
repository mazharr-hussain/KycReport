page 181 (
    name: Data Access Rule
    alias: DATA-SECURITY-RULE
    title: Data Access Rule
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            All rows: the role sees every row. Own records: only rows whose column holds the user name.
            Column in list: only rows whose column holds one of the values (comma-separated, e.g. AE,SA).
            ```
    }

    region form (
        name: Data Security Rule
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_DATA_SECURITY_RULES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P181_RULE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: RULE_ID
            dataType: number
            primaryKey: true
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P181_TABLE_NAME (
        type: selectList
        label {
            label: Table
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.table_name || ' (' || a.application_code || ')' as display_value, t.table_name as return_value
                  -- release 79: a rule is no longer tied to one role: the tables of every registered application
                  -- (its schema, granted to COMMON's schema)
                  from all_tables t
                  join xxfnd_applications a on a.schema_name = t.owner
                 where a.application_code <> 'COMMON'
                   and t.table_name not like 'XXFND\_%' escape '\'
                 order by t.table_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: TABLE_NAME
            dataType: varchar2
        }
        help {
            helpText: The business table whose rows this rule filters.
        }
    )

    pageItem P181_RULE_TYPE (
        type: selectList
        label {
            label: Rule
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from (select 'All rows' as display_value, 'ALL_ROWS' as return_value, 1 as seq from dual union all
                        select 'Own records', 'OWN_RECORDS', 2 from dual union all
                        select 'Column in list', 'COLUMN_IN_LIST', 3 from dual)
                 order by seq
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: RULE_TYPE
            dataType: varchar2
        }
        help {
            helpText: All rows, own records (column holds the user name) or column in list.
        }
    )

    pageItem P181_COLUMN_NAME (
        type: selectList
        label {
            label: Column
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select column_name as display_value, column_name as return_value
                  from all_tab_columns
                 where owner in (select a.schema_name from xxfnd_applications a where a.application_code <> 'COMMON')
                   and table_name = :P181_TABLE_NAME
                   and data_type in ('VARCHAR2','CHAR','NUMBER')
                 order by column_id
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P181_TABLE_NAME
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: COLUMN_NAME
            dataType: varchar2
        }
        help {
            helpText: Required for Own records and Column in list.
        }
    )

    pageItem P181_VALUE_LIST (
        type: textField
        label {
            label: Values
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @form
            column: VALUE_LIST
            dataType: varchar2
        }
        help {
            inlineHelpText: Column in list only, comma-separated, e.g. AE,SA
        }
    )

    pageItem P181_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Why this role has this access.
        }
    )

    pageItem P181_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Disabled rules are ignored.
        }
    )

    validation rule-columns (
        name: Column and values match the rule
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P181_RULE_TYPE = 'ALL_ROWS' and (:P181_COLUMN_NAME is not null or :P181_VALUE_LIST is not null) then
                    return 'All rows takes no column and no values.';
                elsif :P181_RULE_TYPE in ('OWN_RECORDS','COLUMN_IN_LIST') and :P181_COLUMN_NAME is null then
                    return 'Choose the column.';
                elsif :P181_RULE_TYPE = 'OWN_RECORDS' and :P181_VALUE_LIST is not null then
                    return 'Own records takes no values.';
                elsif :P181_RULE_TYPE = 'COLUMN_IN_LIST' and :P181_VALUE_LIST is null then
                    return 'Enter the values.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P181_RULE_TYPE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation rule-unique (
        name: Rule not defined yet
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from xxfnd_data_security_rules
                 where table_name = :P181_TABLE_NAME
                   and rule_type = :P181_RULE_TYPE and nvl(column_name, '#') = nvl(:P181_COLUMN_NAME, '#')
                   and nvl(value_list, '#') = nvl(:P181_VALUE_LIST, '#') and role_code is null
                   and rule_id <> nvl(to_number(:P181_RULE_ID), -1)
                ```
        }
        error {
            errorMessage: This rule exists already: open it and assign it to more users or roles.
            associatedItem: @P181_RULE_TYPE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P181_RULE_ID
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P181_RULE_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P181_RULE_ID
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process apply-policies (
        name: Apply data security policies
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- A table gets its policy the first time a rule refers to it.
                xxfnd_vpd_pkg.apply_policies;
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    branch (
        name: After create: stay on the record for its tabs
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 181
                items: {
                    P181_RULE_ID: &P181_RULE_ID.
                }
                clearCache: 181
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )


    pageItem P181_REMOVE_ID (
        type: hidden
        layout {
            sequence: 3
            region: @form
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    region access (
        name: Assigned To
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        advanced {
            htmlDomId: access
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P181_RULE_ID
        }
    )

    region tab-users (
        name: Users
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @access
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tab_users
        }
    )
    region tab-roles (
        name: Roles
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @access
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tab_roles
        }
    )
    region users (
        name: Users
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 79: users the rule is assigned to directly
                select a.assignment_id, coalesce(u.full_name, u.user_name) as full_name, u.user_name, 'Remove' as remove
                  from xxfnd_data_rule_assignments a
                  join xxfnd_users u on u.user_id = a.user_id
                 where a.rule_id = :P181_RULE_ID
                 order by 2
                ```
            pageItemsToSubmit: [
                P181_RULE_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-users
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: rule_users
        }
        messages {
            whenNoDataFound: Not assigned to a user directly.
        }

        column ASSIGNMENT_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column FULL_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
        )

        column USER_NAME (
            type: plainText
            heading {
                heading: User Name
            }
            layout {
                sequence: 30
            }
        )

        column REMOVE (
            type: link
            heading {
                heading: Action
            }
            layout {
                sequence: 40
            }
            link {
                target: {
                    type: url
                    url: javascript:apex.confirm('Remove this user from the rule?',{request:'REMOVE_ASSIGNMENT',set:{'P181_REMOVE_ID':'#ASSIGNMENT_ID#'}});
                }
                linkText: Remove
            }
        )
    )
    region roles (
        name: Roles
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 79: roles the rule is assigned to (every holder of the role gets the rule)
                select a.assignment_id, r.role_name, r.application_code, 'Remove' as remove
                  from xxfnd_data_rule_assignments a
                  join xxfnd_roles r on r.role_code = a.role_code
                 where a.rule_id = :P181_RULE_ID
                 order by r.role_name
                ```
            pageItemsToSubmit: [
                P181_RULE_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-roles
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: rule_roles
        }
        messages {
            whenNoDataFound: Not assigned to a role.
        }

        column ASSIGNMENT_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 20
            }
        )

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 30
            }
        )

        column REMOVE (
            type: link
            heading {
                heading: Action
            }
            layout {
                sequence: 40
            }
            link {
                target: {
                    type: url
                    url: javascript:apex.confirm('Remove this role from the rule?',{request:'REMOVE_ASSIGNMENT',set:{'P181_REMOVE_ID':'#ASSIGNMENT_ID#'}});
                }
                linkText: Remove
            }
        )
    )
    button assign-users (
        buttonName: ASSIGN_USERS
        label: Assign Users
        layout {
            sequence: 50
            region: @users
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 183
                items: {
                    P183_TARGET: RULE
                    P183_TARGET_ID: &P181_RULE_ID.
                    P183_PICK: USER
                }
                clearCache: 183
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )
    button assign-roles (
        buttonName: ASSIGN_ROLES
        label: Assign Roles
        layout {
            sequence: 60
            region: @roles
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 183
                items: {
                    P183_TARGET: RULE
                    P183_TARGET_ID: &P181_RULE_ID.
                    P183_PICK: ROLE
                }
                clearCache: 183
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )
    dynamicAction refresh-after-assign (
        name: Refresh after the Assign dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @access
        }

        action refresh-after-assign-refresh-1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-after-assign-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @roles
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )
    process remove-assignment (
        name: Remove an assignment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_vpd_pkg.unassign_rule(to_number(:P181_REMOVE_ID));
                ```
        }
        execution {
            sequence: 70
            point: processing
        }
        successMessage {
            successMessage: Removed.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REMOVE_ASSIGNMENT
        }
        security {
            authorizationScheme: @page-submit
        }
    )
)
