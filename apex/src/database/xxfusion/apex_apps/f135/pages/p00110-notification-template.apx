page 110 (
    name: Notification Template
    alias: NOTIFICATION-TEMPLATE
    title: Notification Template
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The wording of a system e-mail: a subject and a plain-text message, in English and in Arabic. The wording is
            plain text; links, formatting and the reading direction (right to left for Arabic) come from the layout
            template XXFND_STANDARD, shared with every application. Tokens (#TOKEN#) are replaced when the e-mail is
            sent. Preview shows the wording as it is sent; Send Test to Me e-mails it to you.
            ```
    }

    region form (
        name: Notification Template
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_NOTIFICATION_TEMPLATES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P110_TEMPLATE_CODE (
        type: textField
        label {
            label: Template Code
            alignment: left
        }
        layout {
            sequence: 1
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            formRegion: @form
            column: TEMPLATE_CODE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P110_SAVED = 'Y'
                ```
        }
        help {
            inlineHelpText: Upper case, no spaces. Cannot be changed once saved.
        }
    )

    pageItem P110_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P110_SAVED
                  from XXFND_NOTIFICATION_TEMPLATES
                 where TEMPLATE_CODE = :P110_TEMPLATE_CODE;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P110_APPLICATION_CODE (
        type: selectList
        label {
            label: Application
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-applications
            displayNullValue: true
            nullDisplayValue: Workspace (all applications)
        }
        layout {
            sequence: 15
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :G_ADMIN_LOCK = 'Y'   -- release 73: delegated - the application that opened the screen
                ```
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nullif(:G_ADMIN_APP, 'ALL')
                ```
        }
        help {
            inlineHelpText: The setup type decides which applications, and whether the workspace (all applications), may be chosen.
        }
    )

    pageItem P110_SUBJECT (
        type: textField
        label {
            label: Subject
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
        source {
            formRegion: @form
            column: SUBJECT
            dataType: varchar2
        }
        help {
            helpText: Enter the subject.
        }
    )

    pageItem P110_MESSAGE_TEXT (
        type: textarea
        label {
            label: Message
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        settings {
            resizable: true
            autoHeight: true
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: MESSAGE_TEXT
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
        help {
            helpText: The message in English, as plain text (no HTML). Use #TOKEN# placeholders such as #TASK_SUBJECT#, #DUE_DATE# or #RFI_NUMBER#. The link button, the formatting and the reading direction come from the layout template XXFND_STANDARD.
        }
    )

    pageItem P110_ENABLED_FLAG (
        type: switch
        label {
            label: Enabled
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: ENABLED_FLAG
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Choose the enabled.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P110_SAVED
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    region translation (
        name: Arabic Translation
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.template_code, t.language_code, t.subject, t.message_text
                  from xxfnd_notification_templates_tl t
                 where t.template_code = :P110_TEMPLATE_CODE
                   and t.language_code = 'ar'
                ```
            pageItemsToSubmit: P110_TEMPLATE_CODE
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: translation
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: false
        }
        messages {
            whenNoDataFound: No Arabic wording yet: the English wording is sent.
        }
        toolbar {
            controls: [
                actionsMenu
                resetButton
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_SAVED
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @SUBJECT
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @MESSAGE_TEXT
                layout {
                    sequence: 2
                }
            )
        )

        column TEMPLATE_CODE (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: TEMPLATE_CODE
                dataType: varchar2
                primaryKey: true
            }
            default {
                type: item
                item: P110_TEMPLATE_CODE
            }
        )

        column LANGUAGE_CODE (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: LANGUAGE_CODE
                dataType: varchar2
                primaryKey: true
            }
            default {
                type: static
                staticValue: ar
            }
        )

        column SUBJECT (
            type: textField
            heading {
                heading: Subject - Arabic
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
                maxLength: 500
            }
            source {
                type: databaseColumn
                databaseColumn: SUBJECT
                dataType: varchar2
            }
        )

        column MESSAGE_TEXT (
            type: textarea
            heading {
                heading: Message - Arabic
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: MESSAGE_TEXT
                dataType: clob
            }
        )
    )

    region preview (
        name: Preview
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 82: the wording as it is sent (XXFND_NOTIFY_PKG), in the chosen language
                select xxfnd_notify_pkg.preview_subject(:P110_TEMPLATE_CODE, :P110_PREVIEW_LANGUAGE) as subject,
                       dbms_lob.substr(xxfnd_notify_pkg.preview_message(:P110_TEMPLATE_CODE, :P110_PREVIEW_LANGUAGE), 4000, 1) as message
                  from dual
                ```
            pageItemsToSubmit: [
                P110_TEMPLATE_CODE
                P110_PREVIEW_LANGUAGE
            ]
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: preview
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: No wording.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_SAVED
        }

        column SUBJECT (
            type: plainText
            heading {
                heading: Subject
            }
            layout {
                sequence: 10
            }
        )

        column MESSAGE (
            type: plainText
            heading {
                heading: Message
            }
            layout {
                sequence: 20
            }
        )
    )

    pageItem P110_PREVIEW_LANGUAGE (
        type: selectList
        label {
            label: Language
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:English;en,Arabic;ar
        }
        layout {
            sequence: 10
            region: @preview
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: en
        }
        help {
            helpText: The language to preview and to send the test in.
        }
    )

    button send-test (
        buttonName: SEND_TEST
        label: Send Test to Me
        layout {
            sequence: 10
            region: @preview
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
        security {
            authorizationScheme: @page-view
        }
    )

    dynamicAction refresh-preview (
        name: Refresh the preview
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: [
                P110_PREVIEW_LANGUAGE
            ]
        }

        action refresh-preview-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preview
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process send-test (
        name: Send a test to me
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 82: the wording in the chosen language, to the current user's e-mail address
                xxfnd_notify_pkg.send_test(:P110_TEMPLATE_CODE, :P110_PREVIEW_LANGUAGE);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: The test e-mail was sent to you.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SEND_TEST
        }
        security {
            authorizationScheme: @page-view
        }
    )

    process save-translation (
        name: Save the Arabic wording
        type: interactiveGridAutoRowProcessing
        editableRegion: @translation
        execution {
            sequence: 20
            point: processing
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
