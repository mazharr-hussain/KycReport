page 109 (
    name: Notification Templates
    alias: NOTIFICATION-TEMPLATES
    title: Notification Templates
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The wording of every system e-mail: a subject and a plain-text message per event, in English and Arabic.
            Wording is plain text; links, formatting and the reading direction come from the layout template
            XXFND_STANDARD (below: the applications that use it). Open a notification to change its wording, preview it
            and send a test to yourself.
            ```
    }

    region breadcrumb (
        name: Notification Templates
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Notification Templates
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 110, p_items => 'P110_TEMPLATE_CODE', p_values => to_char(q.template_code), p_clear_cache => '110') as open_url
                  from (

                            select t.template_code, t.application_code, t.subject, t.enabled_flag, t.last_update_date
                              from xxfnd_notification_templates t
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column TEMPLATE_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#TEMPLATE_CODE#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column SUBJECT (
            type: plainText
            heading {
                heading: Subject
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column ENABLED_FLAG (
            type: plainText
            heading {
                heading: Enabled
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column LAST_UPDATE_DATE (
            type: plainText
            heading {
                heading: Updated
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Template
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 110
                clearCache: 110
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )


    region layout (
        name: Layout Template XXFND_STANDARD - Applications Using It
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 82: the e-mail layout is the APEX Email Template XXFND_STANDARD of COMMON; applications subscribe to it
                select t.application_name,
                       case when t.application_id = :APP_ID then 'Master (COMMON)'
                            when t.is_subscribed = 'Yes' then 'Subscribed'
                            else 'Own copy' end                    as subscription,
                       case when t.subscription_needs_refresh = 'Yes' then 'Refresh needed' else 'Up to date' end as refresh_state,
                       t.last_updated_on
                  from apex_appl_email_templates t
                 where t.static_id = 'XXFND_STANDARD'
                 order by case when t.application_id = :APP_ID then 0 else 1 end, t.application_name
                ```
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: layout
        }
        messages {
            whenNoDataFound: No application uses the layout yet.
        }

        column APPLICATION_NAME (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 10
            }
        )

        column SUBSCRIPTION (
            type: plainText
            heading {
                heading: Subscription
            }
            layout {
                sequence: 20
            }
        )

        column REFRESH_STATE (
            type: plainText
            heading {
                heading: State
            }
            layout {
                sequence: 30
            }
        )

        column LAST_UPDATED_ON (
            type: plainText
            heading {
                heading: Last Updated
            }
            layout {
                sequence: 40
            }
        )
    )
)
