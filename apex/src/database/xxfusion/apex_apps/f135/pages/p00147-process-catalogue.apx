            }
            layout {
                sequence: 50
            }
            source {
                type: databaseColumn
                databaseColumn: EMAIL_ENABLED_FLAG
                dataType: varchar2
            }
        )
    )

    region report (
        name: Workflows and Task Definitions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 73: the workflows and task definitions of every registered application
                select a.application_code,
                       'Workflow' as component_type,
                       w.name,
                       w.static_id,
                       w.title as description,
                       cast(null as varchar2(30)) as task_type,
                       w.last_updated_on
                  from apex_appl_workflows w
                  join xxfnd_applications a on a.apex_application_id = w.application_id
                 where :G_ADMIN_APP = 'ALL' or a.application_code = :G_ADMIN_APP
                union all
                select a.application_code,
                       'Task Definition',
                       t.name,
                       t.static_id,
                       t.subject,
                       t.task_type,
                       t.last_updated_on
                  from apex_appl_taskdefs t
                  join xxfnd_applications a on a.apex_application_id = t.application_id
                 where :G_ADMIN_APP = 'ALL' or a.application_code = :G_ADMIN_APP
                ```
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
        )

        column COMPONENT_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column STATIC_ID (
            type: plainText
            heading {
                heading: Static ID
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Title / Subject
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column TASK_TYPE (
            type: plainText
            heading {
                heading: Task Type
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column LAST_UPDATED_ON (
            type: plainText
