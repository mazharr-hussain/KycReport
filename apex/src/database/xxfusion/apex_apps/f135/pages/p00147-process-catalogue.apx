    region processes (
        name: Workflow Processes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 73: per application and workflow process: approval workflow (off = auto-approved) and e-mail
                select p.application_code, p.process_code, p.process_name, p.participants_type, p.workflow_enabled_flag, p.email_enabled_flag
                  from xxfnd_workflow_processes p
                 where :G_ADMIN_APP = 'ALL' or p.application_code = :G_ADMIN_APP
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: processes
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No workflow process found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @APPLICATION_CODE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @PROCESS_NAME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @PARTICIPANTS_TYPE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @WORKFLOW_ENABLED_FLAG
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @EMAIL_ENABLED_FLAG
                layout {
                    sequence: 5
                }
            )
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column APPLICATION_CODE (
            type: displayOnly
            heading {
                heading: Application
            }
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: APPLICATION_CODE
                dataType: varchar2
                primaryKey: true
            }
        )

        column PROCESS_CODE (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: PROCESS_CODE
                dataType: varchar2
                primaryKey: true
            }
        )

        column PROCESS_NAME (
            type: displayOnly
            heading {
                heading: Process
            }
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: PROCESS_NAME
                dataType: varchar2
            }
        )

        column PARTICIPANTS_TYPE (
            type: selectList
            heading {
                heading: Participants
            }
            layout {
                sequence: 35
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Approval Setup rules;RULE,Chosen by the user;CHOSEN
            }
            source {
                type: databaseColumn
                databaseColumn: PARTICIPANTS_TYPE
