            source {
                dataType: STRING
            }
        )

        column STEP_NAME (
            type: plainText
            heading {
                heading: Step Name
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column APPROVER (
            type: plainText
            heading {
                heading: Approver
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column DEADLINE (
            type: plainText
            heading {
                heading: Deadline
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column DELEGATED_TO (
            type: plainText
            heading {
                heading: Delegated To
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column STATE (
            type: plainText
            heading {
                heading: State
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        column RULE_URL (
