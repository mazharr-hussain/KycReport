page 147 (
    name: Process Catalogue
    alias: PROCESS-CATALOGUE
    title: Process Catalogue
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The workflow processes of every application: approval workflow on or off (off: records are auto-approved) and e-mail on or off; e-mail for the workspace (all applications). Their shape is maintained by developers (App Builder) and deployed as a release.
            ```
    }

    region breadcrumb (
        name: Process Catalogue
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region email (
        name: E-mail for All Applications
        type: staticContent
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: email
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nvl(:G_ADMIN_LOCK, 'N') <> 'Y'   -- the instance switch: IT only
                ```
        }
    )

    pageItem P147_INSTANCE_EMAIL (
        type: switch
        label {
            label: E-mail (workspace)
            alignment: left
        }
        layout {
            sequence: 10
            region: @email
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(max(email_enabled_flag), 'Y') from xxfnd_applications where application_code = 'COMMON'
                ```
            used: always
        }
        help {
            helpText: Off - no e-mail is sent by any application. On - e-mail follows each application's and process's switch.
        }
    )

    button save-email (
        buttonName: SAVE_EMAIL
        label: Save
        layout {
            sequence: 10
            region: @email
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    region approval-paths (
        name: Approval Path per Process
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.application_code, t.approval_type_name as process, r.rule_name, r.priority,
                       s.step_no, s.step_name,
                       xxfnd_approval_rule_pkg.approver_label(s.approver_type, s.role_code, s.user_name) as approver,
                       nvl2(s.due_days, s.due_days || ' days', 'Process deadline') as deadline,
                       (select listagg(d.delegate_user_name || ' until ' || to_char(d.end_date, 'DD-Mon-YYYY'), ', ')
                                 within group (order by d.end_date)
                          from xxfnd_wf_delegations d
                         where s.approver_type = 'USER' and d.delegator_user_name = upper(s.user_name)
                           and trunc(sysdate) between d.start_date and d.end_date) as delegated_to,
                       case when r.enabled_flag = 'Y' and t.enabled_flag = 'Y' then 'Active' else 'Off' end as state,
                       apex_page.get_url(p_page => 149, p_items => 'P149_RULE_ID', p_values => r.rule_id) as rule_url
                  -- release 94 (UI issue 8): each process with its rules (by priority), their steps in order, the
                  -- approver of each step, its deadline and the approver's active delegation (vacation rule) - the
                  -- engine follows this order: rule, approver, delegation, deadline
                  from xxfnd_approval_types t
                  join xxfnd_approval_rules r on r.approval_type_code = t.approval_type_code
                  left join xxfnd_approval_rule_steps s on s.rule_id = r.rule_id
                 where :G_ADMIN_APP = 'ALL' or t.application_code in (:G_ADMIN_APP, 'COMMON')
                 order by t.application_code, t.approval_type_name, r.priority, s.step_no
                ```
        }
        layout {
            sequence: 18
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: approval_paths
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No approval rules yet.
        }
        searchBar {
            includeSearchBar: true
        }
        comments {
            comments: Release 94 (UI issue 8). Approvers are users today; position, manager, hierarchies, area of responsibility and query approvers are listed in Approval Setup as not available yet (HCM data). Rules are changed in Approval Setup, deadlines in Deadlines and Escalation, delegations in Delegations.
        }

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column PROCESS (
            type: plainText
            heading {
                heading: Process
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column RULE_NAME (
            type: plainText
