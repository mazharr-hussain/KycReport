page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Your open and overdue tasks from every application and your unread notifications (each tile opens the list), and the COMMON modules you may open, each with its state. A module card opens the module and its components.
            Registered applications are under Platform, Applications.
            ```
    }

    region breadcrumb (
        name: Home
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region my-tasks (
        name: My Work
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.seq, k.card_title, k.cnt, k.card_link, k.card_icon,
                       case when k.cnt > 0 and k.seq = 20 then 'u-danger-text' end as metric_class
                  -- release 91 (UI issue 1): KPI tiles (Universal Theme Metric Card) of the user's work of every application;
                  -- each tile opens the list (release 82 showed one small badge)
                  from (
                select 10 as seq, 'Open tasks' as card_title, xxfnd_workflow_pkg.open_task_count as cnt,
                       apex_page.get_url(p_page => 40) as card_link, 'fa-inbox' as card_icon
                  from dual
                union all
                select 20, 'Overdue tasks', count(*), apex_page.get_url(p_page => 40), 'fa-clock-o'
                  from table(apex_human_task.get_tasks(p_context => 'MY_TASKS', p_application_id => null))
                 where state_code in ('UNASSIGNED', 'ASSIGNED', 'INFO_REQUESTED')
                   and due_on < systimestamp
                union all
                select 30, 'Unread notifications', xxfnd_notify_pkg.unread_count, apex_page.get_url(p_page => 43), 'fa-bell-o'
                  from dual
                       ) k
                 order by k.seq
                ```
        }
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: my_tasks
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &CARD_TITLE.
            metric: &CNT.
            metricCssClasses: &METRIC_CLASS.
            layout: 3Columns
        }
        plugin-avatar {
            displayAvatar: true
            type: icon
            icon: &CARD_ICON.
            size: medium
            position: inline
            alignment: center
            style: subtle
        }
        messages {
            whenNoDataFound: Nothing to show.
        }

        action open (
            position: link
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &CARD_LINK.
            }
        )

        column SEQ (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: SEQ
                dataType: number
            }
        )

        column CARD_TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: CARD_TITLE
                dataType: varchar2
            }
        )

        column CNT (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CNT
                dataType: number
            }
        )

        column CARD_LINK (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: CARD_LINK
                dataType: varchar2
            }
        )

        column CARD_ICON (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: CARD_ICON
                dataType: varchar2
            }
        )

        column METRIC_CLASS (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: METRIC_CLASS
                dataType: varchar2
            }
        )
    )

    region modules (
        name: Modules
        type: list
        source {
            list: @module-cards
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                t-Cards--animColorFill
            ]
        }
        advanced {
            htmlDomId: modules
        }
    )
)
