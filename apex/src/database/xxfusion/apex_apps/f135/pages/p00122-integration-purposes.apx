page 122 (
    name: Integration Purposes
    alias: INTEGRATION-PURPOSES
    title: Integration Purposes
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Which server (release 86) and REST Data Source serve each business purpose and whether it runs manually or automatically. Changes take effect after a second person approves them.
    }

    region breadcrumb (
        name: Integration Purposes
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Integration Purposes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       apex_page.get_url(p_page => 123, p_items => 'P123_PURPOSE_CODE', p_values => to_char(q.purpose_code), p_clear_cache => '123') as open_url
                  from (

                            select p.purpose_code, p.purpose_name, p.application_code,
                                   xxfnd_lookup_pkg.lookup_meaning('CAPTURE_METHOD', p.capture_method) as capture_method,
                                   p.server_code,   -- release 86: the workspace server
                                   p.rest_source_static_id,
                                   xxfnd_lookup_pkg.lookup_meaning('APPROVAL_STATUS', p.approval_status) as approval_status,
                                   p.approved_by, p.approved_date
                              from xxfnd_integration_purposes p
                ) q
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
                html
            ]
        }

        column PURPOSE_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#PURPOSE_CODE#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column PURPOSE_NAME (
            type: plainText
            heading {
                heading: Purpose
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column APPLICATION_CODE (
            type: plainText
            heading {
                heading: Application
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column CAPTURE_METHOD (
            type: plainText
            heading {
                heading: Capture
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column SERVER_CODE (
            type: plainText
            heading {
                heading: Server
            }
            layout {
                sequence: 45
            }
            source {
                dataType: STRING
            }
        )

        column REST_SOURCE_STATIC_ID (
            type: plainText
            heading {
                heading: REST Data Source
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column APPROVAL_STATUS (
            type: plainText
            heading {
                heading: Approval
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column APPROVED_BY (
            type: plainText
            heading {
                heading: Approved By
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column APPROVED_DATE (
            type: plainText
            heading {
                heading: Approved On
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create Purpose
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 123
                clearCache: 123
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
