webCredential FUSION_CREDENTIALS (
    name: Fusion Credentials
    type: basicAuthentication
    advanced {
        promptOnInstall: false
        validForUrls: https://your-fusion-host.oraclecloud.com
    }
    comments {
        comments: Release 83 - the Fusion integration user for the HCM worker sync (server FUSION). The workspace administrator enters the user name and password; they are never stored in the application.
    }
)
