restDataSourceServer SHAREPOINT_MAIN (
    name: Microsoft SharePoint (Graph)
    endpointUrl {
        url: https://graph.microsoft.com/v1.0
    }
    advanced {
        promptOnInstall: true
    }
    comments {
        comments: Release 83 - Document store SharePoint through Microsoft Graph (attachments). Replaces endpoint SHAREPOINT_MAIN. Kept by the workspace administrator (Workspace Utilities, Remote Servers); COMMON reaches it through XXFND_INTEGRATION_PKG.
    }
)
