lov lov-applications (
    name: APPLICATIONS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 71: the registered applications (COMMON setup forms: the application a row belongs to)
            select a.application_name || ' (' || a.application_code || ')' as display_value,
                   a.application_code as return_value
              from xxfnd_applications a
             where a.enabled_flag = 'Y'
               -- release 72: only applications with this page's common function switched on (pages without one: all)
               and (not exists (select 1 from xxfnd_feature_pages fp
                                 where fp.app_alias = :APP_ALIAS and fp.page_id = :APP_PAGE_ID)
                    or exists (select 1 from xxfnd_application_functions af
                                 join xxfnd_feature_pages fp on fp.feature_code = af.feature_code
                                where fp.app_alias = :APP_ALIAS and fp.page_id = :APP_PAGE_ID
                                  and af.application_code = a.application_code and af.enabled_flag = 'Y'))
             order by decode(a.application_code, 'COMMON', 1, 0), a.application_name
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
