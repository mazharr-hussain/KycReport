    scope: app
    security {
        sessionStateProtection: restricted
    }
    comments {
        comments:
            ```
            Identity-domain sign-in: the user's middle_name (Map Additional User Attributes To of APEX_FA_IABWBN-DEV1_OAUTH).
            ```
    }
)


