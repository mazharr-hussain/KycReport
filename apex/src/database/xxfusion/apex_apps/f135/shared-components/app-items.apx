appItem G_ADMIN_APP (
    scope: app
    security {
        sessionStateProtection: unrestricted
    }
    comments {
        comments:
            ```
            Application (code) the COMMON setup screens work for: ALL (every application), or the application that opened a setup screen for itself (page 99, G_ADMIN_LOCK = Y).
            ```
    }
)

appItem G_ADMIN_LOCK (
    scope: app
    security {
        sessionStateProtection: unrestricted
    }
    comments {
        comments:
            ```
            Y when another application opened a COMMON setup screen for its own application (G_ADMIN_APP): delegated mode.
            ```
    }
)


appItem NOTIFY_COUNT (
    scope: app
    security {
        sessionStateProtection: restricted
    }
    comments {
        comments:
            ```
            Release 84: the signed-in person's unread notifications (the badge of the bell in the navigation bar); empty when none.
            ```
    }
)
