appProcess SET_ADMIN_APP (
    name: SET_ADMIN_APP
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            -- release 73: no application filter - every application (ALL), unless an application opened a setup
            -- screen for itself (delegated: G_ADMIN_LOCK = Y, page 99)
            :G_ADMIN_APP := case when :G_ADMIN_LOCK = 'Y' then xxfnd_application_pkg.default_application(:G_ADMIN_APP) else 'ALL' end;
            ```
    }
    execution {
        sequence: 10
        point: beforeHeader
    }
    serverSideCondition {
        type: userIsAuthenticated
    }
)

appProcess JOURNEY_ACTIONS (
    name: JOURNEY_ACTIONS
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            -- release 86: the row actions of the application journey sections (Global Page regions of pages 165 and 166),
            -- defined once for both pages. Each action needs the Manage privilege of its own feature and a row of the
            -- application in P0_JRN_APP, then calls the routine of the component that owns the rule (no DML here).
            declare
                l_app varchar2(30)  := :P0_JRN_APP;
                l_key varchar2(255) := :P0_JRN_KEY;
                l_n   pls_integer;
                procedure need(p_feature in varchar2) is
                begin
                    if l_app is null or l_key is null
                       or xxfnd_privilege_pkg.has_privilege_yn(p_feature, 'MANAGE') <> 'Y' then
                        raise_application_error(-20186, 'You are not allowed to change this for the application.');
                    end if;
                end need;
            begin
                case
                    when :REQUEST = 'JRN_REMOVE_USER' then
                        need('USERS_ACCESS');
                        select count(*) into l_n from xxfnd_user_roles_v
                         where user_role_id = to_number(l_key default null on conversion error) and application_code = l_app;
                        if l_n = 0 then
                            raise_application_error(-20187, 'The user does not hold a role of this application.');
                        end if;
                        xxfnd_user_pkg.unassign_role(to_number(l_key));
                    when :REQUEST in ('JRN_PROCESS_ON', 'JRN_PROCESS_OFF') then
                        need('WORKFLOW_SETUP');
                        xxfnd_workflow_pkg.set_process_enabled(l_app, l_key, case :REQUEST when 'JRN_PROCESS_ON' then 'Y' else 'N' end);
                    when :REQUEST in ('JRN_RULE_ON', 'JRN_RULE_OFF') then
                        need('NOTIFICATIONS');
                        select count(*) into l_n from xxfnd_notify_rules
                         where rule_id = to_number(l_key default null on conversion error) and application_code = l_app;
                        if l_n = 0 then
                            raise_application_error(-20187, 'The notification rule is not a rule of this application.');
                        end if;
                        xxfnd_notify_pkg.set_rule_enabled(to_number(l_key), case :REQUEST when 'JRN_RULE_ON' then 'Y' else 'N' end);
                end case;
                :P0_JRN_KEY := null;
            end;
            ```
    }
    execution {
        sequence: 20
        point: processing
    }
    serverSideCondition {
        type: expression
        language: plsql
        plsqlExpression:
            ```plsql
            :APP_PAGE_ID in (165, 166) and :REQUEST in ('JRN_REMOVE_USER', 'JRN_PROCESS_ON', 'JRN_PROCESS_OFF', 'JRN_RULE_ON', 'JRN_RULE_OFF')
            ```
    }
    comments {
        comments: Release 86 - Remove (a user from a role), Switch on / off (a process or notification rule of the application) in the journey sections shared by pages 165 and 166. Release 105 - the menu is kept on the Application Menu screen only (page 167).
    }
)

appProcess USER_HOME (
    name: USER_HOME
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            -- release 103: the user's Home, once per session - COMMON Home for a user who may open it; a user who may
            -- not (e.g. a KYC requester on My Tasks) goes home to the own application (logo, Home breadcrumb, page 1)
            declare
                l_alias varchar2(255);
            begin
                if xxfnd_privilege_pkg.has_privilege('COMMON_HOME', 'VIEW') then
                    :G_USER_HOME_URL := apex_page.get_url(p_page => 1);
                else
                    l_alias := xxfnd_user_pkg.home_application;
                    for a in (select a.application_id, a.application_name, a.home_link
                                from apex_applications a
                               where upper(a.alias) = upper(l_alias)
                                 and a.workspace = (select c.workspace from apex_applications c where c.application_id = :APP_ID)) loop
                        :G_USER_APP_NAME := a.application_name;
                        :G_USER_HOME_URL := apex_page.get_url(p_application => a.application_id,
                                                p_page => nvl(regexp_substr(a.home_link, 'f\?p=[^:]*:([^:&]+)', 1, 1, 'i', 1), '1'));
                    end loop;
                    :G_USER_HOME_URL := nvl(:G_USER_HOME_URL, apex_page.get_url(p_page => 40));
                end if;
            end;
            ```
    }
    execution {
        sequence: 5
        point: beforeHeader
    }
    serverSideCondition {
        type: expression
        language: plsql
        plsqlExpression: :G_USER_HOME_URL is null and apex_authentication.is_authenticated
    }
)

appProcess WORK_APP (
    name: WORK_APP
    type: executeCode
    source {
        language: plsql
        plsqlCode:
            ```plsql
            -- release 104 (was My Tasks only, release 97): the application a COMMON page is used from - its menu
            -- (XXFND_NAV_MENU_V), name and Home stay on every COMMON page the user opens from there; COMMON Home
            -- (page 1) is COMMON's own again; a user who may not open COMMON Home always works in the own application
            declare
                l_ref   varchar2(4000) := owa_util.get_cgi_env('HTTP_REFERER');
                l_alias varchar2(255)  := upper(coalesce(regexp_substr(l_ref, '/r/[^/]+/([^/?#]+)', 1, 1, 'i', 1),
                                                         regexp_substr(l_ref, 'f\?p=([^:&]+)', 1, 1, 'i', 1)));
                l_work  varchar2(255)  := :G_WORK_APP;
            begin
                if :APP_PAGE_ID = 1 then
                    l_work := null;
                elsif l_alias is not null and l_alias not in (upper(:APP_ALIAS), to_char(:APP_ID)) then
                    l_work := l_alias;
                end if;
                if l_work is null and :G_USER_APP_NAME is not null then
                    l_work := xxfnd_user_pkg.home_application;
                end if;
                :G_WORK_APP      := null;
                :G_FROM_APP_NAME := null;
                :G_HOME_URL      := null;
                for a in (select a.application_id, a.alias, a.application_name, a.home_link
                            from apex_applications a
                           where (upper(a.alias) = upper(l_work) or to_char(a.application_id) = l_work)
                             and a.application_id <> :APP_ID
                             and a.workspace = (select c.workspace from apex_applications c where c.application_id = :APP_ID)) loop
                    :G_WORK_APP      := upper(a.alias);
                    :G_FROM_APP_NAME := a.application_name;
                    :G_HOME_URL      := apex_page.get_url(p_application => a.application_id,
                                            p_page => nvl(regexp_substr(a.home_link, 'f\?p=[^:]*:([^:&]+)', 1, 1, 'i', 1), '1'));
                end loop;
                :G_HOME_URL := coalesce(:G_HOME_URL, :G_USER_HOME_URL, apex_page.get_url(p_page => 1));
                select coalesce(:G_FROM_APP_NAME, :G_USER_APP_NAME, max(application_name)) into :G_APP_TITLE
                  from apex_applications where application_id = :APP_ID;
            end;
            ```
    }
    execution {
        sequence: 6
        point: beforeHeader
    }
    serverSideCondition {
        type: userIsAuthenticated
    }
)
