list navigation-bar (
    name: Navigation Bar
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lvl, label, target, is_current, image, image_attribute, image_alt, a01, a02
              -- release 105: the navigation bar of every application, COMMON included, kept in COMMON's menu registry
              -- (menu TOP_BAR: Notifications with its badge, Give Feedback, the user menu with Sign Out)
              from table(xxfnd_nav_pkg.nav_menu('TOP_BAR'))
             order by sort_path
            ```
    }
    comments {
        comments: Release 105 - master list: the navigation bar comes from XXFND_NAV_PKG.NAV_MENU('TOP_BAR') (A01 = badge, A02 = class), managed on the Application Menu screen like the side menu.
    }
)

list navigation-menu (
    name: Navigation Menu
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lvl, label, target, is_current, image, image_attribute, image_alt
              -- release 104: one menu for every application (master of the subscribed copies): the application's menu
              -- kept in COMMON (Application Menu, shown by privileges); in COMMON, COMMON's menu (Home, My Tasks,
              -- modules) or the menu of the application a COMMON page is used from (XXFND_NAV_PKG.NAV_MENU)
              from table(xxfnd_nav_pkg.nav_menu)
             order by sort_path
            ```
    }
    comments {
        comments: Release 104 - master list: every application subscribes to it as its navigation menu; the entries come from XXFND_NAV_PKG.NAV_MENU (view XXFND_NAV_MENU_V).
    }
)

list module-cards (
    name: Module Cards
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 78: one card per module the user may open, with its state (Home and page 100)
            select null                                                    as lvl,
                   module_name                                             as label,
                   apex_page.get_url(p_page => 100, p_items => 'P100_MODULE', p_values => module_code,
                                     p_clear_cache => '100')               as target,
                   'NO'                                                    as is_current,
                   icon_css                                                as image,
                   null                                                    as image_attribute,
                   null                                                    as image_alt,
                   description                                             as a01,
                   module_state                                            as a02
              from xxfnd_modules_v
             order by display_sequence
            ```
    }
)

list module-components (
    name: Module Components
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 78: the components (features) of the module on page 100 that the user may open
            select null                                    as lvl,
                   m.feature_name                          as label,
                   apex_page.get_url(p_page => t.page_id)  as target,
                   'NO'                                    as is_current,
                   m.icon_css                              as image,
                   null                                    as image_attribute,
                   null                                    as image_alt,
                   m.description                           as a01
              from xxfnd_admin_menu_v m
              cross apply (select min(fp.page_id) keep (dense_rank first order by
                                      case when fp.page_id = m.home_page_id then 0 else 1 end,
                                      fp.tab_sequence nulls last, fp.page_id) as page_id
                             from xxfnd_feature_pages fp
                             join apex_application_pages ap
                               on ap.application_id = :APP_ID and ap.page_id = fp.page_id
                            where fp.app_alias = :APP_ALIAS and fp.feature_code = m.feature_code) t
             where m.feature_group = :P100_MODULE
               and t.page_id is not null
             order by m.display_sequence
            ```
    }
)

list feature-tabs (
    name: Feature Tabs
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- The list pages of the current page's feature, as tabs (XXFND_FEATURE_PAGES.TAB_LABEL).
            select null                                  as lvl,
                   fp.tab_label                          as label,
                   apex_page.get_url(p_page => fp.page_id) as target,
                   case when fp.page_id = :APP_PAGE_ID then 'YES' else 'NO' end as is_current
              from xxfnd_feature_pages fp
             where fp.app_alias = :APP_ALIAS
               and fp.tab_label is not null
               and fp.feature_code = (select c.feature_code from xxfnd_feature_pages c
                                       where c.app_alias = :APP_ALIAS and c.page_id = :APP_PAGE_ID)
             order by fp.tab_sequence
            ```
    }
)

list application-journey (
    name: Application Journey
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 86: the steps of the application journey, once for both pages: the Wizard Progress of page 165
            -- (current step = P165_STEP) and the section menu of page 166 (a link to each section, its state as the
            -- badge). P0_JRN_APP = the application (empty while a new one is being registered).
            select null                                                        as lvl,
                   s.label                                                     as label,
                   case when :APP_PAGE_ID = 166 then '#' || s.dom_id
                        when :P0_JRN_APP is not null
                        then apex_page.get_url(p_page => 165, p_items => 'P165_APPLICATION_CODE,P165_STEP',
                                               p_values => :P0_JRN_APP || ',' || s.step)
                   end                                                         as target,
                   case when :APP_PAGE_ID = 165 and to_char(s.step) = :P165_STEP then 'YES' else 'NO' end as is_current,
                   case when s.state is null then 'fa-circle-o' else 'fa-check-circle' end as image,
                   null                                                        as image_attribute,
                   null                                                        as image_alt,
                   s.state                                                     as a01
              from (select 1 as step, 'Application' as label, 'jrn-application' as dom_id,
                           (select case enabled_flag when 'Y' then 'Enabled' else 'Disabled' end
                              from xxfnd_applications where application_code = :P0_JRN_APP) as state
                      from dual
                    union all
                    select 2, 'Roles', 'jrn-roles',
                           (select to_char(nullif(count(*), 0)) from xxfnd_roles where application_code = :P0_JRN_APP)
                      from dual
                    union all
                    select 3, 'Users', 'jrn-users',
                           (select to_char(nullif(count(distinct user_id), 0)) from xxfnd_user_roles_v
                             where application_code = :P0_JRN_APP and active_flag = 'Y')
                      from dual
                    union all
                    select 4, 'Shared functions', 'jrn-functions',
                           (select to_char(nullif(count(*), 0)) from xxfnd_application_functions
                             where application_code = :P0_JRN_APP and managed_in_app_flag = 'Y')
                      from dual
                    union all
                    select 5, 'Setup types', 'jrn-setup-types',
                           (select to_char(nullif(count(*), 0)) from xxfnd_setup_types t
                             where :P0_JRN_APP is not null
                               and xxfnd_application_pkg.app_allowed(t.setup_type_code, :P0_JRN_APP) = 'Y')
                      from dual
                    union all
                    select 6, 'Processes', 'jrn-processes',
                           (select case when count(*) > 0
                                        then sum(case workflow_enabled_flag when 'Y' then 1 else 0 end) || ' / ' || count(*) end
                              from xxfnd_workflow_processes where application_code = :P0_JRN_APP)
                      from dual
                    union all
                    select 7, 'Notifications', 'jrn-notifications',
                           (select to_char(nullif(count(*), 0)) from xxfnd_notify_rules
                             where application_code = :P0_JRN_APP and enabled_flag = 'Y')
                      from dual
                    union all
                    select 8, 'Document storage', 'jrn-storage',
                           (select max(state) from xxfnd_app_storage_v
                             where application_code = :P0_JRN_APP and category_code is null)
                      from dual
                    union all
                    select 9, 'Integrations', 'jrn-integrations',
                           (select to_char(nullif(count(*), 0)) from xxfnd_integration_purposes
                             where application_code = :P0_JRN_APP)
                      from dual
                    union all
                    select 10, 'Review', 'jrn-application', cast(null as varchar2(100))
                      from dual
                     where :APP_PAGE_ID = 165) s
             order by s.step
            ```
    }
)

list administration (
    name: Administration
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 88: one list for the Administration menu (was four lists on KYC page 100, one per group).
            -- release 104: the master in COMMON; each application subscribes to it (its Administration page).
            --   1. the application's own setup: each feature the user may open that has a page here (its home page, else its first tab)
            --   2. each common function IT lets the application's administrators manage, opened in COMMON for KYC (COMMON page 99)
            --   3. COMMON's shared setup (COMMON page 100) when the user may open a setup feature that has no page here
            select lvl, label, target, is_current, image, image_attribute, image_alt, a01
              from (
            select null                                    as lvl,
                   m.feature_name                          as label,
                   apex_page.get_url(p_page => t.page_id)  as target,
                   case when exists (select 1 from xxfnd_feature_pages c
                                      where c.app_alias = :APP_ALIAS and c.feature_code = m.feature_code
                                        and c.page_id = :APP_PAGE_ID) then 'YES' else 'NO' end as is_current,
                   m.icon_css                              as image,
                   null                                    as image_attribute,
                   null                                    as image_alt,
                   m.description                           as a01,
                   1                                       as part,
                   m.feature_group                         as grp,
                   m.display_sequence                      as seq
              from xxfnd_admin_menu_v m
              cross apply (select min(fp.page_id) keep (dense_rank first order by
                                      case when fp.page_id = m.home_page_id then 0 else 1 end,
                                      fp.tab_sequence nulls last, fp.page_id) as page_id
                             from xxfnd_feature_pages fp
                            where fp.app_alias = :APP_ALIAS and fp.feature_code = m.feature_code
                              and xxfnd_application_pkg.local_page(fp.page_id) = 'Y') t
             where t.page_id is not null
            union all
            select null,
                   m.feature_name || ' (shared setup)',
                   apex_page.get_url(p_application => 'COMMON', p_page => 99,
                                     p_items  => 'G_ADMIN_APP,G_ADMIN_LOCK,P99_PAGE',
                                     p_values => a.application_code || ',Y,' || to_char(m.home_page_id)),
                   'NO',
                   m.icon_css,
                   null,
                   null,
                   m.description,
                   2,
                   m.feature_group,
                   m.display_sequence
              from xxfnd_admin_menu_v m
              join xxfnd_applications a on upper(a.apex_app_alias) = upper(:APP_ALIAS)
             where xxfnd_application_pkg.is_delegated(a.application_code, m.feature_code) = 'Y'
            union all
            select null,
                   'Shared Setup',
                   apex_page.get_url(p_application => 'COMMON', p_page => 100),
                   'NO',
                   'fa-cogs',
                   null,
                   null,
                   'The common setup of every application, in COMMON.',
                   3,
                   null,
                   null
              from dual
             where exists (select 1 from xxfnd_admin_menu_v m
                            where not exists (select 1 from xxfnd_feature_pages fp
                                               where fp.app_alias = :APP_ALIAS and fp.feature_code = m.feature_code
                                                 and xxfnd_application_pkg.local_page(fp.page_id) = 'Y'))
                   )
             order by part, grp, seq, label
            ```
    }
    comments {
        comments: Release 104 - master list (not used by COMMON's own pages): each application's Administration page subscribes to it.
    }
)
