taskDefinition DOC_CHECKLIST_REVIEW (
    name: Document Checklist Review
    type: approval
    task {
        subject: Document checklist: &REQUEST_NUMBER. - &PARTY_NAME.
        initiatorCanComplete: false
    }
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- always one row: the task stays manageable whatever the data security of the user
            select nvl(r.request_number, 'Request ' || :APEX$TASK_PK) as request_number, r.party_name
              from dual
              left join xxcmp_requests r on r.request_id = to_number(:APEX$TASK_PK)
            ```
    }
    advanced {
        detailsPage: {
            page: 205
            items: {
                P205_TASK_ID: &TASK_ID.
            }
            clearCache: 205
        }
        vacationRuleProcedureName: xxfnd_task_pkg.vacation_rule
    }
    comments {
        comments: Compliance checks that the documents of a KYC request are complete before investigation (Module 1). Approve opens the case; Reject rejects the request; missing items are requested with an RFI. Created by the KYC_REQUEST workflow.
    }

    action notify-owners (
        name: Notify potential owners
        type: executeCode
        source {
            plsqlCode: xxfnd_task_pkg.notify_created(:APEX$TASK_ID);
        }
        execution {
            onEvent: create
            sequence: 10
        }
    )

    participant (
        value {
            type: expression
            plsqlExpression: xxfnd_task_pkg.users_with_privilege('CASES', 'CREATE')
        }
    )

    participant (
        type: businessAdministrator
        value {
            type: expression
            plsqlExpression: xxfnd_task_pkg.business_admins
        }
    )

)
