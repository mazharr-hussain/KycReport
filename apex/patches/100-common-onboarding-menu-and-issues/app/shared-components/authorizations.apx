authorization app-user (
    name: Application User
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- the rule is in the database: XXFND_USER_PKG.AUTHORIZED
            return xxfnd_user_pkg.authorized('APP_USER');
            ```
    }
    error {
        errorMessage: You do not have access to this application. Ask an administrator to grant you a role.
    }
    advanced {
        evaluationType: perPageView
    }
)

