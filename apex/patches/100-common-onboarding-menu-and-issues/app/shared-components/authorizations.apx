authorization admin-area (
    name: Administration Area
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- the rule is in the database: XXFND_USER_PKG.AUTHORIZED
            return xxfnd_user_pkg.authorized('ADMIN_AREA');
            ```
    }
    error {
        errorMessage: You do not have access to Administration.
    }
    advanced {
        evaluationType: perPageView
    }
)

authorization admin-app (
    name: Administration - Application in Scope
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- release 61: the application in scope (G_ADMIN_APP) is one the user administers (XXFND_APPLICATION_PKG)
            return xxfnd_user_pkg.authorized('ADMIN_APP');
            ```
    }
    error {
        errorMessage: You do not administer this application.
    }
    advanced {
        evaluationType: perPageView
    }
)

authorization signed-in-user (
    name: Signed-in User
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- release 87 (C1): every signed-in user - the shared pages show only the user's own data
            return xxfnd_user_pkg.authorized('SIGNED_IN');
            ```
    }
    error {
        errorMessage: You do not have access to this page.
    }
    advanced {
        evaluationType: perPageView
    }
)
