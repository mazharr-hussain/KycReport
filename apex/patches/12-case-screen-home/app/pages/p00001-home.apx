page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Start here: open your worklist, maintain parties, or answer requests for information.
            ```
    }

    region breadcrumb (
        name: Home
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region home-kpis (
        name: My Work
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select (select count(*) from xxcmp_requests
                         where upper(requester_user_name) = upper(:APP_USER) and request_status in ('DRAFT', 'IN_PROGRESS', 'INFO_NEEDED')) as my_requests,
                       apex_page.get_url(p_page => 200, p_request => 'RIR', p_items => 'IR_REQUESTER_USER_NAME', p_values => :APP_USER) as my_requests_url,
                       (select count(*) from xxcmp_requests
                         where upper(requester_user_name) = upper(:APP_USER) and request_status = 'INFO_NEEDED') as info_needed,
                       apex_page.get_url(p_page => 200, p_request => 'RIR', p_items => 'IR_STAGE',
                                         p_values => xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_STATUS', 'INFO_NEEDED')) as info_needed_url,
                       (select count(*) from table(apex_human_task.get_tasks(p_context => 'MY_TASKS', p_application_id => :APP_ID))
                         where state_code in ('ASSIGNED', 'UNASSIGNED')
                           and task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'CASE_APPROVAL', 'CASE_INVESTIGATION', 'COUNTERPARTY_MATCH')) as pending_approval,
                       apex_page.get_url(p_page => 40) as pending_approval_url,
                       (select count(*) from xxcmp_cases
                         where upper(assigned_to) = upper(:APP_USER) and case_status in ('INVESTIGATION', 'PENDING_APPROVAL')) as my_cases,
                       apex_page.get_url(p_page => 210, p_request => 'RIR', p_items => 'IR_ASSIGNED_TO', p_values => upper(:APP_USER)) as my_cases_url,
                       (select count(*) from xxcmp_cases
                         where closed_date is null and sla_due_date < trunc(sysdate)) as overdue,
                       apex_page.get_url(p_page => 210, p_request => 'RIR', p_items => 'IR_SLA_STATUS', p_values => 'Overdue') as overdue_url,
                       (select count(*) from xxcmp_rfis
                         where rfi_status in ('WAITING_FOR_INFORMATION', 'ON_HOLD_PENDING')
                           and (upper(recipient_user_name) = upper(:APP_USER) or upper(created_by) = upper(:APP_USER))) as open_rfis,
                       apex_page.get_url(p_page => 30) as open_rfis_url
                  from dual
                ```
        }
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: home_kpis
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--large
                t-BadgeList--flex
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 1
        }
        messages {
            whenNoDataFound: No data found.
        }
        comments {
            comments: Count tiles of the user's open work (data security applies); each opens the matching list, filtered. A tile shows only with the privilege of the screen it opens.
        }

        column MY_REQUESTS (
            type: plainText
            heading {
                heading: My Open Requests
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#MY_REQUESTS_URL#">#MY_REQUESTS#</a>
                    ```
            }
            serverSideCondition {
                type: expression
                language: plsql
                plsqlExpression:
                    ```plsql
                    xxfnd_privilege_pkg.has_privilege('KYC_REQUESTS', 'VIEW')
                    ```
            }
        )

        column MY_REQUESTS_URL (
            type: hidden
            layout {
                sequence: 15
            }
        )

        column INFO_NEEDED (
            type: plainText
            heading {
                heading: Information Needed
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#INFO_NEEDED_URL#">#INFO_NEEDED#</a>
                    ```
            }
            serverSideCondition {
                type: expression
                language: plsql
                plsqlExpression:
                    ```plsql
                    xxfnd_privilege_pkg.has_privilege('KYC_REQUESTS', 'VIEW')
                    ```
            }
        )

        column INFO_NEEDED_URL (
            type: hidden
            layout {
                sequence: 25
            }
        )

        column PENDING_APPROVAL (
            type: plainText
            heading {
                heading: Pending My Approval
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#PENDING_APPROVAL_URL#">#PENDING_APPROVAL#</a>
                    ```
            }
        )

        column PENDING_APPROVAL_URL (
            type: hidden
            layout {
                sequence: 35
            }
        )

        column MY_CASES (
            type: plainText
            heading {
                heading: My Open Cases
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#MY_CASES_URL#">#MY_CASES#</a>
                    ```
            }
            serverSideCondition {
                type: expression
                language: plsql
                plsqlExpression:
                    ```plsql
                    xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                    ```
            }
        )

        column MY_CASES_URL (
            type: hidden
            layout {
                sequence: 45
            }
        )

        column OVERDUE (
            type: plainText
            heading {
                heading: Overdue Cases
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OVERDUE_URL#">#OVERDUE#</a>
                    ```
            }
            serverSideCondition {
                type: expression
                language: plsql
                plsqlExpression:
                    ```plsql
                    xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                    ```
            }
        )

        column OVERDUE_URL (
            type: hidden
            layout {
                sequence: 55
            }
        )

        column OPEN_RFIS (
            type: plainText
            heading {
                heading: Open RFIs
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_RFIS_URL#">#OPEN_RFIS#</a>
                    ```
            }
        )

        column OPEN_RFIS_URL (
            type: hidden
            layout {
                sequence: 65
            }
        )

    )

    region welcome (
        name: KYC Compliance Platform
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Welcome, &APP_USER.. Use the menu to work with parties, requests for information and your worklist.
                Administrators maintain the platform setup from <strong>Administration</strong>.</p>
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: welcome
        }
    )

    region my-tasks (
        name: My Open Tasks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       subject,
                       task_def_name,
                       details_link_target,
                       due_on,
                       created_on
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'MY_TASKS',
                                   p_application_id => :APP_ID ) )
                 where state_code in ('UNASSIGNED','ASSIGNED')
                 order by due_on nulls last, created_on
                ```
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: my-tasks
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 10
        }
        messages {
            whenNoDataFound: Nothing is waiting for you.
        }

        column TASK_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column SUBJECT (
            type: plainText
            heading {
                heading: Task
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#DETAILS_LINK_TARGET#">#SUBJECT#</a>
                    ```
            }
        )

        column TASK_DEF_NAME (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )

        column DETAILS_LINK_TARGET (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column DUE_ON (
            type: plainText
            heading {
                heading: Due
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: SINCE
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Waiting Since
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: SINCE
            }
        )

    )

    region my-rfis (
        name: Requests for Information Addressed to Me
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.rfi_id,
                       r.rfi_number,
                       xxfnd_util_pkg.lookup_meaning('RFI_CATEGORY', r.rfi_category) as category,
                       substr(r.description, 1, 200) as description,
                       r.due_date
                  from xxcmp_rfis r
                 where upper(r.recipient_user_name) = :APP_USER
                   and r.rfi_status in ('WAITING_FOR_INFORMATION','ON_HOLD_PENDING')
                   and r.responded_date is null
                 order by r.due_date nulls last
                ```
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: my-rfis
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 10
        }
        messages {
            whenNoDataFound: No open requests.
        }

        column RFI_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column RFI_NUMBER (
            type: link
            heading {
                heading: RFI
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 31
                    items: {
                        P31_RFI_ID: #RFI_ID#
                    }
                    clearCache: 31
                }
                linkText: #RFI_NUMBER#
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Request
            }
            layout {
                sequence: 40
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

    )

)
