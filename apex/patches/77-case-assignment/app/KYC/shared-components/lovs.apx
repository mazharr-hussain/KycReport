        display: Last 30 days
        return: 168|720
    )

    entry last-7-days (
        sequence: 3
        display: Last 7 days
        return: 24|168
    )

    entry last-hour (
        sequence: 1
        display: Last hour
        return: |1
    )

    entry older-than-30-days (
        sequence: 5
        display: Older than 30 days
        return: 720|
    )

)

lov unified-task-list-lov-priority (
    name: UNIFIED_TASK_LIST.LOV.PRIORITY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            
            select disp, 
                   val 
              from table ( apex_approval.get_lov_priority )
             order by insert_order
            ```
    }
    columnMapping {
        return: VAL
        display: DISP
    }
)

