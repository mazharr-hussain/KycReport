page 172 (
    name: Review Change
    alias: REVIEW-CHANGE
    title: Review Change
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 800
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Approve or reject a configuration change. You cannot approve a change you made yourself.
    }

    region review (
        name: Review Change
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: review
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P172_TASK_ID (
        type: hidden
        layout {
            sequence: 1
            region: @review
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P172_DETAIL_PK (
        type: hidden
        layout {
            sequence: 2
            region: @review
            slot: regionBody
        }
    )

    pageItem P172_TASK_STATE (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 5
            region: @review
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select state || nvl2(outcome, ' - ' || outcome, null) from apex_tasks where task_id = :P172_TASK_ID
                ```
            used: always
        }
    )

    pageItem P172_CHANGE_TYPE (
        type: displayOnly
        label {
            label: Change
            alignment: left
        }
        layout {
            sequence: 10
            region: @review
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select change_type from xxfnd_config_changes_v where detail_pk = :P172_DETAIL_PK
                ```
            used: always
        }
    )

    pageItem P172_CHANGE_TITLE (
        type: displayOnly
        label {
            label: Item
            alignment: left
        }
        layout {
            sequence: 15
            region: @review
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select change_title from xxfnd_config_changes_v where detail_pk = :P172_DETAIL_PK
                ```
            used: always
        }
    )

    pageItem P172_CHANGE_SUMMARY (
        type: displayOnly
        label {
            label: Summary
            alignment: left
        }
        layout {
            sequence: 20
            region: @review
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select change_summary from xxfnd_config_changes_v where detail_pk = :P172_DETAIL_PK
                ```
            used: always
        }
    )

    pageItem P172_SUBMITTED_BY (
        type: displayOnly
        label {
            label: Changed By
            alignment: left
        }
        layout {
            sequence: 30
            region: @review
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select submitted_by from xxfnd_config_changes_v where detail_pk = :P172_DETAIL_PK
                ```
            used: always
        }
    )

    pageItem P172_REASON (
        type: textarea
        label {
            label: Rejection Reason
            alignment: left
        }
        layout {
            sequence: 40
            region: @review
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Enter the rejection Reason.
        }
    )

    region not-pending (
        name: No Longer Pending
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>This change is no longer waiting for approval (it was withdrawn or already decided). A workflow administrator can cancel the task in the Workflow Monitor.</p>
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--warning
            ]
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxfnd_config_approval_pkg.is_pending(:P172_DETAIL_PK) = 'N'
                and apex_human_task.is_allowed(p_task_id => :P172_TASK_ID, p_operation => apex_human_task.c_task_op_cancel)
                ```
        }
    )

    region trail (
        name: What Changed
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.changed_date, a.changed_by, a.column_name, a.old_value, a.new_value, a.change_reason
                  from xxfnd_audit_log a
                 where (a.table_name = substr(:P172_DETAIL_PK, 1, instr(:P172_DETAIL_PK, ':') - 1)
                        and a.pk_value = substr(:P172_DETAIL_PK, instr(:P172_DETAIL_PK, ':') + 1))
                    or (:P172_DETAIL_PK like 'XXCMP_QUESTIONS:%'
                        and a.table_name = 'XXCMP_ANSWER_OPTIONS'
                        and a.pk_value in (select to_char(o.answer_option_id) from xxcmp_answer_options o
                                            where o.question_id = to_number(substr(:P172_DETAIL_PK, instr(:P172_DETAIL_PK, ':') + 1))))
                 order by a.audit_log_id desc
                ```
            pageItemsToSubmit: P172_DETAIL_PK
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: trail
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 20
        }
        messages {
            whenNoDataFound: No data found.
        }

        column CHANGED_DATE (
            type: plainText
            heading {
                heading: When
            }
            layout {
                sequence: 10
            }
            appearance {
            }
        )

        column CHANGED_BY (
            type: plainText
            heading {
                heading: Who
            }
            layout {
                sequence: 20
            }
        )

        column COLUMN_NAME (
            type: plainText
            heading {
                heading: Field
            }
            layout {
                sequence: 30
            }
        )

        column OLD_VALUE (
            type: plainText
            heading {
                heading: Old
            }
            layout {
                sequence: 40
            }
        )

        column NEW_VALUE (
            type: plainText
            heading {
                heading: New
            }
            layout {
                sequence: 50
            }
        )

        column CHANGE_REASON (
            type: plainText
            heading {
                heading: Reason
            }
            layout {
                sequence: 60
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                xxfnd_config_approval_pkg.is_pending(:P172_DETAIL_PK) = 'Y'
                and (apex_human_task.is_allowed(p_task_id => :P172_TASK_ID, p_operation => apex_human_task.c_task_op_reject)
                     or apex_human_task.is_allowed(p_task_id => :P172_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                xxfnd_config_approval_pkg.is_pending(:P172_DETAIL_PK) = 'Y'
                and (apex_human_task.is_allowed(p_task_id => :P172_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P172_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation VAL_REASON_NEEDED (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P172_REASON is null then 'Enter why the change is rejected.' end;
                ```
        }
        error {
            associatedItem: @P172_REASON
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    process load-task (
        name: Load task
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- only a CONFIG_CHANGE task the user may see
                select max(detail_pk) into :P172_DETAIL_PK
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'SINGLE_TASK',
                                   p_task_id        => :P172_TASK_ID,
                                   p_application_id => :APP_ID ) )
                 where task_def_static_id = 'CONFIG_CHANGE';
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

    process add-reason (
        name: Record the rejection reason
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P172_TASK_ID, p_text => :P172_REASON);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    process approve-task (
        name: Approve
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- claims the task first when it is still unassigned
                apex_human_task.approve_task(p_task_id => :P172_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Change approved.
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
    )

    process reject-task (
        name: Reject
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P172_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Change rejected.
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,REJECT
        }
    )

)
