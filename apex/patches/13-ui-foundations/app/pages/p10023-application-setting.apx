page 10023 (
    name: Application Setting
    alias: APPLICATION-SETTING
    title: Application Setting
    pageGroup: @features
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: The value is kept when the application is upgraded.
    }

    region setting (
        name: Application Setting
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: setting
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10023_NAME (
        type: hidden
        layout {
            sequence: 1
            region: @setting
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10023_DISPLAY_NAME (
        type: displayOnly
        label {
            label: Setting
            alignment: left
        }
        layout {
            sequence: 10
            region: @setting
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select name || ' - ' || comments from apex_application_settings
                 where application_id = :APP_ID and name = :P10023_NAME
                ```
            used: always
        }
    )

    pageItem P10023_VALUE (
        type: textField
        label {
            label: Value
            alignment: left
        }
        layout {
            sequence: 20
            region: @setting
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select value from apex_application_settings
                 where application_id = :APP_ID and name = :P10023_NAME
                ```
            used: always
        }
        help {
            helpText: The value used by the application.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Apply
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process set-value (
        name: Set application setting
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_app_setting.set_value(p_name => :P10023_NAME, p_value => :P10023_VALUE);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Setting saved.
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

)
