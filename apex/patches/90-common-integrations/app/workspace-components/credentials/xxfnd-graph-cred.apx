webCredential XXFND_GRAPH_CRED (
    name: XXFND Graph Credentials
    type: oauth2ClientCredentialsFlow
    advanced {
        promptOnInstall: false
        tokenAuthenticationMethod: clientIdAndClientSecretInBody
    }
    authentication {
        oauthScope: https://graph.microsoft.com/.default
    }
    comments {
        comments: Release 83 - the Microsoft Entra application (client ID and secret) for SharePoint and Outlook through Microsoft Graph (servers SHAREPOINT_MAIN, OUTLOOK_GRAPH). Entered by the workspace administrator.
    }
)
