page 206 (
    name: KYC Request Approval
    alias: KYC-REQUEST-APPROVAL
    title: KYC Request Approval
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The approval screen of a KYC request, opened from the task: the same summary as the request (party, details, answers, documents, approval history) with the decision: Approve, Reject, Request Information (a comment is required to reject or request information) and Merge for a duplicate party.
            ```
    }

    region breadcrumb (
        name: KYC Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region request (
        name: Request
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P206_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_TASK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_CASE_ID (
        type: hidden
        layout {
            sequence: 3
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_PARTY_ID (
        type: hidden
        layout {
            sequence: 4
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_REQUEST_NUMBER (
        type: displayOnly
