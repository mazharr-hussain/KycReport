        }
    )

    pageItem P206_ACTION_DATE (
        type: displayOnly
        label {
            label: Action Date
            alignment: left
        }
        layout {
            sequence: 26
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(last_action_date, 'DD-MON-YYYY HH24:MI') from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_COUNTERPARTY (
        type: displayOnly
        label {
            label: Counterparty
            alignment: left
        }
        layout {
            sequence: 30
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select party_name || ' (' || xxfnd_util_pkg.lookup_meaning('PARTY_TYPE', party_type)
                       || nvl2(registration_number, ', ' || registration_number, null)
                       || nvl2(jurisdiction, ', ' || xxfnd_util_pkg.lookup_meaning('JURISDICTION', jurisdiction), null) || ')'
                  from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_REQUEST_TYPE (
        type: displayOnly
        label {
            label: Type
            alignment: left
        }
        layout {
            sequence: 40
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', request_type) from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_INTAKE (
        type: displayOnly
        label {
            label: Intake Result
            alignment: left
        }
        layout {
            sequence: 50
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('KYC_INTAKE_OUTCOME', intake_outcome)
                       || nvl2(intake_score, ' (score ' || intake_score || case when intake_critical_flag = 'Y' then ', critical answer' end || ')', null)
                  from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_REQUESTED_BY (
        type: displayOnly
        label {
            label: Requested By
            alignment: left
        }
        layout {
            sequence: 60
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select requester_user_name || nvl2(requesting_department, ' - '
                       || xxfnd_util_pkg.lookup_meaning('REQUESTING_DEPARTMENT', requesting_department), null)
                  from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_JUSTIFICATION (
        type: displayOnly
        label {
            label: Business Justification
            alignment: left
        }
        layout {
            sequence: 70
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select justification from xxcmp_requests where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_PARTY (
        type: displayOnly
        label {
            label: Party
            alignment: left
        }
        layout {
            sequence: 80
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case when p.party_id is not null then p.party_number || ' - ' || p.party_name
                            when r.party_id is not null then 'Linked to a party'
                            else 'Not decided yet' end
                       || nvl2(r.match_status, ' (' || xxfnd_util_pkg.lookup_meaning('REQUEST_MATCH_STATUS', r.match_status) || ')', null)
                  from xxcmp_requests r
                  left join xxcmp_parties p on p.party_id = r.party_id
                 where r.request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )

    pageItem P206_CASE_NUMBER (
        type: displayOnly
        label {
            label: Case
            alignment: left
        }
        layout {
            sequence: 90
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select max(case_number) from xxcmp_cases where request_id = :P206_REQUEST_ID
                ```
            used: always
        }
    )




    region checklist (
        name: Document Checklist
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.column_value as category_code,
                       (select nvl(tl.category_name, dc.category_name) from xxfnd_document_categories dc
                          left join xxfnd_document_categories_tl tl on tl.category_code = dc.category_code and tl.language_code = xxfnd_util_pkg.current_lang
                         where dc.category_code = c.column_value) as category,
                       case when exists (select 1 from xxfnd_attached_documents_v a
                                          where a.category_code = c.column_value and nvl(a.expired_flag, 'N') = 'N'
                                            and ((a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = :P206_REQUEST_ID)
                                              or (a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = (select to_char(party_id) from xxcmp_requests where request_id = :P206_REQUEST_ID))))
                            then 'Present' else 'Missing' end as status
                  from table(xxcmp_kyc_pkg.mandatory_categories('XXCMP_PARTIES',
                                 (select jurisdiction from xxcmp_requests where request_id = :P206_REQUEST_ID),
                                 (select entity_type from xxcmp_requests where request_id = :P206_REQUEST_ID))) c
                ```
            pageItemsToSubmit: P206_REQUEST_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: checklist
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No mandatory documents are configured for this counterparty.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }

        column CATEGORY_CODE (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Mandatory Document
            }
            layout {
                sequence: 20
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

    )

    region counterparty_matching (
        name: Possible Duplicate Parties
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>The counterparty was created as a new (Pending) party with the request. If it is an existing party, merge it into that party: the request, its documents and contacts move there and the duplicate is disabled.</p>
                ```
        }
        layout {
            sequence: 50
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: counterparty_matching
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                -- Compliance, while the request's own new party is still Pending
                select 1
                  from xxcmp_requests r
                  join xxcmp_parties p on p.party_id = r.party_id
                 where r.request_id = :P206_REQUEST_ID and r.party_selection = 'NEW' and p.party_status = 'PENDING'
                   and p.enabled_flag = 'Y' and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE')
                ```
        }
    )

    pageItem P206_MERGE_PARTY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Set by the Merge link just before submit. XXCMP_PARTY_PKG.MERGE_PARTIES re-checks the privilege, the party types and that both parties are enabled.
        }
        layout {
            sequence: 1
            region: @counterparty_matching
            slot: regionBody
        }
    )

    region match_candidates (
        name: Existing Parties That May Be This Counterparty
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_number,
                       j.party_name, j.country, j.status, j.score, j.reg_match, j.reasons,
                       apex_page.get_url(p_page => 21, p_items => 'P21_PARTY_ID', p_values => to_char(j.party_id), p_clear_cache => '21') as party_url,
                       'Merge into this party' as merge
                  from json_table(xxcmp_request_pkg.request_candidates_json(:P206_REQUEST_ID), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  status varchar2(80) path '$.status',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: P206_REQUEST_ID
        }
        layout {
            sequence: 20
            slot: BODY
            parentRegion: @counterparty_matching
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: match_candidates
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this counterparty any more.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_URL (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#PARTY_URL#" target="_blank">#PARTY_NUMBER#</a>
                    ```
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration / ID No.
            }
            layout {
                sequence: 40
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Party Status
            }
            layout {
                sequence: 65
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 50
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 60
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 70
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 80
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 90
            }
        )

        column MERGE (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-merge-party" data-party="#PARTY_ID#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#MERGE#</a>
                    ```
            }
        )

    )

    region merge-dialog (
        name: Merge into an Existing Party
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Merge this counterparty's party into <strong id="merge_target"></strong>? The request, its documents and contacts move there and the duplicate is disabled.</p>
                ```
        }
        layout {
            sequence: 95
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: merge_dialog
        }
    )

    pageItem P206_MATCH_NOTE (
        type: textarea
        label {
            label: Merge Note
            alignment: left
        }
        layout {
            sequence: 10
            region: @merge-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Why the counterparty is this existing party.
        }
    )

    button merge (
        buttonName: MERGE
        label: Merge
        layout {
            sequence: 20
            region: @merge-dialog
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button merge-cancel (
        buttonName: MERGE_CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @merge-dialog
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction merge-cancel (
        name: Close the merge dialog
        execution {
            sequence: 65
        }
        when {
            event: click
            selectionType: button
            button: @merge-cancel
        }

        action merge-cancel-close (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @merge-dialog
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation merge-note (
        name: Merge note given
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when trim(:P206_MATCH_NOTE) is null then 'Enter why the counterparty is this existing party.' end;
                ```
        }
        error {
            associatedItem: @P206_MATCH_NOTE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )

    dynamicAction merge-party (
        name: Merge into an existing party
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-merge-party
        }

        action merge-party-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var a = $(this.triggeringElement);
                    this.browserEvent.preventDefault();
                    apex.item("P206_MERGE_PARTY_ID").setValue(String(a.data("party")));
                    $("#merge_target").text(a.data("label"));
                    apex.item("P206_MATCH_NOTE").setValue("");
                    apex.theme.openRegion("merge_dialog");
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process merge-party (
        name: Merge into existing party
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_party number;
                begin
                    select party_id into l_party from xxcmp_requests where request_id = :P206_REQUEST_ID;
                    xxcmp_party_pkg.merge_parties(l_party, to_number(:P206_MERGE_PARTY_ID), :P206_MATCH_NOTE);
                end;
                ```
        }
        execution {
            sequence: 5
            point: processing
        }
        successMessage {
            successMessage: The counterparty's party was merged into the existing party.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: MERGE
        }
    )

    button approve-top (
        buttonName: APPROVE_TOP
        label: Approve
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button reject-top (
        buttonName: REJECT_TOP
        label: Reject Request
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Reject this request?
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button request-info-top (
        buttonName: REQUEST_INFO_TOP
        label: Request Information
        layout {
            sequence: 15
            region: @buttons
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    region decision (
        name: Decision
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Approve completes your approval step: the next step of the approval path follows, and after the last one the request and its party are approved (and the case opens when KYC is required). Reject closes the request. Request Information sends your question to the requester: the request is Information Needed until they answer.</p>
                ```
        }
        layout {
            sequence: 70
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: decision
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    pageItem P206_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 10
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Recorded on the task; required when rejecting.
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 30
            region: @decision
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject Request
        layout {
            sequence: 20
            region: @decision
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Reject this request?
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button request-info (
        buttonName: REQUEST_INFO
        label: Request Information
        layout {
            sequence: 15
            region: @decision
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- the document checklist task of this request (the page also opens from the Counterparty Match task)
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and task_def_static_id = 'DOC_CHECKLIST_REVIEW') loop
                    return apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                        or apex_human_task.is_allowed(p_task_id => :P206_TASK_ID, p_operation => apex_human_task.c_task_op_claim);
                end loop;
                return false;
                ```
        }
    )

    button open-case (
        buttonName: OPEN_CASE
        label: Open Case
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
                items: {
                    P211_CASE_ID: &P206_CASE_ID.
                }
                clearCache: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P206_CASE_ID is not null and xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }
    )

    validation reject-reason (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P206_COMMENT is null then 'Enter why the request is rejected.' end;
                ```
        }
        error {
            associatedItem: @P206_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT,REJECT_TOP
        }
    )

    validation info-question (
        name: Information requested
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P206_COMMENT is null then 'Enter the information you need from the requester.' end;
                ```
        }
        error {
            associatedItem: @P206_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REQUEST_INFO,REQUEST_INFO_TOP
        }
    )

    process open-from-task (
        name: Open from task
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select to_number(detail_pk) into :P206_REQUEST_ID
                  from table ( apex_human_task.get_tasks (
                                   p_context        => 'SINGLE_TASK',
                                   p_task_id        => :P206_TASK_ID,
                                   p_application_id => :APP_ID ) )
                 where task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'COUNTERPARTY_MATCH');
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P206_TASK_ID
        }
    )

    process find-my-task (
        name: My open task on this request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- opened from KYC Requests (not My Tasks): use the approver's own open task on this request
                select max(t.task_id) into :P206_TASK_ID
                  from table ( apex_human_task.get_tasks ( p_context => 'MY_TASKS', p_application_id => :APP_ID ) ) t
                 where t.detail_pk = :P206_REQUEST_ID
                   and t.task_def_static_id in ('DOC_CHECKLIST_REVIEW', 'COUNTERPARTY_MATCH')
                   and t.state_code in ('ASSIGNED', 'UNASSIGNED');
                ```
        }
        execution {
            sequence: 7
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P206_TASK_ID
        }
    )

    process load-case (
        name: Load case
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select max(case_id) into :P206_CASE_ID from xxcmp_cases where request_id = :P206_REQUEST_ID;
                -- the breadcrumb shows the request number before the page items are rendered
                select max(request_number), max(party_id) into :P206_REQUEST_NUMBER, :P206_PARTY_ID
                  from xxcmp_requests where request_id = :P206_REQUEST_ID;
                -- the common Party / Approval Path / History regions (Global Page)
                :P0_REQUEST_ID := :P206_REQUEST_ID;
                :P0_SUMMARY_PARTY_ID := :P206_PARTY_ID;
                ```
        }
        execution {
            sequence: 6
            point: beforeHeader
        }
    )

    process add-comment (
        name: Record comment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P206_TASK_ID, p_text => :P206_COMMENT);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P206_COMMENT
        }
    )

    process approve-task (
        name: Approve checklist
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.approve_task(p_task_id => :P206_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Approved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process reject-task (
        name: Reject request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P206_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Request rejected.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT,REJECT_TOP
        }
    )

    process request-info-task (
        name: Request information
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- the question goes to the requester (task initiator); an unclaimed task is claimed first
                for t in (select 1 from apex_tasks where task_id = :P206_TASK_ID and state_code = 'UNASSIGNED') loop
                    apex_human_task.claim_task(p_task_id => :P206_TASK_ID);
                end loop;
                apex_human_task.request_more_information(p_task_id => :P206_TASK_ID, p_text => :P206_COMMENT);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Information requested: the requester answers in My Tasks, then the task comes back to you.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REQUEST_INFO,REQUEST_INFO_TOP
        }
    )

)
