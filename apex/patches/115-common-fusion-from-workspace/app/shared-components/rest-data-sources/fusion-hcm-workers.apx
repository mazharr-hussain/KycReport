restDataSource FUSION_HCM_WORKERS (
    name: Fusion HCM Workers
    source {
        type: http
        remoteServer: @apex-fa-iabwbn-dev1-rest-apis
        urlPathPrefix: hcmRestApi/resources/11.13.18.05/publicWorkers
    }
    authentication {
        credentials: @apex-fa-iabwbn-dev1-dbms-cred
    }
    comments {
        comments: Release 83 - the HCM workers of Oracle Fusion (purpose HCM_SYNC). Release 100: through the workspace's Fusion server and credential (Fusion integration prerequisite). XXFND_INTEGRATION_PKG.SYNC_HCM reads it to refresh the Fusion employees; workers no longer returned are disabled, not deleted.
    }

    dataProfile {
        name: FUSION_HCM_WORKERS
        rowSelector: items
    }

    dataProfileColumn person-id (
        columnName: PERSON_ID
        source {
            sequence: 1
            dataType: number
            primaryKey: true
        }
        parsing {
            pathExpression: PersonId
        }
        advanced {
            sourceDataType: number
        }
    )

    dataProfileColumn person-number (
        columnName: PERSON_NUMBER
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: PersonNumber
        }
        advanced {
            sourceDataType: string
        }
    )

    dataProfileColumn display-name (
        columnName: DISPLAY_NAME
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            pathExpression: DisplayName
        }
        advanced {
            sourceDataType: string
        }
    )

    dataProfileColumn work-email (
        columnName: WORK_EMAIL
        source {
            sequence: 4
            dataType: varchar2
        }
        parsing {
            pathExpression: WorkEmail
        }
        advanced {
            sourceDataType: string
        }
    )

    operation get-rows (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )
)
