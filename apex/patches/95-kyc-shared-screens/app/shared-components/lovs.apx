lov lov-parties (
    name: PARTIES
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select party_name || ' (' || party_number || ')' as display_value,
                   party_id as return_value
              from xxcmp_parties
             where enabled_flag = 'Y'
             order by party_name
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

