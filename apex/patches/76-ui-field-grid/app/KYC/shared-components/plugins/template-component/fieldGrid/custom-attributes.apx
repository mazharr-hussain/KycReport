customAttribute LABEL (
    apexlangName: label
    attribute: 1
    name: Label
    appearance {
        sequence: 10
    }
)

customAttribute VALUE (
    apexlangName: value
    attribute: 2
    name: Value
    appearance {
        sequence: 20
    }
)

customAttribute TONE (
    apexlangName: tone
    attribute: 3
    name: Badge Tone
    appearance {
        sequence: 30
    }
    help {
        helpText: success, warning, danger, info or neutral: the value is shown as a badge of that tone.
    }
)

customAttribute LINK (
    apexlangName: link
    attribute: 4
    name: Link
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 40
    }
)

customAttribute META (
    apexlangName: meta
    attribute: 5
    name: Note
    appearance {
        sequence: 50
    }
)

customAttribute FULL_WIDTH (
    apexlangName: fullWidth
    attribute: 6
    name: Full Width
    appearance {
        sequence: 60
    }
    help {
        helpText: Y: the field takes the whole row (long text).
    }
)

customAttribute PERSON (
    apexlangName: person
    attribute: 8
    name: Person User Name
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 45
    }
    help {
        helpText: A user name: the value is shown as the person's name with the person card on hover.
    }
)

customAttribute LINK_TEXT (
    apexlangName: linkText
    attribute: 9
    name: Link Text
    appearance {
        sequence: 46
    }
    help {
        helpText: With tone "missing": the text of the link to the place where the value is entered.
    }
)

customAttribute GROUP_TITLE (
    apexlangName: groupTitle
    attribute: 7
    name: Group Title
    scope: reportGroup
    appearance {
        attributeGroup: @grouping
        sequence: 70
    }
)
