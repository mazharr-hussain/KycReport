page 201 (
    name: Create Request - Counterparty
    alias: CREATE-REQUEST
    title: Create Request - Counterparty
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Step 1 of 3: who is the counterparty. The request is saved as a draft; you can come back to it from KYC Requests.
            ```
    }

    region breadcrumb (
        name: Create Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Create Request
        type: list
        source {
            list: @request-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region counterparty (
        name: Counterparty
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: counterparty
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P201_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @counterparty
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_PARTY_TYPE (
        type: radioGroup
        label {
            label: Counterparty Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'PARTY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: ORGANIZATION
        }
        help {
            helpText: An organisation (company, trust, government entity) or an individual.
        }
    )

    pageItem P201_PARTY_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 360
        }
        help {
            helpText: Legal name of the organisation, or full name of the individual.
        }
    )

    pageItem P201_REGISTRATION_NUMBER (
        type: textField
        label {
            label: Registration Number
            alignment: left
        }
        layout {
            sequence: 30
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        help {
            helpText: Commercial registration or company number.
        }
    )

    pageItem P201_ENTITY_TYPE (
        type: selectList
        label {
            label: Entity Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'ENTITY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Legal form of the organisation.
        }
    )

    pageItem P201_DATE_OF_BIRTH (
        type: datePicker
        label {
            label: Date of Birth
            alignment: left
        }
        layout {
            sequence: 45
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_NATIONALITY (
        type: selectList
        label {
            label: Nationality
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 47
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_JURISDICTION (
        type: selectList
        label {
            label: Country
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'JURISDICTION' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 50
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Country of incorporation for an organisation, country of residence for an individual.
        }
    )

    pageItem P201_REQUESTING_DEPARTMENT (
        type: selectList
        label {
            label: Requesting Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'REQUESTING_DEPARTMENT' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 80
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P201_JUSTIFICATION (
        type: textarea
        label {
            label: Business Purpose
            alignment: left
        }
        layout {
            sequence: 90
            region: @counterparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 4000
        }
        help {
            helpText: Why the organisation wants to deal with this counterparty.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process load-request (
        name: Load draft
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select party_type, party_name, registration_number, entity_type, jurisdiction,
                       date_of_birth, nationality, requesting_department, justification
                  into :P201_PARTY_TYPE, :P201_PARTY_NAME, :P201_REGISTRATION_NUMBER, :P201_ENTITY_TYPE, :P201_JURISDICTION,
                       :P201_DATE_OF_BIRTH, :P201_NATIONALITY, :P201_REQUESTING_DEPARTMENT, :P201_JUSTIFICATION
                  from xxcmp_requests
                 where request_id = :P201_REQUEST_ID and request_status = 'DRAFT';
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_REQUEST_ID
        }
    )

    dynamicAction fields-by-type (
        name: Fields for the counterparty type
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_TYPE
        }
        clientSideCondition {
            type: item=value
            item: P201_PARTY_TYPE
            value: ORGANIZATION
        }

        action fields-by-type-org-show (
            action: show
            affectedElements {
                selectionType: items
                items: P201_REGISTRATION_NUMBER,P201_ENTITY_TYPE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action fields-by-type-person-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_DATE_OF_BIRTH,P201_NATIONALITY
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: true
                fireOnInit: true
            }
        )

        action fields-by-type-org-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_REGISTRATION_NUMBER,P201_ENTITY_TYPE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

        action fields-by-type-person-show (
            action: show
            affectedElements {
                selectionType: items
                items: P201_DATE_OF_BIRTH,P201_NATIONALITY
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
                fireOnInit: true
            }
        )

    )

    validation required-1 (
        name: Enter the registration number of the organisation.
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_TYPE = 'ORGANIZATION' and trim(:P201_REGISTRATION_NUMBER) is null then
                    return 'Enter the registration number of the organisation.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_REGISTRATION_NUMBER
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation required-2 (
        name: Choose the entity type of the organisation.
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_TYPE = 'ORGANIZATION' and :P201_ENTITY_TYPE is null then
                    return 'Choose the entity type of the organisation.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_ENTITY_TYPE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation required-3 (
        name: Enter the date of birth.
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_TYPE = 'PERSON' and :P201_DATE_OF_BIRTH is null then
                    return 'Enter the date of birth.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_DATE_OF_BIRTH
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation required-4 (
        name: The date of birth cannot be in the future.
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_TYPE = 'PERSON' and to_date(:P201_DATE_OF_BIRTH) > trunc(sysdate) then
                    return 'The date of birth cannot be in the future.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_DATE_OF_BIRTH
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    validation required-5 (
        name: Choose the nationality.
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                if :P201_PARTY_TYPE = 'PERSON' and :P201_NATIONALITY is null then
                    return 'Choose the nationality.';
                end if;
                return null;
                ```
        }
        error {
            associatedItem: @P201_NATIONALITY
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT
        }
    )

    process save-request (
        name: Save counterparty
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_request_id number := to_number(:P201_REQUEST_ID);
                begin
                    -- one rule set for the page and the database: fields that do not apply to the type are cleared,
                    -- a change of type replaces the questionnaire
                    xxcmp_request_pkg.save_counterparty(
                        p_request_id            => l_request_id,
                        p_party_type            => :P201_PARTY_TYPE,
                        p_party_name            => :P201_PARTY_NAME,
                        p_registration_number   => :P201_REGISTRATION_NUMBER,
                        p_entity_type           => :P201_ENTITY_TYPE,
                        p_jurisdiction          => :P201_JURISDICTION,
                        p_date_of_birth         => to_date(:P201_DATE_OF_BIRTH),
                        p_nationality           => :P201_NATIONALITY,
                        p_requesting_department => :P201_REQUESTING_DEPARTMENT,
                        p_justification         => :P201_JUSTIFICATION);
                    :P201_REQUEST_ID := l_request_id;
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: To questionnaire
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 202
                items: {
                    P202_REQUEST_ID: &P201_REQUEST_ID.
                }
                clearCache: 202
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
