            }
            layout {
                sequence: 50
            }
        )
    )

    region attributes (
        name: Attributes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.attr_name, t.attr_type_name, t.length, t.precision, t.scale
                  from xxfnd_dm_type_attrs_v t
                 where t.application_code = :P176_APPLICATION and t.type_name = :P176_OBJECT
                 order by t.attr_no
                ```
            pageItemsToSubmit: P176_APPLICATION,P176_OBJECT
        }
        layout {
            sequence: 75
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: attributes
        }
        messages {
            whenNoDataFound: No attribute (a collection type).
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nvl(:P176_TYPE, '#') = 'TYPE'
                ```
        }

        column ATTR_NAME (
            type: plainText
            heading {
                heading: Attribute
            }
            layout {
                sequence: 10
            }
        )

        column ATTR_TYPE_NAME (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 20
            }
        )

        column LENGTH (
