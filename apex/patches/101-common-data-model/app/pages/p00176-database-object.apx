    region policies (
        name: Data Security Policies
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.policy_name, p.policy_function, p.statements
                  from xxfnd_dm_policies_v p
                 where p.application_code = :P176_APPLICATION and p.object_name = :P176_OBJECT
                 order by p.policy_name
                ```
            pageItemsToSubmit: P176_APPLICATION,P176_OBJECT
        }
        layout {
