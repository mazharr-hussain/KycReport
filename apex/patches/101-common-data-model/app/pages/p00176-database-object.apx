    region grants (
        name: Granted To
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.grantee, g.privileges
                  from xxfnd_dm_grants_v g
                 where g.application_code = :P176_APPLICATION and g.object_name = :P176_OBJECT
                 order by g.grantee
                ```
            pageItemsToSubmit: P176_APPLICATION,P176_OBJECT
        }
        layout {
            sequence: 80
            slot: BODY
        }
        appearance {
