    region routines (
        name: Procedures and Functions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lower(r.routine_name) as routine_name,
                       case when r.returns is not null then 'function' else 'procedure' end as kind,
                       r.overload, r.parameters, lower(r.returns) as returns
                  from xxfnd_dm_routines_v r
                 where r.application_code = :P176_APPLICATION and r.object_name = :P176_OBJECT
                 order by r.subprogram_id
                ```
            pageItemsToSubmit: P176_APPLICATION,P176_OBJECT
        }
        layout {
            sequence: 70
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
