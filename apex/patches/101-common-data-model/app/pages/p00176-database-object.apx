                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: routines
        }
        messages {
            whenNoDataFound: No procedure or function.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nvl(:P176_TYPE, '#') in ('PACKAGE', 'PROCEDURE', 'FUNCTION')
                ```
        }

