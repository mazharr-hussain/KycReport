    region trigger-detail (
        name: Trigger
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.table_name, lower(t.trigger_type) as trigger_type, lower(t.triggering_event) as triggering_event, t.status,
                       apex_page.get_url(p_page => 176, p_clear_cache => '176', p_items => 'P176_APPLICATION,P176_OBJECT',
                                         p_values => :P176_APPLICATION || ',' || t.table_name) as open_url
                  from xxfnd_dm_triggers_v t
                 where t.application_code = :P176_APPLICATION and t.trigger_name = :P176_OBJECT
