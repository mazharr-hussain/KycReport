            layout {
                sequence: 20
            }
        )
    )

    region uses (
        name: Uses
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.referenced_owner, d.referenced_name, lower(d.referenced_type) as referenced_type,
                       case when d.referenced_owner = d.owner then apex_page.get_url(p_page => 176, p_clear_cache => '176', p_items => 'P176_APPLICATION,P176_OBJECT',
                                         p_values => :P176_APPLICATION || ',' || d.referenced_name) end as open_url
                  from xxfnd_dm_dependencies_v d
                 where d.application_code = :P176_APPLICATION and d.name = :P176_OBJECT
                 order by d.referenced_owner, d.referenced_name
                ```
            pageItemsToSubmit: P176_APPLICATION,P176_OBJECT
        }
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: uses
        }
        messages {
            whenNoDataFound: It uses no other object.
        }

        column REFERENCED_OWNER (
            type: plainText
            heading {
                heading: Schema
            }
            layout {
                sequence: 10
            }
        )

        column REFERENCED_NAME (
            type: link
            heading {
                heading: Object
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    type: url
                    url: #OPEN_URL#
                }
                linkText: #REFERENCED_NAME#
            }
        )

        column REFERENCED_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 40
            }
        )
    )

    region used-by (
        name: Used By
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.owner, d.name, lower(d.type) as type, apex_page.get_url(p_page => 176, p_clear_cache => '176', p_items => 'P176_APPLICATION,P176_OBJECT',
                                         p_values => :P176_APPLICATION || ',' || d.name) as open_url
                  from xxfnd_dm_dependencies_v d
                 where d.application_code = :P176_APPLICATION and d.referenced_owner = (select max(o.owner) from xxfnd_dm_objects_v o
                                                                                       where o.application_code = :P176_APPLICATION
                                                                                         and o.object_name = :P176_OBJECT)
                   and d.referenced_name = :P176_OBJECT
                 order by d.name
                ```
            pageItemsToSubmit: P176_APPLICATION,P176_OBJECT
        }
        layout {
            sequence: 100
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        advanced {
            htmlDomId: used-by
        }
        messages {
            whenNoDataFound: No object of the application uses it.
        }

        column OWNER (
            type: plainText
            heading {
                heading: Schema
            }
            layout {
                sequence: 10
            }
        )

        column NAME (
            type: link
            heading {
                heading: Object
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    type: url
                    url: #OPEN_URL#
                }
                linkText: #NAME#
            }
        )

        column TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 40
            }
        )
    )
)
