app COMMON (
    name: Common
    version: 1.0.0
    logo {
        type: text
        text: &APP_TITLE.
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        usersCanChooseThemeStyle: false
        addBuiltWithApexToFooter: false
        autoDismissSuccessMessages: true
    }
    appFormatMasks {
        date: DD-MON-YYYY
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        scheme: @app-user
        runOnPublicPages: false
        sourceForRoleOrGroupSchemes: customCode
    }
    sessionManagement {
        maxSessionIdleTime: 3600
        maxSessionLength: 28800
    }
    sessionStateProtection {
        enabled: true
        checksumSalt: 29C4B123A65CB0DFF9F412D4E8AA0BA2E82573C69B40FAAFCA8B80C41D184012
    }
    security {
        embedInFrames: deny
        htmlEscapingMode: extended
    }
    runtime {
        allowFeedback: false
        logging: true
        compatibilityMode: 24.2
    }
    comments {
        comments:
            ```
            Common application (code and alias COMMON): the setup every application shares - users and access,
            flexfield and attachment setup, workflow approval flows and history. Parsing schema XXFUSION; the shared
            XXFND_ objects are installed by its Supporting Objects. Application ID is assigned on import.
            ```
    }
)

appSetting LOGIN_TYPE_ENFORCED (
    value {
        staticValue: N
        onUpgradeKeepValue: true
    }
    comments {
        comments:
            ```
            Y: users linked to an employee (SSO users) must sign in with the company account and local users with their user name / password. N (default, until single sign-on is live): any scheme.
            ```
    }
)
