    dynamicAction filter-notes (
        name: Filter notes and RFIs
        execution {
            sequence: 30
        }
        when {
            event: change
            selectionType: items
            items: P211_NOTE_FILTER
        }

        action filter-notes-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @notes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

