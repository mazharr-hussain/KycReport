            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_TYPE is null and xxcmp_case_pkg.can_assign(:P211_CASE_ID) = 'Y'
                ```
        }
