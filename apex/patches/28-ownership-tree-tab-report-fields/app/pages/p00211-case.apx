page 211 (
    name: Case
    alias: CASE
    title: Case
    pageGroup: @kyc
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // the investigation questionnaire opens ready to type (the grid toolbar with its Edit button is hidden)
            var findings = apex.region('findings');
            if (findings && findings.call('getViews', 'grid').model.getOption('editable')) {
                findings.call('getActions').set('edit', true);
            }
            ```
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The case screen: the officer works through the sections on the left (Summary, Party, Contacts and Ownership, Screening, Documents, Risk Assessment, Notes and RFIs) and submits on Review and Submit. Each section saves on its own. The party sections are the common Global Page regions. Approvers open the case from their task in review mode and decide at the top or the bottom.
            ```
    }

    region breadcrumb (
        name: Case
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region top-buttons (
        name: Case Actions
        type: staticContent
        layout {
            sequence: 15
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: top_buttons
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 990
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: kyc-actionbar
        }
        advanced {
            htmlDomId: buttons
        }
    )

    region section-nav (
        name: Sections
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_case_pkg.nav_html(:P211_CASE_ID, :P211_SECTION, :P211_TASK_ID);
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
                P211_SECTION
                P211_TASK_ID
            ]
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_02
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_sections
        }
    )

    region case-history (
        name: Approval History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rownum as seq, h.step_no, h.step_name, h.assigned_to, h.action, h.action_by,
                       to_char(h.action_date, 'DD-MON-YYYY HH24:MI') as action_date, h.comments
                  from table(xxcmp_approval_pkg.case_history_rows(to_number(:P211_CASE_ID))) h
                 order by seq
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 95
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_history
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('REVIEW')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No history yet.
        }

        column SEQ (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column STEP_NAME (
            type: plainText
            heading {
                heading: Step
            }
            layout {
                sequence: 20
            }
        )

        column ASSIGNED_TO (
            type: plainText
            heading {
                heading: Approver
            }
            layout {
                sequence: 30
            }
        )

        column ACTION (
            type: plainText
            heading {
                heading: Action / Status
            }
            layout {
                sequence: 40
            }
        )

        column ACTION_BY (
            type: plainText
            heading {
                heading: By
            }
            layout {
                sequence: 50
            }
        )

        column ACTION_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 60
            }
        )

        column COMMENTS (
            type: plainText
            heading {
                heading: Comments
            }
            layout {
                sequence: 70
            }
        )

        column STEP_NO (
            type: hidden
            layout {
                sequence: 80
            }
        )

    )

    region case-decision (
        name: Decision
        type: staticContent
        layout {
            sequence: 96
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_decision
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL' and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve) or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )

    region decision-buttons (
        name: Decision Buttons
        type: staticContent
        layout {
            sequence: 989
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: kyc-actionbar
        }
        advanced {
            htmlDomId: decision_buttons
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL' and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve) or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )

    region case (
        name: &P211_SECTION_LABEL.
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_CASES
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        advanced {
            htmlDomId: case
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N' or :P211_SECTION = 'REVIEW'
                ```
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                -- release 29: the form keeps the case keys on Summary / Risk / Review; its fields show only in an editable Risk
                -- Assessment (the summary grid shows the rest) and the region hides itself without visible fields (kyc-app.css)
                :P211_SECTION in ('SUMMARY', 'RISK', 'REVIEW')
                ```
        }
    )

    region case-header (
        name: Case Header
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return '<div class="kyc-hcard">' || xxcmp_request_ui_pkg.case_header_html(to_number(:P211_CASE_ID)) || '</div>';
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
            ]
        }
        layout {
            sequence: 1
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_header
        }
    )

    region case-summary (
        name: &P211_SECTION_LABEL.
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_request_ui_pkg.case_summary_html(to_number(:P211_CASE_ID), to_number(:P211_TASK_ID));
                ```
            pageItemsToSubmit: [
                P211_CASE_ID
                P211_TASK_ID
            ]
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: case_summary
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('SUMMARY', 'REVIEW') or (:P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N')
                ```
        }
    )

    pageItem P211_SECTION (
        type: hidden
        layout {
            sequence: 5
            region: @buttons
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        comments {
            comments: The section shown (codes in XXCMP_CASE_PKG.C_SECTIONS). Approvers (CASE_APPROVAL task) always see REVIEW.
        }
    )

    pageItem P211_SECTION_LABEL (
        type: hidden
        layout {
            sequence: 6
            region: @buttons
            slot: regionBody
        }
    )

    pageItem P211_NEXT_SECTION (
        type: hidden
        layout {
            sequence: 7
            region: @buttons
            slot: regionBody
        }
    )

    pageItem P211_TASK_TYPE (
        type: hidden
        layout {
            sequence: 8
            region: @buttons
            slot: regionBody
        }
        comments {
            comments: CASE_APPROVAL when an approver opened the case from the task: review mode with the decision.
        }
    )

    pageItem P211_CASE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: CASE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P211_TASK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @case
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P211_PARTY_ID (
        type: hidden
        layout {
            sequence: 3
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: PARTY_ID
            dataType: number
        }
    )

    pageItem P211_WORKFLOW_ID (
        type: hidden
        layout {
            sequence: 4
            region: @case
            slot: regionBody
        }
        source {
            formRegion: @case
            column: WORKFLOW_ID
            dataType: number
        }
    )

    pageItem P211_CASE_NUMBER (
        type: displayOnly
        label {
            label: Case
            alignment: left
        }
        layout {
            sequence: 10
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: CASE_NUMBER
            dataType: varchar2
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )
    pageItem P211_PARTY (
        type: displayOnly
        label {
            label: Party
            alignment: left
        }
        layout {
            sequence: 20
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.party_number || ' - ' || p.party_name
                       || nvl2(p.jurisdiction, ' (' || xxfnd_util_pkg.lookup_meaning('JURISDICTION', p.jurisdiction) || ')', null)
                  from xxcmp_cases c join xxcmp_parties p on p.party_id = c.party_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 30
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select xxfnd_util_pkg.lookup_meaning('CASE_STATUS', case_status)
                       || case when case_status = 'PENDING_APPROVAL' then ' (level ' || current_level || ')' end
                       || nvl2(closed_date, ' - closed ' || to_char(closed_date, 'DD-Mon-YYYY'), null)
                  from xxcmp_cases where case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_SLA (
        type: displayOnly
        label {
            label: SLA Due
            alignment: left
        }
        layout {
            sequence: 40
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(sla_due_date, 'DD-Mon-YYYY')
                       || case when closed_date is null and sla_due_date < trunc(sysdate) then ' - OVERDUE' end
                  from xxcmp_cases where case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_REQUEST (
        type: displayOnly
        label {
            label: Request
            alignment: left
        }
        layout {
            sequence: 50
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select r.request_number || ' - '
                       || xxfnd_util_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type)
                       || ' - intake score ' || nvl(to_char(r.intake_score), '-') || ' (reference only)'
                  from xxcmp_cases c join xxcmp_requests r on r.request_id = c.request_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )

    pageItem P211_ASSIGNED_TO (
        type: selectList
        label {
            label: Assigned To
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct e.full_name || ' (' || ur.user_name || ')' as display_value, ur.user_name as return_value
                  from xxfnd_user_roles_v ur
                  join xxfnd_employees e on e.user_name = ur.user_name
                 where ur.role_code in ('COMPLIANCE_OFFICER','COMPLIANCE_MANAGER','HEAD_OF_COMPLIANCE') and ur.active_flag = 'Y'
                 order by 1
                ```
            displayNullValue: true
            nullDisplayValue: - Unassigned -
        }
        layout {
            sequence: 60
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @case
            column: ASSIGNED_TO
            dataType: varchar2
        }
        help {
            helpText: The investigating officer. A manager can reassign the case.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                1 = 0   -- release 29: shown in the case header and summary grid
                ```
        }
    )
    pageItem P211_RISK_TIER (
        type: selectList
        label {
            label: Risk Classification
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value from xxfnd_lookup_values
                 where lookup_type = 'RISK_TIER' and enabled_flag = 'Y' order by display_sequence
                ```
            displayNullValue: true
            nullDisplayValue: - Not classified -
        }
        layout {
            sequence: 70
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @case
            column: RISK_TIER
            dataType: varchar2
        }
        help {
            helpText: Your own judgement from everything found in the investigation. The intake score is reference only.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    pageItem P211_DUE_DILIGENCE_TYPE (
        type: selectList
        label {
            label: Due Diligence Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value from xxfnd_lookup_values
                 where lookup_type = 'DUE_DILIGENCE_TYPE' and enabled_flag = 'Y' order by display_sequence
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @case
            column: DUE_DILIGENCE_TYPE
            dataType: varchar2
        }
        help {
            helpText: Simplified, Standard or Enhanced KYC. A confirmed screening match or a PEP flag sets Enhanced; Enhanced KYC needs two approval levels and the source of funds and wealth answers.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    pageItem P211_PEP_FLAG (
        type: displayOnly
        label {
            label: PEP
            alignment: left
        }
        layout {
            sequence: 90
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: PEP_FLAG
            dataType: varchar2
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    pageItem P211_NEXT_REVIEW_DATE (
        type: displayOnly
        label {
            label: Next Review
            alignment: left
        }
        layout {
            sequence: 100
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: NEXT_REVIEW_DATE
            dataType: date
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    pageItem P211_CONDITIONS (
        type: displayOnly
        label {
            label: Conditions
            alignment: left
        }
        layout {
            sequence: 110
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        source {
            formRegion: @case
            column: CONDITIONS
            dataType: varchar2
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    pageItem P211_REPORT_CONCLUSION (
        type: textarea
        label {
            label: Report Conclusion
            alignment: left
        }
        layout {
            sequence: 112
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        settings {
            resizable: true
            autoHeight: true
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @case
            column: REPORT_CONCLUSION
            dataType: varchar2
        }
        help {
            helpText: The conclusion of the KYC report (what was checked and found). Required to submit for approval.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    pageItem P211_NEXT_STEPS (
        type: textarea
        label {
            label: Next Steps
            alignment: left
        }
        layout {
            sequence: 114
            region: @case
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        settings {
            resizable: true
            autoHeight: true
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @case
            column: NEXT_STEPS
            dataType: varchar2
        }
        help {
            helpText: What follows the KYC, e.g. on-going monitoring applied. Required to submit for approval.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION = 'RISK' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y'
                ```
        }
    )
    region findings (
        name: Investigation Questionnaire
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.answer_id,
                       a.question_id,
                       (select q.section_name from xxcmp_questions q where q.question_id = a.question_id) as section_name,
                       (select q.question_text from xxcmp_questions q where q.question_id = a.question_id) as question_text,
                       a.answer_option_id,
                       a.answer_text
                  from xxcmp_request_answers a
                 where a.case_id = :P211_CASE_ID
                   and a.respondent_type = 'OFFICER'
                   -- the Enhanced Due Diligence questions only when the case is Enhanced KYC
                   and (nvl((select q.section_name from xxcmp_questions q where q.question_id = a.question_id), '#') <> 'Enhanced Due Diligence'
                        or (select c.enhanced_kyc_flag from xxcmp_cases c where c.case_id = a.case_id) = 'Y')
                 order by (select q.display_sequence from xxcmp_questions q where q.question_id = a.question_id)
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: findings
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: No investigation questions are configured.
        }
        toolbar {
            show: false
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @SECTION_NAME
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @QUESTION_TEXT
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ANSWER_OPTION_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ANSWER_TEXT
                layout {
                    sequence: 4
                }
            )
        )
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'N' or :P211_SECTION = 'REVIEW'
                ```
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_SECTION in ('RISK', 'REVIEW')
                ```
        }

        column ANSWER_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_ID
                dataType: number
                primaryKey: true
            }
        )

        column QUESTION_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_ID
                dataType: number
            }
        )

        column SECTION_NAME (
            type: displayOnly
            heading {
                heading: Section
            }
            layout {
                sequence: 30
            }
            source {
                type: databaseColumn
                databaseColumn: SECTION_NAME
                dataType: varchar2
                queryOnly: true
            }
        )

        column QUESTION_TEXT (
            type: displayOnly
            heading {
                heading: Question
            }
            layout {
                sequence: 40
            }
            source {
                type: databaseColumn
                databaseColumn: QUESTION_TEXT
                dataType: varchar2
                queryOnly: true
            }
        )

        column ANSWER_OPTION_ID (
            type: selectList
            heading {
                heading: Choice
            }
            layout {
                sequence: 50
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                      from xxcmp_answer_options o
                      join xxcmp_questions q on q.question_id = o.question_id
                      join xxcmp_questionnaires qn on qn.questionnaire_code = q.questionnaire_code
                     where qn.audience = 'OFFICER' and o.enabled_flag = 'Y'
                    ```
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select answer_label as display_value, answer_option_id as return_value
                      from xxcmp_answer_options
                     where question_id = :QUESTION_ID and approval_status = 'APPROVED' and enabled_flag = 'Y'
                     order by display_sequence
                    ```
                displayNullValue: true
                nullDisplayValue: -
            }
            cascadingLov {
                parentColumns: QUESTION_ID
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_OPTION_ID
                dataType: number
            }
        )

        column ANSWER_TEXT (
            type: textarea
            heading {
                heading: Answer
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                type: databaseColumn
                databaseColumn: ANSWER_TEXT
                dataType: varchar2
            }
        )

    )

    region screenings (
        name: Screenings
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.screening_id,
                       xxfnd_util_pkg.lookup_meaning('SCREENING_TYPE', s.screening_type) as screening_type,
                       p.party_name,
                       xxfnd_util_pkg.lookup_meaning('SCREENING_MATCH_STATUS', s.match_status) as match_status,
                       xxfnd_util_pkg.lookup_meaning('RISK_TIER', s.risk_tier) as risk_tier,
                       rtrim(case when s.pep_flag = 'Y' then 'PEP, ' end || case when s.sanctions_flag = 'Y' then 'Sanctions, ' end
                             || case when s.adverse_media_flag = 'Y' then 'Adverse media, ' end, ', ') as flags,
                       s.capture_method, s.screened_date, s.result_notes,
                       apex_page.get_url(p_page => 213, p_items => 'P213_SCREENING_ID,P213_CASE_ID', p_values => to_char(s.screening_id) || ',' || :P211_CASE_ID, p_clear_cache => '213') as open_url
                  from xxcmp_screenings s
                  join xxcmp_parties p on p.party_id = s.party_id
                 where s.case_id = :P211_CASE_ID
                 order by s.screened_date desc, s.screening_id desc
                ```
            pageItemsToSubmit: P211_CASE_ID
        }
        layout {
            sequence: 40
            slot: BODY
