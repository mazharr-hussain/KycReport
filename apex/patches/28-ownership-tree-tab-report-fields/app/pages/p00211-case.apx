    button open-assign (
        buttonName: OPEN_ASSIGN
        label: Assign
        layout {
            sequence: 1
            region: @top-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-user
            cssClasses: kyc-open-assign_dialog
        }
