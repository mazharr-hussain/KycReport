    validation decision-reject-reason (
        name: Reason for rejection
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_DEC_COMMENT is null then 'Enter why the case is rejected.' end;
                ```
        }
        error {
            associatedItem: @P211_DEC_COMMENT
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT,REJECT_TOP
        }
    )

    validation decision-sar (
        name: SAR determination
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P211_DEC_SAR_GATE = 'Y' and :P211_DEC_SAR_REQUIRED_FLAG is null then 'Record whether a Suspicious Activity Report is required.' end;
                ```
        }
        error {
            associatedItem: @P211_DEC_SAR_REQUIRED_FLAG
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process save-decision-data (
        name: Save SAR, conditions and review date
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                update xxcmp_cases
                   set sar_required_flag = :P211_DEC_SAR_REQUIRED_FLAG,
                       sar_notes         = :P211_DEC_SAR_NOTES,
                       conditions        = :P211_DEC_CONDITIONS,
                       next_review_date  = to_date(:P211_DEC_NEXT_REVIEW_DATE, 'DD-MON-YYYY')
                 where case_id = :P211_CASE_ID;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP,REJECT,REJECT_TOP
        }
    )

    process check-approval (
        name: Check the case can be approved
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_error varchar2(4000) := xxcmp_case_pkg.approval_error(:P211_CASE_ID);
                begin
                    if l_error is not null then
                        raise_application_error(-20615, l_error);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 15
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process add-decision-comment (
        name: Record comment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.add_task_comment(p_task_id => :P211_TASK_ID, p_text => :P211_DEC_COMMENT);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P211_DEC_COMMENT
        }
    )

    process approve-task (
        name: Approve
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.approve_task(p_task_id => :P211_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Case approved at this level.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,APPROVE_TOP
        }
    )

    process reject-task (
        name: Reject
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                apex_human_task.reject_task(p_task_id => :P211_TASK_ID, p_autoclaim => true);
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        successMessage {
            successMessage: Case rejected.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REJECT,REJECT_TOP
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @decision-buttons
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Reject this case?
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )


    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 30
            region: @decision-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P211_TASK_ID is not null and :P211_TASK_TYPE = 'CASE_APPROVAL'
                and (apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_approve)
                     or apex_human_task.is_allowed(p_task_id => :P211_TASK_ID, p_operation => apex_human_task.c_task_op_claim))
                ```
        }
    )


    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @case
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Save case
        type: formAutoRowProcessing
        formRegion: @case
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Case saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,NEXT_SECTION,SUBMIT_APPROVAL
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process save-findings (
        name: Save questionnaire
        type: interactiveGridAutoRowProcessing
        editableRegion: @findings
        execution {
            sequence: 15
            point: processing
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process apply-screening (
        name: Enhanced KYC from screening
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.apply_screening(:P211_CASE_ID);
                ```
        }
        execution {
            sequence: 18
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,NEXT_SECTION,SUBMIT_APPROVAL
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process submit-for-approval (
        name: Submit for approval
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.submit_for_approval(:P211_CASE_ID);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Case submitted for approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit-approval
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process add-note (
        name: Add note
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                insert into xxcmp_case_notes (case_id, note_text) values (:P211_CASE_ID, :P211_NEW_NOTE);
                :P211_NEW_NOTE := null;
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        successMessage {
            successMessage: Note added.
        }
        serverSideCondition {
            whenButtonPressed: @add-note
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
