        name: Assign Case
        type: staticContent
        layout {
            sequence: 97
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: assign_dialog
        }
    )

    pageItem P211_ASSIGN_TO (
        type: selectList
        label {
            label: Officer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct e.full_name as display_value, upper(ur.user_name) as return_value
                  from xxfnd_user_roles_v ur
                  join xxfnd_employees e on upper(e.user_name) = upper(ur.user_name)
                 where ur.role_code in ('COMPLIANCE_OFFICER','COMPLIANCE_MANAGER','HEAD_OF_COMPLIANCE') and ur.active_flag = 'Y'
                 order by 1
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @assign-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P211_ASSIGN_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 20
            region: @assign-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
    )

    button assign (
        buttonName: ASSIGN
        label: Assign
        layout {
            sequence: 10
            region: @assign-dialog
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process assign-case (
        name: Assign case
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.assign(:P211_CASE_ID, :P211_ASSIGN_TO, :P211_ASSIGN_COMMENT);
                :P211_ASSIGN_TO := null;
                :P211_ASSIGN_COMMENT := null;
                ```
        }
        execution {
            sequence: 32
            point: processing
        }
        successMessage {
            successMessage: Case assigned.
        }
        serverSideCondition {
            whenButtonPressed: @assign
        }
    )

    button open-withdraw (
        buttonName: OPEN_WITHDRAW
        label: Withdraw from Approval
        layout {
            sequence: 2
            region: @top-buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: kyc-open-withdraw_dialog
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
