            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.case_number || ' - ' || p.party_name || ' (' || p.party_number || ')'
                  from xxcmp_cases c join xxcmp_parties p on p.party_id = c.party_id where c.case_id = :P211_CASE_ID
                ```
            used: always
        }
