        column SERVER_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )

        column FOLDER (
            type: plainText
            heading {
                heading: Folder
            }
            layout {
                sequence: 40
            }
        )

        column STATE (
            type: plainText
            heading {
                heading: State
            }
            layout {
                sequence: 50
            }
        )
