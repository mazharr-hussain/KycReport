    region jrn-integrations (
        name: Integrations
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 86: the application's integration purposes (journey step 9); a purpose opens the Purpose dialog (123)
                select p.purpose_code,
                       p.purpose_name,
                       case p.capture_method when 'API' then 'Automatic (API)' else 'Manual' end as capture_method,
                       p.rest_source_static_id,
                       initcap(replace(p.approval_status, '_', ' ')) as approval_status,
                       case when xxfnd_privilege_pkg.has_privilege_yn('INTEGRATIONS', 'MANAGE') = 'Y'
                            then apex_page.get_url(p_page => 123, p_items => 'P123_PURPOSE_CODE', p_values => p.purpose_code,
                                                   p_clear_cache => '123') end as edit_url
                  from xxfnd_integration_purposes p
                 where p.application_code = :P0_JRN_APP
                 order by p.purpose_name
                ```
            pageItemsToSubmit: [
                P0_JRN_APP
            ]
        }
        layout {
            sequence: 190
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: jrn-integrations
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: The application has no integration purpose yet.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P0_JRN_APP is not null and (:APP_PAGE_ID = 166 or (:APP_PAGE_ID = 165 and :P165_STEP in ('9', '10')))
                ```
        }
        comments {
            comments: Release 86 - journey section 9, shared by 165 and 166; Add / Edit open the Purpose dialog (123, which also deletes); Integrations privileges.
        }

        column PURPOSE_CODE (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PURPOSE_NAME (
            type: plainText
            heading {
                heading: Purpose
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if EDIT_URL/}<a href="#EDIT_URL#">#PURPOSE_NAME#</a>{else/}#PURPOSE_NAME#{endif/}
                    ```
            }
        )

        column CAPTURE_METHOD (
            type: plainText
            heading {
                heading: Runs
            }
            layout {
                sequence: 30
            }
        )

        column REST_SOURCE_STATIC_ID (
            type: plainText
            heading {
                heading: REST Data Source
            }
            layout {
                sequence: 40
            }
        )

        column APPROVAL_STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
        )

        column EDIT_URL (
            type: hidden
            layout {
                sequence: 60
            }
        )
    )

