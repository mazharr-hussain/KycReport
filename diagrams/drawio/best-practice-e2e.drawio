<mxfile host="app.diagrams.net" modified="2026-06-26" version="21.0.0">
  <diagram id="best-practice-e2e" name="Best Practice End-to-End Process">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="Best Practice KYC Process — End to End" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <!-- Phase 0 -->
        <mxCell id="p0" value="Phase 0 — Structured Digital Intake&#xa;Business dept completes structured form&#xa;System determines KYC Required / Not Required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 1 -->
        <mxCell id="p1" value="Phase 1 — Document Validation&#xa;Compliance officer reviews against checklist&#xa;KPI clock starts when docs confirmed complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 2 -->
        <mxCell id="p2" value="Phase 2 — Risk Pre-Assessment&#xa;System computes geographic, entity type, structure risk&#xa;Suggests LOW / MEDIUM / HIGH — officer confirms or overrides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 3 -->
        <mxCell id="p3" value="Phase 3 — Due Diligence Research&#xa;Manual WorldCheck screening&#xa;Structured results recorded per entity + per UBO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 4 -->
        <mxCell id="p4" value="Phase 4 — Entity Record Creation&#xa;Auto-populated from intake form&#xa;Duplicate check — Jaro-Winkler fuzzy matching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 5 -->
        <mxCell id="p5" value="Phase 5 — KYC Report Creation&#xa;Auto-populated from entity record&#xa;Conclusion templates | SLA indicator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 6 -->
        <mxCell id="p6" value="Phase 6 — Level 1 Approval&#xa;Approve / RFI / Reject&#xa;Delegation pre-configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="800" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Risk split -->
        <mxCell id="risk_split" value="Risk Level?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="920" width="220" height="80" as="geometry" />
        </mxCell>
        <!-- Phase 7 -->
        <mxCell id="p7" value="Phase 7 — Level 2 / MLRO Approval&#xa;SAR Gate (mandatory)&#xa;Approve / RFI / Reject / SAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1060" width="400" height="70" as="geometry" />
        </mxCell>
        <!-- Phase 8 -->
        <mxCell id="p8" value="Phase 8 — Completion&#xa;Auto PDF | Notify requestor | Seal record&#xa;Set next review date | Ongoing monitoring alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#E65100;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1200" width="400" height="70" as="geometry" />
