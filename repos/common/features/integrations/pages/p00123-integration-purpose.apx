page 123 (
    name: Integration Purpose
    alias: INTEGRATION-PURPOSE
    title: Integration Purpose
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Maker-checker controlled: saving an approved purpose sends it back for approval. The one purpose form: opened
            from the Purposes tab, and from the application journey with the application preset (P123_APPLICATION_CODE).
            ```
    }

    region form (
        name: Integration Purpose
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXFND_INTEGRATION_PURPOSES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P123_PURPOSE_CODE (
        type: textField
        label {
            label: Purpose Code
            alignment: left
        }
        layout {
            sequence: 1
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @form
            column: PURPOSE_CODE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P123_SAVED = 'Y'
                ```
        }
        help {
            inlineHelpText: Upper case, no spaces. Cannot be changed once saved.
        }
    )

    pageItem P123_SAVED (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process set-saved (
        name: Detect existing record
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                select case when count(*) > 0 then 'Y' end
                  into :P123_SAVED
                  from XXFND_INTEGRATION_PURPOSES
                 where PURPOSE_CODE = :P123_PURPOSE_CODE;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    pageItem P123_PURPOSE_NAME (
        type: textField
        label {
            label: Purpose
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @form
            column: PURPOSE_NAME
            dataType: varchar2
        }
        help {
            helpText: Enter the purpose.
        }
    )

    pageItem P123_APPLICATION_CODE (
        type: selectList
        label {
            label: Application
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-applications
            displayNullValue: true
            nullDisplayValue: Workspace (all applications)
        }
        layout {
            sequence: 15
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :G_ADMIN_LOCK = 'Y'   -- release 73: delegated - the application that opened the screen
                ```
        }
        source {
            formRegion: @form
            column: APPLICATION_CODE
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nullif(:G_ADMIN_APP, 'ALL')
                ```
        }
        help {
            inlineHelpText: The setup type decides which applications, and whether the workspace (all applications), may be chosen.
        }
    )

    pageItem P123_CAPTURE_METHOD (
        type: selectList
        label {
            label: Capture Method
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-capture-method
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: CAPTURE_METHOD
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MANUAL
        }
        help {
            helpText: Choose the capture Method.
        }
    )

    pageItem P123_CATALOG_SERVICE_ID (
        type: selectList
        label {
            label: Catalog Service
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cs.catalog_name || ' - ' || cs.service_name || ' (' || cs.url_endpoint || ')' as display_value,
                       cs.service_id as return_value
                  from apex_rest_catalog_services cs
                 order by 1
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 38
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: CATALOG_SERVICE_ID
            dataType: number
        }
        help {
            helpText: The REST Source Catalog service (Workspace Utilities) whose endpoint the purpose calls on its server (release 110); the server's Web Credential is used, else the catalog's. When empty, the REST Data Source is used.
        }
    )

    pageItem P123_REST_SOURCE_STATIC_ID (
        type: selectList
        label {
            label: REST Data Source
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.module_name || ' (' || m.remote_server_name || ')' as display_value,
                       m.module_static_id as return_value
                  from apex_appl_web_src_modules m
                 where m.application_id = :APP_ID
                 order by m.module_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: REST_SOURCE_STATIC_ID
            dataType: varchar2
        }
        help {
            helpText: The REST Data Source of COMMON that serves the purpose (release 83); its server and Web Credential are kept by the workspace administrator. A purpose that runs by API needs a REST Data Source or a server.
        }
    )

    pageItem P123_SERVER_CODE (
        type: selectList
        label {
            label: Server
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select server_name || ' (' || server_type_name || ')' as display_value, server_code as return_value
                  from xxfnd_servers_v
                 where usage = 'INTEGRATION' or server_code = :P123_SERVER_CODE
                 order by server_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 35
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: SERVER_CODE
            dataType: varchar2
        }
        help {
            helpText: The workspace server (Servers tab) the purpose uses (release 86). A purpose that runs by API needs a server or a REST Data Source.
        }
    )

    pageItem P123_APPROVAL_STATUS (
        type: selectList
        label {
            label: Approval Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-approval-status
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: APPROVAL_STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        readOnly {
            type: always
        }
        help {
            helpText: Choose the approval Status.
        }
    )

    pageItem P123_CHANGE_REASON (
        type: textField
        label {
            label: Reason for Change
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Recorded in the audit log with this change.
        }
    )

    process set-change-reason (
        name: Set change reason
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_audit_pkg.set_change_reason(:P123_CHANGE_REASON);
                ```
        }
        execution {
            sequence: 1
            point: processing
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P123_SAVED
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P123_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P123_SAVED
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-purpose (
        name: Save the purpose
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 86: saved by the integration package (no DML in the page); the maker-checker trigger applies
                xxfnd_integration_pkg.save_purpose(
                    p_purpose_code          => :P123_PURPOSE_CODE,
                    p_purpose_name          => :P123_PURPOSE_NAME,
                    p_application_code      => :P123_APPLICATION_CODE,
                    p_capture_method        => :P123_CAPTURE_METHOD,
                    p_server_code           => :P123_SERVER_CODE,
                    p_rest_source_static_id => :P123_REST_SOURCE_STATIC_ID,
                    p_catalog_service_id    => :P123_CATALOG_SERVICE_ID,
                    p_new                   => case when :REQUEST = 'CREATE' then 'Y' else 'N' end);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process delete-purpose (
        name: Delete the purpose
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_integration_pkg.delete_purpose(:P123_PURPOSE_CODE);
                ```
        }
        execution {
            sequence: 15
            point: processing
        }
        successMessage {
            successMessage: Purpose deleted.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    button submit-approval (
        buttonName: SUBMIT_APPROVAL
        label: Submit for Approval
        layout {
            sequence: 35
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P123_APPROVAL_STATUS in ('DRAFT','REJECTED')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    process submit-for-approval (
        name: Submit for approval
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxfnd_approval_pkg.request('XXFND_INTEGRATION_PURPOSES', :P123_PURPOSE_CODE);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Submitted for approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit-approval
        }
        security {
            authorizationScheme: @page-submit
        }
    )

    process close-dialog-submitted (
        name: Close Dialog after submit
        type: closeDialog
        execution {
            sequence: 95
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SUBMIT_APPROVAL
        }
    )

)
