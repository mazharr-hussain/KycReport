
lov lov-categories (
    name: DOCUMENT CATEGORIES
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select category_name as display_value, category_code as return_value
              from xxfnd_document_categories_vl
             where enabled_flag = 'Y'
             order by category_name
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov lov-doc-datatype (
    name: DOC_DATATYPE
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select meaning as display_value,
                   lookup_code as return_value
              from xxfnd_lookup_values_vl
             where lookup_type = 'DOC_DATATYPE'
               and active_flag = 'Y'
             order by display_sequence, meaning
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov lov-entities (
    name: DOCUMENT ENTITIES
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select user_entity_name || ' (' || entity_name || ')' as display_value, entity_name as return_value
              from xxfnd_document_entities_vl
             order by user_entity_name
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
