
lov lov-dm-applications (
    name: DM_APPLICATIONS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 123 (I-3B2): the applications of the data model (pages 175 and 177 share it)
            select a.application_name || ' (' || a.application_code || ')' as display_value,
                   a.application_code as return_value
              from xxfnd_dm_apps_v a
             order by 1
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
