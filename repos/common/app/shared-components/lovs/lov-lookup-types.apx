
lov lov-lookup-types (
    name: LOOKUP TYPES
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select meaning || ' (' || lookup_type || ')' as display_value, lookup_type as return_value
              from xxfnd_lookup_types
             order by lookup_type
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
