
authorization page-view (
    name: Page - View
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- the rule is in the database: XXFND_USER_PKG.AUTHORIZED
            return xxfnd_user_pkg.authorized('PAGE_VIEW');
            ```
    }
    error {
        errorMessage: You do not have access to this page.
    }
    advanced {
        evaluationType: perPageView
    }
)
