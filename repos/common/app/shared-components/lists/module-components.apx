list module-components (
    name: Menu Group Entries
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- release 111: the entries of the menu group on page 100 that the user sees (the menu of the application
            -- the page is used from, XXFND_NAV_MENU_V): a page opens it, a group opens page 100 for that group
            select null          as lvl,
                   label,
                   target,
                   'NO'          as is_current,
                   image,
                   null          as image_attribute,
                   null          as image_alt,
                   description   as a01
              from xxfnd_nav_menu_v
             where parent_code = :P100_GROUP
               and target_type not in ('USER_MENU', 'SEPARATOR', 'SIGN_OUT')
             order by sort_path
            ```
    }
)
