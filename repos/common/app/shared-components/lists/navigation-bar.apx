list navigation-bar (
    name: Navigation Bar
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lvl, label, target, is_current, image, image_attribute, image_alt, a01, a02
              -- release 105: the navigation bar of every application, COMMON included, kept in COMMON's menu registry
              -- (menu TOP_BAR: Notifications with its badge, Give Feedback, the user menu with Sign Out)
              from table(xxfnd_nav_pkg.nav_menu('TOP_BAR'))
             order by sort_path
            ```
    }
    comments {
        comments: Release 105 - master list: the navigation bar comes from XXFND_NAV_PKG.NAV_MENU('TOP_BAR') (A01 = badge, A02 = class), managed on the Application Menu screen like the side menu.
    }
)
