    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P192_OBJECT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @buttons
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button run-now (
        buttonName: RUN_NOW
        label: Run Now
        layout {
            sequence: 10
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                exists (select 1 from xxfnd_fi_objects where object_id = :P192_OBJECT_ID and status_code = 'ACTIVE' and mode_code = 'REPLICA')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button check (
        buttonName: CHECK
        label: Check Metadata
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                exists (select 1 from xxfnd_fi_objects where object_id = :P192_OBJECT_ID and status_code <> 'RETIRED')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button pause (
        buttonName: PAUSE
        label: Pause
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                exists (select 1 from xxfnd_fi_objects where object_id = :P192_OBJECT_ID and status_code = 'ACTIVE')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button resume (
        buttonName: RESUME
        label: Resume
        layout {
            sequence: 40
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                exists (select 1 from xxfnd_fi_objects where object_id = :P192_OBJECT_ID and status_code = 'PAUSED')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button continue (
        buttonName: CONTINUE
        label: Continue Onboarding
        layout {
            sequence: 50
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 191
                items: {
                    P191_OBJECT_ID: &P192_OBJECT_ID.
                    P191_STEP: 2
                }
                clearCache: 191
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                exists (select 1 from xxfnd_fi_objects where object_id = :P192_OBJECT_ID and status_code = 'DRAFT')
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button retire (
        buttonName: RETIRE
        label: Retire
        layout {
            sequence: 60
            region: @buttons
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Retire this object? It stops running; its tables and business view are kept.
            style: warning
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                exists (select 1 from xxfnd_fi_objects where object_id = :P192_OBJECT_ID and status_code <> 'RETIRED')
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    process actions (
        name: Object actions
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                -- release 107: through the registry, runtime and drift packages (no DML in the page)
                declare
                    l_n number;
                begin
                    case :REQUEST
                        when 'RUN_NOW' then xxfnd_fi_run_pkg.run_object(to_number(:P192_OBJECT_ID));
                        when 'CHECK'   then l_n := xxfnd_fi_drift_pkg.check_object(to_number(:P192_OBJECT_ID));
                        when 'PAUSE'   then xxfnd_fi_registry_pkg.pause(to_number(:P192_OBJECT_ID));
                        when 'RESUME'  then xxfnd_fi_registry_pkg.resume(to_number(:P192_OBJECT_ID));
                        when 'RETIRE'  then xxfnd_fi_registry_pkg.retire(to_number(:P192_OBJECT_ID));
                    end case;
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Done.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: RUN_NOW,CHECK,PAUSE,RESUME,RETIRE
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    branch (
        name: Stay on the object
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 192
            }
        }
    )

)
