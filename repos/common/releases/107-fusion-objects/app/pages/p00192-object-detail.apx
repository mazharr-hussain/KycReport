page 192 (
    name: Object Detail
    alias: OBJECT-DETAIL
    title: Fusion Object
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            One onboarded Fusion object: its mode, schedule and status, the business view the applications read, its attributes, metadata versions, drift and runs.
            Run Now runs a replica at once; Check Metadata compares the live Fusion metadata with the registry; Pause / Resume / Retire change its status.
            ```
    }

    region breadcrumb (
        name: Fusion Object
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Object
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.business_name, o.object_code, o.source_type, o.source_name, o.offering_code,
                       decode(o.mode_code, 'REPLICA', 'Replica', 'REALTIME', 'Real-time', 'PUSH', 'Push') as mode_name,
                       initcap(o.status_code) as status, o.schedule_minutes, o.business_view, o.replica_table, o.current_version,
                       o.bicc_job_id, o.storage_server_code, o.storage_bucket, o.storage_prefix,
                       o.last_sync_date, initcap(o.last_status) as last_status, o.last_message, o.next_run_date
                  from xxfnd_fi_objects o
                 where o.object_id = :P192_OBJECT_ID
                ```
            pageItemsToSubmit: [
                P192_OBJECT_ID
            ]
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: header
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: The object does not exist.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
            ]
        }

        column BUSINESS_NAME (
            type: plainText
            heading {
                heading: Object
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column OBJECT_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column SOURCE_TYPE (
            type: plainText
