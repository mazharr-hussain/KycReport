page 194 (
    name: Run Log
    alias: RUN-LOG
    title: Run Log
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Every run of the onboarded Fusion objects: BICC extract (the job request) and load (Object Storage), REST replica pulls and metadata checks, with the rows loaded, merged and deleted. The HTTP calls are on the Transmission Log.
            ```
    }

    region breadcrumb (
        name: Run Log
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Runs
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.run_id, o.business_name, o.object_code, initcap(r.run_type) as run_type, initcap(r.status_code) as status,
                       r.started_date, r.ended_date, r.bicc_request_id, r.rows_loaded, r.rows_merged, r.rows_deleted, r.message,
                       apex_page.get_url(p_page => 192, p_items => 'P192_OBJECT_ID', p_values => o.object_id, p_clear_cache => '192') as open_url
                  from xxfnd_fi_runs r
                  join xxfnd_fi_objects o on o.object_id = r.object_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No run yet.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
            ]
        }

        column BUSINESS_NAME (
            type: plainText
            heading {
                heading: Object
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#BUSINESS_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column OBJECT_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column RUN_TYPE (
            type: plainText
            heading {
                heading: Run
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column STARTED_DATE (
            type: plainText
            heading {
                heading: Started
            }
            layout {
                sequence: 50
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column ENDED_DATE (
            type: plainText
            heading {
                heading: Ended
            }
            layout {
                sequence: 60
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column BICC_REQUEST_ID (
            type: plainText
            heading {
                heading: BICC Request
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column ROWS_LOADED (
            type: plainText
            heading {
                heading: Loaded
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
        )

        column ROWS_MERGED (
            type: plainText
            heading {
                heading: Merged
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
        )

        column ROWS_DELETED (
            type: plainText
            heading {
                heading: Deleted
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
        )

        column MESSAGE (
            type: plainText
            heading {
                heading: Message
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
        )

        column RUN_ID (
            type: hidden
            heading {
                heading: Run ID
            }
            layout {
                sequence: 120
            }
            source {
                dataType: NUMBER
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
        )

    )

)
