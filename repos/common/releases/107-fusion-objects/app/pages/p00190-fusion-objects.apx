page 190 (
    name: Fusion Objects
    alias: FUSION-OBJECTS
    title: Fusion Objects
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            The Fusion BICC view objects and REST resources onboarded from live metadata: mode (replica, real-time, push), schedule, status, the business view the applications read and the last sync. Onboard Object adds one; a row opens it.
            ```
    }

    region breadcrumb (
        name: Fusion Objects
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region report (
        name: Fusion Objects
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.object_id, o.object_code, o.business_name, o.source_type, o.source_name,
                       decode(o.mode_code, 'REPLICA', 'Replica', 'REALTIME', 'Real-time', 'PUSH', 'Push') as mode_name,
                       initcap(o.status_code) as status, o.schedule_minutes, o.business_view, o.current_version,
                       o.last_sync_date, initcap(o.last_status) as last_status, o.next_run_date,
                       (select count(*) from xxfnd_fi_drift d where d.object_id = o.object_id and d.status_code = 'PENDING') as pending_drift,
                       -- release 107: an onboarded Fusion object; a row opens its detail (192)
                       apex_page.get_url(p_page => 192, p_items => 'P192_OBJECT_ID', p_values => o.object_id, p_clear_cache => '192') as open_url
                  from xxfnd_fi_objects o
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No Fusion object is onboarded yet: Onboard Object starts.
        }
        searchBar {
            includeSearchBar: true
        }
        download {
            formats: [
                csv
            ]
        }

        column BUSINESS_NAME (
            type: plainText
            heading {
                heading: Object
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#OPEN_URL#">#BUSINESS_NAME#</a>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column OBJECT_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column SOURCE_TYPE (
            type: plainText
            heading {
                heading: Source
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column SOURCE_NAME (
            type: plainText
            heading {
                heading: Fusion Name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column MODE_NAME (
            type: plainText
            heading {
                heading: Mode
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column SCHEDULE_MINUTES (
            type: plainText
            heading {
                heading: Every (Minutes)
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )

        column BUSINESS_VIEW (
            type: plainText
            heading {
                heading: Business View
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column CURRENT_VERSION (
            type: plainText
            heading {
                heading: Version
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
        )

        column LAST_SYNC_DATE (
            type: plainText
            heading {
                heading: Last Sync
            }
            layout {
                sequence: 100
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column LAST_STATUS (
            type: plainText
            heading {
                heading: Last Run
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
        )

        column NEXT_RUN_DATE (
            type: plainText
            heading {
                heading: Next Run
            }
            layout {
                sequence: 120
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column PENDING_DRIFT (
            type: plainText
            heading {
                heading: Drift Waiting
            }
            layout {
                sequence: 130
            }
            source {
                dataType: NUMBER
            }
        )

        column OBJECT_ID (
            type: hidden
            heading {
                heading: Object ID
            }
            layout {
                sequence: 140
            }
            source {
                dataType: NUMBER
            }
        )

        column OPEN_URL (
            type: hidden
            heading {
                heading: Open Url
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
        )

    )

    button onboard (
        buttonName: ONBOARD
        label: Onboard Object
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 191
                clearCache: 191
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

)
