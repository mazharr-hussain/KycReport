# The application the COMMON pipeline deploys (sourced by the scripts in this folder; KYC will have its own copy).
APP_CODE=COMMON                  # release tag prefix (common-<N>) and zip name
APP_ID=135                       # APEX application id
APP_SCHEMA=XXFUSION              # parsing schema: every object of the application
BKP_SCHEMA=XXFUSION_BKP          # backup schema of the upgrade test (created and dropped by the pipeline)
WORKSPACE=XXCUS                  # APEX workspace
CI_USER=XXCI_DEPLOY              # pipeline database user (created by bootstrap; ADMIN only for bootstrap and test users)
ZIP_NAME=COMMON-Application-APEXlang
# Tables never restored by the upgrade test: the release record must stay the old release's own
RESTORE_EXCLUDE=XXFND_SCHEMA_RELEASES
