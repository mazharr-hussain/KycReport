page 200 (
    name: KYC Requests
    alias: KYC-REQUESTS
    title: KYC Requests
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            KYC requests you may see: your own, or all of them for the Compliance team. Create Request starts a new one.
            ```
    }

    region breadcrumb (
        name: KYC Requests
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: KYC Requests
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.*,
                       xxcmp_request_pkg.status_tone(q.request_status) as stage_tone,
                       xxfnd_ui_pkg.person_name(q.pending_with) as pending_with_name,
                       xxfnd_ui_pkg.person_name(q.requester_user_name) as requester_name,
                       case when q.case_id is not null then
                           apex_page.get_url(p_page => 211, p_items => 'P211_CASE_ID', p_values => to_char(q.case_id), p_clear_cache => '211')
                       end as case_url,
                       apex_page.get_url(p_page => 205, p_items => 'P205_REQUEST_ID', p_values => to_char(q.request_id), p_clear_cache => '205') as open_url,
                       -- the requester's action by status: Edit (Draft, Information Needed; Cancel is on the edit screen),
                       -- Withdraw (waiting for approval: back to Draft)
                       -- release 105: no Edit once a case exists (its questions are answered on 206); Withdraw while Submitted
                       case when upper(q.requester_user_name) <> upper(:APP_USER) then null
                            when q.request_status in ('DRAFT', 'INFO_NEEDED', 'REJECTED') and q.case_number is null
                            then apex_page.get_url(p_page => 201, p_items => 'P201_REQUEST_ID', p_values => to_char(q.request_id), p_clear_cache => '201,202,203,204')
                            when q.request_status = 'SUBMITTED' and q.case_number is null then '#'
                       end as edit_url,
                       case when upper(q.requester_user_name) <> upper(:APP_USER) then null
                            when q.request_status in ('DRAFT', 'INFO_NEEDED', 'REJECTED') and q.case_number is null then 'Edit'
                            when q.request_status = 'SUBMITTED' and q.case_number is null then 'Withdraw'
                       end as edit
                  from (
                        select r.request_id,
                               r.request_number,
                               r.party_name,
                               xxfnd_lookup_pkg.lookup_meaning('BUSINESS_RELATIONSHIP', r.business_relationship) as business_relationship,
                               xxfnd_lookup_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type) as request_type,
                               xxcmp_request_pkg.stage(r.request_id) as stage,
                               xxcmp_request_pkg.kyc_required(r.request_id) as kyc_required,
                               xxcmp_request_pkg.pending_with(r.request_id) as pending_with,
                               r.last_action_date,
                               xxfnd_lookup_pkg.lookup_meaning('KYC_INTAKE_OUTCOME', r.intake_outcome) as intake_outcome,
                               r.intake_score,
                               coalesce(xxcmp_request_pkg.department_name(r.requesting_department_id),   -- release 96
                                        xxfnd_lookup_pkg.lookup_meaning('REQUESTING_DEPARTMENT', r.requesting_department)) as department,
                               r.requester_user_name,
                               r.request_status,
                               -- release 99: the Home tiles open the list on Open / Closed
                               case when r.request_status in ('DRAFT', 'SUBMITTED', 'UNDER_REVIEW', 'IN_APPROVAL', 'INFO_NEEDED') then 'Open' else 'Closed' end as open_closed,
                               r.submitted_date,
                               (select c.case_number from xxcmp_cases c where c.request_id = r.request_id) as case_number,
                               (select c.case_id from xxcmp_cases c where c.request_id = r.request_id) as case_id,
                               r.created_by, r.creation_date, r.last_updated_by, r.last_update_date
                          from xxcmp_requests r
                       ) q
                 order by q.request_number desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: report
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }
        download {
            formats: [
                csv
                html
                excel
            ]
        }

        column REQUEST_ID (
            type: hidden
            heading {
                heading: Request Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
                primaryKey: true
            }
        )

        column REQUEST_NUMBER (
            type: plainText
