    button create (
        buttonName: CREATE
        label: Create Request
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action refresh-report-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction withdraw (
        name: Withdraw a request
        execution {
            sequence: 30
            eventScope: dynamic
            staticContainer: #report
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: a.kyc-row-action[data-action="Withdraw"]
        }

        action withdraw-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var id = $(this.triggeringElement).data("id");
                    this.browserEvent.preventDefault();
                    apex.message.confirm("Withdraw this request from approval? It goes back to Draft: you can then edit or cancel it.", function (ok) {
                        if (!ok) { return; }
                        apex.server.process("WITHDRAW", { x01: id }, { dataType: "text" }).done(function (err) {
                            err = $.trim(err);    // the reply ends with a line break even when there is no error
                            if (err) {
                                apex.message.alert(err);
                            } else {
                                apex.message.showPageSuccess("Request withdrawn: it is back in Draft.");
                            }
                            apex.region("report").refresh();
                        });
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process withdraw (
        name: WITHDRAW
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id    number := to_number(apex_application.g_x01);
                    l_error varchar2(4000) := xxcmp_request_pkg.withdraw_error(l_id);
                begin
                    if l_error is null then
                        xxcmp_request_pkg.withdraw(l_id);
                    end if;
                    htp.p(l_error);
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )

    region new-requests (
        name: New Requests
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 105 (stage 1): the submitted requests waiting for the user's initial assessment (their open
                -- document checklist task); selected rows are assigned to one contributor (Assign)
                select r.request_id,
                       r.request_number || ' - ' || r.party_name as title,
                       coalesce(xxcmp_request_pkg.department_name(r.requesting_department_id), '-')
                       || ' · ' || nvl(xxfnd_lookup_pkg.lookup_meaning('BUSINESS_RELATIONSHIP', r.business_relationship), '-')
                       || ' · ' || nvl(xxfnd_lookup_pkg.lookup_meaning('JURISDICTION', r.requesting_country), '-') as description,
                       to_char(r.submitted_date, 'DD-MON-YYYY') as submitted,
                       r.submitted_date
                  from xxcmp_requests r
                 where to_char(r.request_id) in (
                           select t.detail_pk
                             from table(apex_human_task.get_tasks(p_context => 'MY_TASKS', p_application_id => :APP_ID)) t
                            where t.task_def_static_id = 'DOC_CHECKLIST_REVIEW' and t.state_code in ('ASSIGNED', 'UNASSIGNED'))
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: submitted_date, request_id
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: new_requests
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            description: &DESCRIPTION.
            miscellaneous: &SUBMITTED.
        }
        rowSelection {
            type: multipleSelection
            currentSelectionPageItem: P200_ASSIGN_REQUESTS
            selectAllPageItem: P200_SELECT_ALL
        }
        pagination {
            type: page
            entitiesPerPage: 50
        }
        messages {
            whenNoDataFound: No new requests.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from table(apex_human_task.get_tasks(p_context => 'MY_TASKS', p_application_id => :APP_ID))
                 where task_def_static_id = 'DOC_CHECKLIST_REVIEW' and state_code in ('ASSIGNED', 'UNASSIGNED')
                ```
        }
        comments {
            comments: Release 105 - stage 1: the requests waiting for the user's initial assessment; select and Assign gives them to one contributor (XXCMP_REQUEST_PKG.ASSIGN_REQUESTS). Native row selection (Content Row template component).
        }

        column REQUEST_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: REQUEST_ID
                dataType: number
                primaryKey: true
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

        column DESCRIPTION (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column SUBMITTED (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SUBMITTED
                dataType: varchar2
            }
        )

        column SUBMITTED_DATE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SUBMITTED_DATE
                dataType: timestamp
            }
        )

    )

    pageItem P200_ASSIGN_REQUESTS (
        type: hidden
        layout {
            sequence: 1
            region: @new-requests
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        comments {
            comments: Release 105: the selected request IDs (colon-separated), set by the row selection. XXCMP_REQUEST_PKG.ASSIGN_REQUESTS skips any request without the user's own open checklist task.
        }
    )

    pageItem P200_SELECT_ALL (
        type: checkbox
        label {
            label: Select All
            alignment: left
        }
        layout {
            sequence: 2
            region: @new-requests
            slot: regionBody
            alignment: left
        }
    )

    button open-assign (
        buttonName: OPEN_ASSIGN
        label: Assign
        layout {
            sequence: 5
            region: @new-requests
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-user
            cssClasses: kyc-open-assign_dialog
        }
        behavior {
            action: definedByDynamicAction
        }
        comments {
            comments: Release 105 - assigns the selected new requests to one contributor (XXCMP_REQUEST_PKG.ASSIGN_REQUESTS).
        }
    )

    region assign-dialog (
        name: Assign
        type: staticContent
        layout {
            sequence: 97
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: assign_dialog
        }
    )

    pageItem P200_ASSIGN_TO (
        type: selectList
        label {
            label: Contributor
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-case-officers
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @assign-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P200_ASSIGN_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 30
            region: @assign-dialog
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 1000
        }
    )

    button assign (
        buttonName: ASSIGN
        label: Assign
        layout {
            sequence: 10
            region: @assign-dialog
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation assign-selection (
        name: A request is selected
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return case when :P200_ASSIGN_REQUESTS is null then 'Select one or more new requests.' end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @assign
        }
    )

    process assign-requests (
        name: Assign the requests
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_done number;
                begin
                    -- release 105: the request package approves each checklist and gives its case to the contributor
                    l_done := xxcmp_request_pkg.assign_requests(:P200_ASSIGN_REQUESTS, :P200_ASSIGN_TO, :P200_ASSIGN_COMMENT);
                    apex_application.g_print_success_message := l_done || ' request(s) assigned.';
                    :P200_ASSIGN_REQUESTS := null;
                    :P200_ASSIGN_TO := null;
                    :P200_ASSIGN_COMMENT := null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @assign
        }
    )
)
