                layout {
                    sequence: 2
                }
            )

            displayColumn PARTY_NAME (
                layout {
                    sequence: 2
                }
            )

            displayColumn STAGE (
                layout {
                    sequence: 3
                }
            )


            displayColumn PENDING_WITH (
                layout {
                    sequence: 5
                }
            )

            displayColumn LAST_ACTION_DATE (
                layout {
