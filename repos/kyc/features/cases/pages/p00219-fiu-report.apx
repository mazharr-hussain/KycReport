page 219 (
    name: FIU Report
    alias: FIU-REPORT
    title: FIU Report (goAML)
    pageGroup: @kyc
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: A suspicious transaction or activity report to the Financial Intelligence Unit, raised from the case: prepared by the officer, approved by another Compliance manager, then filed in goAML (by hand now) with its reference and date.
    }

    region form (
        name: FIU Report (goAML)
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: XXCMP_FIU_REPORTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        advanced {
            htmlDomId: form
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P219_FIU_REPORT_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: FIU_REPORT_ID
            dataType: number
            primaryKey: true
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P219_PARTY_ID (
        type: hidden
        layout {
            sequence: 2
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: PARTY_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P219_CASE_ID (
        type: hidden
        layout {
            sequence: 3
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: CASE_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P219_REPORT_TYPE (
        type: selectList
        label {
            label: Report
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'FIU_REPORT_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: REPORT_TYPE
            dataType: varchar2
        }
    )

    pageItem P219_REPORT_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 15
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: REPORT_STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        settings {
            sendOnPageSubmit: true
        }
    )

    pageItem P219_GROUNDS (
        type: textarea
        label {
            label: Grounds for Suspicion
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @form
            column: GROUNDS
            dataType: varchar2
        }
    )

    pageItem P219_TRANSACTIONS_SUMMARY (
        type: textarea
        label {
            label: Transactions
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @form
            column: TRANSACTIONS_SUMMARY
            dataType: varchar2
        }
        help {
            helpText: The transactions or activity reported (dates, amounts, counterparties).
        }
    )

    pageItem P219_PREPARED_BY (
        type: displayOnly
        label {
            label: Prepared By
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: PREPARED_BY
            dataType: varchar2
        }
        default {
            type: item
            item: APP_USER
        }
        settings {
            sendOnPageSubmit: true
        }
    )

    pageItem P219_APPROVED_BY (
        type: displayOnly
        label {
            label: Approved By
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: APPROVED_BY
            dataType: varchar2
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    pageItem P219_GOAML_REFERENCE (
        type: textField
        label {
            label: goAML Reference
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form
            column: GOAML_REFERENCE
            dataType: varchar2
        }
        help {
            helpText: The reference the FIU returned when the report was filed in goAML (by hand now; a goAML integration later).
        }
    )

    pageItem P219_FILED_DATE (
        type: datePicker
        label {
            label: Filed On
            alignment: left
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: FILED_DATE
            dataType: date
        }
    )

    pageItem P219_NOTES (
        type: textarea
        label {
            label: Notes
            alignment: left
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @form
            column: NOTES
            dataType: varchar2
        }
    )

    pageItem P219_FILE (
        type: fileUpload
        label {
            label: Attachment
            alignment: left
        }
        layout {
            sequence: 900
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: Drop a file here
            dropzoneDesc: or click to browse
        }
        storage {
            type: appTempFiles
        }
        help {
            helpText: Optional: the copy or the extract that was checked (kept with this record).
        }
    )

    validation rules (
        name: Rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_case_pkg.fiu_report_error(:P219_CASE_ID, :P219_REPORT_TYPE, :P219_GROUNDS);
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P219_FIU_REPORT_ID is null and xxcmp_case_pkg.fiu_editable(:P219_FIU_REPORT_ID, :P219_CASE_ID) = 'Y'
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P219_FIU_REPORT_ID is not null and xxcmp_case_pkg.fiu_editable(:P219_FIU_REPORT_ID, :P219_CASE_ID) = 'Y'
                ```
        }
        security {
            authorizationScheme: @page-manage
        }
    )

    button fiu-approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 36
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P219_FIU_REPORT_ID is not null and xxcmp_case_pkg.fiu_action_allowed(:P219_FIU_REPORT_ID, 'APPROVE') = 'Y'
                ```
        }
    )

    button fiu-file (
        buttonName: FILE
        label: Record Filing
        layout {
            sequence: 37
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P219_FIU_REPORT_ID is not null and xxcmp_case_pkg.fiu_action_allowed(:P219_FIU_REPORT_ID, 'FILE') = 'Y'
                ```
        }
    )

    button fiu-cancel (
        buttonName: CANCEL_REPORT
        label: Cancel Report
        layout {
            sequence: 38
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Cancel this report?
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P219_FIU_REPORT_ID is not null and xxcmp_case_pkg.fiu_action_allowed(:P219_FIU_REPORT_ID, 'CANCEL') = 'Y'
                ```
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog-action (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process fiu-approve (
        name: Approve
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.fiu_action(:P219_FIU_REPORT_ID, 'APPROVE');
                ```
        }
        execution {
            sequence: 21
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE
        }
    )

    process fiu-file (
        name: File
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.fiu_action(:P219_FIU_REPORT_ID, 'FILE', :P219_GOAML_REFERENCE, to_date(:P219_FILED_DATE, :APP_NLS_DATE_FORMAT));
                ```
        }
        execution {
            sequence: 22
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: FILE
        }
    )

    process fiu-cancel (
        name: Cancel
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_case_pkg.fiu_action(:P219_FIU_REPORT_ID, 'CANCEL');
                ```
        }
        execution {
            sequence: 23
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CANCEL_REPORT
        }
    )

    process attach-file (
        name: Keep the attachment
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := xxfnd_attach_pkg.add_file(
                                p_entity_name    => 'XXCMP_FIU_REPORTS',
                                p_pk1_value      => :P219_FIU_REPORT_ID,
                                p_category_code  => 'OTHER',
                                p_temp_file_name => :P219_FILE,
                                p_title          => 'FIU Report (goAML)',
                                p_page_id        => 219);
                end;
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P219_FILE is not null and :REQUEST in ('CREATE', 'SAVE')
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,APPROVE,FILE,CANCEL_REPORT
        }
    )

)
