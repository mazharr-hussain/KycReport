
lov lov-qa-answer-type (
    name: QA_ANSWER_TYPE
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select meaning as display_value,
                   lookup_code as return_value
              from xxfnd_lookup_values_vl
             where lookup_type = 'QA_ANSWER_TYPE'
               and active_flag = 'Y'
             order by display_sequence, meaning
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
