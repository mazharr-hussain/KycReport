lov lov-categories (
    name: DOCUMENT CATEGORIES
    subscription {
        master: @/135/lov-categories
    }
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select category_name as display_value, category_code as return_value
              from xxfnd_document_categories_vl
             where enabled_flag = 'Y'
             order by category_name
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov lov-entities (
    name: DOCUMENT ENTITIES
    subscription {
        master: @/135/lov-entities
    }
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select user_entity_name || ' (' || entity_name || ')' as display_value, entity_name as return_value
              from xxfnd_document_entities_vl
             order by user_entity_name
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov lov-lookup-types (
    name: LOOKUP TYPES
    subscription {
        master: @/135/lov-lookup-types
    }
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select meaning || ' (' || lookup_type || ')' as display_value, lookup_type as return_value
              from xxfnd_lookup_types
             order by lookup_type
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)
