page 201 (
    name: Create Request - Counterparty
    alias: CREATE-REQUEST
    title: Create Request - Counterparty
    pageGroup: @kyc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // release 99: the risk screening answers go to P201_ANSWERS before every submit
            kycQuestionnaire.bind('screening_questions', 'P201_ANSWERS');
            ```
    }
    help {
        helpText:
            ```
            Step 1 of 3: the counterparty and the risk screening. Enter the counterparty in the party form (it is created as a party with status Pending and approved with the request; Compliance merges a duplicate later), answer the risk screening questions and press Check: the answers show whether a KYC report is required. Required: enter the business relationship type and the business justification, then Next. Not required: attach the evidence at Review and Submit and submit anyway. Save as Draft keeps the request to finish later; Cancel Request withdraws it.
            ```
    }

    region breadcrumb (
        name: Create Request
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wizard (
        name: Create Request
        type: list
        source {
            list: @request-wizard
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: wizard
        }
    )

    region request (
        name: Request
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request
        }
    )


    region screening (
        name: Risk Screening
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: screening
        }
        comments {
            comments: Release 99 (B1) - answer the questions and Check: the outcome (XXCMP_REQUEST_PKG.SCREENING_OUTCOME, the rule of the submit) shows whether a KYC report is required.
        }
    )

    region screening-questions (
        name: Screening Questions
        type: appTemplateComponent/question
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- the questionnaire form from data (as page 202): one group per question, one row per approved option of a
                -- choice question or one row for a text / number / date answer
                -- release 99: the requester questionnaire as risk screening on step 1 - the request's answer rows once it
                -- is saved, before that the questions of the questionnaire of the chosen party type
                with q as (
                    select qu.question_id, a.answer_option_id, a.answer_text, qu.answer_type, qu.required_flag,
                           qu.display_sequence,
                           nvl(tl.question_text, qu.question_text) as question_text,
                           nvl(nvl(tl.section_name, qu.section_name), 'General') as section_name
                      from xxcmp_questions qu
                      left join xxcmp_request_answers a on a.question_id = qu.question_id
                                                       and a.request_id = :P201_REQUEST_ID
                                                       and a.respondent_type = 'REQUESTER'
                      left join xxcmp_questions_tl tl on tl.question_id = qu.question_id
                                                     and tl.language_code = xxfnd_util_pkg.current_lang
                     where (:P201_REQUEST_ID is not null and a.request_id is not null)
                        or (:P201_REQUEST_ID is null and qu.enabled_flag = 'Y'
                            and qu.questionnaire_code = xxcmp_request_pkg.questionnaire_code(nvl(:P0_PARTY_TYPE, 'ORGANIZATION'))))
                select q.question_id || '-' || o.answer_option_id as row_key,
                       q.question_id as group_question_id,
                       q.answer_type as group_answer_type,
                       q.question_text,
                       case when q.required_flag = 'Y' then 'Y' end as required,
                       case when q.answer_type in ('YES_NO', 'SINGLE_SELECT', 'MULTI_SELECT') then 'Y' end as choice,
                       -- the section title on its first question; a section's questions stay together, in the order
                       -- of its first question
                       case when dense_rank() over (partition by q.section_name
                                                    order by q.display_sequence, q.question_id) = 1
                            then q.section_name end as section_title,
                       case when q.answer_type in ('YES_NO', 'SINGLE_SELECT', 'MULTI_SELECT')
                            then nvl2(o.answer_option_id, 'OPTION', null)
                            when q.answer_type in ('TEXT', 'DATE') then q.answer_type
                            else 'NUMBER' end as row_kind,
                       o.answer_option_id as option_id,
                       o.answer_label as option_label,
                       case when o.answer_option_id = q.answer_option_id then 'Y' end as checked,
                       case when q.answer_type not in ('YES_NO', 'SINGLE_SELECT', 'MULTI_SELECT') then q.answer_text end as answer_text,
                       min(q.display_sequence) over (partition by q.section_name) as section_seq,
                       q.display_sequence as question_seq,
                       o.display_sequence as option_seq
                  from q
                  left join xxcmp_answer_options o
                    on o.question_id = q.question_id
                   and q.answer_type in ('YES_NO', 'SINGLE_SELECT', 'MULTI_SELECT')
                   and o.approval_status = 'APPROVED'
                   and o.enabled_flag = 'Y'
                 order by section_seq, q.section_name, question_seq, q.question_id, option_seq, o.answer_option_id
                ```
            pageItemsToSubmit: [
                P201_REQUEST_ID
                P0_PARTY_TYPE
            ]
        }
        layout {
            sequence: 10
            parentRegion: @screening
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: screening_questions
        }
        componentAppearance {
            display: report
        }
        settings {
            rowKind: &ROW_KIND.
            questionId: &GROUP_QUESTION_ID.
            optionId: &OPTION_ID.
            optionLabel: &OPTION_LABEL.
            checked: &CHECKED.
            answerText: &ANSWER_TEXT.
            inputLabel: &QUESTION_TEXT.
        }
        plugin-question {
            groupQuestionId: &GROUP_QUESTION_ID.
            groupAnswerType: &GROUP_ANSWER_TYPE.
            questionText: &QUESTION_TEXT.
            required: &REQUIRED.
            choice: &CHOICE.
            sectionTitle: &SECTION_TITLE.
        }
        messages {
            whenNoDataFound: No questions are configured for this counterparty type.
        }
        comments {
            comments: Release 99 (B1) - the requester questionnaire (the questions of page 202, plus the ownership structure question) answered on step 1; kycQuestionnaire (kyc-app.js) collects the answers into P201_ANSWERS and XXCMP_REQUEST_PKG.SAVE_SCREENING checks and saves them.
        }

        column ROW_KEY (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ROW_KEY
                dataType: varchar2
                primaryKey: true
            }
        )

        column GROUP_QUESTION_ID (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: GROUP_QUESTION_ID
                dataType: number
            }
            appearance {
                group: true
            }
        )

        column GROUP_ANSWER_TYPE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: GROUP_ANSWER_TYPE
                dataType: varchar2
            }
        )

        column QUESTION_TEXT (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: QUESTION_TEXT
                dataType: varchar2
            }
        )

        column REQUIRED (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: REQUIRED
                dataType: varchar2
            }
        )

        column CHOICE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: CHOICE
                dataType: varchar2
            }
        )

        column SECTION_TITLE (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: SECTION_TITLE
                dataType: varchar2
            }
        )

        column ROW_KIND (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ROW_KIND
                dataType: varchar2
            }
        )

        column OPTION_ID (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: OPTION_ID
                dataType: number
            }
        )

        column OPTION_LABEL (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: OPTION_LABEL
                dataType: varchar2
            }
        )

        column CHECKED (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: CHECKED
                dataType: varchar2
            }
        )

        column ANSWER_TEXT (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: ANSWER_TEXT
                dataType: varchar2
            }
        )

        column SECTION_SEQ (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: SECTION_SEQ
                dataType: number
            }
        )

        column QUESTION_SEQ (
