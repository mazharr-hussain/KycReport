            comments: Release 99 - the intake outcome of the saved screening answers (XXCMP_REQUEST_PKG.SCREENING_OUTCOME), set when the page loads.
        }
    )

    pageItem P201_ANSWERS (
        type: hidden
        layout {
            sequence: 6
            region: @request
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by kycQuestionnaire (kyc-app.js). XXCMP_REQUEST_PKG.SAVE_SCREENING / SAVE_ANSWERS re-check every question and option on the server.
                ```
        }
    )

    pageItem P201_REQUESTING_DEPARTMENT (
        type: selectList
        label {
            label: Requesting Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select organization_name as display_value, organization_id as return_value
                  -- release 76: the departments data security allows; release 96: COMMON's departments, by ID
                  from xxhr_organizations
                 where organization_type = 'DEPARTMENT' and enabled_flag = 'Y'
                   and (xxcmp_request_pkg.allowed_departments is null
                        or to_char(organization_id) in (select column_value
                                                          from apex_string.split(xxcmp_request_pkg.allowed_departments, ',')))
                 order by organization_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select case   -- release 76: the only department data security allows, else the employee profile's
                       when xxcmp_request_pkg.allowed_departments <> '#NONE'
                                 and instr(xxcmp_request_pkg.allowed_departments, ',') = 0
                            then xxcmp_request_pkg.allowed_departments
                            else to_char(xxcmp_request_pkg.default_department) end   -- release 96: an ID
                  from dual
                ```
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.can_choose_department = 'N' and xxcmp_request_pkg.default_department is not null
                ```
        }
        help {
            helpText: The departments you may raise requests for (the departments of your requesting entity role, e.g. Requesting Entity1 = Finance), or the department of your employee profile. Level 1 approvers and Compliance can raise requests for any department.
        }
    )

    pageItem P201_BUSINESS_RELATIONSHIP (
        type: selectList
        label {
            label: Business Relationship Type
            alignment: left
        }
        layout {
            sequence: 15
            region: @relationship
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'BUSINESS_RELATIONSHIP' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        help {
            helpText: What the counterparty is to the company for this request (customer, vendor...). One relationship per request; a party that is both a customer and a vendor gets one request for each. It goes on to the case and can choose the approval path.
        }
    )

    pageItem P201_JUSTIFICATION (
        type: textarea
        label {
            label: Business Justification
            alignment: left
        }
        layout {
            sequence: 20
            region: @relationship
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 3
        }
        validation {
            maxLength: 4000
        }
        help {
            helpText: Why the organisation wants to deal with this counterparty.
        }
    )

    pageItem P201_USE_EXISTING (
        type: radioGroup
        label {
            label: Use the Existing Party
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Yes;Y,No - I will change the details;N
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                nvl(:P201_PARTY_SELECTION, 'NEW') <> 'EXISTING'
                and xxcmp_request_pkg.duplicate_party_id(to_number(:P201_REQUEST_ID), :P0_PARTY_TYPE,
                        :P0_PARTY_REGISTRATION_NUMBER, :P0_PARTY_JURISDICTION, :P0_PARTY_REGISTRATION_TYPE) is not null
                ```
        }
        help {
            helpText: Another party already has this registration type, registration number and country. Yes - the request uses that party (no new party is created). No - change the registration type, number or country.
        }
        comments {
            comments: Release 100 - shown only when the counterparty duplicates a party (XXCMP_REQUEST_PKG.DUPLICATE_PARTY_ID); XXCMP_REQUEST_PKG.REQUEST_ERROR / SAVE_REQUEST read it.
        }
    )

    pageItem P201_CONTACT_NAME (
        type: textField
        label {
            label: Contact Person
            alignment: left
        }
        layout {
            sequence: 92
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 240
        }
        help {
            helpText: Who the organisation deals with at the counterparty (or the individual).
        }
        config {
            buildOption: @request-contact
        }
    )

    pageItem P201_CONTACT_EMAIL (
        type: textField
        label {
            label: Contact Email
            alignment: left
        }
        layout {
            sequence: 94
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
        config {
            buildOption: @request-contact
        }
    )

    pageItem P201_CONTACT_PHONE (
        type: textField
        label {
            label: Contact Phone
            alignment: left
        }
        layout {
            sequence: 96
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 50
        }
        config {
            buildOption: @request-contact
        }
    )




    dynamicAction existing-or-new (
        name: Existing party or new counterparty
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_SELECTION
        }

        action existing-or-new-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // a new counterparty is entered in the common party form (Global Page region)
                    var isNew = apex.item("P201_PARTY_SELECTION").getValue() !== "EXISTING";
                    $("#party-form, #possible_matches")[isNew ? "show" : "hide"]();
                    $("#party_card")[isNew ? "hide" : "show"]();
                    apex.item("P201_PARTY_ID")[isNew ? "hide" : "show"]();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )




    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel-request (
        buttonName: CANCEL_REQUEST
        label: Cancel Request
        layout {
            sequence: 15
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-ban
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Cancel this request? It cannot be submitted afterwards.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P201_REQUEST_ID is not null and xxcmp_request_pkg.cancel_error(:P201_REQUEST_ID) is null
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save as Draft
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            executeValidations: false
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button check (
        buttonName: CHECK
        label: Check
        layout {
            sequence: 30
            region: @screening
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-check-circle-o
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: kyc-screening-next
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.outcome_kyc_required(:P201_SCREENING) is not null
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction screening-changed (
        name: Screening answer changed - check again
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: screening
        }
        when {
            event: change
            selectionType: jQuerySelector
            jquerySelector: #screening input, #screening textarea, #screening select
        }

        action screening-changed-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // release 99: the outcome shown belongs to the saved answers - a changed answer is checked again first
                    $(".kyc-screening-next, #relationship, #not_required").hide();
                    apex.item("P201_KYC_REQUIRED").setValue("Answers changed: press Check.");
                    $("#P201_KYC_REQUIRED_DISPLAY").text("Answers changed: press Check.");
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load-request (
        name: Load the request and its counterparty
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_party number;
                begin
                    -- release 99: after a failed Next / Check / Save the page shows the posted values (no reload)
                    if :REQUEST in ('NEXT', 'CHECK', 'SAVE_DRAFT', 'CANCEL_REQUEST') then
                        return;
                    end if;
                    -- release 100: a fresh answer to Use the existing party for each counterparty
                    :P201_USE_EXISTING := null;
                    if :P201_REQUEST_ID is not null then
                        select business_relationship into :P201_BUSINESS_RELATIONSHIP from xxcmp_requests where request_id = :P201_REQUEST_ID;
                        select party_selection, case when party_selection = 'EXISTING' then party_id end, request_status,
                               requesting_department_id, justification, contact_name, contact_email, contact_phone,
                               case when party_selection = 'NEW' then party_id end
                          into :P201_PARTY_SELECTION, :P201_PARTY_ID, :P201_REQUEST_STATUS,
                               :P201_REQUESTING_DEPARTMENT, :P201_JUSTIFICATION, :P201_CONTACT_NAME, :P201_CONTACT_EMAIL,
                               :P201_CONTACT_PHONE, l_party
                          from xxcmp_requests
                         where request_id = :P201_REQUEST_ID;
                    end if;
                    -- the new counterparty in the common party form: editable while it is the request's Pending party
                    xxcmp_party_pkg.load_items(l_party,
                        case when xxcmp_request_pkg.party_editable(:P201_REQUEST_ID) = 'Y' then 'N' else 'Y' end);
                    -- the common Party summary (existing party) and the duplicate confirmation
                    :P0_REQUEST_ID := :P201_REQUEST_ID;
                    :P0_SUMMARY_PARTY_ID := :P201_PARTY_ID;
                    if :P201_REQUEST_ID is not null then
                        select match_ack_flag into :P0_PARTY_MATCH_ACK from xxcmp_requests where request_id = :P201_REQUEST_ID;
                    end if;
                    -- release 99: the outcome of the saved risk screening answers
                    :P201_SCREENING := case when :P201_REQUEST_ID is not null
                                            then xxcmp_request_pkg.screening_outcome(:P201_REQUEST_ID) end;
                    :P201_KYC_REQUIRED := case xxcmp_request_pkg.outcome_kyc_required(:P201_SCREENING)
                                              when 'Yes' then 'Yes - enter the business relationship type and justification, then Next.'
                                              when 'No'  then 'No - attach the evidence at Review and Submit and submit anyway.'
                                              else 'Answer the questions, then press Check.' end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    validation request-rules (
        name: Request and counterparty rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- one rule set for the page and the database; Save as Draft only needs the type and a name or party
                return xxcmp_request_pkg.request_error(
                           p_request_id          => to_number(:P201_REQUEST_ID),
                           p_party_selection     => nvl(:P201_PARTY_SELECTION, 'NEW'),
                           p_party_id            => to_number(:P201_PARTY_ID),
                           p_party_type          => :P0_PARTY_TYPE,
                           p_party_name          => :P0_PARTY_NAME,
                           p_jurisdiction        => :P0_PARTY_JURISDICTION,
                           p_registration_number => :P0_PARTY_REGISTRATION_NUMBER,
                           p_entity_type         => :P0_PARTY_ENTITY_TYPE,
                           p_registration_type   => :P0_PARTY_REGISTRATION_TYPE,
                           p_business_relationship => :P201_BUSINESS_RELATIONSHIP,
                           p_incorporation_date  => to_date(:P0_PARTY_INCORPORATION_DATE),
                           p_email               => :P0_PARTY_EMAIL,
                           p_phone               => :P0_PARTY_PHONE,
                           p_justification       => :P201_JUSTIFICATION,
                           p_draft               => case when :REQUEST in ('SAVE_DRAFT', 'CHECK') then 'Y' else 'N' end,
                           -- release 99: no Possible Matches on the request form (Compliance merges a duplicate)
                           p_match_ack           => 'Y',
                           p_use_existing        => :P201_USE_EXISTING);
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT,SAVE_DRAFT,CHECK
        }
    )

    process save-request (
        name: Save the request and its counterparty
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_request_id number := to_number(:P201_REQUEST_ID);
                begin
                    xxcmp_request_pkg.save_request(
                        p_request_id            => l_request_id,
                        p_party_selection       => nvl(:P201_PARTY_SELECTION, 'NEW'),
                        p_party_id              => to_number(:P201_PARTY_ID),
                        p_party_type            => :P0_PARTY_TYPE,
                        p_party_name            => :P0_PARTY_NAME,
                        p_jurisdiction          => :P0_PARTY_JURISDICTION,
                        p_registration_number   => :P0_PARTY_REGISTRATION_NUMBER,
                        p_entity_type           => :P0_PARTY_ENTITY_TYPE,
                        p_registration_type     => :P0_PARTY_REGISTRATION_TYPE,
                        p_business_relationship => :P201_BUSINESS_RELATIONSHIP,
                        p_incorporation_date    => to_date(:P0_PARTY_INCORPORATION_DATE),
                        p_email                 => :P0_PARTY_EMAIL,
                        p_phone                 => :P0_PARTY_PHONE,
                        p_website               => :P0_PARTY_WEBSITE,
                        p_fax                   => :P0_PARTY_FAX,
                        p_address               => :P0_PARTY_ADDRESS,
                        p_requesting_department_id => :P201_REQUESTING_DEPARTMENT,
                        p_justification         => :P201_JUSTIFICATION,
                        p_draft                 => case when :REQUEST in ('SAVE_DRAFT', 'CHECK') then 'Y' else 'N' end,
                        p_contact_name          => :P201_CONTACT_NAME,
                        p_contact_email         => :P201_CONTACT_EMAIL,
                        p_contact_phone         => :P201_CONTACT_PHONE,
                        p_match_ack             => 'Y',
                        p_use_existing          => :P201_USE_EXISTING);
                    :P201_REQUEST_ID := l_request_id;
                    -- release 99: the risk screening answers of step 1
                    xxcmp_request_pkg.save_screening(l_request_id, :P201_ANSWERS);
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Request saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT,SAVE_DRAFT,CHECK
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process cancel-request (
        name: Cancel the request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_request_pkg.cancel(:P201_REQUEST_ID);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Request cancelled.
        }
        serverSideCondition {
            whenButtonPressed: @cancel-request
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: Draft saved or cancelled
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 200
                clearCache: 200
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_DRAFT,CANCEL_REQUEST
        }
    )

    branch (
        name: Checked - show the outcome
        execution {
            sequence: 15
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_REQUEST_ID: &P201_REQUEST_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @check
        }
    )

    branch (
        name: To party details
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 204
                items: {
                    P204_REQUEST_ID: &P201_REQUEST_ID.
                }
                clearCache: 202
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
