        )

    )

    pageItem P201_KYC_REQUIRED (
        type: displayOnly
        label {
            label: KYC Report Required
            alignment: left
        }
        layout {
            sequence: 20
            region: @screening
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        help {
            helpText: The outcome of the risk screening answers, from the KYC rules. Press Check again after changing an answer.
        }
    )

    region not-required (
        name: KYC Report Not Required
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>The risk screening shows that a KYC report is not required for this counterparty.</p>
                <p>Attach the evidence (for example the stock exchange listing, or the government ownership document) at Review and Submit, under Request Documents, then submit the request anyway: it is recorded as not requiring KYC.</p>
                ```
        }
        layout {
            sequence: 35
            slot: BODY
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        advanced {
            htmlDomId: not_required
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.outcome_kyc_required(:P201_SCREENING) = 'No'
                ```
        }
    )

    region relationship (
        name: Business Relationship
        type: staticContent
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: relationship
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.outcome_kyc_required(:P201_SCREENING) = 'Yes'
                ```
        }
        comments {
            comments: Release 99 (B3) - asked only when the risk screening finds a KYC report required.
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 990
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: kyc-actionbar
        }
        advanced {
            htmlDomId: buttons
        }
    )

    pageItem P201_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @request
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_REQUEST_STATUS (
        type: hidden
        layout {
            sequence: 2
            region: @request
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P201_PARTY_SELECTION (
        type: hidden
        layout {
            sequence: 3
            region: @request
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
        default {
            type: static
            staticValue: NEW
        }
        comments {
            comments: Release 99 (B4) - a requester always enters a new counterparty (no Existing party choice); an older request keeps the choice it was saved with.
        }
    )

    pageItem P201_PARTY_ID (
        type: hidden
        layout {
            sequence: 4
            region: @request
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P201_SCREENING (
        type: hidden
        layout {
            sequence: 5
            region: @request
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
        comments {
            comments: Release 99 - the intake outcome of the saved screening answers (XXCMP_REQUEST_PKG.SCREENING_OUTCOME), set when the page loads.
        }
    )

    pageItem P201_ANSWERS (
        type: hidden
        layout {
            sequence: 6
            region: @request
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments:
                ```
                Unrestricted on purpose: filled in the browser just before submit by kycQuestionnaire (kyc-app.js). XXCMP_REQUEST_PKG.SAVE_SCREENING / SAVE_ANSWERS re-check every question and option on the server.
                ```
        }
    )

    pageItem P201_REQUESTING_DEPARTMENT (
        type: selectList
        label {
            label: Requesting Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select organization_name as display_value, organization_id as return_value
                  -- release 76: the departments data security allows; release 96: COMMON's departments, by ID
                  from xxhr_organizations
                 where organization_type = 'DEPARTMENT' and enabled_flag = 'Y'
                   and (xxcmp_request_pkg.allowed_departments is null
                        or to_char(organization_id) in (select column_value
                                                          from apex_string.split(xxcmp_request_pkg.allowed_departments, ',')))
                 order by organization_name
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select case   -- release 76: the only department data security allows, else the employee profile's
                       when xxcmp_request_pkg.allowed_departments <> '#NONE'
                                 and instr(xxcmp_request_pkg.allowed_departments, ',') = 0
                            then xxcmp_request_pkg.allowed_departments
                            else to_char(xxcmp_request_pkg.default_department) end   -- release 96: an ID
                  from dual
                ```
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.can_choose_department = 'N' and xxcmp_request_pkg.default_department is not null
                ```
        }
        help {
            helpText: The departments you may raise requests for (the departments of your requesting entity role, e.g. Requesting Entity1 = Finance), or the department of your employee profile. Level 1 approvers and Compliance can raise requests for any department.
        }
    )

    pageItem P201_PARTY_TYPE (
        type: radioGroup
        label {
            label: Party Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select /* release 103: chosen on step 1 - it decides the risk screening questionnaire; the requester's
                          form names the types as the KYC policy does (as P0_PARTY_TYPE on step 2) */
                       case lookup_code when 'ORGANIZATION' then 'Legal Person'
                                        when 'PERSON' then 'Natural Person (Individual)'
                                        else meaning end as display_value,
                       lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'PARTY_TYPE' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: false
        }
        layout {
            sequence: 12
            region: @request
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: ORGANIZATION
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P201_PARTY_ID is not null
                ```
        }
        help {
            helpText: Legal Person (a company or other organisation) or Natural Person (an individual). It decides the risk screening questions; it cannot be changed once the counterparty is entered on step 2.
        }
    )

    pageItem P201_BUSINESS_RELATIONSHIP (
        type: selectList
        label {
            label: Business Relationship Type
            alignment: left
        }
        layout {
            sequence: 15
            region: @relationship
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select meaning as display_value, lookup_code as return_value
                  from xxfnd_lookup_values
                 where lookup_type = 'BUSINESS_RELATIONSHIP' and enabled_flag = 'Y'
                 order by display_sequence, meaning
                ```
            displayNullValue: true
            nullDisplayValue: - Select -
        }
        help {
            helpText: What the counterparty is to the company for this request (customer, vendor...). One relationship per request; a party that is both a customer and a vendor gets one request for each. It goes on to the case and can choose the approval path.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel-request (
        buttonName: CANCEL_REQUEST
        label: Cancel Request
        layout {
            sequence: 15
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-ban
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Cancel this request? It cannot be submitted afterwards.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :P201_REQUEST_ID is not null and xxcmp_request_pkg.cancel_error(:P201_REQUEST_ID) is null
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save as Draft
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            executeValidations: false
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button check (
        buttonName: CHECK
        label: Check
        layout {
            sequence: 30
            region: @screening
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-check-circle-o
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @page-create
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: kyc-screening-next
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                xxcmp_request_pkg.outcome_kyc_required(:P201_SCREENING) is not null
                ```
        }
        security {
            authorizationScheme: @page-create
        }
    )

    dynamicAction party-type-changed (
        name: Party type changed - other questions
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P201_PARTY_TYPE
        }

        action party-type-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @screening-questions
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action party-type-check-again (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // release 103: another party type answers another questionnaire - check again
                    $(".kyc-screening-next, #relationship, #not_required").hide();
                    $("#P201_KYC_REQUIRED_DISPLAY").text("Answers changed: press Check.");
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )
    )

    dynamicAction screening-changed (
        name: Screening answer changed - check again
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: screening
        }
        when {
            event: change
            selectionType: jQuerySelector
            jquerySelector: #screening input, #screening textarea, #screening select
        }

        action screening-changed-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // release 99: the outcome shown belongs to the saved answers - a changed answer is checked again first
                    $(".kyc-screening-next, #relationship, #not_required").hide();
                    apex.item("P201_KYC_REQUIRED").setValue("Answers changed: press Check.");
                    $("#P201_KYC_REQUIRED_DISPLAY").text("Answers changed: press Check.");
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load-request (
        name: Load the request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                begin
                    -- release 99: after a failed Next / Check / Save the page shows the posted values (no reload)
                    if :REQUEST in ('NEXT', 'CHECK', 'SAVE_DRAFT', 'CANCEL_REQUEST') then
                        return;
                    end if;
                    -- release 103: step 1 is the request only; the counterparty is entered on step 2 (page 204)
                    if :P201_REQUEST_ID is not null then
                        select party_selection, party_id, request_status, requesting_department_id, party_type,
                               business_relationship
                          into :P201_PARTY_SELECTION, :P201_PARTY_ID, :P201_REQUEST_STATUS, :P201_REQUESTING_DEPARTMENT,
                               :P201_PARTY_TYPE, :P201_BUSINESS_RELATIONSHIP
                          from xxcmp_requests
                         where request_id = :P201_REQUEST_ID;
                    end if;
                    :P0_REQUEST_ID := :P201_REQUEST_ID;
                    -- release 99: the outcome of the saved risk screening answers
                    :P201_SCREENING := case when :P201_REQUEST_ID is not null
                                            then xxcmp_request_pkg.screening_outcome(:P201_REQUEST_ID) end;
                    :P201_KYC_REQUIRED := case xxcmp_request_pkg.outcome_kyc_required(:P201_SCREENING)
                                              when 'Yes' then 'Yes - choose the business relationship type, then Next.'
                                              when 'No'  then 'No - press Next, attach the evidence at Review and Submit and submit anyway.'
                                              else 'Answer the questions, then press Check.' end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    validation request-rules (
        name: Request rules
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- release 103: one rule set for the page and the database (step 1 is the request only)
                return xxcmp_request_pkg.intake_error(
                           p_request_id            => to_number(:P201_REQUEST_ID),
                           p_party_type            => :P201_PARTY_TYPE,
                           p_business_relationship => :P201_BUSINESS_RELATIONSHIP,
                           p_draft                 => case when :REQUEST in ('SAVE_DRAFT', 'CHECK') then 'Y' else 'N' end);
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT,SAVE_DRAFT,CHECK
        }
    )

    process save-request (
        name: Save the request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_request_id number := to_number(:P201_REQUEST_ID);
                begin
                    -- release 103: the request of step 1; the counterparty is saved on step 2
                    xxcmp_request_pkg.save_intake(
                        p_request_id               => l_request_id,
                        p_party_type               => :P201_PARTY_TYPE,
                        p_requesting_department_id => :P201_REQUESTING_DEPARTMENT,
                        p_business_relationship    => :P201_BUSINESS_RELATIONSHIP);
                    :P201_REQUEST_ID := l_request_id;
                    -- release 99: the risk screening answers of step 1
                    xxcmp_request_pkg.save_screening(l_request_id, :P201_ANSWERS);
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Request saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT,SAVE_DRAFT,CHECK
        }
        security {
            authorizationScheme: @page-create
        }
    )

    process cancel-request (
        name: Cancel the request
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                xxcmp_request_pkg.cancel(:P201_REQUEST_ID);
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        successMessage {
            successMessage: Request cancelled.
        }
        serverSideCondition {
            whenButtonPressed: @cancel-request
        }
        security {
            authorizationScheme: @page-create
        }
    )

    branch (
        name: Draft saved or cancelled
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 200
                clearCache: 200
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_DRAFT,CANCEL_REQUEST
        }
    )

    branch (
        name: Checked - show the outcome
        execution {
            sequence: 15
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_REQUEST_ID: &P201_REQUEST_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @check
        }
    )

    branch (
        name: To the counterparty (step 2)
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 204
                items: {
                    P204_REQUEST_ID: &P201_REQUEST_ID.
                }
                clearCache: 202
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)
