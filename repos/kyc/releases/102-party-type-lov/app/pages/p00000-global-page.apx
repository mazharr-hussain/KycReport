    region party-documents (
        name: Party Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.attached_document_id, a.title, a.category_name, a.document_date, a.expiry_date,
                       case when a.expired_flag = 'Y' then 'Expired' end as expired,
                       case when a.datatype_code = 'FILE' then
                           apex_page.get_url(p_page => 1, p_request => 'APPLICATION_PROCESS=DOWNLOAD_DOCUMENT',
                                             p_items => 'G_DOCUMENT_ID', p_values => to_char(a.document_id))
                            when a.datatype_code = 'WEB_PAGE' then a.url end as open_url,
                       a.created_by, a.creation_date
                  from xxfnd_attached_documents_v a
                 where a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = :P0_SUMMARY_PARTY_ID
                   and xxcmp_party_pkg.can_view(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y'
                 order by a.seq_num, a.creation_date
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 29
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_attachments
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('DOCUMENTS', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No party documents.
        }

        column ATTACHED_DOCUMENT_ID (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if OPEN_URL/}<a href="#OPEN_URL#">#TITLE#</a>{else/}#TITLE#{endif/}
                    ```
            }
        )

        column OPEN_URL (
            type: hidden
            layout {
                sequence: 12
            }
        )

        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 20
            }
        )

        column DOCUMENT_DATE (
            type: plainText
            heading {
                heading: Document Date
            }
            layout {
                sequence: 30
            }
        )

        column EXPIRY_DATE (
            type: plainText
