            type: hidden
            layout {
                sequence: 15
            }
        )

        column SOURCE (
            type: plainText
            heading {
                heading: Source
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    #SOURCE#{if CHANGED/} <span class="kyc-badge kyc-badge--neutral">#CHANGED#</span>{endif/}
                    ```
            }
        )

