    region checklist (
        name: Document Checklist
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.column_value as category_code,
                       (select nvl(tl.category_name, dc.category_name) from xxfnd_document_categories dc
                          left join xxfnd_document_categories_tl tl on tl.category_code = dc.category_code and tl.language_code = xxfnd_util_pkg.current_lang
                         where dc.category_code = c.column_value) as category,
                       case when exists (select 1 from xxfnd_attached_documents_v a
                                          where a.category_code = c.column_value and nvl(a.expired_flag, 'N') = 'N'
                                            and ((a.entity_name = 'XXCMP_REQUESTS' and a.pk1_value = :P0_REQUEST_ID)
                                              or (a.entity_name = 'XXCMP_PARTIES' and a.pk1_value = (select to_char(party_id) from xxcmp_requests where request_id = :P0_REQUEST_ID))))
                            then 'Present' else 'Missing' end as status
                  from table(xxcmp_doc_rule_pkg.mandatory_categories('XXCMP_PARTIES',
                                 (select jurisdiction from xxcmp_requests where request_id = :P0_REQUEST_ID),
                                 (select case when party_type = 'PERSON' then registration_type else entity_type end from xxcmp_requests where request_id = :P0_REQUEST_ID))) c
                ```
            pageItemsToSubmit: P0_REQUEST_ID
        }
        layout {
            sequence: 40
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: checklist
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No mandatory documents are configured for this counterparty.
        }
        comments {
            comments: Release 90: defined once here for the request (205) and its approval (206) - the mandatory documents of the counterparty and whether each is attached.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (205, 206) and :P0_REQUEST_ID is not null and xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW')
                ```
        }

        column CATEGORY_CODE (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column CATEGORY (
            type: plainText
            heading {
                heading: Mandatory Document
            }
            layout {
                sequence: 20
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

    )

    region request-answers (
        name: Questionnaire
        type: staticContent
        layout {
            sequence: 31
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: answer_summary
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (203, 205, 206) and :P0_REQUEST_ID is not null
                -- release 99: the questionnaire and the approval path are for Compliance and the approvers; a requester
                -- (no Cases - View) answered the risk screening on step 1 and sees the next steps instead
                and (:APP_PAGE_ID = 206 or xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW'))
                ```
        }
        comments {
            comments: Release 74 (R11): the requester's answers as standard reports - the score badges and the question / answer list.
        }
    )

    region request-answers-score (
        name: Questionnaire Score
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(sum(nvl(o.risk_points, 0)), 0) as risk_points,
                       count(case when o.critical_flag = 'Y' then 1 end) as critical_answers,
                       count(case when nvl(o.risk_points, 0) > 0 and nvl(o.critical_flag, 'N') = 'N' then 1 end) as risk_answers
                  from xxcmp_request_answers a
                  left join xxcmp_answer_options o on o.answer_option_id = a.answer_option_id
                 where a.request_id = :P0_REQUEST_ID and a.respondent_type = 'REQUESTER'
                having count(*) > 0
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @request-answers
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--flex
            ]
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 1
        }
        messages {
            whenNoDataFound: No answers yet.
        }

        column RISK_POINTS (
            type: plainText
            heading {
                heading: Risk Points
            }
            layout {
                sequence: 10
            }
        )

        column CRITICAL_ANSWERS (
            type: plainText
            heading {
                heading: Critical Answers
            }
            layout {
                sequence: 20
            }
        )

        column RISK_ANSWERS (
            type: plainText
            heading {
                heading: Risk Answers
            }
            layout {
                sequence: 30
            }
        )

    )

    region request-answers-list (
        name: Questionnaire Answers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select q.display_sequence,
                       q.question_text,
                       nvl(coalesce(o.answer_label, a.answer_text), '-') as answer,
                       case when o.critical_flag = 'Y' then 'Critical' when nvl(o.risk_points, 0) > 0 then 'Risk' end as flag,
                       case when o.critical_flag = 'Y' then 'danger' else 'warning' end as flag_tone
                  from xxcmp_request_answers a
                  join xxcmp_questions q on q.question_id = a.question_id
                  left join xxcmp_answer_options o on o.answer_option_id = a.answer_option_id
                 where a.request_id = :P0_REQUEST_ID and a.respondent_type = 'REQUESTER'
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 20
            parentRegion: @request-answers
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--horizontalBorders
            ]
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 500
        }
        messages {
            whenNoDataFound: No answers yet.
        }

        column DISPLAY_SEQUENCE (
            type: hidden
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
            }
        )

        column QUESTION_TEXT (
            type: plainText
            heading {
                heading: Question
            }
            layout {
                sequence: 10
            }
        )

        column ANSWER (
            type: plainText
            heading {
                heading: Answer
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <strong>#ANSWER#</strong>{if FLAG/} <span class="kyc-badge kyc-badge--#FLAG_TONE#">#FLAG#</span>{endif/}
                    ```
            }
