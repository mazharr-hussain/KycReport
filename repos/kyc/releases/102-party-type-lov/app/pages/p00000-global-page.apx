    button add-party-document (
        buttonName: PARTY_ATTACHMENTS_ADD
        label: Add Document
        layout {
            sequence: 10
            region: @party-documents
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-paperclip
        }
        behavior {
            action: redirectOtherApp
            target: {
                app: COMMON
                page: 47
                items: {
                    P47_APP_ALIAS: &APP_ALIAS.
                    P47_SOURCE_PAGE: &APP_PAGE_ID.
                    P47_SOURCE_REGION: party_attachments
                    P47_ENTITY_NAME: XXCMP_PARTIES
                    P47_PK1_VALUE: &P0_SUMMARY_PARTY_ID.
                }
                clearCache: 47
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y')) and xxcmp_party_pkg.can_edit_details(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y'
        and xxfnd_attach_pkg.block_permission(:APP_ALIAS, :APP_PAGE_ID, 'party_attachments', 'XXCMP_PARTIES', 'INSERT') = 'Y'
                ```
        }
    )

    dynamicAction refresh-party-documents (
        name: Refresh party documents
        execution {
            sequence: 57
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @party-documents
        }

        action refresh-party-documents-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party-documents
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    region record-header (
        name: Request Header
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R11): the header card from data (no HTML from PL/SQL); data security applies
                select r.request_number || ' · ' || r.party_name as title,
                       xxfnd_ui_pkg.status_label('REQUEST', r.request_status) as status_label,
                       xxfnd_ui_pkg.status_tone('REQUEST', r.request_status) as status_tone,
                       case when xxcmp_request_pkg.kyc_required(r.request_id) = 'Yes' then 'KYC required' end as kyc_label,
                       case when r.intake_score is not null
                            then 'Score ' || r.intake_score || case when r.intake_critical_flag = 'Y' then ' · critical answer' end
                       end as score_label,
                       case when r.intake_critical_flag = 'Y' then 'danger' else 'neutral' end as score_tone,
                       (select max(c.case_number) from xxcmp_cases c where c.request_id = r.request_id) as case_number,
                       rtrim(xxfnd_lookup_pkg.lookup_meaning('KYC_REQUEST_TYPE', r.request_type)
                             || nvl2(r.business_relationship, ' · ' || xxfnd_lookup_pkg.lookup_meaning('BUSINESS_RELATIONSHIP', r.business_relationship), null)
                             || nvl2(coalesce(to_char(r.requesting_department_id), r.requesting_department),   -- release 96
                                     ' · ' || coalesce(xxcmp_request_pkg.department_name(r.requesting_department_id),
                                                       xxfnd_lookup_pkg.lookup_meaning('REQUESTING_DEPARTMENT', r.requesting_department)), null),
                             ' ·') as type_line,
                       r.requester_user_name as requester,
                       xxfnd_ui_pkg.person_name(r.requester_user_name) as requester_name,
                       w.pending_user,
                       xxfnd_ui_pkg.person_name(w.pending_user) as pending_name,
                       case when w.pending_user is not null then to_char(r.last_action_date, 'DD-MON-YYYY HH24:MI') end as since
                  from xxcmp_requests r
                 cross apply (select case when r.request_status in ('DRAFT', 'IN_PROGRESS', 'INFO_NEEDED')
                                          then xxcmp_request_pkg.pending_with(r.request_id) end as pending_user
                                from dual) w
                 where r.request_id = :P0_REQUEST_ID
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 1
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: record_header
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (203, 205, 206) and :P0_REQUEST_ID is not null
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        heading {
            type: none
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 1
        }
        messages {
            whenNoDataFound: The request is not available.
        }
        comments {
            comments: UI/UX standard header card of a request. Release 74: SQL data and the column's HTML template (kyc-hcard classes); kyc-app.js builds the section menu from the regions under it.
        }

        column TITLE (
            type: plainText
            heading {
                heading: Request
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="kyc-hcard"><div class="kyc-hcard-top"><span class="kyc-hcard-title">#TITLE#</span><span class="kyc-badge kyc-badge--#STATUS_TONE#">#STATUS_LABEL#</span>{if KYC_LABEL/}<span class="kyc-badge kyc-badge--warning">#KYC_LABEL#</span>{endif/}{if SCORE_LABEL/}<span class="kyc-badge kyc-badge--#SCORE_TONE#">#SCORE_LABEL#</span>{endif/}{if CASE_NUMBER/}<span class="kyc-badge kyc-badge--info">#CASE_NUMBER#</span>{endif/}</div><div class="kyc-hcard-line">#TYPE_LINE# · requested by <span class="kyc-person" tabindex="0" data-user="#REQUESTER#">#REQUESTER_NAME#</span></div>{if PENDING_USER/}<div class="kyc-hcard-line">Waiting for <b><span class="kyc-person" tabindex="0" data-user="#PENDING_USER#">#PENDING_NAME#</span></b>{if SINCE/} since #SINCE#{endif/}</div>{endif/}</div>
                    ```
            }
        )

        column STATUS_LABEL (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column STATUS_TONE (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column KYC_LABEL (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column SCORE_LABEL (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column SCORE_TONE (
            type: hidden
            layout {
                sequence: 60
            }
        )

        column CASE_NUMBER (
            type: hidden
            layout {
                sequence: 70
            }
        )

        column TYPE_LINE (
            type: hidden
            layout {
                sequence: 80
            }
        )

        column REQUESTER (
            type: hidden
            layout {
                sequence: 90
            }
        )

        column REQUESTER_NAME (
            type: hidden
            layout {
                sequence: 100
            }
        )

        column PENDING_USER (
            type: hidden
            layout {
                sequence: 110
            }
        )

        column PENDING_NAME (
            type: hidden
            layout {
                sequence: 120
            }
        )

        column SINCE (
            type: hidden
            layout {
                sequence: 130
            }
        )

    )

    region request-details (
        name: Request
        type: appTemplateComponent/fieldGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R11): the request's details as data (XXCMP_REQUEST_UI_PKG.DETAILS_JSON)
                select j.group_name, j.seq, j.label, j.value, j.tone, j.url, j.user_name,
                         min(j.seq) over (partition by j.group_name) as group_seq,
                         case when length(j.value) > 80 then 'Y' end as full_width
                  from json_table(xxcmp_request_ui_pkg.details_json(to_number(:P0_REQUEST_ID)), '$[*]'
                           columns (group_name varchar2(30)   path '$.group_name',
                                    seq        number         path '$.seq',
                                    label      varchar2(100)  path '$.label',
                                    value      varchar2(4000) path '$.value',
                                    tone       varchar2(30)   path '$.tone',
                                    url        varchar2(4000) path '$.url',
                                    user_name  varchar2(255)  path '$.user_name')) j
                   order by j.seq
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: request_details
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (205, 206) and :P0_REQUEST_ID is not null
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            label: &LABEL.
            value: &VALUE.
            tone: &TONE.
            link: &URL.
            person: &USER_NAME.
            fullWidth: &FULL_WIDTH.
        }
        plugin-grouping {
            groupTitle: &GROUP_NAME.
        }
        messages {
            whenNoDataFound: The request is not available.
        }
        comments {
            comments: Release 75 (U-01, U-02): the KYC Field Grid template component (grouped 3-column grid). Release 90: defined once here for the request (205) and its approval (206); each page sets P0_REQUEST_ID before header.
        }

        column GROUP_NAME (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: GROUP_NAME
                dataType: varchar2
            }
        )

        column SEQ (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: SEQ
                dataType: number
                primaryKey: true
            }
        )

        column LABEL (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column VALUE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: VALUE
                dataType: varchar2
            }
        )

        column TONE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: TONE
                dataType: varchar2
            }
        )

        column URL (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: URL
                dataType: varchar2
            }
        )

        column USER_NAME (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: USER_NAME
                dataType: varchar2
            }
        )

        column GROUP_SEQ (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: GROUP_SEQ
                dataType: number
            }
            appearance {
                group: true
            }
        )

