            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-badge kyc-badge--#RESULT_TONE#">#CHECK_RESULT#</span>
                    ```
            }
        )

        column RESULT_TONE (
            type: hidden
            layout {
                sequence: 45
            }
        )

        column CHECKED_BY (
            type: plainText
            heading {
                heading: Checked By
            }
            layout {
                sequence: 50
            }
        )

        column CHECKED_DATE (
            type: plainText
            heading {
                heading: Checked On
            }
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
                direction: desc
            }
        )

        column REVIEWED_BY (
            type: plainText
            heading {
                heading: Reviewed By
            }
            layout {
                sequence: 70
            }
        )

        column CHANGED (
            type: hidden
            layout {
                sequence: 75
            }
        )

        column EDIT_URL (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if EDIT_URL/}<a href="#EDIT_URL#">Edit</a>{endif/}
                    ```
            }
        )

    )

    button add-registry-check (
        buttonName: ADD_REGISTRY_CHECK
        label: Add Registry Check
        layout {
            sequence: 10
            region: @party-registry-checks
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                items: {
                    P27_PARTY_ID: &P0_SUMMARY_PARTY_ID.
                    P27_CASE_ID: &P211_CASE_ID.
                }
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID = 21 or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW')) and xxcmp_party_pkg.can_record_verification(:P0_SUMMARY_PARTY_ID, case when :APP_PAGE_ID = 211 then :P211_CASE_ID end) = 'Y'
                ```
        }
    )

    dynamicAction refresh-party-registry-checks (
        name: Refresh registry checks
        execution {
            sequence: 60
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @party-registry-checks
        }

        action refresh-party-registry-checks-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party-registry-checks
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
