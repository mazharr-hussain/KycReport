            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 24) and :P0_PARTY_ID is not null
                ```
        }
    )

    pageItem P0_PARTY_MATCH_ACK (
        type: hidden
        layout {
            sequence: 170
            region: @party-form
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        comments {
            comments: Answer of the similar-parties dialog (Global Page dynamic action party-match-dialog): Y = none of the possible matches is this party, N = a possible match exists. Stored on a request as MATCH_ACK_FLAG; empty = not answered (the save is stopped).
        }
    )

    region request-context (
        name: Request Context
        type: staticContent
        layout {
            sequence: 1
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (21, 25, 201, 203, 204, 205, 206, 211)
                ```
        }
        comments {
            comments: Holds the context of the common Party and Request regions: P0_SUMMARY_PARTY_ID (the party shown), P0_REQUEST_ID (the request, empty on the party screens). Each page sets them before header.
        }
    )

    pageItem P0_CASE_ID (
        type: hidden
        layout {
            sequence: 2
            region: @request-context
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        help {
            helpText: The case of the case screen (211, release 42): Owners and Officers shows the case's party and each party's screening in the case.
        }
    )

    pageItem P0_REQUEST_ID (
        type: hidden
        layout {
            sequence: 1
            region: @request-context
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
    )

    pageItem P0_SUMMARY_PARTY_ID (
        type: hidden
        layout {
            sequence: 2
            region: @request-context
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
    )

    region possible_matches (
        name: Possible Matches
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.party_id, j.party_number, j.registration_type, j.registration_number,
                       j.party_name, j.country, j.status, j.score, j.reg_match, j.reasons,
                       case when :APP_PAGE_ID = 201 then 'Use this party' end as use_party
                  from json_table(xxcmp_party_pkg.party_candidates_json(:P0_PARTY_TYPE, :P0_PARTY_NAME, :P0_PARTY_REGISTRATION_NUMBER,
                                      to_date(:P0_PARTY_INCORPORATION_DATE), :P0_PARTY_JURISDICTION, to_number(:P0_PARTY_ID)), '$[*]'
                         columns (party_id number path '$.party_id', party_number varchar2(30) path '$.party_number',
                                  registration_type varchar2(240) path '$.registration_type',
                                  registration_number varchar2(100) path '$.registration_number',
                                  party_name varchar2(360) path '$.party_name', country varchar2(240) path '$.country',
                                  status varchar2(80) path '$.status',
                                  score number path '$.score', reg_match number path '$.reg_match',
                                  reasons varchar2(1000) path '$.reasons')) j
                ```
            pageItemsToSubmit: [
                P0_PARTY_ID
                P0_PARTY_TYPE
                P0_PARTY_NAME
                P0_PARTY_REGISTRATION_NUMBER
                P0_PARTY_INCORPORATION_DATE
                P0_PARTY_JURISDICTION
            ]
        }
        layout {
            sequence: 35
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: possible_matches
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (23, 24) and nvl(:P0_PARTY_READ_ONLY, 'N') <> 'Y'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No existing party resembles this party.
        }

        column PARTY_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column PARTY_NUMBER (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 20
            }
        )

        column REGISTRATION_TYPE (
            type: plainText
            heading {
                heading: Registration / ID Type
            }
            layout {
                sequence: 25
            }
        )

        column REGISTRATION_NUMBER (
            type: plainText
            heading {
                heading: Registration / ID No.
            }
            layout {
                sequence: 30
            }
        )

        column PARTY_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 40
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 50
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Party Status
            }
            layout {
                sequence: 55
            }
        )

        column SCORE (
            type: plainText
            heading {
                heading: Match %
            }
            layout {
                sequence: 60
            }
        )

        column REG_MATCH (
            type: plainText
            heading {
                heading: Registration Match %
            }
            layout {
                sequence: 70
            }
        )

        column REASONS (
            type: plainText
            heading {
                heading: Why
            }
            layout {
                sequence: 80
            }
        )

        column USE_PARTY (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="#" class="kyc-use-party" data-party="#PARTY_ID#" data-status="#STATUS#" data-label="#PARTY_NAME# (#PARTY_NUMBER#)">#USE_PARTY#</a>
                    ```
            }
        )

    )

    region party-summary (
        name: Party
        type: appTemplateComponent/fieldGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.seq, j.label, j.value, j.meta, j.tone, j.url, j.group_name,
                       min(j.seq) over (partition by j.group_name) as group_seq
                  from json_table(xxcmp_party_pkg.card_json(to_number(:P0_SUMMARY_PARTY_ID), to_number(:P0_REQUEST_ID),
                                     p_request_form => case when :APP_PAGE_ID in (201, 204) then 'Y' else 'N' end), '$[*]'
                           columns (group_name varchar2(30)   path '$.group_name',
                                    seq        number         path '$.seq',
                                    label      varchar2(100)  path '$.label',
                                    value      varchar2(4000) path '$.value',
                                    meta       varchar2(1000) path '$.meta',
                                    tone       varchar2(30)   path '$.tone',
                                    url        varchar2(4000) path '$.url')) j
                 order by j.seq
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
                P0_SUMMARY_PARTY_ID
            ]
        }
        layout {
            sequence: 25
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_card
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 201, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('PARTY', 'REVIEW')))
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            label: &LABEL.
            value: &VALUE.
            tone: &TONE.
            link: &URL.
            meta: &META.
        }
        plugin-grouping {
            groupTitle: &GROUP_NAME.
        }
        messages {
            whenNoDataFound: No party linked yet.
        }
        comments {
            comments: Common Party region (Global Page): the party in full on the party and request screens (no party status on a request). Release 75 (U-01, U-02): the KYC Field Grid template component - groups Party / Identity / Contact / KYC in a 3-column grid; data from XXCMP_PARTY_PKG.CARD_JSON.
        }

        column SEQ (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: SEQ
                dataType: number
                primaryKey: true
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column VALUE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: VALUE
                dataType: varchar2
            }
        )

        column META (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: META
                dataType: varchar2
            }
        )

        column TONE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: TONE
                dataType: varchar2
            }
        )

        column URL (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: URL
                dataType: varchar2
            }
        )

        column GROUP_NAME (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: GROUP_NAME
                dataType: varchar2
            }
        )

        column GROUP_SEQ (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: GROUP_SEQ
                dataType: number
            }
            appearance {
                group: true
            }
        )

    )






    region party-dff (
        name: Additional Information
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return xxcmp_party_pkg.dff_html(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID, :P0_PARTY_DFF_CONTEXT,
                                                case when :APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y') then 'Y' else 'N' end);
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
                P0_PARTY_DFF_CONTEXT
            ]
        }
        layout {
            sequence: 26
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_dff
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('PARTY', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null
                -- hidden when the party type has no Additional Information fields (release 90: COMMON's rendering returns
                -- nothing then; no test on the markup)
                and nvl(dbms_lob.getlength(xxcmp_party_pkg.dff_html(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID, :P0_PARTY_DFF_CONTEXT, 'N')), 0) > 0
                ```
        }
    )

    pageItem P0_PARTY_DFF_JSON (
        type: hidden
        layout {
            sequence: 900
            region: @party-dff
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Unrestricted on purpose: filled in the browser before submit by xxfnd-dff.js (dynamic action bind-party-dff); XXCMP_PARTY_PKG.DFF_ERROR / SAVE_DFF re-validate every value on the server.
        }
    )

    pageItem P0_PARTY_DFF_CONTEXT (
        type: hidden
        layout {
            sequence: 901
            region: @party-dff
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Unrestricted on purpose: filled in the browser before submit by xxfnd-dff.js (dynamic action bind-party-dff); XXCMP_PARTY_PKG.DFF_ERROR / SAVE_DFF re-validate every value on the server.
        }
    )

    dynamicAction bind-party-dff (
        name: Bind additional information
        execution {
            sequence: 1
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (25, 204, 211)
                ```
        }

        action bind-party-dff-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    if (window.xxfndDff) { xxfndDff.bind('party_dff', 'P0_PARTY_DFF_JSON', 'P0_PARTY_DFF_CONTEXT'); }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    region party-contacts (
        name: Contact Persons
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.party_contact_id, c.contact_name, c.job_title, c.email, c.phone,
                       case c.primary_flag when 'Y' then 'Y' end as primary_contact,
                       case c.enabled_flag when 'N' then 'Y' end as enabled,
                       case when xxcmp_party_pkg.can_edit_details(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y' and (:APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y')) then apex_page.get_url(p_page => 22, p_items => 'P22_PARTY_CONTACT_ID,P22_PARTY_ID', p_values => to_char(c.party_contact_id) || ',' || :P0_SUMMARY_PARTY_ID, p_clear_cache => '22') end as edit_url
                  from xxcmp_party_contacts c
                 where c.party_id = :P0_SUMMARY_PARTY_ID
                   and xxcmp_party_pkg.can_view(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y'
                 order by c.primary_flag desc, c.contact_name
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 27
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_contacts
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID in (21, 25, 203, 204, 205, 206, 211) and (:APP_PAGE_ID <> 211 or :P211_SECTION in ('PARTY', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null
                -- release 99: no contact persons or owners for an individual on Create Request - Party Details
                and (:APP_PAGE_ID <> 204 or xxcmp_party_pkg.party_type(:P0_SUMMARY_PARTY_ID) <> 'PERSON')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No contact persons.
        }

        column PARTY_CONTACT_ID (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column CONTACT_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <strong>#CONTACT_NAME#</strong> {if PRIMARY_CONTACT/}<span class="kyc-badge kyc-badge--info">Primary</span>{endif/} {if ENABLED/}<span class="kyc-badge kyc-badge--neutral">Disabled</span>{endif/}
                    ```
            }
        )

        column JOB_TITLE (
            type: plainText
            heading {
                heading: Job Title
            }
            layout {
                sequence: 20
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 30
            }
        )

        column PHONE (
            type: plainText
            heading {
                heading: Phone
            }
            layout {
                sequence: 40
            }
        )

        column PRIMARY_CONTACT (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column ENABLED (
            type: hidden
            layout {
                sequence: 60
            }
        )

        column EDIT_URL (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if EDIT_URL/}<a href="#EDIT_URL#">Edit</a>{endif/}
                    ```
            }
            serverSideCondition {
                type: expression
                language: plsql
                plsqlExpression:
                    ```plsql
                    (:APP_PAGE_ID in (25, 204) or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P211_CASE_ID) = 'Y')) and xxcmp_party_pkg.can_edit_details(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y'
                    ```
            }
        )

    )

