    region approval-history (
        name: Approval History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 75 (U-09): person names (a role or System stays as it is)
                select rownum as seq, h.step_no, h.step_name, xxfnd_ui_pkg.person_name(h.assigned_to) as assigned_to, h.action,
                       xxfnd_ui_pkg.person_name(h.action_by) as action_by,
                       to_char(h.action_date, 'DD-MON-YYYY HH24:MI') as action_date, h.comments
                  from table(xxcmp_request_pkg.history_rows(to_number(:P0_REQUEST_ID))) h
                 order by seq
                ```
            pageItemsToSubmit: [
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 62
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: approval_history
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (203, 205, 206) and :P0_REQUEST_ID is not null
                -- release 99: the questionnaire and the approval path are for Compliance and the approvers; a requester
                -- (no Cases - View) answered the risk screening on step 1 and sees the next steps instead
                and (:APP_PAGE_ID = 206 or xxfnd_privilege_pkg.has_privilege('CASES', 'VIEW'))
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No approval path applies.
        }
        comments {
            comments: One table for the approval path and its history: what happened (who, when, comments), then the current step (Pending) and the steps to come (Waiting); before submit, the expected steps.
        }

