    region ownership-tree (
        name: Ownership Tree
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 42: the whole ownership tree (owners of owners); on the case screen also the case's party and
                -- each party's latest screening in the case
                select j.party_relationship_id, j.lvl, j.direction, j.related_party, j.party_type, j.relationship_type,
                       j.ownership_percentage, j.start_date, j.end_date, j.country, j.birth_date, j.id_number, j.id_expiry,
                       j.results, j.conclusion, j.source, j.risk_tier,
                       j.lvl * 1.5 as indent,
                       case when l.can_edit = 'Y' and j.lvl = 1 then
                            apex_page.get_url(p_page => 23, p_items => 'P23_PARTY_RELATIONSHIP_ID,P23_OBJECT_PARTY_ID',
                                              p_values => to_char(j.party_relationship_id) || ',' || :P0_SUMMARY_PARTY_ID, p_clear_cache => '23') end as edit_url,
                       -- owners of a related company are added from here too (Compliance)
                       case when l.can_edit = 'Y' and j.grp = 1 and j.lvl >= 1 and j.party_type_code = 'ORGANIZATION'
                                 and xxfnd_privilege_pkg.has_privilege('PARTIES', 'MANAGE') then
                            apex_page.get_url(p_page => 23, p_items => 'P23_OBJECT_PARTY_ID', p_values => to_char(j.related_party_id), p_clear_cache => '23') end as add_owner_url,
                       case when :APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW' and xxcmp_case_pkg.is_editable(:P0_CASE_ID) = 'Y' then
                            apex_page.get_url(p_page => 213, p_items => 'P213_CASE_ID,P213_SCREEN_PARTY_ID,P213_SCREENING_ID',
                                              p_values => :P0_CASE_ID || ',' || j.related_party_id || ',' || j.screening_id, p_clear_cache => '213') end as screen_url
                  from (select case when xxcmp_party_pkg.can_edit_details(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID) = 'Y'
                                     and (:APP_PAGE_ID = 211 and xxcmp_case_pkg.is_editable(:P0_CASE_ID) = 'Y')
                                    then 'Y' else 'N' end as can_edit
                          from dual) l,
                       json_table(xxcmp_party_pkg.ownership_tree_json(:P0_SUMMARY_PARTY_ID, :P0_REQUEST_ID, case when :APP_PAGE_ID = 211 then to_number(:P0_CASE_ID) end), '$[*]'
                         columns (party_relationship_id number path '$.party_relationship_id', grp number path '$.grp', lvl number path '$.lvl',
                                  direction varchar2(400) path '$.direction', related_party_id number path '$.related_party_id',
                                  related_party varchar2(400) path '$.related_party', party_type varchar2(240) path '$.party_type',
                                  party_type_code varchar2(30) path '$.party_type_code',
                                  relationship_type varchar2(240) path '$.relationship_type',
                                  ownership_percentage number path '$.ownership_percentage', start_date varchar2(20) path '$.start_date',
                                  end_date varchar2(20) path '$.end_date', country varchar2(240) path '$.country',
                                  birth_date varchar2(20) path '$.birth_date', id_number varchar2(100) path '$.id_number',
                                  id_expiry varchar2(20) path '$.id_expiry', screening_id number path '$.screening_id',
                                  results varchar2(240) path '$.results', conclusion varchar2(4000) path '$.conclusion',
                                  source varchar2(1000) path '$.source', risk_tier varchar2(240) path '$.risk_tier')) j
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
                P0_CASE_ID
            ]
        }
        layout {
            sequence: 29
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ownership_tree
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                -- release 42: the party screen and the case's Ownership Tree section only
                (:APP_PAGE_ID = 21 or (:APP_PAGE_ID = 211 and :P211_SECTION = 'TREE')) and :P0_SUMMARY_PARTY_ID is not null
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: No owners, officers or related parties.
        }

