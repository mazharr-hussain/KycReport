    dynamicAction party-form-labels (
        name: Party form - labels by party type
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P0_PARTY_TYPE
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APP_PAGE_ID in (23, 24, 201)
                ```
        }

        action party-form-labels-js (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    // one column per organisation / individual pair: the label follows the party type
                    var person = apex.item("P0_PARTY_TYPE").getValue() === "PERSON",
                        requestForm = $v("pFlowStepId") === "201",   // release 99: the requester's KYC request form
                        labels = { P0_PARTY_JURISDICTION: ["Country", "Nationality"],
                                   P0_PARTY_REGISTRATION_NUMBER: ["Registration No.", "ID Number"],
                                   P0_PARTY_REGISTRATION_TYPE: ["Registration Type", "ID Type"],
                                   P0_PARTY_INCORPORATION_DATE: ["Incorporation Date", "Date of Birth"],
                                   P0_PARTY_ADDRESS: ["Headquarters Address", "Address"] };
                    if (requestForm) {
                        labels.P0_PARTY_NAME = ["Name (as per CR / Official Documents)", "Full name as per Official Document (in English)"];
                        labels.P0_PARTY_INCORPORATION_DATE = ["Incorporation Date", "Date of Birth as per Official Document"];
                    }
                    Object.keys(labels).forEach(function (item) {
                        $("#" + item + "_LABEL").text(labels[item][person ? 1 : 0]);
                    });
                    // order: organisation = Entity Type before Name, Registration Type before Registration No.;
                    // individual = no entity type (category of organisations only), ID Type before ID Number
                    var row = function (item) { return $("#" + item + "_CONTAINER").closest(".row"); };
                    row("P0_PARTY_ENTITY_TYPE").insertBefore(row("P0_PARTY_NAME"))[person ? "hide" : "show"]();
                    if (person) { apex.item("P0_PARTY_ENTITY_TYPE").setValue(""); }
                    row("P0_PARTY_REGISTRATION_TYPE").insertBefore(row("P0_PARTY_REGISTRATION_NUMBER"));
                    // release 99: the request form asks an organisation for no incorporation date (release 100: the
                    // registration type is asked - part of the duplicate rule)
                    if (requestForm) {
                        ["P0_PARTY_INCORPORATION_DATE"].forEach(function (item) {
                            row(item)[person ? "show" : "hide"]();
                            if (!person) { apex.item(item).setValue(""); }
                        });
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

    region party-id-verifications (
        name: ID Verifications
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R14): identity document checks of the individual (manual)
                select v.id_verification_id,
                       xxfnd_lookup_pkg.lookup_meaning('ID_DOCUMENT_TYPE', v.document_type) as document_type,
                       v.document_number,
                       xxfnd_lookup_pkg.lookup_meaning('JURISDICTION', v.issuing_country) as issuing_country,
                       v.expiry_date,
                       xxfnd_lookup_pkg.lookup_meaning('ID_VERIFICATION_METHOD', v.verification_method) as verification_method,
                       xxfnd_lookup_pkg.lookup_meaning('ID_VERIFICATION_RESULT', v.verification_result) as verification_result,
                       decode(v.verification_result, 'VERIFIED', 'success', 'NOT_VERIFIED', 'danger', 'warning') as result_tone,
                       xxfnd_ui_pkg.person_name(v.verified_by) as verified_by,
                       v.verified_date,
                       case when (:APP_PAGE_ID = 21 or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW')) and xxcmp_party_pkg.can_record_verification(:P0_SUMMARY_PARTY_ID, case when :APP_PAGE_ID = 211 then :P211_CASE_ID end) = 'Y' then apex_page.get_url(p_page => 26, p_items => 'P26_ID_VERIFICATION_ID,P26_PARTY_ID,P26_CASE_ID', p_values => to_char(v.id_verification_id) || ',' || :P0_SUMMARY_PARTY_ID || ',' || v.case_id, p_clear_cache => '26') end as edit_url
                  from xxcmp_party_id_verifications v
                 where v.party_id = :P0_SUMMARY_PARTY_ID
                 order by v.verified_date desc, v.id_verification_id desc
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_id_verifications
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID = 21 or (:APP_PAGE_ID = 211 and :P211_SECTION in ('PARTY', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null and xxfnd_privilege_pkg.has_privilege('PARTIES', 'VIEW') and xxcmp_party_pkg.party_type(:P0_SUMMARY_PARTY_ID) = 'PERSON'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 20
        }
        messages {
            whenNoDataFound: No identity document checked yet.
        }
        comments {
            comments: Release 74 (R14): identity document checks of an individual, recorded by hand (Compliance only).
        }

        column ID_VERIFICATION_ID (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column DOCUMENT_TYPE (
            type: plainText
            heading {
                heading: Document
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <strong>#DOCUMENT_TYPE#</strong> #DOCUMENT_NUMBER#
                    ```
            }
        )

        column DOCUMENT_NUMBER (
            type: hidden
            layout {
                sequence: 15
            }
        )

        column ISSUING_COUNTRY (
            type: plainText
            heading {
                heading: Issued By
            }
            layout {
                sequence: 20
            }
        )

        column EXPIRY_DATE (
            type: plainText
            heading {
                heading: Expires
            }
            layout {
                sequence: 30
            }
        )

        column VERIFICATION_METHOD (
            type: plainText
            heading {
                heading: How Checked
            }
            layout {
                sequence: 40
            }
        )

        column VERIFICATION_RESULT (
            type: plainText
            heading {
                heading: Result
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="kyc-badge kyc-badge--#RESULT_TONE#">#VERIFICATION_RESULT#</span>
                    ```
            }
        )

