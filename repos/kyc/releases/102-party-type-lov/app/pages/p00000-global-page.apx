    region party-registry-checks (
        name: Registry Checks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- release 74 (R14): company registry (KYB) checks of the organisation (manual now, from a provider later)
                select r.registry_check_id,
                       r.registry_name,
                       r.external_reference,
                       xxfnd_lookup_pkg.lookup_meaning('DATA_SOURCE', r.source) as source,
                       xxfnd_lookup_pkg.lookup_meaning('REGISTRATION_STATUS', r.registration_status) as registration_status,
                       xxfnd_lookup_pkg.lookup_meaning('REGISTRY_CHECK_RESULT', r.check_result) as check_result,
                       decode(r.check_result, 'MATCH', 'success', 'MISMATCH', 'danger', 'warning') as result_tone,
                       xxfnd_ui_pkg.person_name(r.checked_by) as checked_by,
                       r.checked_date,
                       case when r.source = 'API' then nvl(xxfnd_ui_pkg.person_name(r.reviewed_by), 'Not reviewed') end as reviewed_by,
                       case r.changed_by_person_flag when 'Y' then 'Changed by a person' end as changed,
                       case when (:APP_PAGE_ID = 21 or (:APP_PAGE_ID = 211 and :P211_SECTION <> 'REVIEW')) and xxcmp_party_pkg.can_record_verification(:P0_SUMMARY_PARTY_ID, case when :APP_PAGE_ID = 211 then :P211_CASE_ID end) = 'Y' then apex_page.get_url(p_page => 27, p_items => 'P27_REGISTRY_CHECK_ID,P27_PARTY_ID,P27_CASE_ID', p_values => to_char(r.registry_check_id) || ',' || :P0_SUMMARY_PARTY_ID || ',' || r.case_id, p_clear_cache => '27') end as edit_url
                  from xxcmp_party_registry_checks r
                 where r.party_id = :P0_SUMMARY_PARTY_ID
                 order by r.checked_date desc, r.registry_check_id desc
                ```
            pageItemsToSubmit: [
                P0_SUMMARY_PARTY_ID
                P0_REQUEST_ID
            ]
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: party_registry_checks
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                (:APP_PAGE_ID = 21 or (:APP_PAGE_ID = 211 and :P211_SECTION in ('PARTY', 'REVIEW'))) and :P0_SUMMARY_PARTY_ID is not null and xxfnd_privilege_pkg.has_privilege('PARTIES', 'VIEW') and xxcmp_party_pkg.party_type(:P0_SUMMARY_PARTY_ID) = 'ORGANIZATION'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 20
        }
        messages {
            whenNoDataFound: No registry check yet.
        }
        comments {
            comments: Release 74 (R14): company registry (KYB) checks of an organisation - by hand now, from a registry provider later (Compliance only).
        }

        column REGISTRY_CHECK_ID (
            type: hidden
            layout {
                sequence: 5
            }
        )

        column REGISTRY_NAME (
            type: plainText
            heading {
                heading: Registry
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <strong>#REGISTRY_NAME#</strong> #EXTERNAL_REFERENCE#
                    ```
            }
        )

