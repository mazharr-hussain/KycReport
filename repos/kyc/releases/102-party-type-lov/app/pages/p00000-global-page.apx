    pageItem P0_PARTY_STATUS (
        type: displayOnly
        label {
            label: Party Status
            alignment: left
        }
        layout {
            sequence: 120
            region: @party-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
