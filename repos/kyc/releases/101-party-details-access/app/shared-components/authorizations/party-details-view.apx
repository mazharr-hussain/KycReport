
authorization party-details-view (
    name: Party Details - View
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- release 101: the rule is in the party package (COMMON's page privilege or the requester)
            return xxcmp_party_pkg.details_authorized('VIEW');
            ```
    }
    error {
        errorMessage: You do not have access to this page.
    }
    advanced {
        evaluationType: perPageView
    }
)
