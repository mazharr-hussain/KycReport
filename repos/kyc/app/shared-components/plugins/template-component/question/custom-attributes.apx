customAttribute ROW_KIND (
    apexlangName: rowKind
    attribute: 1
    name: Row Kind
    appearance {
        sequence: 10
    }
    help {
        helpText: OPTION (a radio button), TEXT, NUMBER or DATE (the answer input); empty for nothing.
    }
)

customAttribute QUESTION_ID (
    apexlangName: questionId
    attribute: 2
    name: Question ID
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 20
    }
)

customAttribute OPTION_ID (
    apexlangName: optionId
    attribute: 3
    name: Option ID
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 30
    }
)

customAttribute OPTION_LABEL (
    apexlangName: optionLabel
    attribute: 4
    name: Option Label
    appearance {
        sequence: 40
    }
)

customAttribute CHECKED (
    apexlangName: checked
    attribute: 5
    name: Checked
    appearance {
        sequence: 50
    }
    help {
        helpText: Y: the saved answer (radio button checked).
    }
)

customAttribute ANSWER_TEXT (
    apexlangName: answerText
    attribute: 6
    name: Answer Text
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 60
    }
)

customAttribute INPUT_LABEL (
    apexlangName: inputLabel
    attribute: 7
    name: Input Label
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 70
    }
    help {
        helpText: The question text, for screen readers.
    }
)

customAttribute GROUP_QUESTION_ID (
    apexlangName: groupQuestionId
    attribute: 8
    name: Question ID (Group)
    scope: reportGroup
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @question
        sequence: 80
    }
)

customAttribute GROUP_ANSWER_TYPE (
    apexlangName: groupAnswerType
    attribute: 9
    name: Answer Type (Group)
    scope: reportGroup
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        attributeGroup: @question
        sequence: 90
    }
)

customAttribute QUESTION_TEXT (
    apexlangName: questionText
    attribute: 10
    name: Question Text
    scope: reportGroup
    appearance {
        attributeGroup: @question
        sequence: 100
    }
)

customAttribute REQUIRED (
    apexlangName: required
    attribute: 11
    name: Required
    scope: reportGroup
    appearance {
        attributeGroup: @question
        sequence: 110
    }
    help {
        helpText: Y: the question must be answered.
    }
)

customAttribute CHOICE (
    apexlangName: choice
    attribute: 12
    name: Choice
    scope: reportGroup
    appearance {
        attributeGroup: @question
        sequence: 120
    }
    help {
        helpText: Y: the answer is one of the options (radio buttons).
    }
)

customAttribute SECTION_TITLE (
    apexlangName: sectionTitle
    attribute: 13
    name: Section Title
    scope: reportGroup
    appearance {
        attributeGroup: @question
        sequence: 130
    }
    help {
        helpText: Set on the first question of a section: its title.
    }
)
