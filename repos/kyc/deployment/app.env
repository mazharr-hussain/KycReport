# The KYC application the pipeline deploys on top of COMMON (I-096, #272; sourced by repos/common/deployment/db/kyc.sh).
APP_CODE=KYC                     # application code in COMMON (its APEX alias)
APP_ID=134                       # APEX application id
APP_SCHEMA=XXCUS                 # parsing schema: every object of the application
WORKSPACE=XXCUS                  # APEX workspace
CI_USER=XXCI_DEPLOY              # pipeline database user (the same as COMMON's: one per database)
ZIP_NAME=KYC-Compliance-Platform-APEXlang
APP_PATH=xxcus/kyc               # friendly URL path of the application (workspace path / application alias)
