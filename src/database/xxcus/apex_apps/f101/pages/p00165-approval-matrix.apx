page 165 (
    name: Approval Matrix
    alias: APPROVAL-MATRIX
    title: Approval Matrix
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @page-view
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: How many approval levels each risk tier needs and which roles approve. Enhanced KYC always follows the High row.
    }

    region breadcrumb (
        name: Approval Matrix
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region matrix (
        name: Approval Matrix
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.risk_tier, m.required_levels, m.level1_role_code, m.level2_role_code, m.sar_gate_flag
                  from xxcmp_approval_matrix m
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: matrix
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No data found.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @RISK_TIER
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @REQUIRED_LEVELS
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @LEVEL1_ROLE_CODE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @LEVEL2_ROLE_CODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @SAR_GATE_FLAG
                layout {
                    sequence: 6
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 5
            }
        )

        column RISK_TIER (
            type: selectList
            heading {
                heading: Risk Tier
            }
            layout {
                sequence: 20
            }
            lov {
                type: sharedComponent
                lov: @lov-risk-tier
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: RISK_TIER
                dataType: varchar2
                primaryKey: true
            }
        )

        column REQUIRED_LEVELS (
            type: numberField
            heading {
                heading: Levels
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: REQUIRED_LEVELS
                dataType: number
            }
        )

        column LEVEL1_ROLE_CODE (
            type: selectList
            heading {
                heading: Level 1 Role
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @lov-roles
            }
            validation {
                valueRequired: true
            }
            source {
                type: databaseColumn
                databaseColumn: LEVEL1_ROLE_CODE
                dataType: varchar2
            }
        )

        column LEVEL2_ROLE_CODE (
            type: selectList
            heading {
                heading: Level 2 Role
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @lov-roles
            }
            source {
                type: databaseColumn
                databaseColumn: LEVEL2_ROLE_CODE
                dataType: varchar2
            }
        )

        column SAR_GATE_FLAG (
            type: switch
            heading {
                heading: SAR Gate
            }
            layout {
                sequence: 60
            }
            source {
                type: databaseColumn
                databaseColumn: SAR_GATE_FLAG
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
        )

    )

    process save-matrix (
        name: Save matrix
        type: interactiveGridAutoRowProcessing
        editableRegion: @matrix
        execution {
            sequence: 10
            point: processing
        }
        security {
            authorizationScheme: @page-submit
        }
    )

)
