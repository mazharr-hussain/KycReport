<mxfile host="app.diagrams.net" modified="2026-06-26" version="21.0.0">
  <diagram id="intake-flow" name="Intake and Document Validation">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="KYC Intake &amp; Document Validation — Phase 0 and Phase 1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <!-- Swimlane: Business Dept -->
        <mxCell id="lane_dept" value="Business Department" style="swimlane;startSize=30;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1080" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Open KYC Request Portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;" vertex="1" parent="lane_dept">
          <mxGeometry x="40" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Complete Structured Form&#xa;(name &amp; dept auto-filled&#xa;from Oracle Fusion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;" vertex="1" parent="lane_dept">
          <mxGeometry x="280" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Upload Documents&#xa;(checklist shown by&#xa;entity type + country)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;" vertex="1" parent="lane_dept">
          <mxGeometry x="660" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Submit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;" vertex="1" parent="lane_dept">
          <mxGeometry x="880" y="60" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- Rules Engine -->
        <mxCell id="rules" value="KYC Rules Engine" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="lane_dept">
          <mxGeometry x="500" y="45" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_rules" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d2" target="rules" parent="lane_dept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rules_d3" value="KYC Required" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="rules" target="d3" parent="lane_dept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d3_d4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3" target="d4" parent="lane_dept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Swimlane: System -->
        <mxCell id="lane_sys" value="KYC System (Oracle APEX)" style="swimlane;startSize=30;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="1080" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Create Waiver Record&#xa;+ Store Evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="440" y="45" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Create Case&#xa;INTAKE-YYYY-NNNNNN&#xa;Notify Compliance Team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="720" y="45" width="200" height="60" as="geometry" />
        </mxCell>
        <!-- Compliance Officer Lane -->
        <mxCell id="lane_co" value="Compliance Officer" style="swimlane;startSize=30;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1080" height="500" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Review Documents&#xa;Against Checklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="100" y="60" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_check" value="Documents&#xa;Complete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="320" y="45" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Send Structured&#xa;Document Request&#xa;Set Deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF9A9A;strokeColor=#B71C1C;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="320" y="200" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Mark: Documents&#xa;Complete ✅&#xa;KPI Clock Starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;fontColor=#ffffff;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="540" y="60" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_dup" value="Duplicate Check&#xa;Jaro-Winkler&#xa;Fuzzy Match" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="740" y="45" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_match" value="Show Existing&#xa;Record to Officer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="740" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_proceed" value="Proceed to&#xa;Risk Assessment" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="920" y="55" width="120" height="70" as="geometry" />
        </mxCell>
        <!-- Dept uploads response -->
        <mxCell id="c_dept_upload" value="Department Uploads&#xa;via Portal&#xa;(not email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;" vertex="1" parent="lane_co">
          <mxGeometry x="100" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Edges in CO lane -->
        <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c1" target="c_check" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="Missing" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c_check" target="c2" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec3" value="Complete" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c_check" target="c3" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c2" target="c_dept_upload" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c_dept_upload" target="c1" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c3" target="c_dup" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec7" value="Match Found" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c_dup" target="c_match" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec8" value="No Match" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c_dup" target="c_proceed" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="c_match" target="c_proceed" parent="lane_co">
          <mxGeometry relative="1" as="geometry" />
