          <mxGeometry x="760" y="620" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="worldcheck" value="WorldCheck (Refinitiv)&#xa;Manual Screening&#xa;Results recorded in system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF9A9A;strokeColor=#B71C1C;fontSize=11;" vertex="1" parent="ext_bg">
