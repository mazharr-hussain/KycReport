        <mxCell id="r_submit" value="Report Submitted" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_risk" value="Risk Level?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_l1" value="L1 Approver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;fontColor=#1A237E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_final_low" value="Final Approved" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="45" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_officer" value="Back to Officer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#BF360C;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_l2" value="L2 Approver / MLRO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;fontColor=#1A237E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="230" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_sar" value="SAR question&#xa;answered" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="360" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_final" value="Final Approved" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="240" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_sarproc" value="SAR Process" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="re1" edge="1" source="r_submit" target="r_risk" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" value="Low" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_risk" target="r_l1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" value="Medium" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_risk" target="r_l1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re4" value="High" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_risk" target="r_l1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re5" value="Approve (Low)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_l1" target="r_final_low" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re6" value="RFI or Reject" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_l1" target="r_officer" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re7" value="Approve (Med/High)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_l1" target="r_l2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re8" edge="1" source="r_l2" target="r_sar" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re9" value="No SAR, Approve" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_sar" target="r_final" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re10" value="SAR Identified" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_sar" target="r_sarproc" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re11" value="RFI or Reject" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_l2" target="r_officer" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="approval-delegation" name="Delegation">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dtitle" value="Delegation — Active Approver Resolution" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d_submit" value="Report Ready for&#xa;L1 Approval" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_check" value="Is Primary L1&#xa;Approver On Leave?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="190" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d_primary" value="Route to Primary&#xa;L1 Approver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;fontColor=#1A237E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d_deputy_check" value="Is Deputy&#xa;Configured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="310" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d_deputy" value="Route to&#xa;Designated Deputy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#4A148C;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d_alert" value="Alert Administrator&#xa;No Deputy Configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;fontColor=#7F0000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="440" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d_queue" value="Appears in&#xa;Approver's Queue" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="440" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="de1" edge="1" source="d_submit" target="d_check" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" value="No — Available" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d_check" target="d_primary" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de3" value="Yes — On Leave" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d_check" target="d_deputy_check" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d_deputy_check" target="d_deputy" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" value="No" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d_deputy_check" target="d_alert" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
