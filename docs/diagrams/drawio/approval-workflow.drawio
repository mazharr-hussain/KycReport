<mxfile host="app.diagrams.net" modified="2026-06-26" version="21.0.0">
  <diagram id="approval-workflow" name="Approval Workflow State Machine">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="KYC Approval Workflow — State Machine" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <!-- States -->
        <mxCell id="draft" value="DRAFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="submitted" value="SUBMITTED&#xa;/ PENDING L1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rfi" value="RFI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rejected" value="REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="approved_l1" value="APPROVED L1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="final_low" value="FINAL APPROVED&#xa;(Low Risk)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="340" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pending_l2" value="PENDING L2&#xa;/ MLRO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="460" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sar_note" value="Mandatory SAR question&#xa;answered by L2/MLRO&#xa;before any action&#xa;(not a separate state)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sar_process" value="SAR PROCESS&#xa;(Approval Paused)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="580" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l2_rfi" value="RFI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="460" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l2_rejected" value="REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="340" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="final" value="FINAL APPROVED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="700" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="e1" value="Officer Submits" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="draft" target="submitted" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="L1 Approves" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="submitted" target="approved_l1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="L1 Rejects" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="submitted" target="rejected" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="L1 Issues RFI" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="submitted" target="rfi" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Officer Responds &amp; Resubmits" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="rfi" target="submitted" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Low Risk" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="approved_l1" target="final_low" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Medium / High Risk" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="approved_l1" target="pending_l2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="SAR = Yes&#xa;Approval Paused" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pending_l2" target="sar_process" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="SAR = No, L2 Approves" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pending_l2" target="final" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="L2 Rejects" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pending_l2" target="l2_rejected" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="L2 Issues RFI" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pending_l2" target="l2_rfi" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="Officer Responds &amp; Resubmits" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="l2_rfi" target="submitted" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Completion notes -->
        <mxCell id="note1" value="Auto-generate PDF&#xa;Notify Requestor&#xa;Set Review Date&#xa;Seal Record" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="700" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="final" target="note1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 4-eyes note -->
        <mxCell id="note2" value="⚠️ 4-Eyes Principle:&#xa;Contributor CANNOT&#xa;approve their own report.&#xa;Enforced at DB level." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="180" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="approval-routing" name="Routing Rules">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rtitle" value="Approval Routing Rules by Risk Level" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="5" width="700" height="30" as="geometry" />
